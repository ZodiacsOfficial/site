{"info":{"author":"Stanislas Marquis","author_email":"stan@astrorigin.com","bugtrack_url":null,"classifiers":["Development Status :: 3 - Alpha","Intended Audience :: Developers","Intended Audience :: Religion","License :: OSI Approved :: GNU Affero General Public License v3","Programming Language :: C","Programming Language :: Python","Programming Language :: Python :: 2","Programming Language :: Python :: 3","Topic :: Religion","Topic :: Scientific/Engineering :: Astronomy","Topic :: Software Development :: Libraries :: Python Modules"],"description":"Python extension to AstroDienst Swiss Ephemeris library.\n\nThe Swiss Ephemeris is the de-facto standard library for astrological\ncalculations. It is a high-precision ephemeris, based upon the DE431\nephemerides from NASA's JPL, and covering the time range 13201 BC to AD 17191.\n\n::\n\n    >>> import swisseph as swe\n    >>> # first set path to ephemeris files\n    >>> swe.set_ephe_path('/usr/share/sweph/ephe')\n    >>> # find time of next lunar eclipse\n    >>> jd = swe.julday(2007, 3, 3) # julian day\n    >>> res = swe.lun_eclipse_when(jd)\n    >>> ecltime = swe.revjul(res[1][0])\n    >>> print(ecltime)\n    (2007, 3, 3, 23.347926892340183)\n    >>> # get ecliptic position of asteroid 13681 \"Monty Python\"\n    >>> jd = swe.julday(2008, 3, 21)\n    >>> xx, rflags = swe.calc_ut(jd, swe.AST_OFFSET+13681)\n    >>> # print longitude\n    >>> print(xx[0])\n    0.09843983166646618\n\n:Documentation: https://astrorigin.com/pyswisseph\n:Repository: https://github.com/astrorigin/pyswisseph\n\n","description_content_type":"text/x-rst","docs_url":null,"download_url":"https://pypi.org/project/pyswisseph","downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":null,"home_page":"https://astrorigin.com/pyswisseph","keywords":"Astrology Ephemeris Swisseph","license":"","license_expression":null,"license_files":null,"maintainer":"","maintainer_email":"","name":"pyswisseph","package_url":"https://pypi.org/project/pyswisseph/","platform":null,"project_url":"https://pypi.org/project/pyswisseph/","project_urls":{"Download":"https://pypi.org/project/pyswisseph","Homepage":"https://astrorigin.com/pyswisseph"},"provides_extra":null,"release_url":"https://pypi.org/project/pyswisseph/2.10.3.2/","requires_dist":null,"requires_python":">=3.5","summary":"Python extension to the Swiss Ephemeris","version":"2.10.3.2","yanked":false,"yanked_reason":null},"last_serial":18367433,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"stnsls"},{"role":"Maintainer","user":"ShadowJonathan"}]},"urls":[{"comment_text":"","core-metadata":{"sha256":"db90110588920e0602137f66ad6b37ea3b694fefc8d2bc4c9bc3ca4adada289c"},"digests":{"blake2b_256":"f00915b24c8d41b57bdc5cb73e0366938fc2a21362551144bd76af2ddf743f4e","md5":"c43e859b1e9adc638e97ea8f6569abd0","sha256":"0dbbc136286e590aeeddd6bd76fa7058b5672ebb338b49c584f3396e5dbc0c7a"},"downloads":-1,"filename":"pyswisseph-2.10.3.2-cp310-cp310-macosx_10_9_universal2.whl","has_sig":false,"md5_digest":"c43e859b1e9adc638e97ea8f6569abd0","packagetype":"bdist_wheel","python_version":"cp310","requires_python":">=3.5","size":793952,"upload_time":"2023-06-04T17:04:31","upload_time_iso_8601":"2023-06-04T17:04:31.612731Z","url":"https://files.pythonhosted.org/packages/f0/09/15b24c8d41b57bdc5cb73e0366938fc2a21362551144bd76af2ddf743f4e/pyswisseph-2.10.3.2-cp310-cp310-macosx_10_9_universal2.whl","yanked":false,"yanked_reason":null},{"comment_text":"","core-metadata":{"sha256":"db90110588920e0602137f66ad6b37ea3b694fefc8d2bc4c9bc3ca4adada289c"},"digests":{"blake2b_256":"cf783f48abf3a0629dc0129819a006f5c65b9e2a94c895ec36a81988f7071ae5","md5":"63203b819923f8a1992dbbd1ed29074e","sha256":"2dc1bef1d425f27684b0316e3f2bd6bb199e8da2af9e5e6bd4a29c309eba01c3"},"downloads":-1,"filename":"pyswisseph-2.10.3.2-cp310-cp310-manylinux_2_17_i686.manylinux2014_i686.whl","has_sig":false,"md5_digest":"63203b819923f8a1992dbbd1ed29074e","packagetype":"bdist_wheel","python_version":"cp310","req