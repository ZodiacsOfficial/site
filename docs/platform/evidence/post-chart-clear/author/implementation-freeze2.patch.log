 export function clearPostChartContext(): void {
   if (typeof window === 'undefined') return;
   delete (window as PostChartWindow).zodiacsPostChartContext;
+  // Consumers also cache derived state. Invalidate it synchronously, without
+  // repeating any chart or profile data in the clear signal.
+  window.dispatchEvent(new Event('zodiacs:chart-context-cleared'));
 }
 
 export function publishPostChartContext(context: PostChartContext): void {
