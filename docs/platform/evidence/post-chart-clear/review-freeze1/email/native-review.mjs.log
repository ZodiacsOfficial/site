import fs from 'node:fs';
import crypto from 'node:crypto';
import {chromium} from 'playwright-core';
import {fixture,installControls} from './fixture.mjs';

const variant=process.env.SUBJECT??'candidate';
const clearEvent=process.env.CLEAR_EVENT??'zodiacs:chart-context-cleared';
const bytes=fs.readFileSync(`${variant}.js`,'utf8');
const results={variant,clearEvent,node:process.version,subjectSha256:crypto.createHash('sha256').update(bytes).digest('hex'),groups:[],requests:[],pageErrors:[]};
const tests=[
 ['ordinary chart success and native reset',async()=>{const r=review;r.computed();r.fill();r.submit();r.resolve(0);await Promise.resolve();await Promise.resolve();const s=r.state('chart');r.check(s.status==='Success'&&s.email===''&&s.checked==='cancer'&&s.chooserHidden&&!s.disabled,'Current success did not reset and preserve selected sign');r.check(r.subscribed()===1,'Current success analytics missing');}],
 ['ordinary chart failure preserves input and retries',async()=>{const r=review;r.computed();r.fill();r.submit();r.reject(0);await Promise.resolve();await Promise.resolve();const s=r.state('chart');r.check(s.status==='Retry later'&&s.email==='first@example.invalid'&&!s.disabled,'Current failure semantics changed');r.check(r.subscribed()===0,'Failure emitted success');r.submit();r.check(r.requests.length===2&&r.state('chart').disabled,'Current retry is unavailable');}],
 ['same-chart later form edits retain existing submit completion semantics',async()=>{const r=review;r.computed();r.fill();r.submit();r.fill('chart','later-edit@example.invalid');r.choose('chart','leo');r.resolve(0);await Promise.resolve();await Promise.resolve();const s=r.state('chart');r.check(s.status==='Success'&&s.email===''&&s.checked==='cancer'&&!s.disabled,'Ordinary edits were given a new cancellation policy');r.check(r.requests.length===1&&r.requests[0].body.includes('first%40example.invalid')&&r.requests[0].body.includes('sign=cancer')&&r.subscribed()===1,'Original submitted snapshot/count changed');}],
 ['clear hides chart and preserves typed email and other surfaces',async()=>{const r=review;r.computed();r.fill();r.fill('footer','footer@example.invalid');r.choose('footer','leo');const footer=r.state('footer'),horoscopes=r.state('horoscopes');r.clear();r.check(r.state('chart').hidden&&r.state('chart').email==='first@example.invalid','Clear did not hide chart/preserve typed email');r.equal(r.state('footer'),footer,'Clear changed footer');r.equal(r.state('horoscopes'),horoscopes,'Clear changed horoscope');}],
 ['late success after clear has no obsolete UI mutation',async()=>{const r=review;r.computed();r.fill();r.submit();r.clear();const prior=r.state('chart');r.resolve(0);await Promise.resolve();await Promise.resolve();r.equal(r.state('chart'),prior,'Old success changed cleared form');r.check(r.requests.length===1&&r.subscribed()===1,'Submitted operation/analytics was not retained once');}],
 ['late rejection after clear has no obsolete error or finalizer',async()=>{const r=review;r.computed();r.fill();r.submit();r.clear();const prior=r.state('chart');r.reject(0);await Promise.resolve();await Promise.resolve();r.equal(r.state('chart'),prior,'Old rejection changed cleared form');r.check(r.requests.length===1&&r.subscribed()===0,'Rejected operation count changed');}],
 ['late success cannot reset a new chart or edited address',async()=>{const r=review;r.computed();r.fill();r.submit();r.clear();r.computed('leo');r.fill('chart','replacement@example.invalid');const prior=r.state('chart');r.resolve(0);await Promise.resolve();await Promise.resolve();r.equal(r.state('chart'),prior,'Old success reset replacement chart/input');r.check(r.subscribed()===1,'Already submitted success analytics missing');}],
 ['old failure cannot end a newer pending submit',async()=>{const r=review;r.computed();r.fill();r.submit();r.clear();r.computed('leo');r.fill('chart','replacement@example.invalid');r.submit();const prior=r.state('chart');r.reject(0);await Promise.resolve();await Promise.resolve();r.equal(r.state('chart'),prior,'Old rejection mutated newer pending form');r.check(r.state('chart').disabled,'New submission prematurely enabled');r.resolve(1);await Promise.resolve();await Promise.resolve();r.check(r.state('chart').status==='Success'&&r.state('chart').checked==='leo'&&!r.state('chart').disabled,'New submission cannot complete');r.check(r.requests.length===2&&r.subscribed()===1,'Request/analytics count wrong');}],
 ['old success cannot end a newer pending submit',async()=>{const r=review;r.computed();r.fill();r.submit();r.clear();r.computed('leo');r.fill('chart','replacement@example.invalid');r.submit();const prior=r.state('chart');r.resolve(0);await Promise.resolve();await Promise.resolve();r.equal(r.state('chart'),prior,'Old success mutated newer pending form');r.reject(1);await Promise.resolve();await Promise.resolve();r.check(r.state('chart').status==='Retry later'&&r.state('chart').email==='replacement@example.invalid'&&!r.state('chart').disabled,'New failure/recovery changed');r.check(r.requests.length===2&&r.subscribed()===1,'Already committed success analytics wrong');}],
 ['queued chart chooser focus is fenced after clear',async()=>{const r=review;r.computed();r.change();r.focusOutside();r.clear();r.flushFrames();r.check(r.active().outside,'Old frame focused a cleared chart chooser');}],
 ['queued chart chooser focus is fenced after replacement',async()=>{const r=review;r.computed();r.change();r.focusOutside();r.computed('leo');r.flushFrames();r.check(r.active().outside,'Old frame focused replacement chooser');}],
 ['obsolete focus cannot enter a reopened replacement chooser',async()=>{const r=review;r.computed();r.change();r.computed('leo');r.change();r.focusOutside();r.flushNextFrame();r.check(r.active().outside,'Old focus frame entered reopened replacement chooser');r.flushNextFrame();r.check(r.active().shell==='chart'&&r.active().value==='leo','New focus frame was wrongly suppressed');}],
 ['queued reset cannot collapse newly opened replacement chooser',async()=>{const r=review;r.computed();r.el('chart','form').reset();r.clear();r.computed('leo');r.change();const prior=r.state('chart');await Promise.resolve();await Promise.resolve();r.equal(r.state('chart'),prior,'Old reset microtask rerendered new chooser');}],
 ['current reset and focus controls remain functional',async()=>{const r=review;r.computed();r.choose('chart','leo');r.el('chart','form').reset();await Promise.resolve();r.check(r.state('chart').checked==='leo'&&r.state('chart').chooserHidden,'Current native reset lost personalization');r.change();r.flushFrames();r.check(r.active().shell==='chart'&&r.active().name==='sign'&&r.active().value==='leo','Current chooser focus broken');}],
 ['footer pending success survives unrelated chart lifecycle',async()=>{const r=review;r.fill('footer','footer@example.invalid');r.choose('footer','leo');r.submit('footer');r.computed();r.clear();r.resolve(0);await Promise.resolve();await Promise.resolve();const s=r.state('footer');r.check(s.status==='Success'&&s.email===''&&s.checked===''&&!s.disabled&&!s.hidden,'Weekly footer success/reset changed');r.check(r.requests.length===1&&r.subscribed()===1,'Footer operation count changed');}],
 ['horoscope pending success preserves standalone sign',async()=>{const r=review;r.fill('horoscopes','horoscope@example.invalid');r.submit('horoscopes');r.computed('leo');r.clear();r.resolve(0);await Promise.resolve();await Promise.resolve();const s=r.state('horoscopes');r.check(s.status==='Success'&&s.email===''&&s.checked==='virgo'&&s.chooserHidden&&!s.hidden,'Standalone daily personalization changed');r.check(r.requests.length===1&&r.subscribed()===1,'Standalone operation count changed');}],
 ['non-chart queued chooser focus survives chart clear',async()=>{const r=review;r.change('horoscopes');r.focusOutside();r.computed();r.clear();r.flushFrames();r.check(r.active().shell==='horoscopes'&&r.active().value==='virgo','Global chart generation fenced unrelated focus');}],
 ['replacement computed alone invalidates old submit UI',async()=>{const r=review;r.computed();r.fill();r.submit();r.computed('leo');r.fill('chart','replacement@example.invalid');const prior=r.state('chart');r.resolve(0);await Promise.resolve();await Promise.resolve();r.equal(r.state('chart'),prior,'Next computed without clear admitted obsolete success');r.check(r.subscribed()===1,'Already submitted success analytics missing');}],
 ['native invalid-email and daily-sign validation preserved',async()=>{const r=review;r.computed();r.fill('chart','invalid');r.submit();r.check(r.requests.length===0&&r.state('chart').status==='Invalid email','Invalid email submitted');r.fill('horoscopes','valid@example.invalid');Array.from(document.querySelectorAll('#horoscopes [name=sign]')).forEach(x=>x.checked=false);r.submit('horoscopes');r.check(r.requests.length===0&&r.state('horoscopes').status==='Choose sign'&&!r.state('horoscopes').chooserHidden,'Daily missing sign validation changed');}],
 ['positions computed does not reveal hidden chart capture',async()=>{const r=review;r.computed('leo','positions');r.check(r.state('chart').hidden,'Positions-only event revealed capture');r.check(!r.state('footer').hidden&&!r.state('horoscopes').hidden,'Positions event hid unrelated forms');}],
];
let browser;
try{
 browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking']});results.browser=browser.version();
 for(const [label,run] of tests){const context=await browser.newContext();const page=await context.newPage();let snapshot;await context.route('**/*',route=>{results.requests.push(route.request().url());return route.abort()});page.on('pageerror',e=>results.pageErrors.push({label,message:String(e)}));
  try{await page.setContent(fixture());await page.evaluate(installControls,clearEvent);await page.evaluate(()=>{review.check=(ok,message)=>{if(!ok)throw Error(message)};review.equal=(a,b,message)=>review.check(JSON.stringify(a)===JSON.stringify(b),message+' '+JSON.stringify({actual:a,expected:b}));review.subscribed=()=>review.analytics.filter(x=>x.name==='email_subscribed').length});await page.addScriptTag({content:bytes});await page.evaluate(run);snapshot=await page.evaluate(()=>review.summary());results.groups.push({label,outcome:'passed',snapshot});}
  catch(error){snapshot=await page.evaluate(()=>window.review?.summary());results.groups.push({label,outcome:'failed',error:String(error.stack??error),snapshot});}
  finally{await context.close()}
 }
 results.passed=results.groups.filter(x=>x.outcome==='passed').length;results.failed=results.groups.length-results.passed;results.outcome=results.failed||results.requests.length||results.pageErrors.length?'failed':'passed';if(results.outcome!=='passed')process.exitCode=1;
}catch(error){results.error=String(error.stack??error);results.outcome='failed';process.exitCode=1}finally{await browser?.close();results.cleanup='All owned blank native contexts and browser closed. Deferred fetch never sent to network.';fs.writeFileSync(`${variant}-native-result.json`,JSON.stringify(results,null,2)+'\n');console.log(JSON.stringify({variant,browser:results.browser,outcome:results.outcome,passed:results.passed,failed:results.failed,pageErrors:results.pageErrors.length,requests:results.requests.length,error:results.error}));}
