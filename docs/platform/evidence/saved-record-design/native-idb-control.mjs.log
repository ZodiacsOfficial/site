});const result={checkedAt:new Date().toISOString(),node:process.version,browser:await browser.version(),origin:url,adapterSHA256:createHash('sha256').update(source).digest('hex'),controls,scope:'Actual frozen IndexedDbLivingChartAdapter executed against native Chromium IndexedDB in a disposable browser context. Hypothetical version2 upgrade only in that context; no site or user storage touched.'};fs.writeFileSync('native-idb-result.json',JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result,null,2));await context.close();}finally{await browser?.close();await new Promise(r=>server.close(r))}
