import assert from 'node:assert/strict';import fs from 'node:fs';import {createHash} from 'node:crypto';
import * as actual from './current-boundaries.mjs';
const observed=[];const check=(name,fn)=>{const result=fn();observed.push({name,...result});};
class Storage { values=new Map(); log=[]; hook=null; failSet=null; get length(){return this.values.size}key(i){return [...this.values.keys()][i]??null}getItem(k){const value=this.values.get(k)??null;this.log.push(['get',k]);if(this.hook&&k===actual.PROFILE_KEY){const f=this.hook;this.hook=null;f()}return value}setItem(k,v){if(this.failSet===k)throw new Error('synthetic-quota');this.values.set(k,String(v));this.log.push(['set',k]);}removeItem(k){this.values.delete(k);this.log.push(['remove',k])}}
globalThis.window={dispatchEvent:()=>true};globalThis.CustomEvent=class{constructor(type,options){this.type=type;this.detail=options?.detail}};
let calls=0;globalThis.fetch=()=>{calls++;throw new Error('unexpected-network')};
const idA='10000000-0000-4000-8000-000000000001',idB='20000000-0000-4000-8000-000000000002';
const chart=(id,date)=>({id,name:'Synthetic control',createdAt:'2026-09-08T00:00:00.000Z',updatedAt:'2026-09-08T00:00:00.000Z',birth:{date,time:'08:30',timeKnown:true,place:{name:'Synthetic polar location',admin1:'',country:'XX',lat:78.2232,lon:15.6267,tz:'Arctic/Longyearbyen'}},summary:{engineVersion:'0.1.1-rc.5',utcISO:date+'T08:30:00.000Z',houseSystem:'whole',bodies:[],angles:null,flags:['polar-fallback']}});
const first=chart(idA,'2001-12-21'),second=chart(idB,'2002-12-21');
check('control/sequential-old-writers-preserve-distinct-records',()=>{const s=new Storage();globalThis.localStorage=s;assert.equal(actual.saveChart(first),'saved');assert.equal(actual.saveChart(second),'saved');assert.deepEqual(actual.loadProfile().charts.map(c=>c.id),[idB,idA]);return{status:'passed',finalIds:[idB,idA]}});
check('counterexample/interleaved-actual-aggregate-writers-lose-acknowledged-save',()=>{const s=new Storage();globalThis.localStorage=s;let otherResult;s.hook=()=>{otherResult=actual.saveChart(second)};const firstResult=actual.saveChart(first);const ids=actual.loadProfile().charts.map(c=>c.id);assert.equal(firstResult,'saved');assert.equal(otherResult,'saved');assert.deepEqual(ids,[idA]);return{status:'reproduced',schedule:'A reads snapshot, B reads+writes, A writes its earlier snapshot; injected Storage.getItem hook models this allowed two-tab schedule.',bothReturnedSaved:true,lostId:idB,finalIds:ids}});
const native=actual.computePortableChart({utc:'2001-12-21T08:30:00-00:00',latitude:78.2232,longitude:15.6267,houseSystem:'placidus',timeKnown:false},{sourceInstant:'2001-12-21T08:30:00-00:00'});
const proposedKey='zodiacs.saved-natal.candidate-v1';const pendingRecord={schema:'unapproved-store-control',id:idA,owner:{kind:'account',accountId:idA},envelope:native.envelope};const serialized=JSON.stringify(pendingRecord);
check('counterexample/new-global-key-alone-escapes-existing-handoff-inventory',()=>{const s=new Storage();s.setItem(proposedKey,serialized);assert.equal(actual.hasAccountBoundLocalProfileData(s),false);const state=actual.inspectLocalAccountBoundary(s,idB,false);return{status:'reproduced',inventoryRecognizesSensitiveRecord:false,boundary:state,key:proposedKey}});
check('counterexample/new-global-key-survives-actual-account-switch-and-account-delete',()=>{const s=new Storage();s.setItem(actual.ACCOUNT_V2_LOCAL_OWNER_KEY,JSON.stringify({version:1,accountId:idA}));s.setItem(actual.PROFILE_KEY,JSON.stringify({...actual.EMPTY_PROFILE,charts:[first]}));s.setItem(proposedKey,serialized);
const boundary=actual.inspectLocalAccountBoundary(s,idB,actual.hasAccountBoundLocalProfileData(s));assert.equal(boundary.status,'decision-required');const switched=actual.completeAccountBoundaryDecision(s,boundary,'isolate');assert.equal(switched.ok,true);assert.equal(actual.readLocalAccountOwner(s).accountId,idB);assert.equal(s.getItem(proposedKey),serialized);const archive=JSON.parse(s.getItem(actual.localProfileArchiveKey(idA)));assert.equal(Object.hasOwn(archive.values,proposedKey),false);
const deletion=actual.completeDeletedAccountLocalData(s,idA,true);assert.equal(deletion.ok,true);assert.equal(s.getItem(proposedKey),serialized);return{status:'reproduced',switchReturned:switched,ownerAfterSwitch:idB,archiveContainsCandidateKey:false,deletionReturned:deletion,sensitiveNewKeyRemains:true}});
check('control/full-device-clear-includes-zodiacs-localStorage-prefix',()=>{const s=new Storage(),session=new Storage();s.setItem(proposedKey,serialized);s.setItem('unrelated-control','keep');const result=actual.clearAllZodiacsDataFromDevice(s,session);assert.equal(result.ok,true);assert.equal(s.getItem(proposedKey),null);assert.equal(s.getItem('unrelated-control'),'keep');return{status:'passed',candidateKeyRemoved:true,unrelatedKeyRetained:true}});
check('control/storage-quota-failure-does-not-claim-saved',()=>{const s=new Storage();globalThis.localStorage=s;s.failSet=actual.PROFILE_KEY;assert.equal(actual.saveChart(first),'error');assert.equal(s.getItem(actual.PROFILE_KEY),null);return{status:'passed',result:'error',profileWritten:false}});
check('counterexample/per-record-localStorage-naive-CAS-still-loses-update',()=>{const s=new Storage(),key=proposedKey+'.'+idA;s.setItem(key,JSON.stringify({revision:1,label:'original'}));const a=JSON.parse(s.getItem(key)),b=JSON.parse(s.getItem(key));assert.equal(a.revision,1);assert.equal(b.revision,1);s.setItem(key,JSON.stringify({...b,revision:2,label:'B edit'}));s.setItem(key,JSON.stringify({...a,revision:2,label:'A edit'}));assert.equal(JSON.parse(s.getItem(key)).label,'A edit');return{status:'reproduced',modelOnly:true,schedule:'Both read revision1; B writes revision2; A writes revision2 based on stale snapshot.',lostEdit:'B edit'}});
check('counterexample/per-record-cap-and-delete-recreate-need-serialization',()=>{const s=new Storage();s.setItem('record1','old');const seenA=[...s.values.keys()],seenB=[...s.values.keys()];assert.equal(seenA.length,1);assert.equal(seenB.length,1);s.setItem('record2','A');s.setItem('record3','B');assert.equal(s.length,3);const stale=s.getItem('record1');s.removeItem('record1');s.setItem('record1',stale);return{status:'reproduced',modelOnly:true,capacity:2,bothObservedCount:1,actualCountAfterConcurrentCreates:3,deletedRecordResurrected:true}});
check('control/epoch-detects-account-A-B-A-obsolete-work',()=>{const epoch={current:0};const captured=actual.beginAccountAuthEpoch(epoch);actual.beginAccountAuthEpoch(epoch);actual.beginAccountAuthEpoch(epoch);assert.equal(actual.isAccountAuthEpochCurrent(epoch,captured),false);return{status:'passed',capturedEpoch:captured,currentEpoch:epoch.current,lateActionAllowed:false}});
assert.equal(calls,0);
const result={generatedAt:new Date().toISOString(),node:process.version,rootSource:JSON.parse(fs.readFileSync('identity.json','utf8')).rootHead,actualModuleSHA256:createHash('sha256').update(fs.readFileSync('current-boundaries.mjs')).digest('hex'),controls:observed,networkCalls:calls,scope:'Synthetic in-memory exact source-function executions plus explicitly labeled candidate storage models. No real localStorage, IndexedDB, account or UI mutation.'};fs.writeFileSync('result.json',JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result,null,2));
