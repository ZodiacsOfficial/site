if(result.status==='existing'){
 const first:number=result.intervals[0].start;
 const end:number=result.intervals[0].endExclusive;
 // @ts-expect-error Result intervals are readonly.
 result.intervals[0].start=0;
 void[first,end];
}else if(result.status==='empty'){
 const empty:readonly[]=result.intervals;void empty;
}else{
 const reason:string=result.reason;
