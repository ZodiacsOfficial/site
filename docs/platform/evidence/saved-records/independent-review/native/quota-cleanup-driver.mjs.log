import fs from 'node:fs';import path from 'node:path';import http from 'node:http';import {createHash} from 'node:crypto';import {createRequire} from 'node:module';
const root=path.dirname(new URL(import.meta.url).pathname);const reviewRoot=path.dirname(root);
if(!fs.existsSync(path.join(reviewRoot,'freeze.json')))throw new Error('No frozen patch identity; native acceptance is not authorized to use changing author source.');
const identity=JSON.parse(fs.readFileSync(path.join(reviewRoot,'freeze.json'),'utf8'));
const {chromium}=createRequire('/Users/chiburashka/.codex/worktrees/4806/site/package.json')('playwright-core');
const expected=new Set(['/browser-cases.mjs','/native-hooks.mjs','/subject.js']);
const server=http.createServer((request,response)=>{const route=new URL(request.url,'http://localhost').pathname;if(route==='/'){response.setHeader('Content-Type','text/html');response.end('<!doctype html><title>Synthetic saved natal acceptance</title><p>Synthetic saved natal acceptance</p><script type="module" src="/browser-cases.mjs"></script>');return;}if(!expected.has(route)){response.statusCode=404;response.end('Not found');return;}response.setHeader('Content-Type','text/javascript');response.end(fs.readFileSync(path.join(root,route.slice(1))));});
await new Promise(resolve=>server.listen(0,'127.0.0.1',resolve));const origin=`http://127.0.0.1:${server.address().port}`;
let browser;const results=[];const openedAt=new Date().toISOString();
async function openCase(){const context=await browser.newContext();const page=await context.newPage();const errors=[];const requests=[];page.on('pageerror',e=>errors.push(String(e)));page.on('request',r=>requests.push({url:r.url(),method:r.method()}));await page.addInitScript(()=>{window.subjectOpenCount=0;const original=IDBFactory.prototype.open;IDBFactory.prototype.open=function(...args){window.subjectOpenCount++;return original.apply(this,args)}});await page.goto(origin);await page.waitForFunction(()=>Array.isArray(window.nativeCaseNames));return{context,page,errors,requests};}
try{browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--no-first-run','--no-default-browser-check','--disable-background-networking']});
const first=await openCase();const names=await first.page.evaluate(()=>window.nativeCaseNames);const importOpens=await first.page.evaluate(()=>window.subjectOpenCount);results.push({name:'import-no-database-open',status:importOpens===0?'passed':'failed',openCount:importOpens});await first.context.close();
for(const name of []){const fixture=await openCase();let result;try{result=await fixture.page.evaluate(name=>window.runNativeCase(name),name)}catch(error){result={name,status:'failed',error:String(error)}}result.pageErrors=fixture.errors;result.externalRequests=fixture.requests.filter(r=>!r.url.startsWith(origin+'/'));if(result.externalRequests.length||result.pageErrors.length)result.status='failed';results.push(result);console.log(JSON.stringify(result));await fixture.context.close();}
const quota=await openCase();const client=await quota.context.newCDPSession(quota.page);let quotaResult;
try{await quota.page.evaluate(()=>window.quotaWarmup());const before=await client.send('Storage.getUsageAndQuota',{origin});await client.send('Storage.overrideQuotaForOrigin',{origin,quotaSize:Math.max(1,before.usage)});const after=await client.send('Storage.getUsageAndQuota',{origin});const attempt=await quota.page.evaluate(()=>window.quotaAttempt());const passed=attempt.result.ok===false&&attempt.result.code==='quota-exceeded'&&attempt.result.mayHaveCommitted===false&&attempt.recordsAfterAttempt===0;quotaResult={name:'native-quota-exceeded',status:passed?'passed':'failed',before,after,attempt};}
catch(error){quotaResult={name:'native-quota-exceeded',status:'environment-blocked',error:String(error)}}finally{try{await client.send('Storage.overrideQuotaForOrigin',{origin}); quotaResult.restored=await client.send('Storage.getUsageAndQuota',{origin}); if(quotaResult.restored.overrideActive)quotaResult.status='failed';}catch(error){quotaResult.cleanupError=String(error);quotaResult.status='failed';} quotaResult.pageErrors=quota.errors;quotaResult.externalRequests=quota.requests.filter(r=>!r.url.startsWith(origin+'/'));if(quotaResult.pageErrors.length||quotaResult.externalRequests.length)quotaResult.status='failed';await quota.context.close();quotaResult.contextClosed=true;}results.push(quotaResult);console.log(JSON.stringify(quotaResult));
const record={startedAt:openedAt,completedAt:new Date().toISOString(),node:process.version,browser:await browser.version(),source:identity,origin,results,passed:results.filter(r=>r.status==='passed').length,failed:results.filter(r=>r.status==='failed').length,environmentBlocked:results.filter(r=>r.status==='environment-blocked').length,harnessFiles:Object.fromEntries(['quota-cleanup-driver.mjs','browser-cases.mjs','native-hooks.mjs','subject.js'].map(n=>[n,createHash('sha256').update(fs.readFileSync(path.join(root,n))).digest('hex')]))};const file=`quota-cleanup-result-${Date.now()}.json`;fs.writeFileSync(path.join(root,file),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify({file,passed:record.passed,failed:record.failed,environmentBlocked:record.environmentBlocked}));if(record.failed)process.exitCode=1;
}finally{await browser?.close();await new Promise(resolve=>server.close(resolve));}
