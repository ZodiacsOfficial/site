import {createServer} from 'node:http';
import {readFile,writeFile,mkdir,stat,readdir} from 'node:fs/promises';
import {resolve,extname,sep} from 'node:path';
import {createRequire} from 'node:module';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
import {parseNatalEnvelope} from './freeze2-accepted-compatibility-subject.mjs';
const root='/private/tmp/zodiacs-platform-site-receipt-export';
const base='/private/tmp/zodiacs-platform-site-receipt-export-evidence';
const run=base+'/browser-'+Date.now();await mkdir(run);
const require=createRequire(root+'/package.json');const {chromium}=require('playwright-core');
const identity=JSON.parse(await readFile(base+'/freeze2-identity.json','utf8'));
const sha=bytes=>createHash('sha256').update(bytes).digest('hex');
for(const [file,hash] of Object.entries(identity.files))assert.equal(sha(await readFile(root+'/'+file)),hash);
const requestLog=[],served=new Map(),results=[];const dist=resolve(root,'dist');
const types={'.html':'text/html','.js':'text/javascript','.css':'text/css','.json':'application/json','.svg':'image/svg+xml','.png':'image/png','.webp':'image/webp','.woff2':'font/woff2','.ico':'image/x-icon','.jpg':'image/jpeg','.mp4':'video/mp4','.webm':'video/webm','.xml':'application/xml'};
const server=createServer(async(req,res)=>{try{
 const pathname=decodeURIComponent(new URL(req.url,'http://127.0.0.1').pathname);let file=resolve(dist,'.'+pathname);if(!file.startsWith(dist+sep)&&file!==dist)throw Error('path');
 if((await stat(file)).isDirectory())file=resolve(file,'index.html');
 const bytes=await readFile(file);requestLog.push({method:req.method,path:pathname,status:200});served.set(file.slice(dist.length+1),{bytes:bytes.length,sha256:sha(bytes)});res.writeHead(200,{'Content-Type':types[extname(file)]??'application/octet-stream','Cache-Control':'no-store'});res.end(bytes);
 }catch{requestLog.push({method:req.method,path:req.url,status:404});res.writeHead(404);res.end('Not found');}});
await new Promise(resolve=>server.listen(0,'127.0.0.1',resolve));const origin='http://127.0.0.1:'+server.address().port;
let browser;const contexts=[];const startedAt=new Date().toISOString();
const share=wire=>'1.'+Buffer.from(JSON.stringify(wire)).toString('base64url');
const link=(wire,locale='en')=>origin+(locale==='en'?'':'/'+locale)+'/birth-chart/#c='+share(wire);
const ordinary={d:'1990-06-15',t:'14:30',z:'America/New_York',la:40.71,lo:-74,h:'placidus',n:'Synthetic private label',p:'Synthetic birthplace'};
const observer=()=>{
 window.__receiptChecks={calculations:0,created:[],revoked:[],downloads:0,failAllocation:false};
 addEventListener('zodiacs:chart-computed',()=>window.__receiptChecks.calculations++);
 const create=URL.createObjectURL.bind(URL),revoke=URL.revokeObjectURL.bind(URL);
 URL.createObjectURL=function(blob){if(blob.type.startsWith('application/json')){if(window.__receiptChecks.failAllocation)throw Error('Synthetic private allocation error');const url=create(blob);window.__receiptChecks.created.push(url);return url;}return create(blob);};
 URL.revokeObjectURL=function(url){if(window.__receiptChecks.created.includes(url))window.__receiptChecks.revoked.push(url);return revoke(url);};
};
async function pageFor(name,viewport={width:1280,height:900}){
 const context=await browser.newContext({viewport,acceptDownloads:true,reducedMotion:'reduce'});contexts.push(context);
 const external=[],errors=[],consoleErrors=[];
 await context.route('**/*',route=>{const u=route.request().url();if(u.startsWith(origin+'/')||u.startsWith('data:')||u.startsWith('blob:'))return route.continue();external.push(u);return route.abort();});
 await context.addInitScript(observer);const page=await context.newPage();page.on('pageerror',e=>errors.push(e.message));page.on('console',m=>{if(m.type()==='error')consoleErrors.push(m.text());});let downloads=0;page.on('download',()=>downloads++);
 return {page,context,external,errors,consoleErrors,get downloads(){return downloads;},name};
}
async function ready(s,url){await s.page.goto(url,{waitUntil:'networkidle'});await s.page.locator('astro-island[component-url*="ChartCalculator"]:not([ssr])').waitFor();assert.equal(await s.page.locator('vite-error-overlay').count(),0);}
async function rendered(s){await s.page.locator('.calc__result').waitFor({timeout:20000});await s.page.waitForFunction(()=>document.querySelector('.calc__form')?.getAttribute('aria-busy')==='false');}
async function more(s){const summary=s.page.locator('[data-chart-more] > summary');await summary.scrollIntoViewIfNeeded();if(!(await s.page.locator('[data-chart-more]').getAttribute('open'))){await summary.focus();await s.page.keyboard.press('Enter');}await s.page.locator('[data-calculation-receipt-export]').waitFor({state:'visible'});}
async function state(s){return s.page.evaluate(()=>({calculations:window.__receiptChecks.calculations,created:[...window.__receiptChecks.created],revoked:[...window.__receiptChecks.revoked],storage:Object.fromEntries(Object.entries(localStorage))}));}
async function download(s,name){const before=await state(s);const requestsBefore=requestLog.length;const control=s.page.locator('[data-download-calculation-receipt]');assert.equal(await control.isEnabled(),true);const pending=s.page.waitForEvent('download');await control.focus();await s.page.keyboard.press('Enter');const file=await pending;assert.equal(file.suggestedFilename(),'zodiacs-calculation-receipt.json');const path=run+'/'+name+'.json';await file.saveAs(path);const bytes=await readFile(path);const parsed=parseNatalEnvelope(bytes.toString());assert.equal(parsed.ok,true);await s.page.waitForFunction(()=>window.__receiptChecks.created.every(url=>window.__receiptChecks.revoked.includes(url)));const after=await state(s);assert.equal(after.calculations,before.calculations);assert.deepEqual(after.storage,before.storage);assert.equal(after.created.length,before.created.length+1);assert.equal(after.revoked.length,before.revoked.length+1);const newRequests=requestLog.slice(requestsBefore);assert.equal(newRequests.some(r=>r.method!=='GET'),false);return{envelope:parsed.envelope,sha256:sha(bytes),bytes:bytes.length,before,after,requests:newRequests};}
async function close(s){await s.context.close();}
try{
 browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking']});
 const s=await pageFor('ru-diagnostic',{width:360,height:780});const cdp=await s.context.newCDPSession(s.page);await cdp.send('Debugger.enable');await s.context.addInitScript(()=>{window.__ruTrace=[];});
await cdp.send('Debugger.setBreakpointByUrl',{"urlRegex": "ChartCalculator.*\\.js", "lineNumber": 1, "columnNumber": 13914, "condition": "(window.__ruTrace.push(({kind:'clear',revision:R.current,run:V?.current,stack:new Error().stack})),false)"});
await cdp.send('Debugger.setBreakpointByUrl',{"urlRegex": "ChartCalculator.*\\.js", "lineNumber": 1, "columnNumber": 25223, "condition": "(window.__ruTrace.push(({kind:'commit',revision:i,current:R.current,portable:!!p,input:{date:t.date,time:t.time,tz:t.city.tz},run:l})),false)"});
await cdp.send('Debugger.setBreakpointByUrl',{"urlRegex": "ChartCalculator.*\\.js", "lineNumber": 1, "columnNumber": 13992, "condition": "(window.__ruTrace.push(({kind:'render',date:yt,time:xt,house:Et,chart:!!D,receipt:!!kt,refReceipt:!!jt.current,revision:R.current,hasCity:!!E})),false)"});
await ready(s,link(ordinary,'ru'));await rendered(s);await more(s);
 const inspect=()=>s.page.evaluate(()=>({trace:window.__ruTrace,state:window.__receiptChecks,button:document.querySelector('[data-download-calculation-receipt]').outerHTML,help:document.querySelector('#calculation-receipt-privacy').textContent,form:[...document.querySelectorAll('.calc__form input,.calc__form select')].map(e=>({id:e.id,type:e.type,value:e.value,checked:e.checked})),parents:(()=>{let el=document.querySelector('[data-download-calculation-receipt]');const rows=[];while(el){rows.push({tag:el.tagName,class:el.className,disabled:el.disabled});el=el.parentElement;}return rows;})(),calcProperties:Object.keys(document.querySelector('.calc')),htmlLang:document.documentElement.lang}));
 const before=await inspect();await s.page.screenshot({path:run+'/ru-before.png'});await s.page.waitForTimeout(1500);const later=await inspect();await s.page.locator('.calc__submit').click();await rendered(s);const recomputed=await inspect();await s.page.screenshot({path:run+'/ru-after.png'});results.push({name:'ru-diagnostic',status:'observed',before,later,recomputed,errors:s.errors,consoleErrors:s.consoleErrors,external:s.external});await close(s);
}catch(error){results.push({name:'harness',status:'failed',error:error.stack});console.error(error);}finally{
 for(const context of contexts)await context.close().catch(()=>{});if(browser)await browser.close();await new Promise(resolve=>server.close(resolve));
 const finalSource={};for(const [file,hash]of Object.entries(identity.files)){finalSource[file]=sha(await readFile(root+'/'+file));assert.equal(finalSource[file],hash);}
 const report={startedAt,completedAt:new Date().toISOString(),node:process.version,browser:'Chrome152',identity,origin,run,harnessSha256:sha(await readFile(base+'/ru-hooks-diagnostic.mjs')),results,passed:results.filter(r=>r.status==='passed').length,failed:results.filter(r=>r.status==='failed').length,requestLog,served:Object.fromEntries(served),cleanup:{contextsClosed:true,browserClosed:true,serverClosed:true},finalSource};await writeFile(run+'/result.json',JSON.stringify(report,null,2)+'\n');await writeFile(base+'/ru-hooks-diagnostic-latest.json',JSON.stringify({run,report:run+'/result.json'},null,2)+'\n');console.log(JSON.stringify({run,passed:report.passed,failed:report.failed},null,2));if(report.failed)process.exitCode=1;
}
