import fs from 'node:fs';import path from 'node:path';import{createHash}from'node:crypto';import{execFileSync}from'node:child_process';
const work=path.dirname(new URL(import.meta.url).pathname),source='/private/tmp/zodiacs-platform-receipt-bundle-gate',sha=bytes=>createHash('sha256').update(bytes).digest('hex');
const identity=JSON.parse(fs.readFileSync(path.join(work,'refreeze-identity.json'))),recheck=Object.entries(identity.files).map(([file,expected])=>{const actual=sha(fs.readFileSync(path.join(source,file)));if(actual!==expected)throw new Error('Frozen source changed');return{file,expected,actual,matches:true};});
const fixtureBudgets=[];for(const prefix of ['fixtures','fixtures-refreeze']){for(const name of fs.readdirSync(path.join(work,prefix))){const file=path.join(work,prefix,name,'budgets.json'),hash=sha(fs.readFileSync(file));if(hash!==identity.files['budgets.json'])throw new Error('Fixture budget mismatch');fixtureBudgets.push({fixture:`${prefix}/${name}`,sha256:hash});}}
fs.writeFileSync(path.join(work,'final-recheck.json'),JSON.stringify({at:new Date().toISOString(),allFrozenInputsMatch:true,files:recheck,allFixtureBudgetsUnchanged:true,fixtureBudgets},null,2)+'\n');
execFileSync('tar',['-czf',path.join(work,'fixture-trees.tar.gz'),'fixtures','fixtures-refreeze'],{cwd:work});
const delivery=path.join(work,'delivery');fs.mkdirSync(delivery,{recursive:true});const files=[];
function walk(dir){for(const entry of fs.readdirSync(dir,{withFileTypes:true})){if(dir===work&&['node_modules','fixtures','fixtures-refreeze','delivery'].includes(entry.name))continue;const source=path.join(dir,entry.name);if(entry.isDirectory()){walk(source);continue;}const relative=path.relative(work,source),name=relative.endsWith('.tar.gz')?relative:relative+'.log',target=path.join(delivery,name),bytes=fs.readFileSync(source);fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,bytes);files.push({path:name,originalPath:relative,bytes:bytes.length,sha256:sha(bytes)});}}
walk(work);files.sort((a,b)=>a.path.localeCompare(b.path));fs.writeFileSync(path.join(delivery,'manifest.json'),JSON.stringify({at:new Date().toISOString(),scope:'Independent bundle-gate Freeze2 concrete-syntax/closure review; actual fixture trees archived; dependency bytes indexed in setup identity and retained in scratch.',files},null,2)+'\n');console.log(JSON.stringify({records:files.length,fixtureRepositories:fixtureBudgets.length,allFrozenInputsMatch:true,allFixtureBudgetsUnchanged:true,manifestSha256:sha(fs.readFileSync(path.join(delivery,'manifest.json')))}));
