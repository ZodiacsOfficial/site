import fs from 'node:fs';import path from 'node:path';import{spawnSync}from'node:child_process';import{createHash}from'node:crypto';
const work=path.dirname(new URL(import.meta.url).pathname),source='/private/tmp/zodiacs-platform-receipt-bundle-gate';
const identity=JSON.parse(fs.readFileSync(path.join(source,'identity.json'))),initial=JSON.parse(fs.readFileSync(path.join(work,'author-identity.json'))),sha=bytes=>createHash('sha256').update(bytes).digest('hex');
if(identity.files['scripts/report-bundles.mjs']===initial.files['scripts/report-bundles.mjs'])throw new Error('New root freeze required before acceptance rerun');
if(identity.files['budgets.json']!==initial.files['budgets.json'])throw new Error('Budget mutation is outside this review');
for(const[file,expected]of Object.entries(identity.files)){const bytes=fs.readFileSync(path.join(source,file));if(sha(bytes)!==expected)throw new Error('Root source does not match new frozen identity');const target=path.join(work,'refrozen',file);fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,bytes);}
fs.writeFileSync(path.join(work,'refreeze-identity.json'),JSON.stringify(identity,null,2)+'\n');
const previous=[...JSON.parse(fs.readFileSync(path.join(work,'initial-results.json'))).results,...JSON.parse(fs.readFileSync(path.join(work,'adversarial-results.json'))).results];
const pass=new Set(['control-inert','inert-template','inert-import-string','cycle-shared','aliased-dynamic','computed-dynamic']);
const results=[];
for(const record of previous){const original=path.join(work,'fixtures',`${record.name}-candidate`),target=path.join(work,'fixtures-refreeze',record.name);fs.cpSync(original,target,{recursive:true});fs.copyFileSync(path.join(work,'refrozen/scripts/report-bundles.mjs'),path.join(target,'scripts/report-bundles.mjs'));if(sha(fs.readFileSync(path.join(target,'budgets.json')))!==initial.files['budgets.json'])throw new Error('Fixture budgets changed');const run=spawnSync(process.execPath,['scripts/report-bundles.mjs','--fail'],{cwd:target,encoding:'utf8'}),output=run.stdout+'\n'+run.stderr;fs.writeFileSync(path.join(target,'run.log'),output);const expectedStatus=pass.has(record.name)?0:1;results.push({name:record.name,previousStatus:record.status,status:run.status,expectedStatus,matched:run.status===expectedStatus,signal:run.signal,output});}
const allMatched=results.every(row=>row.matched);fs.writeFileSync(path.join(work,'refreeze-results.json'),JSON.stringify({at:new Date().toISOString(),node:process.version,allMatched,unchangedBudgetSha256:initial.files['budgets.json'],results},null,2)+'\n');console.log(JSON.stringify({allMatched,count:results.length,results:results.map(({name,previousStatus,status,expectedStatus})=>({name,previousStatus,status,expectedStatus}))},null,2));if(!allMatched)process.exit(1);
