import fs from 'node:fs';import path from 'node:path';import{spawnSync}from'node:child_process';
const work=path.dirname(new URL(import.meta.url).pathname),budgetsBytes=fs.readFileSync(path.join(work,'frozen/budgets.json')),budgets=JSON.parse(budgetsBytes);
function run(name,changes,kind='candidate'){
 const root=path.join(work,'fixtures',`${name}-${kind}`),files={
 'budgets.json':budgetsBytes,
 'dist/index.html':'<script type="module" src="/_astro/client.fixture.js"></script>',
 'dist/_astro/client.fixture.js':'export const ready=true;',
 'dist/_astro/full.fixture.js':'import { engine } from "./engine-core.fixture.js";export { engine };',
 'dist/_astro/engine-core.fixture.js':'export const engine=["Value is not boolean:","Light-travel time solver did not converge"];',
 'dist/_astro/receipt.fixture.js':'export const provenance={name:"astronomy-engine"};',
 'src/lib/engine/server-ephemeris.ts':'import * as A from "astronomy-engine";',
 'src/lib/engine/full.ts':'import { computeChart } from "@zodiacs/engine/internal";',
 'src/lib/engine/aspects.ts':'import { A } from "@zodiacs/engine/internal/math";',
 'src/lib/engine/houses.ts':'import { H } from "@zodiacs/engine/internal/math";',
 'src/lib/engine/types.ts':'import { T } from "@zodiacs/engine/internal/math";',
 };
 for(const route of Object.keys(budgets).filter(key=>key.startsWith('/')&&key!=='/'))files[`dist${route}index.html`]='';
 Object.assign(files,changes);
 for(const[file,contents]of Object.entries(files)){const target=path.join(root,file);fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,contents);}
 fs.mkdirSync(path.join(root,'scripts'),{recursive:true});fs.copyFileSync(path.join(work,kind==='candidate'?'frozen/scripts/report-bundles.mjs':'baseline-report-bundles.mjs'),path.join(root,'scripts/report-bundles.mjs'));
 const result=spawnSync(process.execPath,['scripts/report-bundles.mjs','--fail'],{cwd:root,encoding:'utf8'});const output=result.stdout+'\n'+result.stderr;fs.writeFileSync(path.join(root,'run.log'),output);return{name,kind,status:result.status,signal:result.signal,output};
}
const cases=[
 ['control-inert',{},'pass'],
 ['plain-vendor',{'dist/_astro/receipt.fixture.js':'import "astronomy-engine";'},'reject'],
 ['escaped-static-vendor',{'dist/_astro/receipt.fixture.js':String.raw`import "astronomy-\u0065ngine";`},'reject'],
 ['escaped-reexport-vendor',{'dist/_astro/receipt.fixture.js':String.raw`export * from "\u0061stronomy-engine";`},'reject'],
 ['escaped-dynamic-vendor',{'dist/_astro/receipt.fixture.js':String.raw`import("astronomy-\x65ngine");`},'reject'],
 ['escaped-require-vendor',{'dist/_astro/receipt.fixture.js':String.raw`require("astronomy-\u0065ngine");`},'reject'],
 ];
const results=cases.map(([name,changes,expected])=>({...run(name,changes),expected,source:changes['dist/_astro/receipt.fixture.js']??null}));
fs.writeFileSync(path.join(work,'initial-results.json'),JSON.stringify({at:new Date().toISOString(),node:process.version,results},null,2)+'\n');
console.log(JSON.stringify(results.map(({name,status,expected,source})=>({name,status,expected,source})),null,2));
export{run};
