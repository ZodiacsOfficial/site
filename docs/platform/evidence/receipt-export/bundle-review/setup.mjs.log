import fs from 'node:fs';import path from 'node:path';import{createHash}from'node:crypto';import{execFileSync}from'node:child_process';
const work=path.dirname(new URL(import.meta.url).pathname),source='/private/tmp/zodiacs-platform-receipt-bundle-gate',site='/Users/chiburashka/.codex/worktrees/4806/site';
const identity=JSON.parse(fs.readFileSync(path.join(source,'identity.json'))),sha=bytes=>createHash('sha256').update(bytes).digest('hex');
fs.writeFileSync(path.join(work,'author-identity.json'),JSON.stringify(identity,null,2)+'\n');
for(const[file,expected]of Object.entries(identity.files)){const bytes=fs.readFileSync(path.join(source,file));if(sha(bytes)!==expected)throw new Error('Frozen input changed');const target=path.join(work,'frozen',file);fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,bytes);}
const baseline=execFileSync('git',['show',`${identity.siteBase}:scripts/report-bundles.mjs`],{cwd:site});fs.writeFileSync(path.join(work,'baseline-report-bundles.mjs'),baseline);
const typescript=fs.realpathSync(path.join(source,'node_modules/typescript')),target=path.join(work,'node_modules/typescript');fs.mkdirSync(path.dirname(target),{recursive:true});fs.cpSync(typescript,target,{recursive:true,dereference:true});
const records=[];function walk(dir){for(const entry of fs.readdirSync(dir,{withFileTypes:true})){const file=path.join(dir,entry.name);if(entry.isDirectory())walk(file);else records.push({path:path.relative(work,file),sha256:sha(fs.readFileSync(file))});}}walk(target);
fs.writeFileSync(path.join(work,'setup-identity.json'),JSON.stringify({at:new Date().toISOString(),frozenFiles:Object.keys(identity.files).length,baselineSha256:sha(baseline),typescript:{source:typescript,version:JSON.parse(fs.readFileSync(path.join(target,'package.json'))).version,files:records}},null,2)+'\n');
try{execFileSync('diff',['-u',path.join(work,'baseline-report-bundles.mjs'),path.join(work,'frozen/scripts/report-bundles.mjs')],{encoding:'utf8'});}catch(error){fs.writeFileSync(path.join(work,'reviewed.diff'),error.stdout);}
