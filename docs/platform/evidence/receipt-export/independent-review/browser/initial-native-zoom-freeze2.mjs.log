import fs from 'node:fs';import path from 'node:path';import http from 'node:http';import assert from 'node:assert/strict';import {createRequire} from 'node:module';import {createHash} from 'node:crypto';
const out=path.dirname(new URL(import.meta.url).pathname),review=path.dirname(out);
const freeze=JSON.parse(fs.readFileSync(path.join(review,'freeze2-identity.json'),'utf8'));
const build=JSON.parse(fs.readFileSync(path.join(review,'freeze2-build.json'),'utf8'));
const staticRoot=build.staticRoot;const source=freeze.sourceCheckout;
for(const[rel,sha]of Object.entries(freeze.files))assert.equal(createHash('sha256').update(fs.readFileSync(path.join(source,rel))).digest('hex'),sha,`Frozen source changed: ${rel}`);
const {chromium}=createRequire('/Users/chiburashka/.codex/worktrees/4806/site/package.json')('playwright-core');
const receipt=await import('/Users/chiburashka/.codex/worktrees/4806/site/node_modules/@zodiacs/engine/dist/receipt.js');
const mime={'.html':'text/html','.js':'text/javascript','.mjs':'text/javascript','.json':'application/json','.css':'text/css','.svg':'image/svg+xml','.png':'image/png','.jpg':'image/jpeg','.webp':'image/webp','.avif':'image/avif','.woff2':'font/woff2','.ico':'image/x-icon','.mp4':'video/mp4','.webm':'video/webm'};
const served=new Map();const server=http.createServer((req,res)=>{try{let pathname=decodeURIComponent(new URL(req.url,'http://localhost').pathname);let file=path.resolve(staticRoot,'.'+pathname);if(!file.startsWith(staticRoot+path.sep)&&file!==staticRoot){res.statusCode=403;res.end();return}if(fs.existsSync(file)&&fs.statSync(file).isDirectory())file=path.join(file,'index.html');if(!fs.existsSync(file)){res.statusCode=404;res.end('Not found');return}const data=fs.readFileSync(file);served.set(path.relative(staticRoot,file),createHash('sha256').update(data).digest('hex'));res.setHeader('Content-Type',mime[path.extname(file)]??'application/octet-stream');res.end(data);}catch{res.statusCode=500;res.end('Error')}});
await new Promise(r=>server.listen(0,'127.0.0.1',r));const base=`http://127.0.0.1:${server.address().port}`;
const fixture=JSON.parse(fs.readFileSync(path.join(review,'browser-plan.json'),'utf8')).fixtures;
const token=f=>'1.'+Buffer.from(JSON.stringify({d:f.date,z:f.zone,la:f.lat,lo:f.lon,n:'Synthetic Receipt',p:'Synthetic Place',...(f.time===null?{}:{t:f.time}),...(f.houses==='placidus'?{h:'placidus'}:{})})).toString('base64url');
const routeFor=locale=>locale==='en'?'/birth-chart/':`/${locale}/birth-chart/`;
const button='[data-download-calculation-receipt]';let browser;const results=[];

const profile=fs.mkdtempSync('/private/tmp/zodiacs-receipt-native-zoom-');let context,settings,originalZoom;const result={at:new Date().toISOString(),freeze,build,profile,node:process.version};
try{context=await chromium.launchPersistentContext(profile,{executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking','--no-first-run'],viewport:{width:1280,height:900},deviceScaleFactor:1,reducedMotion:'reduce',acceptDownloads:true});result.browser=context.browser()?.version();settings=await context.newPage();await settings.goto('chrome://settings/appearance');await settings.waitForFunction(()=>typeof chrome.settingsPrivate?.getDefaultZoom==='function');originalZoom=await settings.evaluate(()=>new Promise(resolve=>chrome.settingsPrivate.getDefaultZoom(resolve)));await settings.evaluate(()=>new Promise(resolve=>chrome.settingsPrivate.setDefaultZoom(4,resolve)));result.configuredZoom=await settings.evaluate(()=>new Promise(resolve=>chrome.settingsPrivate.getDefaultZoom(resolve)));assert.equal(result.configuredZoom,4);const page=await context.newPage();const errors=[];page.on('pageerror',e=>errors.push(String(e)));await page.goto(base+'/birth-chart/#c='+token(fixture[0]),{waitUntil:'domcontentloaded'});await page.locator('.calc__result').waitFor({timeout:45000});await page.waitForFunction(()=>document.querySelector('.calc__form')?.getAttribute('aria-busy')==='false');await page.locator('[data-chart-more]>summary').focus();await page.keyboard.press('Space');await page.locator(button).waitFor({state:'visible'});await page.locator(button).focus();const pending=page.waitForEvent('download');await page.keyboard.press('Enter');const item=await pending;await item.saveAs(path.join(out,'native-zoom-download.json'));assert.equal(item.suggestedFilename(),'zodiacs-calculation-receipt.json');assert.equal(receipt.parseNatalEnvelope(fs.readFileSync(path.join(out,'native-zoom-download.json'),'utf8')).ok,true);result.metrics=await page.evaluate(()=>({innerWidth,devicePixelRatio,scrollWidth:document.documentElement.scrollWidth,clientWidth:document.documentElement.clientWidth,htmlZoom:getComputedStyle(document.documentElement).zoom,bodyZoom:getComputedStyle(document.body).zoom,focusedReceipt:document.activeElement?.matches('[data-download-calculation-receipt]'),buttonRect:document.querySelector('[data-download-calculation-receipt]')?.getBoundingClientRect().toJSON()}));assert.equal(result.metrics.innerWidth,320);assert.equal(result.metrics.devicePixelRatio,4);assert.equal(result.metrics.scrollWidth,320);assert.equal(result.metrics.htmlZoom,'1');assert.equal(result.metrics.bodyZoom,'1');assert.equal(result.metrics.focusedReceipt,true);assert.equal(errors.length,0);const cdp=await context.newCDPSession(page);const screen=await cdp.send('Page.captureScreenshot',{format:'png',fromSurface:true,captureBeyondViewport:false});fs.writeFileSync(path.join(out,'native-zoom-400.png'),Buffer.from(screen.data,'base64'));result.errors=errors;result.status='passed';}catch(error){result.status='failed';result.error=String(error);result.stack=error.stack;process.exitCode=1;}finally{if(settings&&originalZoom!==undefined){await settings.evaluate(value=>new Promise(resolve=>chrome.settingsPrivate.setDefaultZoom(value,resolve)),originalZoom);result.restoredZoom=await settings.evaluate(()=>new Promise(resolve=>chrome.settingsPrivate.getDefaultZoom(resolve)));}await context?.close();result.contextClosed=true;await new Promise(resolve=>server.close(resolve));result.servedFiles=Object.fromEntries(served);result.harnessSha256=createHash('sha256').update(fs.readFileSync(new URL(import.meta.url))).digest('hex');fs.writeFileSync(path.join(out,'native-zoom-result.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({status:result.status,metrics:result.metrics,error:result.error,restoredZoom:result.restoredZoom}));}
