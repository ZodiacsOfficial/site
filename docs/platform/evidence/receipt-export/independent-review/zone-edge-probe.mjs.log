import fs from 'node:fs';import {resolveLocalToUtc,computePortableChart,computeChart,decodeChartLink} from './zone-edge-subject.mjs';
const results=[];
for(const zone of ['+01:00','+0100','-02:30','+23:59','-00:00','UTC','utc','US/Eastern','GMT0','Etc/GMT+1']){
const row={zone};try{const token='1.'+Buffer.from(JSON.stringify({d:'1990-06-15',t:'14:30',z:zone,la:40.7128,lo:-74.006})).toString('base64url');row.detailsLinkAccepted=decodeChartLink(token)!==null;const resolved=resolveLocalToUtc('1990-06-15','14:30',zone);row.instant=resolved.utc.toISOString();row.offsetMinutes=resolved.offsetMinutes;row.flags=resolved.flags;const input={utc:resolved.utc,latitude:40.7128,longitude:-74.006,houseSystem:'whole',timeKnown:true,flags:resolved.flags};const old=computeChart(input);row.legacySuccess=old.bodies.length===12;const wall=Date.parse('1990-06-15T14:30:00Z');const context={reference:'supplied-instant',localResolution:{date:'1990-06-15',time:'14:30',timeZone:zone,offsetMinutes:resolved.offsetMinutes,gapShiftMinutes:(resolved.utc.getTime()+resolved.offsetMinutes*60000-wall)/60000,policy:{fold:'earlier',gap:'shift-forward'}}};try{computePortableChart(input,context);row.portableContextSuccess=true;}catch(error){row.portableContextSuccess=false;row.failureCode=error.code;row.failureName=error.name;}}catch(error){row.resolutionError=error.name;}results.push(row);}
const record={at:new Date().toISOString(),node:process.version,icu:process.versions.icu,tzdb:process.versions.tz,results,counterexamples:results.filter(r=>r.detailsLinkAccepted&&r.legacySuccess&&r.portableContextSuccess===false)};fs.writeFileSync(new URL('./zone-edge-result.json',import.meta.url),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify(record,null,2));
