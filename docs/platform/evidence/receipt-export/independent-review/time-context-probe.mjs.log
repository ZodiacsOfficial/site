import fs from 'node:fs';import {resolveLocalToUtc,computePortableChart} from './time-context-subject.mjs';import assert from 'node:assert/strict';
const cases=[
['ordinary','1990-06-15','14:30','America/New_York',true,'1990-06-15T18:30:00.000Z',-240,0,[]],
['gap-hour','2024-03-10','02:30','America/New_York',true,'2024-03-10T07:30:00.000Z',-240,60,['dst-gap']],
['fold-earlier','2024-11-03','01:30','America/New_York',true,'2024-11-03T05:30:00.000Z',-240,0,['dst-fold']],
['gap-half-hour','2024-10-06','02:15','Australia/Lord_Howe',true,'2024-10-05T15:45:00.000Z',660,30,['dst-gap']],
['gap-whole-day-unknown','2011-12-30','12:00','Pacific/Apia',false,'2011-12-30T22:00:00.000Z',840,1440,['dst-gap']],
['LMT-seconds','1907-07-06','08:30','America/Mexico_City',true,'1907-07-06T15:06:36.000Z',-396.6,0,['lmt']],
['early-Gregorian','0099-06-15','12:00','Etc/UTC',false,'0099-06-15T12:00:00.000Z',0,0,[]],
];const results=[];
for(const[name,date,time,timeZone,timeKnown,expectedInstant,offset,gap,flags]of cases){const resolved=resolveLocalToUtc(date,time,timeZone);assert.equal(resolved.utc.toISOString(),expectedInstant);assert.equal(resolved.offsetMinutes,offset);assert.deepEqual(resolved.flags,flags);const[y,m,d]=date.split('-').map(Number),[h,min]=time.split(':').map(Number);const wall=new Date(0);wall.setUTCFullYear(y,m-1,d);wall.setUTCHours(h,min,0,0);const gapShiftMinutes=(resolved.utc.getTime()+resolved.offsetMinutes*60000-wall.getTime())/60000;assert.equal(gapShiftMinutes,gap);const context={reference:timeKnown?'supplied-instant':'local-noon',localResolution:{date,time,timeZone,offsetMinutes:resolved.offsetMinutes,gapShiftMinutes,policy:{fold:'earlier',gap:'shift-forward'}}};const computed=computePortableChart({utc:resolved.utc,latitude:40.7128,longitude:-74.006,houseSystem:'placidus',timeKnown,flags:resolved.flags},context);assert.deepEqual(computed.envelope.receipt.localResolution,context.localResolution);assert.equal(computed.envelope.receipt.sourceInstant,null);assert.equal(computed.envelope.receipt.reference,context.reference);if(!timeKnown){assert.equal(computed.envelope.receipt.houses.actual,null);assert.equal(computed.envelope.receipt.houses.absenceReason,'unknown-time');}results.push({name,date,time,timeZone,timeKnown,instant:resolved.utc.toISOString(),offsetMinutes:resolved.offsetMinutes,gapShiftMinutes,flags:resolved.flags,reference:computed.envelope.receipt.reference,sourceInstant:computed.envelope.receipt.sourceInstant,houseAbsence:computed.envelope.receipt.houses.absenceReason});}
const output={at:new Date().toISOString(),node:process.version,icu:process.versions.icu,tzdb:process.versions.tz,purpose:'Actual baseline resolver + delivered portable codec, reviewer context arithmetic control; not author patch acceptance or broad historical accuracy certification',passed:results.length,results};fs.writeFileSync(new URL('./time-context-result.json',import.meta.url),JSON.stringify(output,null,2)+'\n');console.log(JSON.stringify(output,null,2));
