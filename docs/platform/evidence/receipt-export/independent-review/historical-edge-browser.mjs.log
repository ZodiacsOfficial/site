import fs from 'node:fs';import path from 'node:path';import http from 'node:http';import {createRequire} from 'node:module';
const base=path.dirname(new URL(import.meta.url).pathname);const {chromium}=createRequire('/Users/chiburashka/.codex/worktrees/4806/site/package.json')('playwright-core');let browser;
const server=http.createServer((req,res)=>{res.setHeader('Content-Type',req.url==='/subject.js'?'text/javascript':'text/html');res.end(req.url==='/subject.js'?fs.readFileSync(path.join(base,'zone-edge-browser-subject.mjs')):'<!doctype html><title>Synthetic timezone compatibility</title>')});await new Promise(r=>server.listen(0,'127.0.0.1',r));
try{browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking']});const context=await browser.newContext();const page=await context.newPage();const errors=[];const requests=[];page.on('pageerror',e=>errors.push(String(e)));page.on('request',r=>requests.push(r.url()));const origin=`http://127.0.0.1:${server.address().port}`;await page.goto(origin);
const fixtures=JSON.parse(fs.readFileSync(path.join(base,'time-edge-search/result.json'),'utf8')).charts;
const results=await page.evaluate(async fixtures=>{const{resolveLocalToUtc,computePortableChart,computeChart,decodeChartLink}=await import('/subject.js');const rows=[];for(const fixture of fixtures){const{zone,date,time}=fixture;const row={zone,date,time};try{const token='1.'+btoa(JSON.stringify({d:date,t:time,z:zone,la:40,lo:0,h:'placidus'})).replace(/=/g,'').replace(/\+/g,'-').replace(/\//g,'_');row.detailsLinkAccepted=decodeChartLink(token)!==null;const resolved=resolveLocalToUtc(date,time,zone);row.instant=resolved.utc.toISOString();row.offsetMinutes=resolved.offsetMinutes;row.flags=resolved.flags;const input={utc:resolved.utc,latitude:40,longitude:0,houseSystem:'placidus',timeKnown:true,flags:resolved.flags};row.legacySuccess=computeChart(input).bodies.length===12;const wall=Date.parse(`${date}T${time}:00Z`);row.gapShiftMinutes=(resolved.utc.getTime()+resolved.offsetMinutes*60000-wall)/60000;const context={reference:'supplied-instant',localResolution:{date,time,timeZone:zone,offsetMinutes:resolved.offsetMinutes,gapShiftMinutes:row.gapShiftMinutes,policy:{fold:'earlier',gap:'shift-forward'}}};row.portableWithoutContextSuccess=computePortableChart(input).envelope.receipt.instant===row.instant;try{computePortableChart(input,context);row.portableContextSuccess=true}catch(error){row.portableContextSuccess=false;row.failureCode=error.code}}catch(error){row.resolutionError=error.name}rows.push(row)}return rows},fixtures);
const record={at:new Date().toISOString(),node:process.version,browser:await browser.version(),purpose:'Independent actual Chrome recheck of 16 Node-discovered historical context counterexamples; synthetic baseline helpers, not author patch acceptance',results,pageErrors:errors,externalRequests:requests.filter(r=>!r.startsWith(origin+'/')),contextClosed:true};await context.close();fs.writeFileSync(path.join(base,'historical-edge-browser-result.json'),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify(record,null,2));}
finally{await browser?.close();await new Promise(r=>server.close(r))}
