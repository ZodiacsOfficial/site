import fs from 'node:fs';import path from 'node:path';import http from 'node:http';import assert from 'node:assert/strict';import {createRequire} from 'node:module';import {createHash} from 'node:crypto';
const out=path.dirname(new URL(import.meta.url).pathname),review=path.dirname(out);
const freeze=JSON.parse(fs.readFileSync(path.join(review,'freeze-combined-identity.json'),'utf8'));
const build=JSON.parse(fs.readFileSync(path.join(review,'freeze-postbuild-build.json'),'utf8'));
const staticRoot=build.staticRoot;const source=freeze.sourceCheckout;
for(const[rel,sha]of Object.entries(freeze.files))assert.equal(createHash('sha256').update(fs.readFileSync(path.join(source,rel))).digest('hex'),sha,`Frozen source changed: ${rel}`);
const {chromium}=createRequire('/Users/chiburashka/.codex/worktrees/4806/site/package.json')('playwright-core');
const receipt=await import('/Users/chiburashka/.codex/worktrees/4806/site/node_modules/@zodiacs/engine/dist/receipt.js');
const mime={'.html':'text/html','.js':'text/javascript','.mjs':'text/javascript','.json':'application/json','.css':'text/css','.svg':'image/svg+xml','.png':'image/png','.jpg':'image/jpeg','.webp':'image/webp','.avif':'image/avif','.woff2':'font/woff2','.ico':'image/x-icon','.mp4':'video/mp4','.webm':'video/webm'};
const served=new Map();const server=http.createServer((req,res)=>{try{let pathname=decodeURIComponent(new URL(req.url,'http://localhost').pathname);let file=path.resolve(staticRoot,'.'+pathname);if(!file.startsWith(staticRoot+path.sep)&&file!==staticRoot){res.statusCode=403;res.end();return}if(fs.existsSync(file)&&fs.statSync(file).isDirectory())file=path.join(file,'index.html');if(!fs.existsSync(file)){res.statusCode=404;res.end('Not found');return}const data=fs.readFileSync(file);served.set(path.relative(staticRoot,file),createHash('sha256').update(data).digest('hex'));res.setHeader('Content-Type',mime[path.extname(file)]??'application/octet-stream');res.end(data);}catch{res.statusCode=500;res.end('Error')}});
await new Promise(r=>server.listen(0,'127.0.0.1',r));const base=`http://127.0.0.1:${server.address().port}`;
const fixture=JSON.parse(fs.readFileSync(path.join(review,'browser-plan.json'),'utf8')).fixtures;
const token=f=>'1.'+Buffer.from(JSON.stringify({d:f.date,z:f.zone,la:f.lat,lo:f.lon,n:'Synthetic Receipt',p:'Synthetic Place',...(f.time===null?{}:{t:f.time}),...(f.houses==='placidus'?{h:'placidus'}:{})})).toString('base64url');
const routeFor=locale=>locale==='en'?'/birth-chart/':`/${locale}/birth-chart/`;
const button='[data-download-calculation-receipt]';let browser;const results=[];
async function setup(options={}){const context=await browser.newContext({viewport:{width:options.width??1280,height:900},reducedMotion:'reduce',timezoneId:'UTC',acceptDownloads:true});const page=await context.newPage();const cdp=await context.newCDPSession(page);await cdp.send('Profiler.enable');await cdp.send('Profiler.startPreciseCoverage',{callCount:true,detailed:true});const errors=[],requests=[],downloads=[];page.on('pageerror',e=>errors.push(String(e)));page.on('request',r=>requests.push({url:r.url(),method:r.method(),body:r.postData()}));page.on('download',d=>downloads.push(d));await context.addInitScript(()=>{window.review={computed:[],urls:[],revoked:[],writes:[],idbOpens:[]};window.addEventListener('zodiacs:chart-computed',e=>window.review.computed.push(e.detail));const create=URL.createObjectURL.bind(URL),revoke=URL.revokeObjectURL.bind(URL);URL.createObjectURL=function(v){const url=create(v);window.review.urls.push({url,type:v.type,size:v.size});return url};URL.revokeObjectURL=function(url){window.review.revoked.push(url);return revoke(url)};const set=Storage.prototype.setItem;Storage.prototype.setItem=function(k,v){window.review.writes.push({key:k});return set.call(this,k,v)};const open=IDBFactory.prototype.open;IDBFactory.prototype.open=function(name,...args){window.review.idbOpens.push(name);return open.call(this,name,...args)}});return{context,page,cdp,errors,requests,downloads};}
async function load(fx,f=fixture[0],locale='en',route=routeFor(locale)){const response=await fx.page.goto(base+route+'#c='+token(f),{waitUntil:'domcontentloaded'});assert.equal(response.status(),200);await fx.page.locator('.calc__result').waitFor({timeout:45000});await fx.page.waitForFunction(()=>document.querySelector('.calc__form')?.getAttribute('aria-busy')==='false');assert.equal(await fx.page.locator('astro-error-overlay,.vite-error-overlay').count(),0);}
async function more(fx){await fx.page.locator('[data-chart-more]>summary').click();await fx.page.locator(button).waitFor({state:'visible'});}
async function download(fx,name){const pending=fx.page.waitForEvent('download');await fx.page.locator(button).click();const item=await pending;const file=path.join(out,name+'.json');await item.saveAs(file);assert.equal(item.suggestedFilename(),'zodiacs-calculation-receipt.json');const text=fs.readFileSync(file,'utf8');const parsed=receipt.parseNatalEnvelope(text);assert.equal(parsed.ok,true);assert.ok(!text.includes('Synthetic Receipt'));assert.ok(!text.includes('Synthetic Place'));return{file:path.basename(file),sha256:createHash('sha256').update(text).digest('hex'),envelope:parsed.envelope};}
async function finish(fx){const rawCoverage=await fx.cdp.send('Profiler.takePreciseCoverage');const engineCoverage=rawCoverage.result.filter(x=>/\/(?:calculator-receipt|chart-adapter)\./.test(x.url));fs.writeFileSync(path.join(out,'coverage-'+fx.caseName+'.json'),JSON.stringify(engineCoverage,null,2)+'\n');const count=(chunk,name)=>engineCoverage.filter(x=>x.url.includes('/'+chunk+'.')).flatMap(x=>x.functions).filter(x=>x.functionName===name).reduce((sum,x)=>sum+(x.ranges[0]?.count??0),0);const natalCalls=count('chart-adapter','Et'),publicNatalCalls=count('calculator-receipt','ce');const expectedNatal=fx.expectedNatal??(fx.caseName==='replacement-run'?2:fx.caseName==='positions-only-has-no-receipt'?0:1);assert.equal(natalCalls,expectedNatal,'Actual native natal call count');const expectedPublic=fx.expectedPublic??(fx.caseName.startsWith('preserve-')||fx.caseName==='positions-only-has-no-receipt'?0:expectedNatal);assert.equal(publicNatalCalls,expectedPublic,'Actual public natal call count');const observation=await fx.page.evaluate(()=>({computed:window.review.computed.length,writes:window.review.writes,idbOpens:window.review.idbOpens,urls:window.review.urls,revoked:window.review.revoked,viewport:innerWidth,scrollWidth:document.documentElement.scrollWidth,clientWidth:document.documentElement.clientWidth,overlay:!!document.querySelector('astro-error-overlay,.vite-error-overlay')}));assert.equal(fx.errors.length,0,fx.errors.join('\n'));assert.equal(observation.overlay,false);assert.ok(!observation.writes.some(x=>x.key==='zodiacs.profile.v1'||x.key.includes('saved-natal')));assert.ok(!observation.idbOpens.includes('zodiacs-saved-natal-v1'));assert.ok(!fx.requests.some(x=>(x.body??'').includes('Synthetic Receipt')||x.url.includes('Synthetic%20Receipt')));await fx.context.close();return{observation,natalCalls,publicNatalCalls,pageErrors:fx.errors,requests:fx.requests};}
async function check(name,run){let fx;try{fx=await setup();fx.caseName=name;const detail=await run(fx);const observation=await finish(fx);fx=null;results.push({name,status:'passed',detail,...observation});console.log(JSON.stringify({name,status:'passed'}));}catch(e){if(fx){try{await fx.page.screenshot({path:path.join(out,'failure-'+name+'.png'),fullPage:true})}catch{}await fx.context.close()}results.push({name,status:'failed',error:String(e),stack:e.stack});console.log(JSON.stringify(results.at(-1)));}}
try{browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking','--no-first-run']});
for(const f of fixture)await check('download-'+f.name,async fx=>{await load(fx,f);await more(fx);const item=await download(fx,'download-'+f.name);const r=item.envelope.receipt;assert.equal(r.instant,f.instant);assert.equal(r.localResolution.date,f.date);assert.equal(r.localResolution.time,f.time??'12:00');assert.equal(r.localResolution.timeZone,f.zone);assert.equal(r.localResolution.gapShiftMinutes,f.gap);assert.equal(r.houses.requested,f.houses);assert.equal(r.sourceInstant,null);assert.equal(r.reference,f.time===null?'local-noon':'supplied-instant');if(f.time===null){assert.equal(r.houses.actual,null);assert.equal(r.houses.absenceReason,'unknown-time')}if(f.name==='polar-requested-placidus'){assert.equal(r.houses.actual,'whole');assert.ok(r.resultFlags.includes('polar-fallback'))}assert.ok((await fx.page.locator('[data-chart-receipt]').textContent()).includes(r.instant.slice(0,10)));await fx.page.waitForFunction(()=>window.review.urls.filter(x=>x.type.startsWith('application/json')).every(x=>window.review.revoked.includes(x.url)));return{file:item.file,sha256:item.sha256,receipt:r}});
for(const [name,f]of [['fixed-offset',{...fixture[0],zone:'+01:00',instant:'1990-06-15T13:30:00.000Z'}],['subminute-gap',{...fixture[0],date:'1914-01-01',time:'00:00',zone:'America/Manaus',lat:-3.1,lon:-60.02,instant:'1914-01-01T04:00:04.000Z'}],['exact-pole',{...fixture[0],zone:'Etc/UTC',lat:90,instant:'1990-06-15T14:30:00.000Z'}]])await check('preserve-'+name,async fx=>{await load(fx,f);await more(fx);assert.equal(await fx.page.locator(button).isDisabled(),true);assert.ok((await fx.page.locator('#calculation-receipt-privacy').textContent()).includes('not available'));assert.equal(fx.downloads.length,0);return{receiptUnavailable:true,chartPresent:true}});
await check('stale-DOM-after-edit',async fx=>{await load(fx);await more(fx);assert.equal(await fx.page.locator(button).isEnabled(),true);await fx.page.evaluate(()=>{window.staleReceiptButton=document.querySelector('[data-download-calculation-receipt]');const input=document.querySelector('#birth-date');input.value='1991-06-15';input.dispatchEvent(new Event('input',{bubbles:true}));window.staleReceiptButton.dispatchEvent(new MouseEvent('click',{bubbles:true}));});await fx.page.waitForTimeout(150);assert.equal(fx.downloads.length,0);assert.equal(await fx.page.locator(button).isDisabled(),true);return{noStaleDownload:true}});
await check('replacement-run',async fx=>{await load(fx);await more(fx);const first=await download(fx,'replacement-first');await fx.page.locator('#birth-date').fill('1991-06-15');assert.equal(await fx.page.locator(button).isDisabled(),true);await fx.page.locator('.calc__submit').click();await fx.page.waitForFunction(()=>window.review.computed.length===2);await fx.page.locator(button).waitFor({state:'visible'});assert.equal(await fx.page.locator(button).isEnabled(),true);const second=await download(fx,'replacement-second');assert.equal(second.envelope.receipt.localResolution.date,'1991-06-15');assert.notEqual(first.sha256,second.sha256);return{first:first.sha256,second:second.sha256}});
await check('positions-only-has-no-receipt',async fx=>{const p='2.'+Buffer.from(JSON.stringify({b:Array.from({length:12},(_,i)=>i*27),h:'w',v:'0.1.1-rc.5'})).toString('base64url');await fx.page.goto(base+'/birth-chart/#p='+p,{waitUntil:'networkidle'});assert.equal(await fx.page.locator(button).count(),0);assert.equal(await fx.page.locator('[data-positions-only]').count(),1);assert.ok(!fx.requests.some(r=>r.url.includes('/calculator-receipt.')));assert.ok((await fx.page.locator('body').textContent()).length>100);return{noReceipt:true}});
for(const locale of ['en','es','pt','fr','it','ru'])await check('locale-'+locale,async fx=>{await fx.page.setViewportSize({width:390,height:900});await load(fx,fixture[0],locale);const summary=fx.page.locator('[data-chart-more]>summary');await summary.focus();await fx.page.keyboard.press('Space');await fx.page.locator(button).waitFor({state:'visible'});assert.equal(await fx.page.locator('#birth-date').inputValue(),fixture[0].date);assert.equal(await fx.page.locator('#birth-time').inputValue(),fixture[0].time);const label=(await fx.page.locator(button).textContent()).trim();const privacy=(await fx.page.locator('#calculation-receipt-privacy').textContent()).trim();assert.ok(label&&privacy);assert.equal(await fx.page.locator(button).getAttribute('aria-describedby'),'calculation-receipt-privacy');await fx.page.locator(button).focus();const pending=fx.page.waitForEvent('download');await fx.page.keyboard.press('Enter');await(await pending).saveAs(path.join(out,'locale-'+locale+'.json'));const dimensions=await fx.page.evaluate(()=>({width:innerWidth,scrollWidth:document.documentElement.scrollWidth}));assert.equal(dimensions.scrollWidth,dimensions.width);await fx.page.screenshot({path:path.join(out,'locale-'+locale+'.png'),fullPage:false});return{label,privacy,keyboardDownload:true,dimensions}});
const record={at:new Date().toISOString(),node:process.version,browser:await browser.version(),freeze,build,base,results,passed:results.filter(x=>x.status==='passed').length,failed:results.filter(x=>x.status==='failed').length,servedFiles:Object.fromEntries(served),harnessSha256:createHash('sha256').update(fs.readFileSync(new URL(import.meta.url))).digest('hex')};fs.writeFileSync(path.join(out,'result-'+Date.now()+'.json'),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify({passed:record.passed,failed:record.failed}));if(record.failed)process.exitCode=1;
}finally{await browser?.close();await new Promise(r=>server.close(r))}
