import fs from 'node:fs';import path from 'node:path';import http from 'node:http';import {createRequire} from 'node:module';
const base=path.dirname(new URL(import.meta.url).pathname);const {chromium}=createRequire('/Users/chiburashka/.codex/worktrees/4806/site/package.json')('playwright-core');let browser;
const server=http.createServer((req,res)=>{res.setHeader('Content-Type',req.url==='/subject.js'?'text/javascript':'text/html');res.end(req.url==='/subject.js'?fs.readFileSync(path.join(base,'zone-edge-browser-subject.mjs')):'<!doctype html><title>Synthetic timezone compatibility</title>')});await new Promise(r=>server.listen(0,'127.0.0.1',r));
try{browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking']});const context=await browser.newContext();const page=await context.newPage();const errors=[];const requests=[];page.on('pageerror',e=>errors.push(String(e)));page.on('request',r=>requests.push(r.url()));const origin=`http://127.0.0.1:${server.address().port}`;await page.goto(origin);
const results=await page.evaluate(async()=>{const{resolveLocalToUtc,computePortableChart,computeChart,decodeChartLink}=await import('/subject.js');const rows=[];for(const zone of ['+01:00','+0100','-02:30','+23:59','-00:00','UTC','US/Eastern']){const row={zone};try{const token='1.'+btoa(JSON.stringify({d:'1990-06-15',t:'14:30',z:zone,la:40.7128,lo:-74.006})).replace(/=/g,'').replace(/\+/g,'-').replace(/\//g,'_');row.detailsLinkAccepted=decodeChartLink(token)!==null;const resolved=resolveLocalToUtc('1990-06-15','14:30',zone);row.instant=resolved.utc.toISOString();row.offsetMinutes=resolved.offsetMinutes;const input={utc:resolved.utc,latitude:40.7128,longitude:-74.006,houseSystem:'whole',timeKnown:true,flags:resolved.flags};row.legacySuccess=computeChart(input).bodies.length===12;const context={reference:'supplied-instant',localResolution:{date:'1990-06-15',time:'14:30',timeZone:zone,offsetMinutes:resolved.offsetMinutes,gapShiftMinutes:(resolved.utc.getTime()+resolved.offsetMinutes*60000-Date.parse('1990-06-15T14:30:00Z'))/60000,policy:{fold:'earlier',gap:'shift-forward'}}};try{computePortableChart(input,context);row.portableContextSuccess=true}catch(error){row.portableContextSuccess=false;row.failureCode=error.code}}catch(error){row.resolutionError=error.name}rows.push(row)}return rows});
const record={at:new Date().toISOString(),node:process.version,browser:await browser.version(),purpose:'Baseline source and proposed truthful context compatibility control, not author patch acceptance',results,pageErrors:errors,externalRequests:requests.filter(r=>!r.startsWith(origin+'/')),contextClosed:true};await context.close();fs.writeFileSync(path.join(base,'zone-edge-browser-result.json'),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify(record,null,2));}
finally{await browser?.close();await new Promise(r=>server.close(r))}
