import fs from 'node:fs';import path from 'node:path';import http from 'node:http';import {createHash} from 'node:crypto';import {createRequire} from 'node:module';
const out=path.dirname(new URL(import.meta.url).pathname);const source='/private/tmp/zodiacs-platform-site-receipt-export/src/client-directives/interaction.ts';const text=fs.readFileSync(source,'utf8');fs.writeFileSync(path.join(out,'draft-option-order-source.ts'),text);const require=createRequire('/Users/chiburashka/.codex/worktrees/4806/site/package.json');const {build}=require('esbuild'),{chromium}=require('playwright-core');const bundle=(await build({stdin:{contents:text.replace('export default interactionDirective;','window.reviewDirective = interactionDirective;'),loader:'ts'},bundle:true,write:false,format:'iife',platform:'browser'})).outputFiles[0].contents;const hash=x=>createHash('sha256').update(x).digest('hex');const server=http.createServer((req,res)=>{res.setHeader('Content-Type',req.url==='/subject.js'?'text/javascript':'text/html');res.end(req.url==='/subject.js'?bundle:'<!doctype html><script src="/subject.js"></script>')});await new Promise(r=>server.listen(0,'127.0.0.1',r));let browser;const result={at:new Date().toISOString(),node:process.version,source,sourceSha256:hash(text),bundleSha256:hash(bundle),checks:[]};try{browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking']});result.browser=browser.version();const page=await browser.newPage();await page.goto('http://127.0.0.1:'+server.address().port);result.checks=await page.evaluate(async()=>{const checks=[];for(const replaced of [false,true]){const host=document.createElement('div');host.innerHTML='<select id="review-select"><option value="a">A</option><option value="b">B</option></select>';document.body.append(host);window.reviewDirective(async()=>()=>{if(replaced)host.innerHTML='<select id="review-select"><option value="b">B</option><option value="a">A</option></select>';else host.firstChild.insertBefore(host.firstChild.lastChild,host.firstChild.firstChild);host.firstChild.value='a';},{value:{eagerHash:false}},host);host.firstChild.value='b';host.firstChild.dispatchEvent(new Event('input',{bubbles:true}));host.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true}));await new Promise(r=>setTimeout(r,330));checks.push({replaced,expected:'b',actual:host.firstChild.value,options:Array.from(host.firstChild.options,x=>({value:x.value,selected:x.selected}))});host.remove()}return checks});}finally{await browser?.close();await new Promise(r=>server.close(r));result.cleanup={browserClosed:true,serverClosed:true};result.harnessSha256=hash(fs.readFileSync(new URL(import.meta.url)));fs.writeFileSync(path.join(out,'draft-option-order-result.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result,null,2));}
