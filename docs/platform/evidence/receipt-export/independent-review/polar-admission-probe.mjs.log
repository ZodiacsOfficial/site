import fs from 'node:fs';import {computeChart,computePortableChart,decodeChartLink,resolveLocalToUtc} from './zone-edge-subject.mjs';
const results=[];for(const latitude of [90,-90,89.99,-89.99])for(const timeKnown of [true,false]){const date='2001-12-21',time=timeKnown?'08:30':'12:00',zone='Etc/UTC';const wire={d:date,z:zone,la:latitude,lo:0,h:'placidus',...(timeKnown?{t:time}:{})};const token='1.'+Buffer.from(JSON.stringify(wire)).toString('base64url');const resolved=resolveLocalToUtc(date,time,zone);const input={utc:resolved.utc,latitude,longitude:0,houseSystem:'placidus',timeKnown,flags:resolved.flags};const row={latitude,timeKnown,linkAccepted:!!decodeChartLink(token)};try{const chart=computeChart(input);row.legacySuccess=true;row.legacyHouses=chart.houses?.system??null;row.legacyAngles=chart.angles}catch(e){row.legacyFailure=e.name}try{computePortableChart(input);row.portableNoContextSuccess=true}catch(e){row.portableNoContextSuccess=false;row.failureCode=e.code}results.push(row)}const record={at:new Date().toISOString(),node:process.version,purpose:'Bounded chart admission difference under existing documented SDK receipt angle exclusions; not a new civil-context failure or a proposed relaxation of numerical policy',results};fs.writeFileSync(new URL('./polar-admission-result.json',import.meta.url),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify(record,null,2));
