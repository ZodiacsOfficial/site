import fs from'node:fs';import path from'node:path';import{createHash}from'node:crypto';import{execFileSync}from'node:child_process';import assert from'node:assert/strict';
const input='/private/tmp/zodiacs-platform-moon-preview-review/delivery',out=import.meta.dirname,repo='/Users/chiburashka/.codex/worktrees/4806/site',hash=b=>createHash('sha256').update(b).digest('hex'),read=n=>JSON.parse(fs.readFileSync(path.join(input,n),'utf8'));
const expected='fc873f343183390e8328ad8a8ab0e4779861643745b6c2917253d79f33ac4d0c';
assert.equal(hash(fs.readFileSync(input+'/manifest.json')),expected);
const manifest=read('manifest.json');
for(const r of manifest){const b=fs.readFileSync(input+'/'+r.path);assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
const snapshot=read('source-snapshot.json.log'),pr=JSON.parse(fs.readFileSync(out+'/pr430.json','utf8')),pages=JSON.parse(fs.readFileSync(out+'/pr430-files-pages.json','utf8')),files=pages.flat();
assert.equal(pr.headRefOid,snapshot.commit);assert.equal(pr.baseRefOid,'65418003c07efc0c435ce1010e3c9ec05b478eb4');assert.equal(pr.isDraft,true);
const identity=[];
for(const f of snapshot.files){const bytes=execFileSync('git',['show',snapshot.commit+':'+f.path],{cwd:repo});assert.equal(hash(bytes),f.sha256);assert.equal(hash(fs.readFileSync(input+'/source/'+f.path+'.log')),f.sha256);identity.push({path:f.path,sha256:f.sha256,bytes:bytes.length});}
const sourceFiles=files.filter(f=>!f.filename.startsWith('docs/'));
for(const f of sourceFiles){const object=execFileSync('git',['rev-parse',snapshot.commit+':'+f.filename],{cwd:repo,encoding:'utf8'}).trim();assert.equal(object,f.sha);}
const localNames=fs.readFileSync(out+'/local-changed-names.txt','utf8').trim().split('\n').sort();assert.deepEqual(files.map(f=>f.filename).sort(),localNames);
const authorFreeze=JSON.parse(fs.readFileSync('/private/tmp/zodiacs-platform-moon-result-ownership-evidence/source-freeze1-identity.json','utf8'));
const native=read('browser/result.json.log'),reference=read('local-result-reference.json.log');assert.equal(native.outcome,'passed');assert.equal(native.sourceCommit,snapshot.commit);assert.equal(native.sourceSha,identity[0].sha256);assert.equal(native.checks.length,12);
const pairs=new Set();for(const row of native.checks){pairs.add(row.locale+'/'+row.width);assert.equal(row.editAndRecovery,true);assert.equal(row.noSavedProfile,true);assert.equal(row.noSavedProfileAfterRecovery,true);assert.equal(row.exactLocalResultText,true);const local=reference.checks.find(r=>r.locale===row.locale&&r.width===row.width);assert.equal(row.resultText,local.resultText);assert.equal(hash(fs.readFileSync(input+`/browser/${row.locale}-${row.width}.png`)),row.screenshotSha256);}
assert.deepEqual([...pairs].sort(),['en','es','fr','it','pt','ru'].flatMap(l=>[l+'/1280',l+'/390']).sort());assert.deepEqual(native.pageErrors,[]);assert.ok(native.requests.every(r=>r.method==='GET'));assert.ok(native.responses.every(r=>r.status===200&&typeof r.sha256==='string'&&!r.bodyUnavailable));assert.equal(native.externalRequests.length,12);assert.ok(native.externalRequests.every(r=>r.url==='https://plausible.io/js/pa-HwF2IBb5Sw8eboNPSOgHv.js'));
const moonResponses=native.responses.filter(r=>r.path.includes('/MoonPhaseTool.'));assert.equal(moonResponses.length,12);assert.equal(new Set(moonResponses.map(r=>r.sha256)).size,1);
for(const n of ['deployment-ready.json.log','deployment-after.json.log']){const d=read(n);assert.equal(d.commit,snapshot.commit);assert.equal(d.state,'READY');assert.equal(d.source,'git');assert.equal(d.target,null);assert.equal('https://'+d.url,native.base);}
assert.equal(read('deployment-initial.json.log').state,'BUILDING');
const immutableHelper=hash(fs.readFileSync(repo+'/tests/visual/browser.mjs'));assert.equal(immutableHelper,snapshot.files.find(r=>r.path==='tests/visual/browser.mjs').sha256);
const cleanup=read('cleanup.json.log');assert.equal(cleanup.temporaryAccessDirectoryRemoved,true);assert.equal(fs.existsSync('/private/tmp/zodiacs-platform-moon-preview-auth'),false);assert.equal(cleanup.exactPrivateUrlAndQueryValueMatchesInEvidenceBeforeRemoval,0);
const summary={at:new Date().toISOString(),node:process.version,verdict:'evidence-consistent; no new browser run claimed',deliveryManifestSha256:expected,records:manifest.length,bytes:manifest.reduce((s,r)=>s+r.bytes,0),pr:{number:pr.number,head:pr.headRefOid,base:pr.baseRefOid,state:pr.state,isDraft:pr.isDraft,mergeStateStatus:pr.mergeStateStatus,files:files.length,pages:pages.length,nonDocumentationFiles:sourceFiles.map(f=>f.filename)},sourceIdentity:identity,preview:native.base,checks:12,pairs:[...pairs].sort(),requests:native.requests.length,responses:native.responses.length,blockedExternalAttempts:native.externalRequests.length,moonModule:{path:moonResponses[0].path,bytes:moonResponses[0].bytes,sha256:moonResponses[0].sha256,observations:moonResponses.length},qualifications:['This is an independent audit of executed browser evidence, not another browser execution.','READY preview metadata and exact source are linked before and after the recorded run; no production deployment claimed.','Numerical result comparison uses the existing local result text, not an independent astronomical oracle.','Native delayed-loader and profile authority evidence remain separate.','Original driver uses a root browser helper; its current hash equals the archived immutable snapshot.','Full GitHub PR patch endpoint rejected its >300-file diff; all four paginated file pages and local commit objects were compared instead.','Temporary secret scan is an author execution record; the removed directory absence was independently checked without retrieving credentials.']};
fs.writeFileSync(out+'/RESULTS.json',JSON.stringify(summary,null,2)+'\n');
fs.writeFileSync(out+'/REVIEW.md',`Moon preview delivery is internally consistent with its exact source and current PR 430 head. All ${manifest.length} manifest records (${summary.bytes} bytes) match supplied SHA-256 ${expected}.\n\nThe recorded 12 actual-page cases cover six locales at 1280 and 390 pixels. Each records successful result/focus, date/time edit clearing and recovery, no saved profile, matching local result text and matching screenshot bytes. All 624 observed same-origin responses are 200 with hashes; all 646 observed requests are GET. Twelve attempts to load the configured Plausible script are explicitly blocked. The same Moon module SHA-256 ${moonResponses[0].sha256} appears in all 12 cases.\n\nThe before/after READY preview metadata refers to commit ${snapshot.commit}, matching the source snapshot and current open draft PR 430. The exact Moon component SHA-256 ${identity[0].sha256} is the independently reviewed two-file implementation. GitHub lists ${files.length} changed files in four pages, including evidence, the Moon component/driver, four workflow lines and screenshot provenance. All remote file names and non-document blob IDs match local immutable commit objects. The ordinary PR diff endpoint failed because it exceeds 300 files; this is preserved and does not invalidate the complete paginated comparison.\n\nThis is evidence validation, not another browser run or a new numerical oracle. Delayed-loader races, profile authority and production deployment are not inferred from these preview checks. The original result-comparison and scope qualifications are accurate. The runtime helper imported from the root checkout currently matches its pinned archived helper hash. The temporary access directory is absent; no credentials were requested or read. No root or product files were changed.\n`);
const records=[];for(const name of fs.readdirSync(out).sort()){if(name==='manifest.json')continue;const p=path.join(out,name);if(!fs.statSync(p).isFile())continue;const b=fs.readFileSync(p);records.push({path:name,bytes:b.length,sha256:hash(b)});}fs.writeFileSync(out+'/manifest.json',JSON.stringify({records},null,2)+'\n');console.log(JSON.stringify({summary,manifestSha256:hash(fs.readFileSync(out+'/manifest.json'))}));
