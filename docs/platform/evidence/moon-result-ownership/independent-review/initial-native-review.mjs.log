import fs from'node:fs';import assert from'node:assert/strict';import{chromium}from'playwright-core';
const browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--no-sandbox']});
const report={browser:browser.version(),node:process.version,requests:[],results:[],outcome:'failed'};
const settle=p=>p.evaluate(()=>new Promise(done=>requestAnimationFrame(()=>requestAnimationFrame(()=>setTimeout(done,0)))));
async function fill(p,time='12:00'){await p.locator('#mp-date').fill('1990-01-04');if(time)await p.locator('#mp-time').fill(time);}
const submit=p=>p.locator('form').evaluate(form=>form.dispatchEvent(new Event('submit',{bubbles:true,cancelable:true})));
const hold=p=>p.evaluate(()=>fixture.hold()),release=(p,id)=>p.evaluate(id=>fixture.release(id),id),reject=(p,id)=>p.evaluate(id=>fixture.reject(id),id);
async function noResult(p){await settle(p);assert.equal(await p.locator('.calc__result').count(),0);}
async function success(p){await submit(p);await p.locator('.calc__result').waitFor();await settle(p);}
async function choose(p,query='Bang'){await p.locator('#mp-place').fill(query);await p.getByRole('option').click();await settle(p);}
const groups=[
 ['production','Rejected focus prefetch is observed and a later real module retry succeeds',async p=>{
  const id=await hold(p);await fill(p);assert.equal(await p.evaluate(()=>fixture.importAttempts),1);await reject(p,id);await settle(p);assert.deepEqual(await p.evaluate(()=>fixture.errors),[]);assert.equal(await p.locator('[role=alert]').count(),0);
  await p.evaluate(()=>fixture.immediate());await success(p);assert.equal(await p.evaluate(()=>fixture.importAttempts),2);assert.equal(await p.locator('h2').evaluate(el=>el===document.activeElement),true);return{importAttempts:2,unhandledRejections:0,calls:await p.evaluate(()=>fixture.calls)};
 }],
 ['production','Shared pending import fences a replaced partial place query and keeps current UTC semantics',async p=>{
  const id=await hold(p);await fill(p);await submit(p);await p.locator('#mp-place').fill('Bang');await p.locator('#mp-place').fill('Tor');await settle(p);assert.equal(await p.locator('form').getAttribute('aria-busy'),'false');await submit(p);await release(p,id);await p.locator('.calc__result').waitFor();await settle(p);
  const calls=await p.evaluate(()=>fixture.calls);assert.equal(calls.length,2);assert.ok(calls.every(x=>x.utc==='1990-01-04T12:00:00.000Z'));assert.equal(await p.evaluate(()=>fixture.importAttempts),1);assert.equal(await p.locator('#mp-place').inputValue(),'Tor');assert.equal(await p.locator('.place__clear').count(),0);return{calls,selectedCity:false,unselectedQuery:'Tor',importAttempts:1};
 }],
 ['production','City selection while import is pending replaces the current clock meaning',async p=>{
  const id=await hold(p);await fill(p);await submit(p);await choose(p);await submit(p);await release(p,id);await p.locator('.calc__result').waitFor();await settle(p);const calls=await p.evaluate(()=>fixture.calls);assert.equal(calls.length,2);assert.ok(calls.every(x=>x.utc==='1990-01-04T05:00:00.000Z'));return{calls};
 }],
 ['production','Removing a selected city while pending fences local time and permits current UTC result',async p=>{
  const id=await hold(p);await fill(p);await choose(p);await submit(p);await p.locator('.place__clear').click();await settle(p);await submit(p);await release(p,id);await p.locator('.calc__result').waitFor();await settle(p);const calls=await p.evaluate(()=>fixture.calls);assert.equal(calls.length,2);assert.ok(calls.every(x=>x.utc==='1990-01-04T12:00:00.000Z'));return{calls};
 }],
 ['production','Clearing the date while pending prevents astronomy and late focus',async p=>{
  const id=await hold(p);await fill(p);await submit(p);await p.locator('#mp-date').fill('');await release(p,id);await noResult(p);assert.equal(await p.evaluate(()=>fixture.calls.length),0);assert.equal(await p.locator('form').getAttribute('aria-busy'),'false');assert.equal(await p.locator('button[type=submit]').isDisabled(),true);assert.equal(await p.evaluate(()=>document.activeElement.id),'mp-date');return{calls:0,active:'mp-date'};
 }],
 ['production','Clearing a known time while pending uses exactly one current unknown-noon calculation',async p=>{
  const id=await hold(p);await fill(p,'15:30');await submit(p);await p.locator('#mp-time').fill('');await submit(p);await release(p,id);await p.locator('.calc__result').waitFor();await settle(p);const calls=await p.evaluate(()=>fixture.calls);assert.deepEqual(calls.map(x=>x.utc),['1990-01-04T12:00:00.000Z','1990-01-04T12:00:00.000Z','1990-01-04T00:00:00.000Z','1990-01-04T23:59:00.000Z']);return{calls};
 }],
 ['raw','Old rejection cannot clear the busy flag or error state of a newer pending request',async p=>{
  await fill(p);const old=await hold(p);await submit(p);await p.locator('#mp-time').fill('13:00');const current=await hold(p);await submit(p);await reject(p,old);await noResult(p);assert.equal(await p.locator('form').getAttribute('aria-busy'),'true');assert.equal(await p.locator('[role=alert]').count(),0);await release(p,current);await p.locator('.calc__result').waitFor();await settle(p);assert.equal(await p.evaluate(()=>fixture.calls.length),2);return{calls:await p.evaluate(()=>fixture.calls)};
 }],
 ['raw','Old success after a newer result does not overwrite the result or steal edit focus',async p=>{
  await fill(p);const old=await hold(p);await submit(p);await p.locator('#mp-time').fill('13:00');const current=await hold(p);await submit(p);await release(p,current);await p.locator('.calc__result').waitFor();await settle(p);const text=await p.locator('.calc__result').innerText();await p.locator('#mp-time').focus();await release(p,old);await settle(p);assert.equal(await p.locator('.calc__result').innerText(),text);assert.equal(await p.evaluate(()=>fixture.calls.length),2);assert.equal(await p.evaluate(()=>document.activeElement.id),'mp-time');return{calls:await p.evaluate(()=>fixture.calls),active:'mp-time'};
 }],
 ['production','Current calculation failure removes the prior result and recovers unchanged numerics',async p=>{
  await fill(p);await success(p);const text=await p.locator('.calc__result').innerText();await p.evaluate(()=>fixture.fail(true));await submit(p);await p.locator('[role=alert]').waitFor();await noResult(p);assert.equal(await p.evaluate(()=>document.activeElement.getAttribute('role')),'alert');await p.evaluate(()=>fixture.fail(false));await success(p);assert.equal(await p.locator('.calc__result').innerText(),text);assert.equal(await p.locator('[role=alert]').count(),0);return{text,recovered:true};
 }],
 ['production','Real current ModuleLoadError is cleared by edit and retry',async p=>{
  const id=await hold(p);await fill(p);await submit(p);await reject(p,id);await p.locator('[role=alert]').waitFor();await settle(p);assert.equal(await p.evaluate(()=>document.activeElement.getAttribute('role')),'alert');const text=await p.locator('[role=alert]').innerText();await p.locator('#mp-time').fill('13:00');await settle(p);assert.equal(await p.locator('[role=alert]').count(),0);await p.evaluate(()=>fixture.immediate());await success(p);assert.equal(await p.evaluate(()=>fixture.importAttempts),2);assert.ok((await p.evaluate(()=>fixture.calls)).every(x=>x.utc==='1990-01-04T13:00:00.000Z'));return{loadErrorText:text,importAttempts:2};
 }],
 ['production','An unmounted old request sharing import with a new mount cannot calculate',async p=>{
  const id=await hold(p);await fill(p);await submit(p);await p.evaluate(()=>{fixture.unmount();fixture.mount();});await settle(p);await fill(p,'13:00');await submit(p);await release(p,id);await p.locator('.calc__result').waitFor();await settle(p);const calls=await p.evaluate(()=>fixture.calls);assert.equal(calls.length,2);assert.ok(calls.every(x=>x.utc==='1990-01-04T13:00:00.000Z'));return{calls};
 }],
 ['production','Rapid mount/input/submit/unmount before a paint still fences the pending request',async p=>{
  const result=await p.evaluate(async()=>{
   fixture.unmount();fixture.calls.splice(0);fixture.mount();const id=fixture.hold();
   const date=document.querySelector('#mp-date');date.value='1990-01-04';date.dispatchEvent(new Event('input',{bubbles:true}));
   const time=document.querySelector('#mp-time');time.value='12:00';time.dispatchEvent(new Event('input',{bubbles:true}));
   await Promise.resolve();await Promise.resolve();
   document.querySelector('form').dispatchEvent(new Event('submit',{bubbles:true,cancelable:true}));
   fixture.unmount();fixture.release(id);await Promise.resolve();await Promise.resolve();await Promise.resolve();
   return{calls:[...fixture.calls],html:document.getElementById('mount').innerHTML,attempts:fixture.importAttempts};
  });await settle(p);assert.deepEqual(await p.evaluate(()=>fixture.calls),[]);assert.equal(await p.locator('#mount').innerHTML(),'');assert.equal(result.attempts,1);return result;
 }],
 ['production','Editing a displayed result including partial place input clears it immediately',async p=>{
  await fill(p);await success(p);await p.locator('#mp-place').fill('B');await noResult(p);assert.equal(await p.locator('form').getAttribute('aria-busy'),'false');assert.equal(await p.locator('#mp-place').inputValue(),'B');return{partialQuery:'B',oldResultCleared:true};
 }],
];
try{
 for(const kind of ['baseline','candidate'])for(const[loader,name,test]of groups){
  const context=await browser.newContext();context.setDefaultTimeout(1500);const errors=[];await context.route('**/*',async route=>{report.requests.push(route.request().url());await route.abort();});const p=await context.newPage();p.on('pageerror',error=>errors.push(String(error)));
  try{await p.goto('about:blank?loader='+loader);await p.addStyleTag({content:fs.readFileSync(kind+'.css','utf8')});await p.addScriptTag({content:fs.readFileSync(kind+'.js','utf8')});await settle(p);const evidence=await test(p);assert.deepEqual(await p.evaluate(()=>fixture.errors),[]);assert.deepEqual(errors,[]);report.results.push({kind,loader,name,passed:true,evidence});}
  catch(error){report.results.push({kind,loader,name,passed:false,error:String(error.stack??error),pageErrors:errors,dom:await p.locator('#mount').innerText()});}
  finally{await context.close();}
 }
 assert.deepEqual(report.requests,[]);assert.ok(report.results.filter(x=>x.kind==='candidate').every(x=>x.passed));report.outcome='passed';
}catch(error){report.error=String(error.stack??error);process.exitCode=1;}finally{await browser.close();fs.writeFileSync('native-result.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({outcome:report.outcome,browser:report.browser,baselinePassed:report.results.filter(x=>x.kind==='baseline'&&x.passed).length,baselineFailed:report.results.filter(x=>x.kind==='baseline'&&!x.passed).length,candidatePassed:report.results.filter(x=>x.kind==='candidate'&&x.passed).length,candidateFailed:report.results.filter(x=>x.kind==='candidate'&&!x.passed).map(x=>({name:x.name,error:x.error})),error:report.error}));}
