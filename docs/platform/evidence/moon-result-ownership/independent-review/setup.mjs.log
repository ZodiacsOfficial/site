import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const author='/private/tmp/zodiacs-platform-moon-result-ownership',evidence=author+'-evidence',sha=b=>createHash('sha256').update(b).digest('hex');
const identity=JSON.parse(fs.readFileSync(evidence+'/source-freeze1-identity.json')),report=JSON.parse(fs.readFileSync(evidence+'/native-final/result.json')),oldReport=JSON.parse(fs.readFileSync(evidence+'/native-baseline-final/result.json'));
assert.equal(sha(fs.readFileSync(evidence+'/source-freeze1.patch')),identity.patchSha256);
for(const name of ['source-freeze1-identity.json','source-freeze1.patch'])fs.copyFileSync(evidence+'/'+name,name);
const records=[];for(const input of report.inputs.filter(x=>x.path.startsWith('src/'))){const bytes=fs.readFileSync(author+'/'+input.path);assert.equal(sha(bytes),input.sha256);fs.mkdirSync(path.dirname('source/'+input.path),{recursive:true});fs.writeFileSync('source/'+input.path,bytes);records.push(input);}
for(const file of identity.files){assert.equal(sha(fs.readFileSync(author+'/'+file.path)),file.sha256);if(file.path.startsWith('tests/'))fs.copyFileSync(author+'/'+file.path,'author-driver.mjs.log');}
const old=fs.readFileSync(evidence+'/MoonPhaseTool-before.tsx');assert.equal(sha(old),oldReport.inputs.find(x=>x.path==='src/islands/MoonPhaseTool.tsx').sha256);fs.writeFileSync('baseline-MoonPhaseTool.tsx',old);
const root='/Users/chiburashka/.codex/worktrees/4806/site/node_modules',reused='/private/tmp/zodiacs-platform-local-date-intervals-independent-review/node_modules';
const deps={preact:root+'/preact','@zodiacs/engine':root+'/@zodiacs/engine','astronomy-engine':root+'/astronomy-engine',esbuild:reused+'/esbuild','@esbuild/darwin-arm64':reused+'/@esbuild/darwin-arm64','playwright-core':reused+'/playwright-core',typescript:reused+'/typescript'};
for(const[name,from]of Object.entries(deps))fs.cpSync(from,'node_modules/'+name,{recursive:true,dereference:true});
for(const row of report.inputs.filter(x=>!x.path.startsWith('src/'))){const index=row.path.indexOf('node_modules/');assert.ok(index>=0);const file=row.path.slice(index);assert.equal(sha(fs.readFileSync(file)),row.sha256);}
fs.writeFileSync('package.json','{"type":"module","private":true}\n');fs.writeFileSync('setup-identity.json',JSON.stringify({author,base:identity.base,patchSha256:identity.patchSha256,source:records,baselineSha256:sha(old),dependencies:deps,allBundledAuthorInputsMatched:true,method:'All source and selected dependency package trees physically copied; no author/root mutation, symlinked build source, downloads or lifecycle scripts.'},null,2)+'\n');console.log(JSON.stringify({sourceFiles:records.length,allAuthorInputsMatched:true,baselineSha256:sha(old)}));
