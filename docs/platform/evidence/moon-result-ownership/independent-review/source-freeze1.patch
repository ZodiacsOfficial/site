diff --git a/tests/moon-result-ownership-drive.mjs b/tests/moon-result-ownership-drive.mjs
new file mode 100644
--- /dev/null
+++ b/tests/moon-result-ownership-drive.mjs
@@ -0,0 +1,207 @@
+/** Render the real island and PlaceSearch in an owned static fixture.
+ * Only the async engine loader and synthetic place-search data are controlled.
+ * Longitude calls execute the unchanged actual full engine.
+ */
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { createServer } from 'node:http';
+import { join, resolve } from 'node:path';
+import { build } from 'esbuild';
+import { chromium } from 'playwright-core';
+import { findChromium, STABLE_CHROMIUM_ARGS } from './visual/browser.mjs';
+
+const root = resolve(import.meta.dirname, '..');
+const out = resolve(process.env.OUT_DIR ?? join(root, 'tests/visual/artifacts/moon-result-ownership'));
+const hash = (bytes) => createHash('sha256').update(bytes).digest('hex');
+await mkdir(out, { recursive: true });
+const entry = `
+import { h, render } from 'preact';
+import MoonPhaseTool from './src/islands/MoonPhaseTool';
+import * as actual from './src/lib/engine/full';
+import en from './src/lib/i18n/ui/en';
+import es from './src/lib/i18n/ui/es';
+import fr from './src/lib/i18n/ui/fr';
+import it from './src/lib/i18n/ui/it';
+import pt from './src/lib/i18n/ui/pt';
+import ru from './src/lib/i18n/ui/ru';
+import { RUSSIAN_RUNTIME } from './src/lib/i18n/ru-runtime/server';
+const catalogs={en,es,fr,it,pt,ru};
+const pending=[];
+const calls=[];
+let current=null;
+let failCalculation=false;
+const engine={...actual,bodyLongitude(body,utc){
+ calls.push({body,utc:new Date(utc).toISOString()});
+ if(failCalculation)throw new Error('Synthetic calculation failure');
+ return actual.bodyLongitude(body,utc);
+}};
+window.fixtureLoadEngine=()=>current?current.promise:Promise.resolve(engine);
+window.fixture={
+ calls,pending,
+ hold(){let yes,no;const promise=new Promise((resolve,reject)=>{yes=resolve;no=reject});current={promise,yes,no};pending.push(current);return pending.length-1;},
+ release(id){pending[id].yes(engine);},reject(id){pending[id].no(new Error('Synthetic loader failure'));},
+ immediate(){current=null;},failCalculation(value){failCalculation=value;},
+ mount(locale='en'){window.__ZDX_UI__={locale,messages:catalogs[locale]};window.__ZDX_RU__={locale:'ru',data:RUSSIAN_RUNTIME};render(h(MoonPhaseTool,{locale}),document.getElementById('mount'));},
+ unmount(){render(null,document.getElementById('mount'));},
+};
+window.fixture.mount(new URL(location.href).searchParams.get('locale')??'en');
+`;
+const compilation = await build({
+  absWorkingDir: root, stdin: { contents: entry, resolveDir: root },
+  bundle: true, write: false, outfile: join(out, 'fixture.js'), platform: 'browser', format: 'iife', target: 'es2022',
+  jsx: 'automatic', jsxImportSource: 'preact', define: { 'import.meta.env': '{}' }, metafile: true,
+  plugins: [{ name: 'controlled-owned-boundaries', setup(builder) {
+    if (process.env.MOON_SOURCE) builder.onLoad({ filter: /\/MoonPhaseTool\.tsx$/ }, async ({ path }) => ({ contents: await readFile(resolve(process.env.MOON_SOURCE), 'utf8'), loader: 'tsx', resolveDir: resolve(path, '..') }));
+    builder.onResolve({ filter: /lib\/hooks\/useEngine$/ }, () => ({ path: 'loader', namespace: 'owned' }));
+    builder.onResolve({ filter: /lib\/geo\/search$/ }, () => ({ path: 'places', namespace: 'owned' }));
+    builder.onLoad({ filter: /.*/, namespace: 'owned' }, ({ path }) => ({ contents: path === 'loader'
+      ? 'export function useEngine(){return ()=>window.fixtureLoadEngine();}'
+      : `const city={name:'Synthetic Bangkok',admin1:'',country:'TH',lat:13.75,lon:100.5,tz:'Asia/Bangkok',pop:0};export const preloadIndex=async()=>{};export const searchCities=async(q)=>q.toLowerCase().includes('bang')?[city]:[];` }));
+  } }],
+});
+const script = compilation.outputFiles.find((file) => file.path.endsWith('.js')).contents;
+const css = compilation.outputFiles.find((file) => file.path.endsWith('.css'))?.contents ?? new Uint8Array();
+await writeFile(join(out, 'fixture.js'), script);
+await writeFile(join(out, 'fixture.css'), css);
+const inputs = await Promise.all(Object.keys(compilation.metafile.inputs).filter((path) => !path.startsWith('<') && !path.startsWith('owned:')).map(async (path) => {
+  const override = path === 'src/islands/MoonPhaseTool.tsx' ? process.env.MOON_SOURCE : undefined;
+  const bytes = await readFile(override ? resolve(override) : join(root, path));
+  return { path, ...(override ? { sourceOverride: resolve(override) } : {}), bytes: bytes.length, sha256: hash(bytes) };
+}));
+const report = { at: new Date().toISOString(), node: process.version, inputs, bundleSha256: hash(script), controlledBoundaries: ['useEngine loader promise settlement', 'synthetic GeoNames search response'], groups: [], pageErrors: [], requests: [], outcome: 'failed' };
+const server = createServer((req, res) => {
+  if (req.url === '/fixture.js') { res.setHeader('Content-Type', 'application/javascript'); res.end(script); }
+  else if (req.url === '/fixture.css') { res.setHeader('Content-Type', 'text/css'); res.end(css); }
+  else { res.setHeader('Content-Type', 'text/html'); res.end('<!doctype html><title>Moon result ownership fixture</title><link rel="stylesheet" href="/fixture.css"><div id="mount"></div><script src="/fixture.js"></script>'); }
+});
+let browser;
+let context;
+let origin;
+const settle = (page) => page.evaluate(() => new Promise((done) => requestAnimationFrame(() => requestAnimationFrame(() => setTimeout(done, 0)))));
+const fill = async (page, time = '12:00') => { await page.locator('#mp-date').fill('1990-01-04'); if (time) await page.locator('#mp-time').fill(time); };
+const submit = (page) => page.locator('button[type=submit]').click();
+const success = async (page) => { await submit(page); await page.locator('.calc__result').waitFor(); await settle(page); };
+const chooseCity = async (page) => { await page.locator('#mp-place').fill('Bang'); await page.getByRole('option').click(); };
+const fresh = async (locale = 'en') => { const page = await context.newPage(); page.on('pageerror', (error) => report.pageErrors.push(String(error))); await page.goto(`${origin}/?locale=${locale}`); await page.locator('#mp-date').waitFor(); await settle(page); return page; };
+const noResult = async (page) => { await settle(page); assert.equal(await page.locator('.calc__result').count(), 0); };
+const idle = async (page) => assert.equal(await page.locator('form').getAttribute('aria-busy'), 'false');
+async function group(name, fn) {
+  const page = await fresh();
+  try { const evidence = await fn(page); report.groups.push({ name, passed: true, evidence }); }
+  catch (error) { report.groups.push({ name, passed: false, error: String(error.stack ?? error), dom: await page.locator('#mount').innerText() }); }
+  finally { await page.close(); }
+}
+try {
+  await new Promise((done, reject) => { server.once('error', reject); server.listen(0, '127.0.0.1', done); });
+  origin = `http://127.0.0.1:${server.address().port}`;
+  const executablePath = await findChromium();
+  browser = await chromium.launch({ executablePath, headless: true, args: STABLE_CHROMIUM_ARGS });
+  context = await browser.newContext();
+  context.setDefaultTimeout(4000);
+  await context.route('**/*', async (route) => {
+    const url = route.request().url(); report.requests.push(url);
+    if (new URL(url).origin === origin) await route.continue(); else await route.abort('blockedbyclient');
+  });
+  report.browser = { executablePath, version: browser.version() };
+  await group('Successful known-time UTC result retains calculations and heading focus', async (page) => {
+    await fill(page); await success(page); await idle(page);
+    assert.equal(await page.evaluate(() => document.activeElement?.tagName), 'H2');
+    const calls = await page.evaluate(() => window.fixture.calls);
+    assert.deepEqual(calls.map(({ body }) => body), ['Moon', 'Sun']);
+    assert.ok(calls.every(({ utc }) => utc === '1990-01-04T12:00:00.000Z'));
+    return { calls, text: await page.locator('.calc__result').innerText() };
+  });
+  for (const field of ['date', 'time', 'city-selection', 'city-removal']) await group(`A ${field} edit clears a displayed result`, async (page) => {
+    await fill(page); if (field === 'city-removal') await chooseCity(page); await success(page);
+    if (field === 'date') await page.locator('#mp-date').fill('1990-01-05');
+    if (field === 'time') await page.locator('#mp-time').fill('13:00');
+    if (field === 'city-selection') await chooseCity(page);
+    if (field === 'city-removal') await page.locator('.place__clear').click();
+    await noResult(page); await idle(page);
+    return { activeId: await page.evaluate(() => document.activeElement?.id), calls: await page.evaluate(() => window.fixture.calls) };
+  });
+  for (const field of ['date', 'time', 'city-removal', 'empty-date']) await group(`Delayed lookup is fenced after ${field} edit`, async (page) => {
+    await fill(page); if (field === 'city-removal') await chooseCity(page);
+    const pending = await page.evaluate(() => window.fixture.hold()); await submit(page);
+    if (field === 'date' || field === 'empty-date') await page.locator('#mp-date').fill(field === 'empty-date' ? '' : '1990-01-05');
+    if (field === 'time') await page.locator('#mp-time').fill('13:00');
+    if (field === 'city-removal') await page.locator('.place__clear').click();
+    const activeBefore = await page.evaluate(() => document.activeElement?.id);
+    await page.evaluate((id) => window.fixture.release(id), pending);
+    await noResult(page); await idle(page);
+    assert.equal(await page.locator('[role=alert]').count(), 0);
+    assert.equal(await page.evaluate(() => window.fixture.calls.length), 0);
+    assert.equal(await page.evaluate(() => document.activeElement?.id), activeBefore);
+    return { pending, activeBefore, noAstronomyCalls: true };
+  });
+  for (const oldOutcome of ['resolve', 'reject']) await group(`Superseded ${oldOutcome} cannot settle a newer pending run`, async (page) => {
+    await fill(page); const old = await page.evaluate(() => window.fixture.hold()); await submit(page);
+    await page.locator('#mp-time').fill('13:00'); await settle(page);
+    const newer = await page.evaluate(() => window.fixture.hold());
+    // Native submit dispatch also checks the run fence independently of a disabled button.
+    await page.locator('form').evaluate((form) => form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true })));
+    await page.evaluate(({ id, outcome }) => window.fixture[outcome === 'resolve' ? 'release' : 'reject'](id), { id: old, outcome: oldOutcome });
+    await noResult(page);
+    assert.equal(await page.locator('form').getAttribute('aria-busy'), 'true');
+    assert.equal(await page.locator('[role=alert]').count(), 0);
+    await page.evaluate((id) => window.fixture.release(id), newer);
+    await page.locator('.calc__result').waitFor(); await settle(page); await idle(page);
+    const calls = await page.evaluate(() => window.fixture.calls);
+    assert.equal(calls.length, 2); assert.ok(calls.every(({ utc }) => utc === '1990-01-04T13:00:00.000Z'));
+    return { old, newer, calls };
+  });
+  await group('Current calculation failure clears old output, focuses alert, and permits retry', async (page) => {
+    await fill(page); await success(page);
+    await page.evaluate(() => window.fixture.failCalculation(true)); await submit(page);
+    await page.locator('[role=alert]').waitFor(); await noResult(page); await idle(page);
+    assert.equal(await page.evaluate(() => document.activeElement?.getAttribute('role')), 'alert');
+    await page.evaluate(() => window.fixture.failCalculation(false)); await success(page);
+    assert.equal(await page.locator('[role=alert]').count(), 0);
+    return { recovered: true, text: await page.locator('.calc__result').innerText() };
+  });
+  await group('Current loader failure clears old output and permits loader retry', async (page) => {
+    await fill(page); await success(page);
+    const pending = await page.evaluate(() => window.fixture.hold()); await submit(page);
+    await page.evaluate((id) => window.fixture.reject(id), pending);
+    await page.locator('[role=alert]').waitFor(); await noResult(page); await idle(page);
+    await page.evaluate(() => window.fixture.immediate()); await success(page);
+    assert.equal(await page.locator('[role=alert]').count(), 0);
+    return { recovered: true };
+  });
+  await group('Unmounted pending lookup performs no calculation or result commit', async (page) => {
+    await fill(page); const pending = await page.evaluate(() => window.fixture.hold()); await submit(page);
+    await page.evaluate(() => window.fixture.unmount()); await settle(page);
+    await page.evaluate((id) => window.fixture.release(id), pending); await settle(page);
+    assert.equal(await page.locator('#mount').innerText(), '');
+    assert.equal(await page.evaluate(() => window.fixture.calls.length), 0);
+    await page.evaluate(() => { window.fixture.immediate(); window.fixture.mount(); }); await settle(page);
+    await fill(page); await success(page);
+    return { remountRecovered: true };
+  });
+  await group('Unknown UTC and local-date engine inputs remain unchanged', async (page) => {
+    await fill(page, ''); await success(page);
+    const utcCalls = await page.evaluate(() => window.fixture.calls.splice(0));
+    assert.deepEqual(utcCalls.map(({ utc }) => utc), ['1990-01-04T12:00:00.000Z', '1990-01-04T12:00:00.000Z', '1990-01-04T00:00:00.000Z', '1990-01-04T23:59:00.000Z']);
+    await chooseCity(page); await success(page);
+    const localCalls = await page.evaluate(() => window.fixture.calls.splice(0));
+    assert.deepEqual(localCalls.map(({ utc }) => utc), ['1990-01-04T05:00:00.000Z', '1990-01-04T05:00:00.000Z', '1990-01-03T17:00:00.000Z', '1990-01-04T16:59:00.000Z']);
+    return { utcCalls, localCalls, qualification: 'No date-interval or sign-candidate correction is included.' };
+  });
+  for (const locale of ['es', 'fr', 'it', 'pt', 'ru']) await group(`Existing ${locale} result text and edit ownership`, async (page) => {
+    await page.goto(`${origin}/?locale=${locale}`); await page.locator('#mp-date').waitFor(); await settle(page);
+    await fill(page); await success(page); const text = await page.locator('.calc__result').innerText();
+    await page.locator('#mp-time').fill('13:00'); await noResult(page);
+    return { locale, text };
+  });
+  assert.deepEqual(report.pageErrors, []);
+  assert.ok(report.requests.every((url) => new URL(url).origin === origin));
+  assert.ok(report.groups.every((row) => row.passed), 'At least one ownership acceptance group failed.');
+  report.outcome = 'passed';
+} catch (error) { report.error = String(error.stack ?? error); process.exitCode = 1; }
+finally {
+  await browser?.close(); await new Promise((done) => server.close(done));
+  report.cleanup = 'Owned browser context and loopback server closed.';
+  await writeFile(join(out, 'result.json'), `${JSON.stringify(report, null, 2)}\n`);
+  console.log(JSON.stringify(report));
+}
