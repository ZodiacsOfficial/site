import fs from'node:fs';import assert from'node:assert/strict';import ts from'typescript';import{createHash}from'node:crypto';
const sha=text=>createHash('sha256').update(text).digest('hex');
function parse(file){const text=fs.readFileSync(file,'utf8'),tree=ts.createSourceFile(file,text,ts.ScriptTarget.Latest,true,ts.ScriptKind.TSX);return{text,tree};}
function find(tree,test){let found;function visit(node){if(test(node))found=node;ts.forEachChild(node,visit);}visit(tree);assert.ok(found);return found;}
const old=parse('baseline-MoonPhaseTool.tsx'),fresh=parse('source/src/islands/MoonPhaseTool.tsx'),printer=ts.createPrinter({removeComments:true});
function computation(source){const lookup=find(source.tree,n=>ts.isFunctionDeclaration(n)&&n.name?.text==='lookup');const statement=find(lookup,n=>ts.isTryStatement(n));const block=ts.factory.updateBlock(statement.tryBlock,statement.tryBlock.statements.filter(node=>!(ts.isIfStatement(node)&&node.expression.getText(source.tree)==='!isCurrent()')));return printer.printNode(ts.EmitHint.Unspecified,block,source.tree);}
const oldComputation=computation(old),newComputation=computation(fresh);assert.equal(newComputation,oldComputation);fs.writeFileSync('unchanged-computation.ts.log',newComputation);
const pure=['PhaseDisc','moonIlluminationFromAngle'];const unchanged=pure.map(name=>{const before=find(old.tree,n=>ts.isFunctionDeclaration(n)&&n.name?.text===name),after=find(fresh.tree,n=>ts.isFunctionDeclaration(n)&&n.name?.text===name);assert.equal(before.getText(old.tree),after.getText(fresh.tree));return{name,sha256:sha(after.getText(fresh.tree))};});
const oldType=find(old.tree,n=>ts.isInterfaceDeclaration(n)&&n.name.text==='Lookup'),newType=find(fresh.tree,n=>ts.isInterfaceDeclaration(n)&&n.name.text==='Lookup');assert.equal(oldType.getText(old.tree),newType.getText(fresh.tree));
const result={allCalculationTryStatementsIdenticalAfterRemovingOnlyNewRevisionGuards:true,computationSha256:sha(newComputation),unchangedPureFunctions:unchanged,lookupSchemaUnchanged:true,qualification:'AST printer comparison strips only the two direct if (!isCurrent()) return guards from the new try block; date/time resolution, endpoint sampling, actual body calls, phase/illumination/sign logic, captions and result construction remain identical.'};fs.writeFileSync('source-parity.json',JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result));
