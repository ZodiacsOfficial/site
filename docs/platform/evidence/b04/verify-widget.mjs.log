 await page.evaluate(()=>{const sheet=document.styleSheets[0];sheet.deleteRule(sheet.cssRules.length-1);sheet.deleteRule(sheet.cssRules.length-1);});
 await page.locator('iframe').scrollIntoViewIfNeeded();await page.screenshot({path:`${root}/${label}.png`,fullPage:true});
 check(`${label}: no page errors`,errors.length===0,errors);
