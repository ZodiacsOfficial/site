 if(attribution)check(`${label}: focused attribution is fully within frame viewport`,attribution.frame.rect.x>=-1&&attribution.frame.rect.right<=attribution.frame.innerWidth+1&&attribution.frame.rect.y>=-1&&attribution.frame.rect.bottom<=attribution.frame.innerHeight+1,attribution.frame);
 // Home-page styles intentionally conflict with the embed's own selectors and variables.
