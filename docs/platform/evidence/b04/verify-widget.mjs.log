 const embedRequest=postLoad.find(r=>r.type==='document');check(`${label}: embed referrer includes only origin`,embedRequest?.referer==='http://127.0.0.1:54770/',embedRequest);
 // Start again at the load button, then traverse the actual cross-origin iframe.
 await page.getByRole('button',{name:'Load widget'}).focus();const keys=[];
