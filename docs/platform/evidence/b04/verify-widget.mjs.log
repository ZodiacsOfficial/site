 check(`${label}: no persistent app state in either document`,[parent,child].every(s=>s.storage.local.length===0&&s.storage.session.length===0&&s.storage.cookies===''&&s.storage.indexedDB.length===0&&s.storage.cache.length===0&&s.storage.workers.length===0),{parent:parent.storage,frame:child.storage});
 const postLoad=requests.filter(r=>!r.url.startsWith('http://127.0.0.1:54770/'));
