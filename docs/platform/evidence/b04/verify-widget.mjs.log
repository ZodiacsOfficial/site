 await frame.waitForLoadState('networkidle');
 const parent=await snapshot(page),child=await snapshot(frame);
 const actualZoom=await settings.evaluate(()=>new Promise(resolve=>chrome.settingsPrivate.getDefaultZoom(resolve)));
 check(`${label}: actual browser zoom configured`,Math.abs(actualZoom-factor)<1e-9,{factor:actualZoom,innerWidth:parent.innerWidth,dpr:parent.dpr});
 check(`${label}: parent reflows without horizontal overflow`,parent.scrollWidth<=parent.clientWidth+1,{width:parent.clientWidth,scrollWidth:parent.scrollWidth});
 check(`${label}: frame reflows without horizontal overflow`,child.scrollWidth<=child.clientWidth+1,{width:child.clientWidth,scrollWidth:child.scrollWidth});
