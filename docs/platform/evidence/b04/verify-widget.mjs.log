}
// Actual offline networking, after initial parent load. No mocked remote response.
await zoom(1);page=await context.newPage();await page.setViewportSize({width:390,height:844});await page.goto('http://127.0.0.1:54770/widget.html',{waitUntil:'networkidle'});
const offlineFailures=[];page.on('requestfailed',r=>offlineFailures.push({url:r.url(),failure:r.failure()?.errorText}));
await context.setOffline(true);await page.getByRole('button',{name:'Load widget'}).click();await page.waitForTimeout(750);
const offlineState=await snapshot(page);
await page.getByRole('button',{name:'Load widget'}).focus();const offlineKeys=[];for(let i=0;i<5;i++){await page.keyboard.press('Tab');offlineKeys.push(await focusState());if(offlineKeys.at(-1).href==='https://zodiacs.org/today/')break;}
check('offline-before-first-frame: actual network failure observed',offlineFailures.some(r=>r.failure==='net::ERR_INTERNET_DISCONNECTED'),offlineFailures);
check('offline-before-first-frame: fallback remains keyboard reachable',offlineKeys.some(k=>k.href==='https://zodiacs.org/today/'),offlineKeys);
check('offline-before-first-frame: parent does not claim load success/current data',offlineState.bodyText.includes('External widget requested. Check its displayed date; use the link below if it is unavailable or stale.'),offlineState.bodyText);
await page.screenshot({path:`root/offline-before-first-frame.png`.replace('root',root),fullPage:true});
scenarios.push({label:'offline-before-first-frame',parent:offlineState,requestFailures:offlineFailures,keyboard:offlineKeys});
await context.setOffline(false);await page.close();page=null;
// Already loaded hosted card retains its displayed timestamp when connectivity drops.
page=await context.newPage();await page.goto('http://127.0.0.1:54770/widget.html',{waitUntil:'networkidle'});await page.getByRole('button',{name:'Load widget'}).click();const frame=await (await page.locator('iframe').elementHandle()).contentFrame();await frame.getByRole('link',{name:/Powered by Zodiacs.org/}).waitFor();const before=await snapshot(frame);await context.setOffline(true);const after=await snapshot(frame);
check('offline-after-hosted-load: static data retains its date and attribution',before.bodyText===after.bodyText&&/\d{4}-\d{2}-\d{2}/.test(after.bodyText),{before:before.bodyText,after:after.bodyText});
scenarios.push({label:'offline-after-hosted-load',frame:after});
} catch(error){failures.push({name:'driver stopped unexpectedly',message:error.message,stack:error.stack});}
finally{await context.setOffline(false).catch(()=>{});await zoom(originalZoom).catch(()=>{});if(page)await page.close().catch(()=>{});await settings.close().catch(()=>{});const report={observedAt:new Date().toISOString(),browser:browser.version(),node:process.version,originalZoom,scope:'Actual isolated Chrome browser; native default zoom changed only in its temporary profile and restored; immutable starter rc.2 extracted and source-checked, local build with existing verified rc.2 dependencies. Live public frame; offline cases use actual network emulation, host CSS injection is synthetic. No source changes, external user study or publication.',observations,failures,scenarios};await fs.writeFile(`${root}/browser.json`,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({checks:observations.length,failures,report:`${root}/browser.json`},null,2));await browser.close();process.exitCode=failures.length?1:0;}
