try{await page.goto('chrome://settings/appearance');console.log(await page.evaluate(()=>({api:typeof chrome.settingsPrivate,methods:chrome.settingsPrivate?Object.keys(chrome.settingsPrivate):[]})));}finally{await page.close();await browser.close();}
