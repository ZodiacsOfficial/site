import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{resolveOneTimeAllowance,protectedPathLabels,parseNameStatus,oneTimeAllowancePath}from'./fixture/scripts/phase1-scope-guard.mjs';
const hash=b=>createHash('sha256').update(b).digest('hex'),base='9d180c9f1a2f66893ccd6d73fcda106cb3894674',identity=JSON.parse(fs.readFileSync('source-identity.json')),freeze=JSON.parse(fs.readFileSync('author-freeze.json')),allowance=JSON.parse(fs.readFileSync('after/'+oneTimeAllowancePath)),changed=[...Object.keys(freeze.files),oneTimeAllowancePath,'.github/workflows/site-check.yml','i18n-additions.md'],checks=[];
function check(name,fn){fn();checks.push({name,passed:true});}
const call=(a=allowance,paths=changed,b=base)=>resolveOneTimeAllowance({allowance:a,baseCommit:b,changed:paths});
check('Unchanged exact Git guard identity',()=>assert.equal(hash(fs.readFileSync('fixture/scripts/phase1-scope-guard.mjs')),identity.guardSha256));
check('All33 frozen source/test identities;23 product sources',()=>{assert.equal(Object.values(freeze.files).filter(r=>r.kind==='product/copy').length,23);for(const[p,v]of Object.entries(freeze.files))assert.equal(hash(fs.readFileSync('fixture/'+p)),v.sha256);});
check('Exact-base frozen scope permits exactly13 protected paths',()=>{assert.deepEqual([...call()].sort(),identity.protectedPaths);assert.deepEqual(changed.filter(p=>protectedPathLabels(p).length).sort(),identity.protectedPaths);});
check('Wrong base rejected',()=>assert.throws(()=>call(allowance,changed,'f803d2543ad81343b22d49326b8b46d0e2ea03a0'),/different base/));
check('Missing changed allowance restores protection',()=>{const admitted=call(allowance,changed.filter(p=>p!==oneTimeAllowancePath));assert.equal(admitted.size,0);assert.equal(changed.filter(p=>protectedPathLabels(p).length&&!admitted.has(p)).length,13);});
check('Missing actual protected change rejected',()=>assert.throws(()=>call(allowance,changed.filter(p=>p!=='src/lib/i18n/ui/en.ts')),/exactly match/));
check('Duplicate allowance path rejected',()=>assert.throws(()=>call({...allowance,protectedPaths:[...allowance.protectedPaths,allowance.protectedPaths[0]]}),/unique and sorted/));
check('Unsorted allowance paths rejected',()=>assert.throws(()=>call({...allowance,protectedPaths:[...allowance.protectedPaths].reverse()}),/unique and sorted/));
check('Unprotected allowance entry rejected',()=>assert.throws(()=>call({...allowance,protectedPaths:[...allowance.protectedPaths,'docs/new.md'].sort()}),/unprotected path/));
for(const path of ['public/sdk/index.html','src/lib/i18n/ui/ru.test.ts','src/pages/fr/other.astro','public/registry/index.html'])check('Unlisted protected change rejected: '+path,()=>assert.throws(()=>call(allowance,[...changed,path]),/exactly match/));
check('Rename preserves protected source and is rejected',()=>{const paths=parseNameStatus('R100\0src/content/learn/old.mdx\0docs/moved.md\0');assert.deepEqual(paths,['src/content/learn/old.mdx','docs/moved.md']);assert.throws(()=>call(allowance,[...changed,...paths]),/exactly match/);});
check('Deletion preserves protected path and is rejected',()=>{const paths=parseNameStatus('D\0src/content/learn/old.mdx\0');assert.deepEqual(paths,['src/content/learn/old.mdx']);assert.throws(()=>call(allowance,[...changed,...paths]),/exactly match/);});
const before=fs.readFileSync('before/.github/workflows/site-check.yml','utf8'),after=fs.readFileSync('after/.github/workflows/site-check.yml','utf8');const step='      - name: Current reference captions\n        timeout-minutes: 5\n        run: OUT_DIR=tests/visual/artifacts/reference-captions node tests/reference-caption-drive.mjs\n\n';
check('Workflow differs only by approved four-line step',()=>{assert.equal(after.split(step).length,2);assert.equal(after.replace(step,''),before);assert.ok(after.indexOf(step)<after.indexOf('      - name: Engine accuracy vectors'));});
check('Node22 pinned setup/Chromium install/read permissions unchanged',()=>{assert.match(after,/node-version: 22/);assert.match(after,/run: npx playwright-core install chromium/);assert.match(after,/permissions:\n  contents: read/);});
check('Output is inside unchanged always-uploaded artifact tree',()=>{assert.match(after,/Upload Phase 1 browser and performance evidence\n        if: always\(\)/);assert.match(after,/            tests\/visual\/artifacts\//);assert.match(after,/retention-days: 90/);});
const driver=fs.readFileSync('fixture/tests/reference-caption-drive.mjs','utf8');
check('Actual final driver resolves OUT_DIR/current source and repository Chromium helper',()=>{assert.equal(hash(driver),freeze.files['tests/reference-caption-drive.mjs'].sha256);assert.match(driver,/process\.env\.OUT_DIR/);assert.match(driver,/resolve\(import\.meta\.dirname, '\.\.'\)/);assert.match(driver,/from '\.\/visual\/browser\.mjs'/);assert.match(driver,/await findChromium\(\)/);assert.match(driver,/process\.exitCode=1/);assert.doesNotMatch(driver,/\/private\/tmp|\/Users\//);});
check('Actual fixture has guarded optional baseline; CI does not silently supply one',()=>{assert.match(driver,/const baseline = process\.env\.REFERENCE_BASELINE_DIR/);assert.match(driver,/baseline \? \['baseline', 'candidate'\] : \['candidate'\]/);assert.doesNotMatch(step,/REFERENCE_BASELINE_DIR/);});
const generation=JSON.parse(fs.readFileSync('generation/identity.json')),generated=fs.readFileSync('fixture/i18n-additions.md'),prior=fs.readFileSync('generation/before/i18n-additions.md','utf8');
check('Unchanged generator identity',()=>assert.equal(hash(fs.readFileSync('fixture/scripts/build-i18n-additions.mjs')),generation.generatorSha256));
check('Independent native Node22 regeneration equals root proposal bytes',()=>{assert.equal(hash(generated),generation.afterSha256);assert.deepEqual(generated,fs.readFileSync('generation/after/i18n-additions.md'));});
check('Generated output contains only one EN default substitution',()=>assert.equal(generated.toString(),prior.replace('  - EN default: `12:00 reference · Birth time unknown`','  - EN default: `Reference positions · Birth time unknown`')));
