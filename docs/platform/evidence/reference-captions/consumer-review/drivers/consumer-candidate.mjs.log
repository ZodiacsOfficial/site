  babySunHead: "\u0421\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439 \u0437\u043D\u0430\u043A \u2014 \u043F\u043E\u0447\u0442\u0438 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430",
