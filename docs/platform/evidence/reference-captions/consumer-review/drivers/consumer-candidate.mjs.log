  const ordered = Array.from({ length: normalized.length }, (_3, index) => {
    const sourceIndex = (start + index) % normalized.length;
    const body = normalized[sourceIndex];
    const unwrapped = body.normalizedLon + (sourceIndex < start ? 360 : 0);
