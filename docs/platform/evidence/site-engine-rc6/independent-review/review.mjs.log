const result={node:process.version,icu:process.versions.icu,tzdb:process.versions.tz,transitions,publicSdkMatches:retained.length+additional.length+validBoundaries.length,additional,validBoundaries,rejected,limitations:['Finite runtime-Intl behavior checks; not historical timezone truth or astronomical accuracy certification.','The existing three-offset sampler remains unchanged; the finite 145-hour reference is not a complete transition proof.','Year 0000/9999 are library syntax checks outside calculator UI dates 1800–2199.','Date interval endpoints, unknown-date candidate completeness, publication and deployment excluded.']};
fs.writeFileSync(process.argv[2]??'node22-result.json',JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({node:result.node,icu:result.icu,tzdb:result.tzdb,retainedControls:transitions.count,correctedFlags:transitions.corrected,retainedInstantChanges:transitions.instantsChanged,additionalControls:additional.length,additionalChanges:additional.filter(x=>x.baselineInstantDeltaMs!==0||JSON.stringify(x.flags)!==JSON.stringify(x.baselineFlags)).length,validBoundaries:validBoundaries.length,rejected:rejected.length,publicSdkMatches:result.publicSdkMatches}));
