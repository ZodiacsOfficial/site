for(const row of retained)assert.deepEqual(candidate.resolveLocalToUtc(row.date,row.time,row.zone),sdk.resolveLocalToUtc(row.date,row.time,row.zone));
const fmt=new Map();
function wall(zone,ms){
 if(!fmt.has(zone))fmt.set(zone,new Intl.DateTimeFormat('en-US',{timeZone:zone,calendar:'gregory',numberingSystem:'latn',era:'short',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',fractionalSecondDigits:3,hourCycle:'h23'}));
 const ps=fmt.get(zone).formatToParts(ms),p=t=>ps.find(x=>x.type===t)?.value;
 const d=new Date(0);d.setUTCFullYear(p('era')==='BC'?1-Number(p('year')):Number(p('year')),Number(p('month'))-1,Number(p('day')));d.setUTCHours(Number(p('hour')),Number(p('minute')),Number(p('second')),Number(p('fractionalSecond')));return d.getTime();
}
function civil(date,time){const d=new Date(0),[y,m,day]=date.split('-').map(Number),[h,min]=time.split(':').map(Number);d.setUTCFullYear(y,m-1,day);d.setUTCHours(h,min,0,0);return d.getTime();}
const groups=[
 ['Europe/Paris','1911-03-10',['23:40','23:49','23:50','23:51','23:55','23:59']],
 ['Europe/Paris','1911-03-11',['00:00','00:01','12:00']],
