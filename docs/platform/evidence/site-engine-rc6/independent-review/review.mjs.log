 ['Africa/Monrovia','1972-01-07',['00:00','00:01','00:30','00:44','00:45','00:46','12:00']],
 ['Asia/Kathmandu','1919-12-31',['23:40','23:48','23:49','23:50','23:59']],
 ['Asia/Kathmandu','1920-01-01',['00:00','00:01','12:00']],
 ['Asia/Kolkata','1906-01-01',['00:00','00:01','00:08','00:09','00:10','12:00']],
 ['Asia/Yangon','1920-01-01',['00:00','00:01','00:05','00:06','12:00']],
 ['Europe/Amsterdam','1937-07-01',['00:00','00:01','00:20','12:00']],
 ['Pacific/Auckland','1868-11-02',['00:00','00:01','00:10','12:00']],
 ['America/New_York','2024-03-10',['01:59','02:00','02:30','02:59','03:00']],
 ['America/New_York','2024-11-03',['00:59','01:00','01:30','01:59','02:00']],
