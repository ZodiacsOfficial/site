const additional=[];
for(const[zone,date,times]of groups)for(const time of times){
 const typed=civil(date,time),fresh=candidate.resolveLocalToUtc(date,time,zone),old=baseline.resolveLocalToUtc(date,time,zone),publicResult=sdk.resolveLocalToUtc(date,time,zone);
 assert.deepEqual(fresh,publicResult);
 // Independent finite reference: obtain offsets from complete wall parts at 145 hourly instants, not longOffset parsing or the implementation's three sample points.
 const offsets=[...new Set(Array.from({length:145},(_,i)=>{const t=typed+(i-72)*3600000;return wall(zone,t)-t;}))];
 const exact=offsets.map(offset=>typed-offset).filter(ms=>wall(zone,ms)===typed).sort((a,b)=>a-b);
 const actualWall=wall(zone,fresh.utc.getTime()),shift=actualWall-typed;
 assert.equal(actualWall-fresh.utc.getTime(),Math.round(fresh.offsetMinutes*60000));assert.ok(shift>=0);assert.equal(fresh.flags.includes('dst-gap'),shift>0);
 if(exact.length){assert.equal(fresh.utc.getTime(),exact[0]);assert.equal(shift,0);assert.equal(fresh.flags.includes('dst-fold'),exact.length>1);}else{assert.ok(shift>0);assert.equal(fresh.flags.includes('dst-fold'),false);}
 assert.equal(fresh.utc.getUTCMilliseconds(),0);
 additional.push({zone,date,time,instant:fresh.utc.toISOString(),offsetMinutes:fresh.offsetMinutes,flags:fresh.flags,actualWall:new Date(actualWall).toISOString(),shiftMilliseconds:shift,independentlyFoundExactCandidates:exact.map(x=>new Date(x).toISOString()),independentOffsetCount:offsets.length,baselineInstantDeltaMs:fresh.utc.getTime()-old.utc.getTime(),baselineFlags:old.flags});
}
const validBoundaries=[];
for(const date of ['0000-01-01','0000-02-29','0099-12-31','0100-01-01','1800-01-01','2199-12-31','9999-12-31'])for(const zone of ['UTC','Pacific/Kiritimati','America/Adak'])for(const time of ['00:00','23:59']){
 const fresh=candidate.resolveLocalToUtc(date,time,zone),old=baseline.resolveLocalToUtc(date,time,zone);assert.deepEqual(fresh,sdk.resolveLocalToUtc(date,time,zone));assert.equal(fresh.utc.getTime(),old.utc.getTime());assert.equal(wall(zone,fresh.utc.getTime()),civil(date,time));assert.equal(fresh.flags.includes('dst-gap'),false);assert.equal(fresh.flags.includes('dst-fold'),false);validBoundaries.push({date,time,zone,instant:fresh.utc.toISOString(),flags:fresh.flags});
}
