 ['2001-02-29','08:30','UTC'],['1900-02-29','08:30','UTC'],['2024-01-01\n','08:30','UTC'],['-0001-01-01','08:30','UTC'],['10000-01-01','08:30','UTC'],['2024-13-01','08:30','UTC'],['2024-01-00','08:30','UTC'],
 ['2024-01-01','24:00','UTC'],['2024-01-01','08:60','UTC'],['2024-01-01','8:30','UTC'],['2024-01-01','08:30:00','UTC'],['2024-01-01','08:30\n','UTC'],['2024-01-01','08:30',''],['2024-01-01','08:30',undefined],['2024-01-01','08:30',null],['2024-01-01','08:30','Synthetic/Invalid'],[null,'08:30','UTC'],[2024,'08:30','UTC'],['2024-01-01',null,'UTC']
