import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { build } from 'esbuild';
const records=[];
for(const kind of ['baseline','candidate']){
 const result=await build({entryPoints:[`${kind}/src/lib/time/localToUtc.ts`],outfile:`${kind}-resolver.mjs`,bundle:true,format:'esm',platform:'node',target:'es2022',metafile:true});
 const inputs=Object.keys(result.metafile.inputs).map(file=>{if(!path.resolve(file).startsWith(process.cwd()+'/'))throw new Error('Source escaped scratch');return{path:file,sha256:createHash('sha256').update(fs.readFileSync(file)).digest('hex')};});
 records.push({kind,inputs,bundleSha256:createHash('sha256').update(fs.readFileSync(`${kind}-resolver.mjs`)).digest('hex')});
}
fs.writeFileSync('build-inputs.json',JSON.stringify(records,null,2)+'\n');console.log(JSON.stringify(records));
