import {createServer} from 'node:http';
import {readFile,writeFile} from 'node:fs/promises';
import {createRequire} from 'node:module';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const out='/private/tmp/zodiacs-platform-site-seconds-adoption-evidence';
const root='/private/tmp/zodiacs-platform-site-seconds-adoption';
const require=createRequire(root+'/package.json');const {chromium}=require('playwright-core');
const sha=b=>createHash('sha256').update(b).digest('hex');
const identity=JSON.parse(await readFile(out+'/source-freeze1-identity.json','utf8'));
async function checkSource(){const hashes={};for(const[file,hash]of Object.entries(identity.files)){hashes[file]=sha(await readFile(root+'/'+file));assert.equal(hashes[file],hash);}return hashes;}
const before=await checkSource(),requests=[],served={};
const server=createServer(async(req,res)=>{let data,type;
 if(req.url==='/'){data=Buffer.from('<!doctype html><meta charset="utf-8"><title>Historical precision acceptance</title><h1>Historical precision acceptance</h1><pre id="result">Loading exact source bundle</pre><script type="module">import {runAcceptance} from "/acceptance-checks.mjs"; window.runAcceptance=runAcceptance;</script>');type='text/html';}
 else if(['/acceptance-checks.mjs','/acceptance-subject.mjs'].includes(req.url)){data=await readFile(out+req.url);type='text/javascript';}
 else{res.writeHead(404);res.end();return;}
 requests.push({path:req.url,method:req.method,bytes:data.length,sha256:sha(data)});served[req.url]={bytes:data.length,sha256:sha(data)};res.writeHead(200,{'Content-Type':type,'Cache-Control':'no-store'});res.end(data);
});
await new Promise(done=>server.listen(0,'127.0.0.1',done));let browser,context;
const record={identity,before,startedAt:new Date().toISOString(),requests,served,errors:[],external:[],cleanup:{context:false,browser:false,server:false}};
try{
 browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking']});record.browser=browser.version();
 context=await browser.newContext();const origin='http://127.0.0.1:'+server.address().port;
 await context.route('**/*',route=>{if(route.request().url().startsWith(origin+'/'))return route.continue();record.external.push(route.request().url());return route.abort();});
 const page=await context.newPage();page.on('pageerror',e=>record.errors.push(e.message));await page.goto(origin);await page.waitForFunction(()=>typeof window.runAcceptance==='function');await context.setOffline(true);
 const fixtures=JSON.parse(await readFile(out+'/historical-counterexamples.json','utf8'));
 const result=await page.evaluate(fixtures=>{
  const calls={};const denied=name=>function(){calls[name]=(calls[name]??0)+1;throw Error('Synthetic side-effect denial');};
  const controls=[];function install(target,key,name,test){Object.defineProperty(target,key,{configurable:true,value:denied(name)});controls.push([name,test]);}
  install(window,'fetch','fetch',()=>fetch('/synthetic'));
  install(XMLHttpRequest.prototype,'open','xhr',()=>new XMLHttpRequest().open('GET','/synthetic'));
  install(window,'WebSocket','websocket',()=>new WebSocket('ws://127.0.0.1'));
  install(window,'EventSource','eventsource',()=>new EventSource('/synthetic'));
  install(navigator,'sendBeacon','beacon',()=>navigator.sendBeacon('/synthetic','fixture'));
  for(const key of ['getItem','setItem','removeItem','clear'])install(Storage.prototype,key,'storage-'+key,()=>localStorage[key]('synthetic','fixture'));
  install(indexedDB,'open','indexedDB-open',()=>indexedDB.open('synthetic'));
  install(indexedDB,'deleteDatabase','indexedDB-delete',()=>indexedDB.deleteDatabase('synthetic'));
  Object.defineProperty(document,'cookie',{configurable:true,get:denied('cookie-read'),set:denied('cookie-write')});controls.push(['cookie-read',()=>document.cookie],['cookie-write',()=>{document.cookie='synthetic=fixture';}]);
  for(const[name,run]of controls){try{run();}catch{}if(calls[name]!==1)throw Error('Observer negative control '+name);}
  const negativeControls={...calls};for(const key of Object.keys(calls))calls[key]=0;
  const report=window.runAcceptance(fixtures);if(Object.values(calls).some(Boolean))throw Error('Unexpected runtime side effects');
  document.querySelector('#result').textContent=JSON.stringify({engine:report.engineVersion,baseline:report.baselineEngineVersion,historical:report.historical.map(r=>({zone:r.zone,instant:r.instant,flags:r.newFlags,gapSeconds:r.gapShiftMinutes*60})),totals:report.totals,offline:true,sideEffects:calls},null,2);
  return{report,negativeControls,runtimeCalls:calls,offline:true};
 },fixtures);
 Object.assign(record,result);assert.deepEqual(record.errors,[]);assert.deepEqual(record.external,[]);await page.screenshot({path:out+'/native-precision.png',fullPage:true});record.after=await checkSource();record.status='passed';
}catch(error){record.status='failed';record.error=error.stack;process.exitCode=1;}finally{
 if(context){await context.close();record.cleanup.context=true;}if(browser){await browser.close();record.cleanup.browser=true;}await new Promise(done=>server.close(done));record.cleanup.server=true;record.completedAt=new Date().toISOString();
 await writeFile(out+'/browser-acceptance.json',JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify({status:record.status,browser:record.browser,totals:record.report?.totals,error:record.error,cleanup:record.cleanup},null,2));
}
