import {createRequire} from 'node:module';
import {readFileSync,writeFileSync,copyFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
const root='/Users/chiburashka/.codex/worktrees/4806/site';const require=createRequire(root+'/package.json');const {PNG}=require('pngjs');const pixelmatch=require('pixelmatch').default;
const out='/private/tmp/zodiacs-platform-rc6-integration';const recorded=JSON.parse(readFileSync(root+'/docs/platform/evidence/receipt-export/integration/chart-visual-comparison.json'));
const rows=recorded.cases.map(row=>{const name=row.name;const currentPath=root+'/tests/visual/artifacts/visual/'+name+'.actual.png';const basePath=name==='birth-chart-kahlo-desktop'?root+'/docs/platform/evidence/receipt-export/integration/'+name+'.current.png':'/private/tmp/zodiacs-platform-rc1-visual-control/current-candidate-visual/'+name+'.actual.png';const current=readFileSync(currentPath),base=readFileSync(basePath);const hash=v=>createHash('sha256').update(v).digest('hex');if(hash(base)!==row.currentSha256)throw Error('Base identity mismatch');const c=PNG.sync.read(current),b=PNG.sync.read(base);if(c.width!==b.width||c.height!==b.height)throw Error('Dimensions differ');const scored=pixelmatch(c.data,b.data,null,c.width,c.height,{threshold:0.1});const result={name,width:c.width,height:c.height,currentSha256:hash(current),baseSha256:hash(base),byteIdentical:current.equals(base),scoredDifferentPixels:scored,scoredDiffRatio:scored/(c.width*c.height)};if(!result.byteIdentical){copyFileSync(currentPath,out+'/'+name+'.current.png');copyFileSync(basePath,out+'/'+name+'.base.png');}return result;});
const report={baseSource:'804c70309d2508e67e8462df526b5f9e71a112e9',originalGate:'same three pre-existing macOS height failures',baselinesUpdated:false,newMasks:0,pixelmatchThreshold:0.1,maxDiffRatio:0.001,cases:rows};writeFileSync(out+'/chart-visual-comparison.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report,null,2));if(rows.some(r=>r.scoredDiffRatio>0.001))process.exitCode=1;
