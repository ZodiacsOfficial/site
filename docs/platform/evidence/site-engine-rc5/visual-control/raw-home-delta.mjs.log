import fs from 'node:fs';import path from 'node:path';import { createRequire } from 'node:module';
const root=path.dirname(new URL(import.meta.url).pathname);const {PNG}=createRequire(path.join(root,'site/package.json'))('pngjs');
const output=[];
for(const name of ['home-desktop.actual.png','home-desktop-reduced-motion.actual.png']){
const a=PNG.sync.read(fs.readFileSync(path.join(root,'site/tests/visual/artifacts/visual',name)));const b=PNG.sync.read(fs.readFileSync(path.join(root,'current-candidate-visual',name)));const histogram={};let max=0,minX=a.width,minY=a.height,maxX=-1,maxY=-1;
for(let y=0;y<a.height;y++)for(let x=0;x<a.width;x++){const i=(y*a.width+x)*4;let delta=0;for(let c=0;c<4;c++)delta=Math.max(delta,Math.abs(a.data[i+c]-b.data[i+c]));if(delta){histogram[delta]=(histogram[delta]??0)+1;max=Math.max(max,delta);minX=Math.min(minX,x);minY=Math.min(minY,y);maxX=Math.max(maxX,x);maxY=Math.max(maxY,y)}}
output.push({name,maximumRawChannelDelta:max,perPixelMaximumChannelDeltaHistogram:histogram,bounds:{minX,minY,maxX,maxY}});
}
fs.writeFileSync(path.join(root,'raw-home-delta.json'),JSON.stringify(output,null,2)+'\n');console.log(JSON.stringify(output,null,2));
