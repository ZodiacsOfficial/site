    "id": "V2",
    "passed": true,
    "observed": {
      "homeFaq": {
        "question": "What if I don't know my birth time?",
        "answer": "Choose “I don’t know it.” The calculator uses 12:00 as a reference, leaves out the rising sign and houses instead of inventing them, and marks the Moon sign as unverified until you add a time, because the Moon can change sign during a day."
      },
      "birthChartFaq": {
        "question": "Do I need my exact birth time?",
        "answer": "For your rising sign and houses, yes — the ascendant changes roughly every two hours. Without a time, we use 12:00 local civil time as a reference for body positions and omit the rising sign, angles, and houses. Because the Moon can change sign during a day, the result marks the Moon sign as unverified until you add a time. Birth certificates, baby books, and parents are the usual sources."
      },
      "moonSignFaq": {
        "question": "Do I need my birth time to find my moon sign?",
        "answer": "Usually not — the Moon spends about two and a half days in each sign, so most days it only occupies one. But it changes signs roughly every 60 hours, so on boundary days the time matters. Without a time, this calculator shows a reference result and marks the Moon sign as unverified instead of guessing."
      },
      "bannedPhraseHits": [
        null,
        null,
        null
      ],
      "unknownTimeNotices": [
        "Without a birth time, we show reference positions and omit the rising sign, angles, and houses. Birth time is unknown. These are reference-moment positions; the Sun sign has not been verified across the whole birth date. The Moon’s possible signs across this birth date are unverified. Add a birth time for a result at that moment."
      ]
    },
