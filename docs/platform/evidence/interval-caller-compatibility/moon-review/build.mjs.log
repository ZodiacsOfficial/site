import fs from 'node:fs';import assert from 'node:assert/strict';import path from 'node:path';import{createHash}from'node:crypto';import ts from'typescript';import{build}from'esbuild';
const records=[];
function extract(file,names){const bytes=fs.readFileSync(file,'utf8'),tree=ts.createSourceFile(file,bytes,ts.ScriptTarget.Latest,true,ts.ScriptKind.TSX),found=new Map();function visit(node){if(ts.isFunctionDeclaration(node)&&node.name&&names.includes(node.name.text))found.set(node.name.text,node);if(ts.isVariableStatement(node))for(const declaration of node.declarationList.declarations)if(ts.isIdentifier(declaration.name)&&names.includes(declaration.name.text))found.set(declaration.name.text,node);ts.forEachChild(node,visit);}visit(tree);return names.map(name=>{const node=found.get(name);assert.ok(node,name+' missing');const text=node.getText(tree),start=tree.getLineAndCharacterOfPosition(node.getStart(tree)).line+1;records.push({file,name,start,end:tree.getLineAndCharacterOfPosition(node.end).line+1,sha256:createHash('sha256').update(text).digest('hex')});return text;}).join('\n');}
const lookup=extract('source/src/islands/MoonPhaseTool.tsx',['lookup','moonIlluminationFromAngle']);const signs=extract('source/src/lib/signs.ts',['SIGNS','signIndexForLongitude','signForLongitude']);
fs.writeFileSync('extracted-signs.ts',signs+'\n');
fs.writeFileSync('lookup-harness.ts',`import {resolveLocalToUtc} from './source/src/lib/time/localToUtc';\nimport {moonPhaseName} from './source/src/lib/engine/lite';\nimport {signForLongitude} from './extracted-signs';\nexport function captureLookup({date,time,city,loadEngine}:any,state:any){\nconst locale='en';\nconst focusAfterComputeRef={current:false};\nconst setBusy=(value:any)=>{state.busy=value;state.events.push({kind:'busy',value});};\nconst setError=(value:any)=>{state.error=value;state.events.push({kind:'error',value});};\nconst setResult=(value:any)=>{state.result=value;state.events.push({kind:'result',value});};\nconst t=(_locale:any,key:any)=>key;\nconst calculationError=(_cause:any,_locale:any,fallback:any)=>fallback;\nconst console={error:(value:any)=>{state.errors.push(String(value));}};\n${lookup}\nreturn lookup;\n}\n`);
for(const [entry,out]of [['lookup-harness.ts','lookup-subject.mjs'],['source/src/lib/engine/full.ts','engine-subject.mjs'],['source/src/lib/time/localToUtc.ts','resolver-subject.mjs'],['source/src/lib/engine/lite.ts','lite-subject.mjs']])await build({entryPoints:[entry],outfile:out,format:'esm',bundle:true,platform:'node',target:'es2022',external:['@zodiacs/engine','@zodiacs/engine/*']});
fs.writeFileSync('extracted-function-identity.json',JSON.stringify({records,qualification:'Exact AST source extraction of the production async lookup closure and its pure sign/illumination functions. Preact setters are modeled as observable state setters, translation returns keys, and the error formatter returns its fallback. Actual resolver, lite phase function and vendored engine code execute. This is a source-level asynchronous control, not a native UI test.'},null,2)+'\n');console.log(JSON.stringify(records));
