import fs from 'node:fs';import {localDateEndpointsUtc} from './subject.mjs';const inputs=[['2001-02-29','UTC'],['0000-02-30','UTC'],['1990-6-15','UTC'],['1990-06-15\n','UTC'],['1990-06-15',''],['1990-06-15','Synthetic/Invalid'],[null,'UTC'],['1990-06-15',null]];const rows=inputs.map(([date,zone])=>{try{const result=localDateEndpointsUtc(date,zone);return{date,zone,rejected:false,result}}catch(e){return{date,zone,rejected:true,error:String(e)}}});const result={at:new Date().toISOString(),node:process.version,rows};fs.writeFileSync(new URL('guards-result.json',import.meta.url),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result,null,2));if(rows.some(x=>!x.rejected))process.exitCode=1;
