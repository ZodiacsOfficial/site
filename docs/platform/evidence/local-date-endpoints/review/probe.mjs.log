import fs from 'node:fs';import {createHash} from 'node:crypto';import {localDateEndpointsUtc,offsetAt} from './subject.mjs';
const DAY=86400000,HOUR=3600000;const formatter=new Map();function parts(zone,t){if(!formatter.has(zone))formatter.set(zone,new Intl.DateTimeFormat('en-US',{timeZone:zone,calendar:'gregory',numberingSystem:'latn',era:'short',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',fractionalSecondDigits:3,hourCycle:'h23'}));const p=Object.fromEntries(formatter.get(zone).formatToParts(t).map(x=>[x.type,x.value]));const year=p.era==='BC'?1-Number(p.year):Number(p.year);return{year,month:Number(p.month),day:Number(p.day),hour:Number(p.hour),minute:Number(p.minute),second:Number(p.second),millisecond:Number(p.fractionalSecond)};}function wallEpoch(p){const d=new Date(0);d.setUTCFullYear(p.year,p.month-1,p.day);d.setUTCHours(p.hour??0,p.minute??0,p.second??0,p.millisecond??0);return+d;}function dateMs(date){const [year,month,day]=date.split('-').map(Number);return wallEpoch({year,month,day});}const iso=t=>new Date(t).toISOString();
export function probe(){const cases=[['2000-01-01','Asia/Tokyo'],['2024-03-10','America/New_York'],['2024-11-03','America/New_York'],['1919-03-30','America/Toronto'],['1919-03-31','America/Toronto'],['2011-12-29','Pacific/Apia'],['2011-12-30','Pacific/Apia'],['2011-12-31','Pacific/Apia'],['2009-10-31','America/St_Johns'],['2009-11-01','America/St_Johns'],['1988-10-29','America/Goose_Bay'],['1988-10-30','America/Goose_Bay'],['1892-07-04','Pacific/Apia'],['0000-01-01','UTC'],['0000-02-29','UTC'],['0099-12-31','UTC'],['9999-12-31','UTC']];const rows=[];for(const[date,zone]of cases){const w=dateMs(date),lo=w-2*DAY,hi=w+3*DAY;const off=t=>Math.round(offsetAt(zone,t)*60000);const transitions=[];let queries=0;const query=t=>(queries++,off(t));for(let a=lo;a<hi;a+=HOUR){let oa=query(a),b=Math.min(a+HOUR,hi),ob=query(b);if(oa!==ob){let left=a,right=b;while(right-left>1){const m=Math.floor((left+right)/2);if(query(m)===oa)left=m;else right=m;}transitions.push(right)}}const boundaries=[lo,...transitions,hi],segments=[];for(let i=0;i<boundaries.length-1;i++){const a=boundaries[i],b=boundaries[i+1],o=off(a),start=Math.max(a,w-o),endExclusive=Math.min(b,w+DAY-o);if(start<endExclusive){const prior=segments.at(-1);if(prior&&prior.endExclusive===start)prior.endExclusive=endExclusive;else segments.push({start,endExclusive});}}const reference={kind:segments.length?'existing':'empty',segments:segments.map(s=>({start:iso(s.start),endExclusive:iso(s.endExclusive),last:iso(s.endExclusive-1),durationMs:s.endExclusive-s.start})),first:segments.length?iso(segments[0].start):null,last:segments.length?iso(segments.at(-1).endExclusive-1):null};const checks=[];for(const s of segments)for(const t of [s.start,s.endExclusive-1]){const p=parts(zone,t);checks.push({instant:iso(t),wall:p,dateMatches:wallEpoch({...p,hour:0,minute:0,second:0,millisecond:0})===w,arithmeticAgrees:wallEpoch(p)===t+off(t)})}const transitionDetails=transitions.map(t=>({instant:iso(t),before:parts(zone,t-1),after:parts(zone,t),beforeOffset:off(t-1),afterOffset:off(t)}));let actual;try{const v=localDateEndpointsUtc(date,zone);actual={start:v.start.toISOString(),end:v.end.toISOString(),durationMs:+v.end-+v.start+1,startWall:parts(zone,+v.start),endWall:parts(zone,+v.end)}}catch(e){actual={error:String(e)}}rows.push({date,zone,actual,reference,actualMatches:actual.start===reference.first&&actual.end===reference.last,transitions:transitionDetails,checks,queries});}return{at:new Date().toISOString(),runtime:typeof process==='undefined'?{browser:true}:{node:process.version,versions:process.versions},model:'Reviewer-only piecewise-constant offset interval algebra; offsets discovered at hourly UTC probes in a five-day window, changed cells bisected to1ms. Assumes no hidden pair of transitions within one probe cell and all applicable offsets inside48h. Complete for these discovered schedules, not a proof of all host Intl histories.',rows};}
const result=probe();fs.writeFileSync(new URL('result.json',import.meta.url),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({rows:result.rows.length,mismatches:result.rows.filter(x=>!x.actualMatches).map(x=>({date:x.date,zone:x.zone,actual:x.actual,reference:x.reference})),failedChecks:result.rows.flatMap(x=>x.checks).filter(x=>!x.dateMatches||!x.arithmeticAgrees)},null,2));
