import fs from'node:fs';import path from'node:path';import{createHash}from'node:crypto';
const work=path.dirname(new URL(import.meta.url).pathname),identity=JSON.parse(fs.readFileSync(path.join(work,'identity.json'))),sha=bytes=>createHash('sha256').update(bytes).digest('hex');
const recheck=[];for(const[kind,repo]of Object.entries(identity.repositories))for(const file of repo.files){const actual=sha(fs.readFileSync(path.join(repo.root,file.file)));recheck.push({repository:kind,file:file.file,readHash:file.sha256,currentHash:actual,matches:actual===file.sha256});}
fs.writeFileSync(path.join(work,'recheck.json'),JSON.stringify({at:new Date().toISOString(),allMatch:recheck.every(row=>row.matches),files:recheck},null,2)+'\n');
const records=[];function walk(dir){for(const entry of fs.readdirSync(dir,{withFileTypes:true})){const file=path.join(dir,entry.name);if(entry.isDirectory())walk(file);else if(entry.name!=='manifest.json'){const bytes=fs.readFileSync(file);records.push({path:path.relative(work,file),bytes:bytes.length,sha256:sha(bytes)});}}}walk(work);records.sort((a,b)=>a.path.localeCompare(b.path));fs.writeFileSync(path.join(work,'manifest.json'),JSON.stringify({at:new Date().toISOString(),files:records},null,2)+'\n');console.log(JSON.stringify({records:records.length,allReadFilesStillMatch:recheck.every(row=>row.matches),manifestSha256:sha(fs.readFileSync(path.join(work,'manifest.json')))}));
