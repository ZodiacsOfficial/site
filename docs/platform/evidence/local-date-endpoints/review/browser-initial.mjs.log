import fs from 'node:fs';import path from 'node:path';import http from 'node:http';import {createRequire} from 'node:module';import {createHash} from 'node:crypto';const out=path.dirname(new URL(import.meta.url).pathname);const require=createRequire('/Users/chiburashka/.codex/worktrees/4806/site/package.json'),{build}=require('esbuild'),{chromium}=require('playwright-core');const probe=fs.readFileSync(out+'/probe.mjs','utf8');const core=probe.slice(probe.indexOf('const DAY='),probe.indexOf('const result=probe();')).replace('export function probe','function probe');const entry="import {localDateEndpointsUtc,offsetAt} from './subject.mjs';\n"+core+'\nwindow.endpointProbe=probe;';fs.writeFileSync(out+'/browser-entry.js',entry);const bytes=(await build({stdin:{contents:entry,resolveDir:out},bundle:true,write:false,format:'iife',platform:'browser'})).outputFiles[0].contents;fs.writeFileSync(out+'/browser-subject.js',bytes);const requests=[],errors=[];const server=http.createServer((req,res)=>{requests.push(req.url);res.setHeader('Content-Type',req.url==='/subject.js'?'text/javascript':'text/html');res.end(req.url==='/subject.js'?bytes:'<!doctype html><script src="/subject.js"></script>')});await new Promise(r=>server.listen(0,'127.0.0.1',r));let browser,result;try{browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking']});const page=await browser.newPage();page.on('pageerror',e=>errors.push(String(e)));await page.goto('http://127.0.0.1:'+server.address().port);result=await page.evaluate(()=>{const r=window.endpointProbe();r.nativeTemporal=typeof Temporal;if(typeof Temporal!=='undefined')r.temporal=r.rows.map(({date,zone})=>{try{const d=Temporal.PlainDate.from(date),s=d.toZonedDateTime(zone),n=d.add({days:1}).toZonedDateTime(zone);return{date,zone,start:s.toInstant().toString(),actualDate:s.toPlainDate().toString(),nextStart:n.toInstant().toString(),hoursInDay:s.hoursInDay,previousTransition:s.getTimeZoneTransition('previous')?.toInstant().toString(),nextTransition:s.getTimeZoneTransition('next')?.toInstant().toString()}}catch(e){return{date,zone,error:String(e)}}});return r});result.browser=browser.version();}finally{await browser?.close();await new Promise(r=>server.close(r));if(result){result.errors=errors;result.requests=requests;result.cleanup={browserClosed:true,serverClosed:true};result.harnessSha256=createHash('sha256').update(fs.readFileSync(new URL(import.meta.url))).digest('hex');result.bundleSha256=createHash('sha256').update(bytes).digest('hex');fs.writeFileSync(out+'/browser-result.json',JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({browser:result.browser,nativeTemporal:result.nativeTemporal,rows:result.rows.length,mismatches:result.rows.filter(x=>!x.actualMatches).length,failedChecks:result.rows.flatMap(x=>x.checks).filter(x=>!x.dateMatches||!x.arithmeticAgrees),temporal:result.temporal,errors,cleanup:result.cleanup},null,2))}}
