import fs from 'node:fs';const H=3600000,D=24*H;const cases=[{name:'ordinary',initial:0,transitions:[]},{name:'hidden earlier date segment',initial:0,transitions:[[-59*60000,H],[-58*60000,0]]},{name:'hidden existing minute in otherwise skipped date',initial:-10*H,transitions:[[10*H,14*H],[10*H+60000,-10*H],[10*H+120000,14*H]]}];function offset(c,t){let o=c.initial;for(const[a,b]of c.transitions)if(t>=a)o=b;return o}function intervals(c,edges){const bounds=[-2*D,...edges,3*D],result=[];for(let i=0;i<bounds.length-1;i++){const a=bounds[i],b=bounds[i+1],o=offset(c,a),start=Math.max(a,-o),endExclusive=Math.min(b,D-o);if(start<endExclusive){const p=result.at(-1);if(p&&p.endExclusive===start)p.endExclusive=endExclusive;else result.push({start,endExclusive})}}return result}const rows=cases.map(c=>{const found=[];for(let a=-2*D;a<3*D;a+=H){const before=offset(c,a);if(before!==offset(c,a+H)){let lo=a,hi=a+H;while(hi-lo>1){const mid=Math.floor((lo+hi)/2);if(offset(c,mid)===before)lo=mid;else hi=mid}found.push(hi)}}const exact=intervals(c,c.transitions.map(x=>x[0])),sampled=intervals(c,found);return{...c,discovered:found,exact,sampled,matches:JSON.stringify(exact)===JSON.stringify(sampled)}});const record={at:new Date().toISOString(),node:process.version,qualification:'Synthetic piecewise-constant offset functions, not actual IANA discoveries. Demonstrates the completeness assumption that a bounded equal-endpoint sample cannot verify; all offsets remain within fourteen hours.',rows};fs.writeFileSync(new URL('sampling-countermodels.json',import.meta.url),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify(record,null,2));
