 finally{await context.tracing.stop({path:`${directory}/${label}-trace.zip`}).catch(()=>{});await context.close();await fs.writeFile(`${directory}/focus-trace.json`,JSON.stringify({observedAt:new Date().toISOString(),browser:browser.version(),plan:'Fixed 16 cases chosen before execution; six immediate mobile contexts per unchanged widget version, desktop controls, then strict settled-focus controls. No retry-until-green.',runs},null,2)+'\n');console.log(JSON.stringify({label,pass:run.assertion,steps:run.steps,error:run.error}));}
