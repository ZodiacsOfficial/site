}catch(error){report.error??=String(error.stack??error);report.outcome='failed';process.exitCode=1}finally{await browser?.close();report.cleanup='Owned browser contexts/browser and foreground Astro preview closed; no production/account backend operation.';fs.writeFileSync(resolve(out,'result.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({outcome:report.outcome,browser:report.browser,checkpoints:report.checkpoints.length,postCount:report.requests.filter(r=>r.method==='POST').length,unexpected:report.unexpected.length,error:report.error}));}
