   const refused=await observe('skipped-date-dedicated-focused-refusal');const expected=await page.evaluate(()=>window.__ZDX_UI__.messages.localDateReferenceError);assert.equal(refused.error,expected);assert.equal(refused.resultCount,0);assert.equal(refused.actionsCount,0);assert.equal(refused.global,null);assert.equal(refused.errorFocused,true);assert.equal(refused.date,'2011-12-30');assert.equal(refused.timeDisabled,true);assert.match(refused.place,/Apia/);assert.ok(refused.daily.every(x=>x.hidden));assert.equal(prefReads(),beforeRefusalReads);assert.equal(refused.events.filter(x=>x.type==='zodiacs:chart-computed').length,eventsBeforeSubmit);await page.screenshot({path:resolve(out,'refusal.png'),fullPage:true});
   await page.locator('#birth-date').fill('2011-12-31');await page.locator('.calc__submit').click();await page.locator('.calc__result').waitFor({state:'visible'});await page.waitForFunction(()=>window.zodiacsPostChartContext?.mode==='full');await page.locator('[data-post-chart-state="device-only"]').waitFor({state:'visible'});await settle();
