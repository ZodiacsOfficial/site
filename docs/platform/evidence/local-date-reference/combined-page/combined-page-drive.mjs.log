   assert.equal(recovered.profileWrites.length,initial.profileWrites.length);assert.equal(report.blockedMutations.length,1);assert.equal(report.requests.filter(r=>r.method==='POST'&&r.phase==='edit-refusal-recovery').length,0);assert.deepEqual(report.unexpected,[]);assert.deepEqual(report.pageErrors,[]);assert.deepEqual(report.requestFailures,[]);
   const refusalDiagnostics=report.consoleErrors.filter(x=>x.split('\n')[0]==='Error: Could not establish a calculation time within the local date.');const blockedDiagnostics=report.consoleErrors.filter(x=>x.startsWith('Failed to load resource: the server responded with a status of 418'));
   assert.equal(refusalDiagnostics.length,1);assert.equal(blockedDiagnostics.length,1);assert.equal(report.consoleErrors.length,2);report.expectedDiagnostics={sourceLoggedRefusal:refusalDiagnostics,locallyBlockedStartupSync:blockedDiagnostics};report.measurement={startupAttemptedPosts:1,startupBlockedPosts:1,flowAttemptedPosts:0,allNetworkIssuedMutations:0,allNetworkCompletedMutations:0,preferenceReadsBeforeRefusal:beforeRefusalReads,preferenceReadsAtRefusal:refused.preferenceReads,preferenceReadsAfterRecovery:recovered.preferenceReads,profileBytesUnchanged:true,flowProfileWrites:0};report.outcome='passed';
