import fs from 'node:fs';import {chromium} from 'playwright-core';let browser;const report={node:process.version,requests:[],pageErrors:[]};
try{browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking']});report.browser=browser.version();const context=await browser.newContext({locale:'ar-SA',timezoneId:'Pacific/Kiritimati'});await context.route('**/*',route=>{report.requests.push(route.request().url());return route.abort()});const page=await context.newPage();page.on('pageerror',e=>report.pageErrors.push(String(e)));await page.goto('about:blank');
 await page.evaluate(()=>{window.reviewImportStats={intl:0,fetch:0,storage:0,temporal:0};const intl=Intl.DateTimeFormat;window.restoreIntl=()=>Intl.DateTimeFormat=intl;Intl.DateTimeFormat=new Proxy(intl,{construct(t,a,n){reviewImportStats.intl++;return Reflect.construct(t,a,n)}});Object.defineProperty(globalThis,'Temporal',{configurable:true,get(){reviewImportStats.temporal++;throw Error('Unexpected Temporal read')}});for(const key of ['localStorage','sessionStorage','indexedDB'])Object.defineProperty(globalThis,key,{configurable:true,get(){reviewImportStats.storage++;throw Error('Unexpected storage')}});window.fetch=()=>{reviewImportStats.fetch++;throw Error('Unexpected fetch')}});
 await page.addScriptTag({content:fs.readFileSync('subject.js','utf8')});report.importEffects=await page.evaluate(()=>{const result={...reviewImportStats};window.restoreIntl();return result});if(Object.values(report.importEffects).some(x=>x!==0))throw Error('Import performed host work');
 await page.addScriptTag({content:fs.readFileSync('interval.js','utf8')});report.checks=await page.evaluate(()=>{const frame=document.createElement('iframe');document.body.appendChild(frame);const foreign=new frame.contentWindow.Date('2000-01-01T00:00:00.000Z');try{return helperSubject.runIndependentChecks(helperSubject,intervalSubject,foreign)}finally{frame.remove()}});report.afterEffects=await page.evaluate(()=>({...reviewImportStats}));if(report.pageErrors.length||report.requests.length)throw Error('Native page error/external request');report.outcome='passed';
}catch(error){report.error=String(error.stack??error);report.outcome='failed';process.exitCode=1}finally{await browser?.close();report.cleanup='Owned blank browser context closed; no server or permitted external request.';fs.writeFileSync('native-result.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({browser:report.browser,outcome:report.outcome,checks:report.checks?.checks,importEffects:report.importEffects,error:report.error}));}
