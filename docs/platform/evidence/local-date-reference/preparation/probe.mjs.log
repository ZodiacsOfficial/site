import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';import*as time from'./time-subject.mjs';import*as calculation from'./calculation-subject.mjs';
const cases=[['2011-12-30','Pacific/Apia'],['1993-08-21','Pacific/Kwajalein'],['1892-07-04','Pacific/Apia'],['2009-10-31','America/St_Johns'],['1919-03-31','America/Toronto'],['2026-03-08','America/New_York'],['2026-11-01','America/New_York'],['1986-01-01','Asia/Kathmandu'],['1914-01-01','America/Manaus'],['1990-01-04','Asia/Bangkok'],['1990-01-04','UTC'],['1990-01-04','+05:30']];
const admission=(date,zone,utc)=>{try{const actual=time.__reviewWallStringAt(zone,utc.getTime()).split('T')[0];return{status:actual===date?'witness':'different-date',actualDate:actual};}catch{return{status:'unresolved'};}};
const rows=cases.map(([date,zone])=>{const resolved=time.resolveLocalToUtc(date,'12:00',zone),witness=admission(date,zone,resolved.utc),input={utc:resolved.utc,latitude:0,longitude:0,houseSystem:'whole',timeKnown:false,flags:resolved.flags};const local={date,time:'12:00',timeZone:zone,offsetMinutes:resolved.offsetMinutes,reference:'local-noon'};
 const baselinePortable=calculation.computeCalculatorReceipt(input,local),baseline=baselinePortable?.chart??calculation.computeChart(input);let candidate=null,chartCalls=0,moonCalls=0,receiptCreated=false;
 if(witness.status==='witness'){chartCalls++;const portable=calculation.computeCalculatorReceipt(input,local);candidate=portable?.chart??calculation.computeChart(input);receiptCreated=!!portable;calculation.bodyLongitude('Moon',resolved.utc);calculation.bodyLongitude('Sun',resolved.utc);moonCalls+=2;}
 const parity=candidate===null?null:JSON.stringify(candidate)===JSON.stringify(baseline);if(candidate)assert.equal(parity,true);
 const intervals=time.resolveLocalDateIntervals(date,zone),endpoints=calculation.localDateEndpointsUtc(date,zone);
 return{date,zone,reference:'local-noon',resolvedUtc:resolved.utc.toISOString(),flags:resolved.flags,offsetMinutes:resolved.offsetMinutes,witness,intervals,baseline:{chartComputed:true,receiptCreated:!!baselinePortable,utc:baseline.input.utc.toISOString()},candidate:{chartCalls,moonReferenceCalls:moonCalls,receiptCreated,outputParity:parity},legacyEndpoints:{start:endpoints.start.toISOString(),end:endpoints.end.toISOString(),durationMs:endpoints.end-endpoints.start+1}};
});
for(const date of ['2011-12-30','1993-08-21']){const row=rows.find(r=>r.date===date);assert.equal(row.witness.status,'different-date');assert.equal(row.candidate.chartCalls,0);assert.equal(row.candidate.moonReferenceCalls,0);assert.equal(row.candidate.receiptCreated,false);}
for(const row of rows.filter(r=>!['2011-12-30','1993-08-21'].includes(r.date)))assert.equal(row.witness.status,'witness');
const edgeYears=['0000-02-29','0099-12-31','9999-12-31'].map(date=>{const resolved=time.resolveLocalToUtc(date,'12:00','UTC');const result=admission(date,'UTC',resolved.utc);assert.equal(result.status,'witness');return{date,utc:resolved.utc.toISOString(),result,numericsExecuted:false};});
const known=[['2011-12-30','12:00','Pacific/Apia'],['2026-03-08','02:30','America/New_York']].map(([date,clock,zone])=>{const resolved=time.resolveLocalToUtc(date,clock,zone);assert.ok(resolved.flags.includes('dst-gap'));return{date,time:clock,zone,utc:resolved.utc.toISOString(),flags:resolved.flags,dateAtReference:admission(date,zone,resolved.utc),unknownOnlyGuardApplied:false};});
const invalid=[['2026-02-30','UTC'],['1990-01-04',''],['1990-01-04','Invalid/Zone']].map(([date,zone])=>{let failed=false;try{time.resolveLocalToUtc(date,'12:00',zone);}catch{failed=true;}assert.equal(failed,true);return{date,zone,resolverRejectedBeforeCandidate:true};});
const output={at:new Date().toISOString(),node:process.version,icu:process.versions.icu,tz:process.versions.tz,nativeTemporalAvailable:time.createNativeTemporalTransitionProvider()!==null,method:'Actual current resolver/private Gregorian wall formatter, interval API, chart adapter and receipt module. Candidate guard exists only in this probe as a reference-date predicate before numerical calls; no product source implementation or rendered caller claim.',rows,edgeYears,known,invalid,limits:['witness proves at least one host-recognized instant belongs to the requested date, not the whole date or any body candidate completeness','different-date is failure of the chosen reference, not proof the requested date is empty','unresolved is formatter/provider inability, not empty','known-time resolver gap policy and positions-only imports remain separate','no date-only UTC calendar date is skipped; Moon no-city path retains UTC semantics']};fs.writeFileSync('result-'+process.version+'.json',JSON.stringify(output,null,2)+'\n');console.log(JSON.stringify({node:process.version,nativeTemporalAvailable:output.nativeTemporalAvailable,rows:rows.map(r=>({date:r.date,zone:r.zone,witness:r.witness,intervals:r.intervals.status,chartCalls:r.candidate.chartCalls,parity:r.candidate.outputParity}))}));
