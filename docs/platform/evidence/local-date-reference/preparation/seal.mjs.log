import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
const hash = b => createHash('sha256').update(b).digest('hex');
const root = '/Users/chiburashka/.codex/worktrees/4806/site';
const identity = JSON.parse(fs.readFileSync('identity.json', 'utf8'));
const current = identity.inputs.map(row => {
  const b = fs.readFileSync(path.join(root, row.path));
  assert.equal(hash(b), row.sha256, row.path);
  if (!row.path.startsWith('node_modules/')) assert.equal(hash(fs.readFileSync('source/' + row.path)), row.sha256, row.path);
  return { path: row.path, unchanged: true, sha256: hash(b) };
});
for (const row of identity.bundles) assert.equal(hash(fs.readFileSync(row.path)), row.sha256, row.path);
const extra = ['src/lib/share.ts', 'src/lib/i18n/ui/en.ts'];
for (const p of extra) {
  const b = fs.readFileSync(path.join(root, p));
  fs.mkdirSync(path.dirname('source/' + p), { recursive: true });
  fs.writeFileSync('source/' + p, b);
  current.push({ path: p, unchanged: true, sha256: hash(b), qualification: 'Additional read-only report source snapshot; not a probe build input.' });
}
fs.writeFileSync('source-verification.json', JSON.stringify({ at: new Date().toISOString(), current }, null, 2) + '\n');
const directories = [
  '../independent-counterexamples/delivery',
  '../independent-counterexamples/synthetic-addendum',
];
const linked = directories.map(dir => {
  const bytes = fs.readFileSync(path.join(dir, 'manifest.json'));
  const manifest = JSON.parse(bytes);
  const rows = manifest.records;
  let total = 0;
  for (const row of rows) {
    assert.ok(!path.isAbsolute(row.path) && !row.path.split('/').includes('..'));
    const b = fs.readFileSync(path.join(dir, row.path));
    assert.equal(b.length, row.bytes, row.path);
    assert.equal(hash(b), row.sha256, row.path);
    total += b.length;
  }
  return { path: path.resolve(dir), manifestSha256: hash(bytes), verifiedRecords: rows.length, verifiedBytes: total };
});
fs.writeFileSync('linked-evidence-verification.json', JSON.stringify({ at: new Date().toISOString(), linked }, null, 2) + '\n');
function walk(dir) {
  return fs.readdirSync(dir, { withFileTypes: true }).flatMap(entry => {
    const p = path.join(dir, entry.name);
    return entry.isDirectory() ? walk(p) : [p];
  });
}
const records = walk('.').filter(p => p !== 'manifest.json' && p !== 'seal.log').sort().map(p => {
  const b = fs.readFileSync(p);
  return { path: p, bytes: b.length, sha256: hash(b) };
});
const manifest = JSON.stringify({ records }, null, 2) + '\n';
fs.writeFileSync('manifest.json', manifest);
console.log(JSON.stringify({ records: records.length, bytes: records.reduce((n, r) => n + r.bytes, 0), manifestSha256: hash(Buffer.from(manifest)), linked }));
