import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{execFileSync}from'node:child_process';import{createHash}from'node:crypto';import{resolveOneTimeAllowance,oneTimeAllowancePath,parseNameStatus,protectedPathLabels}from'./guard-snapshot.mjs';
const proposal=process.argv[2];assert.ok(proposal,'provide exact proposed allowance JSON');const allowance=JSON.parse(fs.readFileSync(proposal,'utf8'));const root='/Users/chiburashka/.codex/worktrees/4806/site';const sha=b=>createHash('sha256').update(b).digest('hex');const actualBase=execFileSync('git',['rev-parse',allowance.baseCommit+'^{commit}'],{cwd:root,encoding:'utf8'}).trim();assert.equal(actualBase,allowance.baseCommit);const catalogPaths=['en','es','fr','it','pt','ru'].map(x=>'src/lib/i18n/ui/'+x+'.ts');assert.deepEqual(allowance.protectedPaths,catalogPaths);
const candidate='/private/tmp/zodiacs-platform-local-date-reference-evidence/frozen-source';const catalogProof=catalogPaths.map(p=>{const before=execFileSync('git',['show',actualBase+':'+p],{cwd:root,encoding:'utf8'}),after=fs.readFileSync(path.join(candidate,p),'utf8');const matches=after.match(/^  localDateReferenceError: .+\n/gm);assert.equal(matches?.length,1);assert.equal(after.replace(/^  localDateReferenceError: .+\n/gm,''),before);return{path:p,beforeSha256:sha(before),afterSha256:sha(after),onlyAddedLine:matches[0].trim()};});
const changed=[oneTimeAllowancePath,...catalogPaths,'src/lib/time/localToUtc.ts','docs/platform/STATUS.md'];const rows=[];function test(name,fn){fn();rows.push({name,passed:true});}
test('exact six-path allowance accepted at exact base',()=>assert.deepEqual([...resolveOneTimeAllowance({allowance,baseCommit:actualBase,changed})],catalogPaths));
test('stale base rejected',()=>assert.throws(()=>resolveOneTimeAllowance({allowance,baseCommit:'0'.repeat(40),changed}),/different base/));
test('extra protected locale rejected',()=>assert.throws(()=>resolveOneTimeAllowance({allowance,baseCommit:actualBase,changed:[...changed,'src/lib/i18n/other.ts']}),/exactly match/));
test('missing protected catalog rejected',()=>assert.throws(()=>resolveOneTimeAllowance({allowance,baseCommit:actualBase,changed:changed.filter(p=>p!==catalogPaths[0])}),/exactly match/));
test('duplicate catalog rejected',()=>assert.throws(()=>resolveOneTimeAllowance({allowance:{...allowance,protectedPaths:[...catalogPaths,catalogPaths[0]]},baseCommit:actualBase,changed}),/unique and sorted/));
test('unsorted catalog list rejected',()=>assert.throws(()=>resolveOneTimeAllowance({allowance:{...allowance,protectedPaths:[...catalogPaths].reverse()},baseCommit:actualBase,changed}),/unique and sorted/));
test('allowance inactive once its file leaves the compared change',()=>assert.equal(resolveOneTimeAllowance({allowance,baseCommit:actualBase,changed:changed.filter(p=>p!==oneTimeAllowancePath)}).size,0));
test('rename operands and deleted catalog remain protected',()=>{const paths=parseNameStatus('R100\0src/lib/i18n/ui/en.ts\0src/new-en.ts\0D\0src/lib/i18n/ui/ru.ts\0');assert.deepEqual(paths,['src/lib/i18n/ui/en.ts','src/new-en.ts','src/lib/i18n/ui/ru.ts']);assert.equal(paths.filter(p=>protectedPathLabels(p).length).length,2);});
fs.writeFileSync('scope-probe.json',JSON.stringify({node:process.version,proposal:sha(fs.readFileSync(proposal)),guard:sha(fs.readFileSync(new URL('./guard-snapshot.mjs',import.meta.url))),base:actualBase,catalogProof,rows,qualification:'Reads the actual exported guard functions and exact frozen catalog bytes; authorization comes from root-approved C014 policy, not this JSON marker. No product or allowance mutation.'},null,2)+'\n');console.log(JSON.stringify({passed:rows.length,catalogs:catalogProof.length,base:actualBase}));
