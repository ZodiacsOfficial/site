      let error; try { computePortableChart(base, context); } catch (caught) { error = caught; }
      assert(error?.message === 'Unable to prepare a portable chart.' && !('cause' in error), 'Fixed context error');
    }
    assert(reads === 0, 'Accessor never invoked');
  });
  run('canonical request reads raw input getters once', () => {
