    window.singleResult = result;
    return { bodies: result.chart.bodies.length, nativeReceiptBodies: result.envelope.result.bodies.length,
      houses: result.envelope.receipt.houses, engine: result.envelope.receipt.engine,
      instant: result.inputSnapshot.utc };
  } finally { phase = 'harness'; }
};
window.runCases = () => {
  const { computePortableChart, serializeNatalEnvelope, parseNatalEnvelope, natalReplayInput } = window.portableAPI;
  const run = (name, action) => {
    phase = 'calculation';
    try { const detail = action(); checks.push({ name, passed: true, ...(detail ? { detail } : {}) }); }
    catch (error) { checks.push({ name, passed: false, error: String(error) }); }
    finally { phase = 'harness'; }
  };
  run('complete receipt and compact chart retain the same full precision result', () => {
    const { chart, envelope } = window.singleResult;
    equal(envelope.receipt.engine, { name: '@zodiacs/engine', version: '0.1.1-rc.5' }, 'Exact engine candidate');
    assert(envelope.result.bodies.length === 12 && chart.bodies.length === 12, 'Twelve full bodies');
    assert(envelope.result.bodies.every((body) => typeof body.sign === 'string' && Number.isFinite(body.degree)), 'Native sign and degree retained');
    assert(chart.bodies.every((body) => !('sign' in body) && !('degree' in body)), 'Compact projection unchanged');
    equal(chart.bodies, envelope.result.bodies.map(({ body, lon, lat, speed, retrograde }) => ({ body, lon, lat, speed, retrograde })), 'Body values identical');
    for (const field of ['angles', 'houses', 'aspects']) equal(chart[field], envelope.result[field], `${field} full precision`);
    assert(chart.bodies.every((body) => ['lon', 'lat', 'speed'].every((key) => Number.isFinite(body[key]))), 'Finite numeric outputs');
    return { bodies: chart.bodies.length, aspects: chart.aspects.length, engineVersion: chart.engineVersion };
  });
  run('polar Placidus request survives actual Whole fallback', () => {
    const result = window.singleResult;
    equal(result.envelope.receipt.houses, { requested: 'placidus', actual: 'whole', absenceReason: null }, 'Requested versus actual');
    equal(result.chart.flags, ['polar-fallback'], 'One derived fallback flag');
    assert(result.inputSnapshot.houseSystem === 'placidus' && result.chart.input.houseSystem === 'placidus', 'Replay request retained');
  });
  run('unknown time keeps 08:30 and the explicit source ISO spelling', () => {
    const result = computePortableChart({ ...base, timeKnown: false }, { sourceInstant: base.utc });
    assert(result.envelope.receipt.instant === '2001-12-21T08:30:00.000Z' && result.envelope.receipt.sourceInstant === base.utc, 'Instant/source spelling preserved');
    assert(result.envelope.receipt.reference === 'supplied-instant', 'No noon inference');
    equal(result.envelope.receipt.houses, { requested: 'placidus', actual: null, absenceReason: 'unknown-time' }, 'No unknown-time houses');
    assert(result.chart.angles === null && result.chart.houses === null, 'No unknown-time angles');
    equal(result.chart.flags, ['no-time'], 'One no-time result');
    equal(result.inputSnapshot, natalReplayInput(result.envelope), 'Snapshot equals codec replay');
  });
  run('codec serializes and parses the frozen receipt without recalculation', () => {
    const result = window.singleResult;
    const encoded = serializeNatalEnvelope(result.envelope);
    const parsed = parseNatalEnvelope(encoded);
    assert(parsed.ok, 'Parser succeeded');
    equal(parsed.envelope, result.envelope, 'Full precision round trip');
    equal(natalReplayInput(parsed.envelope), result.inputSnapshot, 'Replay uses original request');
    return { encodedBytes: new TextEncoder().encode(encoded).length };
  });
  run('receipt and snapshot detach every mutable chart and input/context branch', () => {
    const date = new Date('2001-12-21T08:30:00Z');
    const input = { ...base, utc: date, flags: ['dst-fold'] };
    const context = { sourceInstant: base.utc, provenance: { runtime: { name: 'synthetic-runtime' } }, extensions: { value: ['synthetic'] } };
    const result = computePortableChart(input, context);
    const originalReceipt = serializeNatalEnvelope(result.envelope), originalSnapshot = canonical(result.inputSnapshot);
    assert(frozen(result.envelope) && frozen(result.inputSnapshot) && noDate(result.inputSnapshot), 'Frozen JSON, no mutable Date');
    assert(!Object.isFrozen(result.chart) && !Object.isFrozen(date) && !Object.isFrozen(context.extensions), 'Caller and presentation remain mutable');
