    for (const [key, value] of Object.entries(values)) Object.defineProperty(input, key, { get() {
      counts[key] = (counts[key] ?? 0) + 1; if (counts[key] !== 1) throw new Error('second input read'); return value;
    } });
    const result = computePortableChart(input);
    assert(Object.values(counts).every((count) => count === 1) && Object.keys(counts).length === 6, 'Exactly six single reads');
