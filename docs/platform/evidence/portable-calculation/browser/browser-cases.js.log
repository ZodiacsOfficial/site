window.negativeControls = () => {
  phase = 'negative-control';
  const controls = {
    fetch: () => fetch('/synthetic-observer'),
    XMLHttpRequest: () => new XMLHttpRequest(),
    WebSocket: () => new WebSocket('ws://127.0.0.1/synthetic-observer'),
    EventSource: () => new EventSource('/synthetic-observer'),
    Worker: () => new Worker('/synthetic-observer'),
    SharedWorker: () => new SharedWorker('/synthetic-observer'),
    sendBeacon: () => navigator.sendBeacon('/synthetic-observer', 'synthetic'),
    'localStorage.get': () => localStorage.getItem('synthetic'),
    'sessionStorage.get': () => sessionStorage.getItem('synthetic'),
    'Storage.setItem': () => localStorage.setItem('synthetic', 'synthetic'),
    'Storage.removeItem': () => localStorage.removeItem('synthetic'),
    'Storage.clear': () => localStorage.clear(),
    'Storage.key': () => localStorage.key(0),
    'indexedDB.open': () => indexedDB.open('synthetic'),
    'indexedDB.deleteDatabase': () => indexedDB.deleteDatabase('synthetic'),
    'indexedDB.databases': () => indexedDB.databases(),
    'caches.open': () => caches.open('synthetic'),
    'caches.match': () => caches.match('/synthetic'),
    'caches.delete': () => caches.delete('synthetic'),
    'caches.has': () => caches.has('synthetic'),
    'caches.keys': () => caches.keys(),
