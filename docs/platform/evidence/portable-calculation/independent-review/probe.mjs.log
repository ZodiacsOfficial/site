import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { readFile, writeFile } from 'node:fs/promises';
import { createRequire } from 'node:module';
import { dirname, relative, resolve } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

// All generated evidence is confined to this harness's directory. Product files
// are read only; the actual implementation and dependencies are bundled in memory.
const evidence = dirname(fileURLToPath(import.meta.url));
const checkout = resolve(process.argv[2] ?? '/private/tmp/zodiacs-platform-portable-calculation');
const authorEvidence = resolve(process.argv[3] ?? '/private/tmp/zodiacs-platform-portable-evidence');
const sha = (bytes) => createHash('sha256').update(bytes).digest('hex');
const expected = JSON.parse(await readFile(resolve(authorEvidence, 'identity.json'), 'utf8'));
const identities = {};
for (const [path, digest] of Object.entries(expected.files)) {
  const actual = sha(await readFile(resolve(checkout, path)));
  assert.equal(actual, digest, `Frozen source identity mismatch: ${path}`);
  identities[path] = actual;
}
const patchSha256 = sha(await readFile(resolve(authorEvidence, 'source.patch')));
assert.equal(patchSha256, expected.patchSha256);
assert.equal(patchSha256, '69a5fa55efbf961bb2760bffec4edfdc16ee6df575a84045961fe4e9ee5bbb45');
const artifactSha256 = sha(await readFile(resolve(checkout, 'vendor/zodiacs-engine-0.1.1-rc.5.tgz')));
assert.equal(artifactSha256, expected.installedEngineArtifactSha256);
const require = createRequire(resolve(checkout, 'package.json'));
const { build } = await import(pathToFileURL(require.resolve('esbuild')).href);
const bundled = await build({
  absWorkingDir: checkout,
  stdin: {
    contents: [
      "export { computePortableChart, PortableChartError } from './src/lib/engine/portable.ts';",
      "export { computeChart } from './src/lib/engine/full.ts';",
      "export { adaptChart } from './src/lib/engine/chart-adapter.ts';",
      "export { natalChart } from '@zodiacs/engine';",
      "export { computeChart as internalComputeChart } from '@zodiacs/engine/internal';",
      "export { serializeNatalEnvelope, natalReplayInput } from '@zodiacs/engine/receipt';",
    ].join('\n'),
    resolveDir: checkout, sourcefile: 'independent-portable-entry.ts', loader: 'ts',
  },
  bundle: true, platform: 'node', format: 'esm', write: false,
  metafile: true, logLevel: 'silent',
});
const api = await import('data:text/javascript;base64,' + Buffer.from(bundled.outputFiles[0].text).toString('base64'));
const loadedInputs = {};
for (const path of Object.keys(bundled.metafile.inputs)) {
  if (path === 'independent-portable-entry.ts') continue;
  loadedInputs[relative(checkout, resolve(checkout, path))] = sha(await readFile(resolve(checkout, path)));
}
const cases = [];
async function check(name, action) {
  try {
    const detail = await action();
    cases.push({ name, passed: true, ...(detail === undefined ? {} : { detail }) });
    console.log(`PASS ${name}`);
  } catch (error) {
    cases.push({ name, passed: false, error: { name: error.name, message: error.message } });
    console.log(`FAIL ${name}: ${error.message}`);
  }
}
const birth = { utc: '2001-12-21T08:30:00-00:00', latitude: 78.2232,
  longitude: 15.6267, houseSystem: 'placidus', timeKnown: true };
const frozen = (value) => value === null || typeof value !== 'object' ||
  (Object.isFrozen(value) && Object.values(value).every(frozen));

await check('historical year 0099 preserves the supplied year', () => {
  const result = api.computePortableChart({ utc: '0099-12-21T08:30:00Z', timeKnown: false });
  assert.equal(result.inputSnapshot.utc, '0099-12-21T08:30:00.000Z');
  assert.equal(result.chart.input.utc.getUTCFullYear(), 99);
  return { instant: result.inputSnapshot.utc };
});

await check('two calculations retain isolated receipt and snapshot state', () => {
  const first = api.computePortableChart(birth);
  const second = api.computePortableChart(birth);
  const before = api.serializeNatalEnvelope(second.envelope);
  const snapshot = JSON.stringify(second.inputSnapshot);
  assert.notEqual(first.chart, second.chart);
  assert.notEqual(first.envelope, second.envelope);
  first.chart.input.utc.setUTCFullYear(2026);
  first.chart.input.flags.push('lmt');
  first.chart.bodies[0].lon = 45;
  first.chart.flags.push('lmt');
  first.chart.houses.cusps[0] = 2;
  first.chart.angles.asc = 3;
  first.chart.aspects[0].orb = 4;
  assert.equal(api.serializeNatalEnvelope(second.envelope), before);
  assert.equal(JSON.stringify(second.inputSnapshot), snapshot);
});

await check('revoked context proxy produces only the fixed boundary error', () => {
  const context = Proxy.revocable({}, {});
  context.revoke();
  assert.throws(() => api.computePortableChart(birth, context.proxy), (error) => {
    assert.ok(error instanceof api.PortableChartError);
    assert.equal(error.message, 'Unable to prepare a portable chart.');
    assert.equal(error.code, 'calculation_failed');
    assert.equal('cause' in error, false);
    return true;
  });
});

await check('canonical snapshot has no Date and is recursively frozen', () => {
  const result = api.computePortableChart({ ...birth, flags: ['dst-fold'] });
  const walk = (value) => {
    assert.equal(value instanceof Date, false);
    if (value !== null && typeof value === 'object') Object.values(value).forEach(walk);
  };
  walk(result.inputSnapshot);
  assert.ok(frozen(result.inputSnapshot));
  assert.ok(frozen(result.envelope));
  assert.deepEqual(JSON.parse(JSON.stringify(result.inputSnapshot)), result.inputSnapshot);
  assert.deepEqual(result.inputSnapshot, api.natalReplayInput(result.envelope));
});

await check('context timing is explicitly after calculation, not atomic entry capture', () => {
  const context = { sourceInstant: birth.utc, extensions: { captured: 'before' } };
  const input = { ...birth, get utc() {
    context.sourceInstant = '2001-12-21T08:30:00Z';
    context.extensions.captured = 'after';
    return birth.utc;
  } };
  const result = api.computePortableChart(input, context);
  assert.equal(result.envelope.extensions.captured, 'after');
  assert.equal(result.envelope.receipt.sourceInstant, '2001-12-21T08:30:00Z');
  context.extensions.captured = 'later';
  assert.equal(result.envelope.extensions.captured, 'after');
  return { boundary: 'Caller input getters can mutate context before its post-calculation snapshot.' };
});

await check('each raw birth property is read once before canonical projection', () => {
  const fields = { ...birth, flags: ['dst-fold'] };
  const counts = {};
  const input = {};
  for (const [key, value] of Object.entries(fields)) Object.defineProperty(input, key, {
    get() { counts[key] = (counts[key] ?? 0) + 1; assert.equal(counts[key], 1); return value; },
  });
  const result = api.computePortableChart(input);
  assert.deepEqual(counts, Object.fromEntries(Object.keys(fields).map((key) => [key, 1])));
  assert.equal(result.inputSnapshot.houseSystem, 'placidus');
  return { counts };
});

await check('context accessor is rejected without invocation', () => {
  let calls = 0;
  const context = Object.defineProperty({}, 'sourceInstant', { enumerable: true,
    get() { calls++; throw new Error('synthetic private sentinel'); } });
  assert.throws(() => api.computePortableChart(birth, context), api.PortableChartError);
  assert.equal(calls, 0);
});

await check('frozen receipt detaches every mutable chart branch and caller context', () => {
  const input = { ...birth, utc: new Date(birth.utc), flags: ['dst-fold'] };
  const context = { sourceInstant: birth.utc,
    provenance: { runtime: { name: 'independent-test' } }, extensions: { labels: ['synthetic'] } };
  const result = api.computePortableChart(input, context);
  const before = api.serializeNatalEnvelope(result.envelope);
  const snapshot = JSON.stringify(result.inputSnapshot);
  input.utc.setUTCFullYear(2020); input.latitude = 0; input.flags.push('lmt');
  context.provenance.runtime.name = 'changed'; context.extensions.labels[0] = 'changed';
  result.chart.input.utc.setUTCFullYear(2021); result.chart.input.latitude = 1;
  result.chart.input.flags.push('lmt'); result.chart.flags.push('lmt');
  result.chart.bodies[0].lon = 1; result.chart.houses.cusps[0] = 2;
  result.chart.angles.asc = 3; result.chart.aspects[0].orb = 4;
  assert.equal(api.serializeNatalEnvelope(result.envelope), before);
  assert.equal(JSON.stringify(result.inputSnapshot), snapshot);
  assert.equal(Object.isFrozen(result.chart), false);
  assert.equal(Object.isFrozen(context), false);
  assert.equal(Reflect.set(result.envelope.result.bodies[0], 'lon', 42), false);
});

await check('polar and unknown-time receipts preserve request, actual outcome and source spelling', () => {
  for (const timeKnown of [true, false]) {
    const result = api.computePortableChart({ ...birth, timeKnown }, { sourceInstant: birth.utc });
    assert.equal(result.envelope.receipt.houses.requested, 'placidus');
    assert.equal(result.envelope.receipt.houses.actual, timeKnown ? 'whole' : null);
    assert.equal(result.envelope.receipt.houses.absenceReason, timeKnown ? null : 'unknown-time');
    assert.equal(result.inputSnapshot.houseSystem, 'placidus');
    assert.equal(result.inputSnapshot.utc, '2001-12-21T08:30:00.000Z');
    assert.equal(result.envelope.receipt.sourceInstant, birth.utc);
    assert.equal(result.envelope.receipt.reference, 'supplied-instant');
    assert.deepEqual(result.chart.flags, [timeKnown ? 'polar-fallback' : 'no-time']);
  }
});

await check('shared full adapter preserves original input identity and numerical reference semantics', () => {
  const input = { ...birth, utc: new Date(birth.utc), flags: ['dst-fold'] };
  const native = api.internalComputeChart(input);
  const projected = api.adaptChart(native, input);
  const full = api.computeChart(input);
  const expectedCompact = { input,
    bodies: native.bodies.map(({ body, lon, lat, speed, retrograde }) => ({ body, lon, lat, speed, retrograde })),
    angles: native.angles, houses: native.houses, aspects: native.aspects,
    flags: [...native.flags], engineVersion: native.engineVersion };
  assert.equal(projected.input, input); assert.equal(full.input, input);
  assert.equal(projected.angles, native.angles); assert.equal(projected.houses, native.houses);
  assert.equal(projected.aspects, native.aspects); assert.notEqual(projected.flags, native.flags);
  assert.notEqual(projected.bodies, native.bodies);
  assert.deepEqual(projected, expectedCompact); assert.deepEqual(full, expectedCompact);
});

await check('unknown-time noon and known-time missing location do not fabricate context', () => {
  for (const input of [{ utc: '2001-12-21T12:00:00Z', timeKnown: false },
    { utc: '2001-12-21T08:30:00Z', timeKnown: true }]) {
    const { receipt } = api.computePortableChart(input).envelope;
    assert.equal(receipt.reference, 'supplied-instant');
    assert.equal(receipt.sourceInstant, null); assert.equal(receipt.provenance, null);
    assert.equal(receipt.localResolution, null); assert.equal(receipt.coordinates, null);
    assert.equal(receipt.houses.actual, null);
    assert.equal(receipt.houses.absenceReason, input.timeKnown ? 'missing-location' : 'unknown-time');
  }
});

for (const [path, digest] of Object.entries(identities)) {
  assert.equal(sha(await readFile(resolve(checkout, path))), digest, `Source changed during review: ${path}`);
}
const result = { timestamp: new Date().toISOString(), checkout,
  runtime: { node: process.version, platform: process.platform, architecture: process.arch,
    icu: process.versions.icu, tzdb: process.versions.tz },
  summary: { passed: cases.filter((item) => item.passed).length,
    failed: cases.filter((item) => !item.passed).length }, cases };
await writeFile(resolve(evidence, 'result.json'), JSON.stringify(result, null, 2) + '\n');
await writeFile(resolve(evidence, 'identities.json'), JSON.stringify({
  patchSha256, artifactSha256, authorIdentitySha256: sha(await readFile(resolve(authorEvidence, 'identity.json'))),
  sourceFiles: identities, loadedInputs, bundleSha256: sha(bundled.outputFiles[0].contents),
  harnessSha256: sha(await readFile(fileURLToPath(import.meta.url))),
  sourceUnchangedAfterRun: true,
}, null, 2) + '\n');
console.log(JSON.stringify(result.summary));
if (result.summary.failed) process.exitCode = 1;
