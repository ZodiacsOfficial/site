import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
if(process.env.ZODIACS_EXECUTE_PREVIEW!=='1')throw Error('Preview execution is disabled; exact READY target and explicit execution flag required.');
const {chromium}=await import('playwright-core');
const {parseNatalEnvelope}=await import('@zodiacs/engine/receipt');
const {findChromium,STABLE_CHROMIUM_ARGS,isSiteFooterIconTeardownAbort}=await import('./source/tests/visual/browser.mjs');
const origin='https://zodiacs-et5nq8c46-zodiacsofficial.vercel.app';
const commit='9d180c9f1a2f66893ccd6d73fcda106cb3894674';
const provider=JSON.parse(fs.readFileSync('deployment-before.json','utf8'));
assert.equal(provider.id,'dpl_DCezqWrsukzWV3F7NotmTQCq4ENp');assert.equal(provider.readyState??provider.state,'READY');assert.equal(provider.target,null);
assert.equal(provider.meta.githubCommitSha,commit);assert.equal(provider.meta.githubPrId,'437');assert.equal('https://'+provider.url,origin);
const out=process.env.OUT_DIR;if(!out)throw Error('OUT_DIR required');fs.mkdirSync(out,{recursive:false});
const hash=b=>createHash('sha256').update(b).digest('hex');
const resolve=path.resolve,readFile=fs.promises.readFile,sha=hash;
const sourceSnapshot=JSON.parse(fs.readFileSync('source-snapshot.json','utf8'));
assert.equal(sourceSnapshot.commit,commit);assert.equal(sourceSnapshot.frozenProductFilesMatched,16);
for(const row of sourceSnapshot.records)assert.equal(hash(fs.readFileSync('source/'+row.path)),row.sha256);
fs.mkdirSync(out+'/remote-modules');fs.mkdirSync(out+'/remote-data');
const report={at:new Date().toISOString(),node:process.version,sourceCommit:commit,sourceSnapshot,origin,providerId:provider.id,checks:[],requests:[],responses:[],modules:{},data:{},outcome:'failed',qualification:'Actual remote preview and native form/city controls. Passive chart events only; no source, engine, resolver, date, loader or network-result injection. No numerical-call counts or complete-date/candidate claim. The visible unknown-time Moon admission is unverified; the receipt preserves a single reference. No whole-date numerical oracle, false-Sun example, endpoint call-count or controlled ownership-race claim. No MoonPhaseTool coverage. External/non-GET/API requests blocked. Separate unobserved isolated auth bootstrap.'};
let browser,cookies=[];const pending=[],contexts=new Set();
const unverified={en:'The Moon’s possible signs across this birth date are unverified. Add a birth time for a result at that moment.',ru:'Возможные знаки Луны в течение этой даты рождения не проверены. Укажите время рождения, чтобы получить результат для конкретного момента.'};
const needsTime={en:'Needs a birth time',ru:'Нужно время рождения'};
const expected={
 en:'We couldn’t establish a calculation time within this local date. Check the date and place.',
 es:'No pudimos establecer una hora de cálculo dentro de esta fecha local. Comprueba la fecha y el lugar.',
 fr:'Nous n’avons pas pu déterminer une heure de calcul correspondant à cette date locale. Vérifie la date et le lieu.',
 it:'Non è stato possibile stabilire un orario di calcolo all’interno di questa data locale. Controlla la data e il luogo.',
 pt:'Não foi possível estabelecer um horário de cálculo dentro desta data local. Verifique a data e o local.',
 ru:'Не удалось определить время для расчёта в пределах этой местной даты. Проверьте дату и место.',
};
const actionSelector='[data-share-card],[data-save-chart],[data-share-options],[data-download-calculation-receipt],[data-chart-more],[data-registry-bridge]';
async function settle(page){await page.evaluate(()=>new Promise(done=>requestAnimationFrame(()=>requestAnimationFrame(done))));}
async function snapshot(page,mode){return page.evaluate(({mode,actionSelector})=>({
 date:document.querySelector(mode==='chart'?'#birth-date':'#mp-date')?.value,
 time:document.querySelector(mode==='chart'?'#birth-time':'#mp-time')?.value,
 unknown:mode==='chart'?document.querySelector('.field__toggle input[type=checkbox]')?.checked:document.querySelector('#mp-time')?.value==='',
 place:document.querySelector(mode==='chart'?'#place':'#mp-place')?.value,
 result:!!document.querySelector('.calc__result'),
 resultText:document.querySelector('.calc__result')?.textContent?.trim()??null,
 moonUncertain:!!document.querySelector('[data-moon-uncertain]'),
 registry:document.querySelector('[data-registry-bridge]')?{sign:document.querySelector('[data-registry-bridge]').getAttribute('data-registry-bridge-sign'),href:document.querySelector('[data-registry-bridge] a')?.getAttribute('href')}:null,
 error:document.querySelector('.calc__form .calc__error[role=alert]')?.textContent??null,
 busy:document.querySelector('.calc__form')?.getAttribute('aria-busy'),
 actions:document.querySelectorAll(actionSelector).length,
 context:window.zodiacsPostChartContext??null,
 focus:{tag:document.activeElement?.tagName,id:document.activeElement?.id,role:document.activeElement?.getAttribute('role'),text:document.activeElement?.textContent?.trim()},
 noSavedProfile:localStorage.getItem('zodiacs.profile.v1')===null,
 overflow:document.documentElement.scrollWidth>innerWidth+1,
}),{mode,actionSelector});}
async function capture(page,name){const path=resolve(out,name+'.png');await page.screenshot({path,fullPage:false,animations:'disabled'});const bytes=await readFile(path);return {path:name+'.png',bytes:bytes.length,sha256:sha(bytes)};}
async function cleared(page,mode){
 await page.waitForFunction(selector=>!document.querySelector('.calc__result')&&!document.querySelector(selector)&&window.zodiacsPostChartContext===undefined,actionSelector);
 const value=await snapshot(page,mode);assert.equal(value.result,false);assert.equal(value.actions,0);assert.equal(value.context,null);assert.equal(value.busy,'false');assert.equal(value.noSavedProfile,true);return value;
}
async function success(page,mode){
 await page.locator('.calc__submit').click();await page.locator('.calc__result').waitFor({state:'visible'});
 await page.waitForFunction(()=>document.querySelector('.calc__form')?.getAttribute('aria-busy')==='false'&&document.activeElement===document.querySelector('.calc__result h2'));
 if(mode==='chart'){
  await page.locator('[data-save-chart]').first().waitFor({state:'attached'});
  await page.locator('[data-download-calculation-receipt]').waitFor({state:'attached'});
  await page.waitForFunction(()=>window.zodiacsPostChartContext?.mode==='full');
  assert.equal(await page.locator('[data-download-calculation-receipt]').isEnabled(),true);
 }
 await settle(page);const value=await snapshot(page,mode);assert.ok(value.resultText);assert.equal(value.error,null);assert.equal(value.noSavedProfile,true);assert.equal(value.overflow,false);if(mode==='chart')assert.ok(value.actions>0);return value;
}

async function setup(name,mode,width){
 const context=await browser.newContext({viewport:{width,height:1000},reducedMotion:'reduce',timezoneId:'UTC',serviceWorkers:'block',acceptDownloads:true});contexts.add(context);context.setDefaultTimeout(20000);await context.addCookies(cookies);
 const row={name,mode,width,pageErrors:[],consoleErrors:[],browserRequests:[],blocked:[],requestFailures:[],screenshots:[],passed:false};
 await context.route('**/*',async route=>{const r=route.request(),u=new URL(r.url()),blocked=u.origin!==origin||r.method()!=='GET'||u.pathname.startsWith('/api/');row.browserRequests.push({method:r.method(),origin:u.origin,path:u.pathname,blocked});if(blocked){row.blocked.push({method:r.method(),origin:u.origin,path:u.pathname,reason:r.method()!=='GET'?'non-GET':u.origin!==origin?'external':'api'});return route.abort('blockedbyclient');}return route.continue();});
 await context.addInitScript(()=>{window.__datePreviewEvents={computed:[],cleared:[]};addEventListener('zodiacs:chart-computed',e=>window.__datePreviewEvents.computed.push(e.detail));addEventListener('zodiacs:chart-context-cleared',e=>window.__datePreviewEvents.cleared.push({type:e.constructor.name,detail:typeof e.detail,contextAbsent:window.zodiacsPostChartContext===undefined}));});
 const page=await context.newPage();page.on('pageerror',e=>row.pageErrors.push(String(e)));page.on('console',m=>{if(m.type()==='error')row.consoleErrors.push({text:m.text(),location:m.location()});});
 page.on('request',r=>{const u=new URL(r.url());report.requests.push({case:name,method:r.method(),origin:u.origin,path:u.pathname});});
 page.on('requestfailed',r=>{const u=new URL(r.url());row.requestFailures.push({origin:u.origin,path:u.pathname,method:r.method(),error:r.failure()?.errorText,knownFooterTeardown:isSiteFooterIconTeardownAbort(r)});});
 page.on('response',response=>{const u=new URL(response.url());if(u.origin!==origin)return;pending.push((async()=>{try{const bytes=await response.body(),identity={path:u.pathname,bytes:bytes.length,sha256:hash(bytes)};report.responses.push({case:name,status:response.status(),...identity});if(response.status()===200&&u.pathname.endsWith('.js')){if(report.modules[u.pathname])assert.deepEqual(report.modules[u.pathname],identity);else{report.modules[u.pathname]=identity;fs.writeFileSync(out+'/remote-modules/'+path.basename(u.pathname),bytes);}}if(response.status()===200&&u.pathname.startsWith('/data/cities/')){if(report.data[u.pathname])assert.deepEqual(report.data[u.pathname],identity);else{report.data[u.pathname]=identity;fs.writeFileSync(out+'/remote-data/'+path.basename(u.pathname),bytes);}}}catch(e){report.responses.push({case:name,path:u.pathname,status:response.status(),bodyUnavailable:true,error:String(e)});}})());});
 return {page,context,row};
}
async function finish(s){
 const {page,context,row}=s;await Promise.allSettled(pending);row.events=await page.evaluate(()=>window.__datePreviewEvents);row.final=await snapshot(page,row.mode);assert.equal(row.final.noSavedProfile,true);assert.deepEqual(row.pageErrors,[]);
 assert.equal(row.browserRequests.filter(r=>r.method!=='GET'||r.path.startsWith('/api/')).length,0);
 const unexpected=row.requestFailures.filter(f=>!f.knownFooterTeardown&&!row.blocked.some(b=>b.origin===f.origin&&b.path===f.path&&b.method===f.method));assert.deepEqual(unexpected,[]);
 const expectedErrors=row.consoleErrors.filter(e=>e.text.split('\n')[0]==='Error: Could not establish a calculation time within the local date.');
 const other=row.consoleErrors.filter(e=>!expectedErrors.includes(e)&&!row.blocked.some(b=>e.location?.url===b.origin+b.path)&&!e.text.startsWith('Failed to load resource: net::ERR_BLOCKED_BY_CLIENT'));
 assert.deepEqual(other,[]);row.expectedRefusalDiagnostics=expectedErrors.length;row.passed=true;
}
async function test(name,mode,width,run){if(process.env.REVIEW_CASE_PREFIX&&!name.startsWith(process.env.REVIEW_CASE_PREFIX))return;const s=await setup(name,mode,width);try{await run(s);await finish(s);}catch(e){s.row.failure=String(e.stack??e);s.row.failureState=await snapshot(s.page,mode).catch(()=>null);s.row.screenshots.push(await capture(s.page,name+'-failure').catch(e=>({error:String(e)})));}finally{await s.context.close();contexts.delete(s.context);s.row.contextClosed=true;fs.writeFileSync(out+'/'+name+'.json',JSON.stringify(s.row,null,2)+'\n');report.checks.push(s.row);console.log(JSON.stringify({name,passed:s.row.passed,failure:s.row.failure?.split('\n')[0]}));}}
async function openPage(s,locale,mode,url){const route=(locale==='en'?'':'/'+locale)+(mode==='chart'?'/birth-chart/':'/moon-phase/');s.row.path=route;const response=await s.page.goto(url??origin+route,{waitUntil:'domcontentloaded',timeout:45000});assert.equal(response.status(),200);await s.page.locator(mode==='chart'?'#birth-date':'#mp-date').focus();await s.page.locator(`astro-island[component-url*="${mode==='chart'?'ChartCalculator':'MoonPhaseTool'}"]:not([ssr])`).waitFor();}
async function chooseCity(s,name,zone){
 const place=s.page.locator('#place');if(await place.getAttribute('readonly')!==null)await s.page.locator('.place__clear').first().click();
 await s.page.locator('#place').fill(name);await s.page.getByRole('option').filter({has:s.page.locator('.place__name',{hasText:new RegExp('^'+name+'$')})}).first().waitFor();
 await Promise.allSettled(pending);const shard=name[0].toLowerCase()+'.json';
 const index=JSON.parse(fs.readFileSync(out+'/remote-data/index.json')),rows=JSON.parse(fs.readFileSync(out+'/remote-data/'+shard));
 const matches=rows.filter(r=>r[0]===name&&index.tz[r[6]]===zone);assert.equal(matches.length,1,'Unique actual city/zone row');
 const a=matches[0],city={name:a[0],admin:index.admin1[a[2]],country:index.countries[a[3]],lat:a[4]/100,lon:a[5]/100,zone:index.tz[a[6]],shard};
 const meta=[city.admin,city.country].filter(Boolean).join(', '),chip=[city.name,meta].filter(Boolean).join(' · ');
 const option=s.page.getByRole('option').filter({has:s.page.locator('.place__name',{hasText:new RegExp('^'+name+'$')})}).filter({has:s.page.locator('.place__meta',{hasText:meta})});assert.equal(await option.count(),1);city.observedOption=await option.innerText();await option.click();
 assert.equal(await s.page.locator('#place').inputValue(),chip);assert.equal(await s.page.locator('#place').getAttribute('readonly'),'');s.row.offlineCities??=[];s.row.offlineCities.push(city);return city;
}
async function downloadReceipt(s,label,date,zone,timeKnown){
 const details=s.page.locator('[data-chart-more]');if(await details.getAttribute('open')===null){await details.locator(':scope > summary').focus();await s.page.keyboard.press('Enter');}
 const button=s.page.locator('[data-download-calculation-receipt]');assert.equal(await button.isEnabled(),true);const downloadPromise=s.page.waitForEvent('download');await button.focus();await s.page.keyboard.press('Enter');const download=await downloadPromise;assert.equal(download.suggestedFilename(),'zodiacs-calculation-receipt.json');
 const file=s.row.name+'-'+label+'-receipt.json';await download.saveAs(out+'/'+file);const bytes=fs.readFileSync(out+'/'+file),parsed=parseNatalEnvelope(bytes.toString());assert.equal(parsed.ok,true);
 const receipt=parsed.envelope.receipt;assert.equal(receipt.engine.version,'0.1.1-rc.6');assert.equal(receipt.timeKnown,timeKnown);assert.equal(receipt.localResolution.date,date);assert.equal(receipt.localResolution.timeZone,zone);assert.equal(receipt.localResolution.time,timeKnown?'08:30':'12:00');assert.equal(receipt.reference,timeKnown?'supplied-instant':'local-noon');if(!timeKnown){assert.equal(receipt.houses.absenceReason,'unknown-time');assert.equal(parsed.envelope.result.angles,null);}
 s.row.receipts??=[];s.row.receipts.push({file,sha256:hash(bytes),bytes:bytes.length,receipt,moon:parsed.envelope.result.bodies.find(b=>b.body==='Moon')});return parsed.envelope;
}
async function unknownConfidence(s,locale){
 const card=s.page.locator('.calc__three [data-moon-uncertain]');assert.equal(await card.count(),1);assert.equal(await card.isVisible(),true);assert.equal(await card.locator('a,.three-card__deg').count(),0);
 assert.ok((await card.innerText()).includes(needsTime[locale]));assert.ok((await s.page.locator('.calc__result').innerText()).includes(unverified[locale]));assert.equal(await s.page.locator('[data-registry-bridge]').count(),0);
}
try{
 browser=await chromium.launch({executablePath:await findChromium(),headless:true,args:STABLE_CHROMIUM_ARGS});report.browser=browser.version();const bootstrap=await browser.newContext();try{const auth=JSON.parse(fs.readFileSync(process.env.ZODIACS_PREVIEW_AUTH_FILE,'utf8')),page=await bootstrap.newPage();await page.goto(auth.url,{waitUntil:'networkidle',timeout:60000});cookies=await bootstrap.cookies();report.authBootstrap={isolated:true,observed:false,completed:true};}catch{throw Error('Protected preview bootstrap failed');}finally{await bootstrap.close();}
 for(const locale of ['en','ru'])for(const width of [1280,390])await test(`${locale}-chart-${width}`,'chart',width,async s=>{
  const {page,row}=s;row.locale=locale;await openPage(s,locale,'chart');const date=page.locator('#birth-date'),time=page.locator('#birth-time'),unknown=page.locator('.field__toggle input[type=checkbox]');
  await time.fill('08:30');await unknown.check();row.historical=[];
  for(const c of [{name:'Toronto',zone:'America/Toronto',date:'1919-03-31'},{name:'Juneau',zone:'America/Juneau',date:'1867-10-18'}]){
   await date.fill(c.date);await chooseCity(s,c.name,c.zone);await cleared(page,'chart');const value=await success(page,'chart');await unknownConfidence(s,locale);const envelope=await downloadReceipt(s,c.name.toLowerCase(),c.date,c.zone,false);row.historical.push({input:c,state:value,referenceInstant:envelope.receipt.instant});row.screenshots.push(await capture(page,row.name+'-'+c.name.toLowerCase()));
  }
  await date.fill('1990-06-15');await unknown.uncheck();await time.fill('08:30');await chooseCity(s,'Toronto','America/Toronto');await cleared(page,'chart');row.known=await success(page,'chart');assert.equal(row.known.unknown,false);assert.equal(await page.locator('[data-moon-uncertain]').count(),0);assert.equal(await page.locator('[data-registry-bridge]').count(),1);assert.equal(row.known.registry.sign,'gemini');assert.ok(row.known.registry.href.endsWith('/registry/gemini/'));await downloadReceipt(s,'known','1990-06-15','America/Toronto',true);row.screenshots.push(await capture(page,row.name+'-known'));
  await date.fill('2011-12-30');await unknown.check();await chooseCity(s,'Apia','Pacific/Apia');row.edited=await cleared(page,'chart');const computedBefore=await page.evaluate(()=>window.__datePreviewEvents.computed.length);await page.locator('.calc__submit').click();const error=page.locator('.calc__form .calc__error[role=alert]');await error.waitFor();await page.waitForFunction(()=>document.activeElement===document.querySelector('.calc__form .calc__error[role=alert]')&&document.querySelector('.calc__form')?.getAttribute('aria-busy')==='false');row.refused=await cleared(page,'chart');assert.equal(row.refused.error,expected[locale]);assert.equal(row.refused.date,'2011-12-30');assert.equal(row.refused.focus.role,'alert');assert.equal(row.refused.overflow,false);assert.equal(await page.evaluate(()=>window.__datePreviewEvents.computed.length),computedBefore);row.screenshots.push(await capture(page,row.name+'-refused'));
  await date.fill('2011-12-31');await settle(page);row.beforeRetry=await cleared(page,'chart');assert.equal(row.beforeRetry.error,expected[locale]);assert.equal(row.beforeRetry.focus.id,'birth-date');row.recovered=await success(page,'chart');await unknownConfidence(s,locale);await downloadReceipt(s,'recovered','2011-12-31','Pacific/Apia',false);row.screenshots.push(await capture(page,row.name+'-recovered'));
 });
 for(const locale of ['en','ru'])for(const width of [1280,390])await test(`${locale}-positions-${width}`,'chart',width,async s=>{
  const token='2.'+Buffer.from(JSON.stringify({b:Array.from({length:12},(_,i)=>i*27),h:'w',v:'0.1.1-rc.6'})).toString('base64url');await openPage(s,locale,'chart',origin+(locale==='en'?'':'/'+locale)+'/birth-chart/#p='+token);await s.page.locator('[data-positions-only]').waitFor();assert.equal(await s.page.locator('[data-calculation-receipt-export],[data-registry-bridge]').count(),0);assert.equal(await s.page.evaluate(()=>window.__datePreviewEvents.computed.length),0);assert.ok(!s.row.browserRequests.some(r=>/\/(?:calculator-receipt|chart-adapter|full)\./.test(r.path)));s.row.positionsOnly=true;s.row.screenshots.push(await capture(s.page,s.row.name));
 });
 report.outcome=report.checks.length===(process.env.REVIEW_CASE_PREFIX?2:8)&&report.checks.every(r=>r.passed)?'passed':'failed';
}catch(e){report.failure=String(e.stack??e);}finally{for(const context of contexts)await context.close().catch(()=>{});await browser?.close();await Promise.allSettled(pending);cookies=[];report.cleanup={contextsClosed:true,browserClosed:true,localServerStarted:false};report.driverSha256=hash(fs.readFileSync(new URL(import.meta.url)));fs.writeFileSync(out+'/result.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({groups:report.checks.length,passed:report.checks.filter(r=>r.passed).length,outcome:report.outcome}));if(report.outcome!=='passed')process.exitCode=1;}
