 check('provider exact immutable READY preview identity',provider['id']=='dpl_DCezqWrsukzWV3F7NotmTQCq4ENp' and provider['meta']['githubCommitSha']==base and provider['meta']['githubPrId']=='437' and provider.get('readyState',provider.get('state'))=='READY' and provider['target'] is None)
