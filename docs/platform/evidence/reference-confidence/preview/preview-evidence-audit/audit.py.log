from pathlib import Path
import json,hashlib,subprocess,shutil,difflib
r=Path(__file__).resolve().parent.parent;d=Path(__file__).resolve().parent
base='9d180c9f1a2f66893ccd6d73fcda106cb3894674';git='/Users/chiburashka/.codex/worktrees/4806/site'
