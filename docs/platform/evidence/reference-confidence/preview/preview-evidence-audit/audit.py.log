expected=old.replace("async function test(name,mode,width,run){const s=", "async function test(name,mode,width,run){if(process.env.REVIEW_CASE_PREFIX&&!name.startsWith(process.env.REVIEW_CASE_PREFIX))return;const s=").replace("const card=s.page.locator('[data-moon-uncertain]');", "const card=s.page.locator('.calc__three [data-moon-uncertain]');").replace("report.checks.length===8&&", "report.checks.length===(process.env.REVIEW_CASE_PREFIX?2:8)&&")
check('complete driver correction equals only selector scope + bounded rerun selection/count',new==expected)
(d/'driver.diff').write_text(''.join(difflib.unified_diff(old.splitlines(True),new.splitlines(True),fromfile='initial',tofile='corrected')))
reading=(r/'ReadingPath.exact.tsx.log').read_bytes();raw=subprocess.run(['git','show',base+':src/islands/explorer/ReadingPath.tsx'],cwd=git,capture_output=True);check('ReadingPath exact source contains independent uncertainty marker',raw.returncode==0 and raw.stdout==reading and b'reading-path__big-tile--missing" data-moon-uncertain' in reading)
snapshot=read('source-snapshot.json');frozen=read('freeze2-identity.json')['files'];source=[]
for row in snapshot['records']:
 p=row['path'];raw=subprocess.run(['git','show',base+':'+p],cwd=git,capture_output=True);assert raw.returncode==0
 data=(r/'source'/p).read_bytes();assert raw.stdout==data and sha(data)==row['sha256'];blob=hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest();assert blob==row['gitBlob'];source.append({'path':p,'sha256':row['sha256'],'gitBlob':blob})
 for expectedPath,identity in frozen.items():
  if p==expectedPath:assert sha(data)==identity['sha256']
check('28 source blobs match exact Git objects; all 16 frozen files present',len(source)==28 and set(frozen)<=set(x['path'] for x in source))
check('initial outcome remains six accepted of eight; corrected outcome is two of two',a['outcome']=='failed' and len(a['checks'])==8 and sum(x['passed'] for x in a['checks'])==6 and b['outcome']=='passed' and len(b['checks'])==2 and all(x['passed'] for x in b['checks']))
failed=[x for x in a['checks'] if not x['passed']];check('two initial failures are exactly English hero-marker 2-vs-1 assertions',set(x['name'] for x in failed)=={'en-chart-1280','en-chart-390'} and all('2 !== 1' in x['failure'] and 'unknownConfidence' in x['failure'] for x in failed))
accepted=[('browser-run1',x) for x in a['checks'] if x['passed']]+[('browser-run2',x) for x in b['checks'] if x['passed']]
names=[x['name'] for _,x in accepted];expectedNames={f'{locale}-{mode}-{width}' for locale in ['en','ru'] for mode in ['chart','positions'] for width in [1280,390]};check('eight distinct accepted groups cover EN/RU x chart/positions x two widths',len(names)==8 and set(names)==expectedNames)
missing=[x for run in [a,b] for x in run['responses'] if x.get('bodyUnavailable')]
check('exactly four unavailable 200 image bodies; zero missing JS/city bodies',len(missing)==4 and all(x['status']==200 and x['path'] in ['/assets/app-icons/v3/icon-512.png','/assets/guide-avatar.webp'] for x in missing))
