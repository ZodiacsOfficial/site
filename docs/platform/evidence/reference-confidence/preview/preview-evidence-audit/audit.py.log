 for key,folder in [('modules','remote-modules'),('data','remote-data')]:
  values=run[key];assert len(set(Path(p).name for p in values))==len(values)
  files=set(p.name for p in (r/runname/folder).iterdir() if p.is_file());assert files==set(Path(p).name for p in values)
  for p,row in values.items():
   file=f'{runname}/{folder}/{Path(p).name}';data=(r/file).read_bytes();assert len(data)==row['bytes'] and sha(data)==row['sha256'];payloads.append({'capturedPath':file,**row})
check('all 68 JavaScript and four city bodies rehash and match across both runs',len(a['modules'])==68 and len(a['data'])==4 and a['modules']==b['modules'] and a['data']==b['data'])
requests=[x for run in [a,b] for x in run['requests']];check('all 1150 observed request events are GET and none target API',len(requests)==1150 and all(x['method']=='GET' and not x['path'].startswith('/api/') for x in requests))
blocked=[x for run in [a,b] for c in run['checks'] for x in c['blocked']];check('exactly ten blocked observed requests are configured analytics GETs',len(blocked)==10 and all(x['method']=='GET' and x['origin']=='https://plausible.io' and x['reason']=='external' for x in blocked))
receipts=[];receiptHashes={}
for runname,c in accepted:
 assert c['contextClosed'] and c['final']['noSavedProfile'] and not c['pageErrors']
 for receipt in c.get('receipts',[]):
  file=runname+'/'+receipt['file'];data=(r/file).read_bytes();assert sha(data)==receipt['sha256'] and len(data)==receipt['bytes'];cp(file);raw=json.loads(data);assert raw['receipt']==receipt['receipt'];label=receipt['file'].split('-')[-2];receiptHashes.setdefault(label,set()).add(sha(data));receipts.append({'capturedPath':'captured/'+file,'label':label,'sha256':sha(data),'receipt':receipt['receipt'],'case':c['name']})
check('16 actual downloaded receipt files match recorded bytes and four input classes agree across locales/widths',len(receipts)==16 and set(receiptHashes)=={'toronto','juneau','known','recovered'} and all(len(v)==1 for v in receiptHashes.values()))
result={'checks':checks,'passed':len(checks),'acceptedNames':names,'initialFailedNames':[x['name'] for x in failed],'source':source,'payloads':payloads,'unavailableImageBodies':missing,'receipts':receipts,'sourceCommit':base,'providerId':before['id'],'browser':a['browser'],'requestEvents':len(requests),'blockedRequests':blocked,'qualification':'Read-only independent audit of captured native executions. No browser rerun or private authorization material was read. Parent cleanup exact-secret scan is retained as attributed evidence, not independently repeated.'}
(d/'audit-result.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps({'passed':len(checks),'groups':len(names),'receiptFiles':len(receipts),'payloadFilesRehashed':len(payloads)}))
