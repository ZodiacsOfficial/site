import fs from 'node:fs';import assert from 'node:assert/strict';import{chromium}from'playwright-core';import{createHash}from'node:crypto';
const results=[],browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking','--no-first-run']});
const settle=p=>p.evaluate(()=>new Promise(done=>requestAnimationFrame(()=>requestAnimationFrame(()=>setTimeout(done,30)))));
const submit=p=>p.locator('.calc__form').evaluate(el=>el.dispatchEvent(new Event('submit',{bubbles:true,cancelable:true})));
const hold=(p,key)=>p.evaluate(key=>review.hold(key),key),release=(p,id)=>p.evaluate(id=>review.release(id),id),immediate=(p,key)=>p.evaluate(key=>review.immediate(key),key);
async function mount(p,hash='',locale='en'){await p.evaluate(({hash,locale})=>{history.replaceState(null,'','/'+hash);review.mount(locale);},{hash,locale});await settle(p);}
async function fill(p){await p.locator('#birth-date').fill('1990-01-04');await p.locator('#birth-time').fill('12:00');await p.locator('#place').fill('Bang');await p.locator('[role=listbox] [role=option]').click();await settle(p);}
async function success(p){await submit(p);await p.locator('.calc__result').waitFor();await settle(p);}
async function empty(p){await settle(p);assert.equal(await p.locator('.calc__result').count(),0);assert.equal(await p.locator('[data-download-calculation-receipt]').count(),0);assert.equal(await p.evaluate(()=>window.zodiacsPostChartContext??null),null);}
const observed=p=>p.evaluate(()=>({calls:review.calls,events:review.events,errors:review.errors,active:document.activeElement?.id,hash:location.hash,busy:document.querySelector('.calc__form')?.getAttribute('aria-busy')}));
const groups=[
 ['control-known',async p=>{await mount(p);await fill(p);await success(p);const row=await observed(p);assert.deepEqual(row.calls,[{type:'portable-natal',utc:'1990-01-04T05:00:00.000Z'}]);assert.equal(await p.locator('[data-download-calculation-receipt]').isDisabled(),false);return{calls:row.calls,rendered:true};}],
 ['control-unknown',async p=>{await mount(p);await fill(p);await p.locator('.field__toggle input').check();await success(p);const row=await observed(p);assert.equal(row.calls.filter(x=>x.type==='portable-natal').length,1);assert.equal(row.calls.filter(x=>x.type==='bodies').length,2);return{calls:row.calls,coveragePolicyUnchanged:true};}],
 ['pending-engine-date-edit',async p=>{const id=await hold(p,'engine');await mount(p);await fill(p);await submit(p);await p.locator('#birth-date').fill('1991-02-03');await release(p,id);await empty(p);assert.equal((await observed(p)).calls.length,0);assert.equal((await observed(p)).busy,'false');return{noObsoleteNatal:true};}],
 ['pending-receipt-place-clear',async p=>{const id=await hold(p,'../lib/engine/calculator-receipt');await mount(p);await fill(p);await submit(p);await p.waitForFunction(()=>review.events.some(e=>e.key==='../lib/engine/calculator-receipt'));await p.locator('.place__clear').click();await release(p,id);await empty(p);assert.equal((await observed(p)).calls.length,0);return{clearedSelectionFencesNatal:true};}],
 ['signature-rejection-while-engine-pending',async p=>{const id=await hold(p,'engine'),signature=await hold(p,'../lib/chart-signature');await mount(p);await fill(p);await submit(p);await p.evaluate(id=>review.reject(id),signature);await settle(p);assert.deepEqual((await observed(p)).errors,[]);await release(p,id);await p.locator('.calc__result').waitFor();return{optionalSignatureFailureObservedImmediately:true};}],
 ['late-signature-after-edit',async p=>{const id=await hold(p,'../lib/chart-signature');await mount(p);await fill(p);await success(p);await p.locator('#birth-time').fill('13:00');await release(p,id);await empty(p);assert.equal((await observed(p)).events.filter(e=>e.type==='signature').length,0);return{signatureNotCalculatedForAbandonedResult:true};}],
 ['late-share-preparation-after-edit',async p=>{const id=await hold(p,'prepare-share');await mount(p);await fill(p);await success(p);await p.waitForFunction(()=>review.events.some(e=>e.type==='prepare-share'));await p.locator('#house-system').selectOption('placidus');await release(p,id);await empty(p);return{oldPreparedArtifactNotRestored:true};}],
 ['late-context-match-after-edit',async p=>{const id=await hold(p,'../lib/profile/store');await mount(p);await fill(p);await success(p);await p.locator('#birth-date').fill('1992-03-04');await release(p,id);await empty(p);assert.equal((await observed(p)).events.filter(e=>e.type==='context-event').length,0);return{staleContextNotPublished:true};}],
 ['old-share-completion-newer-result',async p=>{await mount(p);await fill(p);await success(p);await p.evaluate(()=>review.holdShare());await p.locator('[data-share-card]').first().click();await p.locator('#birth-time').fill('13:00');await success(p);await p.evaluate(()=>review.releaseShare());await settle(p);const text=await p.locator('[data-share-card]').first().innerText();assert.ok(!/saved|shared/i.test(text),text);assert.equal((await observed(p)).calls.length,2);return{newShareButton:text,oldAuthorizedShareMayHaveCompleted:true};}],
 ['old-dialog-intent-after-edit',async p=>{const id=await hold(p,'./ChartShareDialog');await mount(p);await fill(p);await success(p);await p.locator('[data-chart-more]>summary').click();await p.locator('[data-share-options]').first().click();await p.locator('#birth-date').fill('1992-03-04');await release(p,id);await empty(p);assert.equal(await p.locator('[data-share-dialog]').count(),0);return{staleDialogNotOpened:true};}],
 ['current-failure-clears-old-result',async p=>{await mount(p);await fill(p);await success(p);await p.evaluate(()=>review.fail(true));await submit(p);await p.locator('.calc__error').waitFor();await empty(p);assert.equal(await p.locator('.calc__error').evaluate(e=>e===document.activeElement),true);await p.evaluate(()=>review.fail(false));await success(p);return{oldResultClearedAndRetrySucceeded:true};}],
 ['positions-only-control',async p=>{const token=await p.evaluate(()=>review.positions());assert.ok(token);await mount(p,'#p='+token);await p.locator('[data-positions-only]').waitFor();assert.equal((await observed(p)).calls.length,0);assert.equal(await p.locator('[data-download-calculation-receipt]').count(),0);return{readOnly:true};}],
 ...['valid','invalid','conflicting'].map(kind=>['pending-'+kind+'-positions-after-new-run',async p=>{const id=await hold(p,'./PositionsShareSurface');const token=kind==='valid'?await p.evaluate(()=>review.positions()):'invalid';await mount(p,'#p='+token+(kind==='conflicting'?'&c=invalid':''));await fill(p);await success(p);await release(p,id);await settle(p);assert.equal(await p.locator('[data-positions-only]').count(),0);assert.equal(await p.locator('.calc__result').count(),1);assert.equal(await p.locator('.calc__error').count(),0);assert.equal((await observed(p)).calls.length,1);return{newResultSurvives:true,hash:(await observed(p)).hash};}]),
 ['stale-controls-retry-focus',async p=>{const initial=await hold(p,'./ChartActionDock');await mount(p);await fill(p);await success(p);await p.evaluate(id=>review.reject(id),initial);await p.locator('[data-chart-controls-retry]').waitFor();const retry=await hold(p,'./ChartActionDock');await p.locator('[data-chart-controls-retry]').click();await p.locator('#birth-time').fill('13:00');await success(p);await p.locator('#birth-date').focus();await release(p,retry);await settle(p);assert.equal((await observed(p)).active,'birth-date');return{obsoleteRetryDidNotStealFocus:true};}],
 ['pending-positions-mine-revoke',async p=>{const id=await hold(p,'./PositionsShareSurface'),token=await p.evaluate(()=>review.positions()),savedId='10000000-0000-4000-8000-000000000001';await p.evaluate(()=>{document.documentElement.setAttribute('data-account-sync-v2','');window.reviewAccess=true;window.zodiacsProfileAccess=Object.freeze({canRead:()=>window.reviewAccess});});await mount(p,'#p='+token+'&subject=other&mineId='+savedId+'&mineSource=profile');await p.evaluate(()=>{window.reviewAccess=false;dispatchEvent(new Event('zodiacs:profile-access'));});await release(p,id);await p.locator('[data-positions-only]').waitFor();await immediate(p,'./PositionsShareSurface');await fill(p);await success(p);const links=await p.locator('a[href*="compatibility"]').evaluateAll(es=>es.map(e=>e.getAttribute('href')));assert.ok(links.every(h=>!h.includes(savedId)),JSON.stringify(links));return{publicPositionsPreserved:true,revokedOpaqueMineNotRecaptured:true,links};}],
 ['unmount-pending-receipt',async p=>{const id=await hold(p,'../lib/engine/calculator-receipt');await mount(p);await fill(p);await submit(p);await p.waitForFunction(()=>review.events.some(e=>e.key==='../lib/engine/calculator-receipt'));await p.evaluate(()=>review.unmount());await release(p,id);await settle(p);assert.equal((await observed(p)).calls.length,0);assert.equal(await p.locator('#mount').innerHTML(),'');return{unmountedRunDidNotCalculate:true};}],
];
try{for(const kind of ['baseline','candidate'])for(const[name,run]of groups.filter(([name])=>!process.env.REVIEW_CASE||name===process.env.REVIEW_CASE)){const context=await browser.newContext({reducedMotion:'reduce',viewport:{width:1400,height:900}});context.setDefaultTimeout(2000);const page=await context.newPage(),pageErrors=[],requests=[];page.on('pageerror',e=>pageErrors.push(String(e)));await context.route('**/*',route=>{requests.push(route.request().url());return route.request().isNavigationRequest()?route.fulfill({contentType:'text/html',body:'<!doctype html><title>Owned Chart review</title><div id="mount"></div>'}):route.abort();});try{await page.goto('http://owned-review.invalid/');await page.addStyleTag({content:fs.readFileSync(kind+'.css','utf8')});await page.addScriptTag({content:fs.readFileSync(kind+'.js','utf8')});const evidence=await run(page);assert.deepEqual(pageErrors,[]);assert.deepEqual((await observed(page)).errors,[]);results.push({kind,name,passed:true,evidence,observation:await observed(page),requests});}catch(error){results.push({kind,name,passed:false,error:String(error.stack??error),pageErrors,observation:await observed(page).catch(()=>null),dom:await page.locator('#mount').innerText(),requests});}finally{await context.close();}console.log(JSON.stringify({kind,name,passed:results.at(-1).passed,error:results.at(-1).error?.split('\n')[0]}));}}
finally{const report={node:process.version,browser:browser.version(),driverSha256:createHash('sha256').update(fs.readFileSync(new URL(import.meta.url))).digest('hex'),qualification:'Actual frozen or original ChartCalculator with actual Preact/BirthFields/PlaceSearch and native DOM. Only import promises, geosearch results, engine load and share artifact effects are controlled at explicit wrapper boundaries; actual rc.6 calculation and existing codecs/context store run. IIFE bundle is not production import-graph evidence.',results,cleanup:{browserClosed:true,contextsClosed:true,noExternalRequestsExecuted:true}};await browser.close();fs.writeFileSync('native-result.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({baselinePass:results.filter(x=>x.kind==='baseline'&&x.passed).length,candidatePass:results.filter(x=>x.kind==='candidate'&&x.passed).length,candidateFail:results.filter(x=>x.kind==='candidate'&&!x.passed).map(x=>x.name)}));if(results.some(x=>x.kind==='candidate'&&!x.passed))process.exitCode=1;}
