for(const[k,file]of Object.entries(sources)){const source=fs.readFileSync(file,'utf8'),ast=ts.createSourceFile(file,source,ts.ScriptTarget.Latest,true,ts.ScriptKind.TSX);let run;function visit(n){if(ts.isFunctionDeclaration(n)&&n.name?.text==='runChart')run=n;ts.forEachChild(n,visit);}visit(ast);const block=run.body.statements.find(ts.isTryStatement).tryBlock;const statements=Array.from(block.statements);const start=statements.findIndex(n=>ts.isVariableStatement(n)&&n.declarationList.declarations.some(d=>d.name.getText(ast)==='effectiveTime'));const end=statements.findIndex((n,i)=>i>start&&ts.isIfStatement(n)&&n.expression.getText(ast)==='!input.timeKnown');assert.ok(start>=0&&end>start);excerpts[k]=ts.createPrinter().printList(ts.ListFormat.MultiLine,ts.factory.createNodeArray(statements.slice(start,end+1)),ast);}
