import fs from'node:fs';import path from'node:path';import http from'node:http';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{chromium}from'playwright-core';
const root='/private/tmp/zodiacs-platform-chart-ownership/dist',freeze=JSON.parse(fs.readFileSync('/private/tmp/zodiacs-platform-chart-ownership-evidence/freeze1/freeze.json','utf8')),hash=b=>createHash('sha256').update(b).digest('hex');
for(const file of freeze.files)assert.equal(hash(fs.readFileSync('/private/tmp/zodiacs-platform-chart-ownership/'+file.path)),file.sha256);
const served={},requests=[],mime={'.html':'text/html','.js':'text/javascript','.css':'text/css','.json':'application/json','.svg':'image/svg+xml','.webp':'image/webp','.png':'image/png','.woff2':'font/woff2'};
const server=http.createServer((req,res)=>{try{let f=path.resolve(root,'.'+decodeURIComponent(new URL(req.url,'http://local').pathname));if(!f.startsWith(root+'/'))throw Error('Path outside root');if(fs.existsSync(f)&&fs.statSync(f).isDirectory())f=path.join(f,'index.html');const b=fs.readFileSync(f);served[path.relative(root,f)]=hash(b);res.setHeader('content-type',mime[path.extname(f)]??'application/octet-stream');res.end(b);}catch{res.statusCode=404;res.end();}});
await new Promise(y=>server.listen(0,'127.0.0.1',y));const origin='http://127.0.0.1:'+server.address().port;
const token='1.'+Buffer.from(JSON.stringify({d:'1990-01-04',t:'12:00',z:'Asia/Bangkok',la:13.75,lo:100.5,p:'Synthetic Bangkok'})).toString('base64url');
const positions='2.'+Buffer.from(JSON.stringify({b:Array.from({length:12},(_,i)=>i*27),h:'w',v:'0.1.1-rc.6'})).toString('base64url');
const results=[],releases=[];let browser;
const settle=p=>p.evaluate(()=>new Promise(y=>requestAnimationFrame(()=>requestAnimationFrame(()=>setTimeout(y,100)))));
async function check(name,fn){if(process.env.REVIEW_CASE&&name!==process.env.REVIEW_CASE)return;const c=await browser.newContext({reducedMotion:'reduce',viewport:{width:1400,height:900}}),p=await c.newPage(),errors=[],localRequests=[];c.setDefaultTimeout(10000);p.on('pageerror',e=>errors.push(String(e)));await c.route('**/*',route=>{const url=route.request().url();requests.push(url);localRequests.push(url);return url.startsWith(origin+'/')?route.continue():route.abort();});try{const detail=await fn(p,c);assert.deepEqual(errors,[]);results.push({name,passed:true,detail,requests:localRequests});}catch(error){results.push({name,passed:false,error:String(error.stack??error),errors,active:await p.evaluate(()=>({id:document.activeElement?.id,tag:document.activeElement?.tagName,html:document.activeElement?.outerHTML.slice(0,1000),result:!!document.querySelector('.calc__result'),busy:document.querySelector('.calc__form')?.getAttribute('aria-busy'),error:document.querySelector('.calc__error')?.textContent,date:document.querySelector('#birth-date')?.value})).catch(()=>null),requests:localRequests});}finally{await c.close();}console.log(JSON.stringify({name,passed:results.at(-1).passed,error:results.at(-1).error?.split('\n')[0]}));}
try{browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--disable-background-networking','--no-first-run']});
for(const locale of ['en','ru'])await check('unchanged-shared-init-'+locale,async p=>{await p.goto(origin+(locale==='en'?'/birth-chart/':'/ru/birth-chart/')+'#c='+token,{waitUntil:'domcontentloaded'});await p.locator('.calc__result').waitFor();await settle(p);assert.equal(await p.locator('#birth-date').inputValue(),'1990-01-04');assert.equal(await p.locator('#birth-time').inputValue(),'12:00');assert.equal(await p.locator('[data-download-calculation-receipt]').isDisabled(),false);return{date:'1990-01-04',time:'12:00',receiptAvailable:true};});
await check('positions-only-production-graph',async(p,c)=>{const seen=[];p.on('request',r=>seen.push(r.url()));await p.goto(origin+'/birth-chart/#p='+positions,{waitUntil:'networkidle'});await p.locator('[data-positions-only]').waitFor();assert.equal(await p.locator('[data-download-calculation-receipt]').count(),0);assert.ok(!seen.some(url=>/\/(?:calculator-receipt|chart-adapter|full)\./.test(url)));return{engineOrReceiptRequests:0,positionsOnly:true};});
await check('pending-positions-mine-revoke',async(p,c)=>{let release;const gate=new Promise(y=>release=y);releases.push(release);await c.addInitScript(()=>{window.reviewAccess=true;const reader=Object.freeze({canRead:()=>window.reviewAccess});Object.defineProperty(window,'zodiacsProfileAccess',{get:()=>reader,set:()=>{},configurable:true});});let started;const loaded=new Promise(y=>started=y);await c.route('**/PositionsShareSurface.*.js',async route=>{started();await gate;await route.continue();});const savedId='10000000-0000-4000-8000-000000000001';await p.goto(origin+'/birth-chart/#p='+positions+'&subject=other&mineId='+savedId+'&mineSource=profile',{waitUntil:'domcontentloaded'});await p.locator('#birth-date').focus();await loaded;await p.evaluate(()=>{document.documentElement.setAttribute('data-account-sync-v2','');window.reviewAccess=false;dispatchEvent(new Event('zodiacs:profile-access'));});release();await p.locator('[data-positions-only]').waitFor();await p.locator('#birth-date').fill('1990-01-04');await p.locator('#birth-time').fill('12:00');await p.locator('#place').fill('Bangkok');await p.locator('[role=listbox] [role=option]').first().click();await p.locator('.calc__form').evaluate(form=>form.dispatchEvent(new Event('submit',{bubbles:true,cancelable:true})));await p.locator('[data-chart-action-dock]').waitFor();await settle(p);const links=await p.locator('a[href*="compatibility"]').evaluateAll(es=>es.map(e=>e.getAttribute('href')));assert.ok(links.length>0);assert.ok(links.every(h=>!h.includes(savedId)),JSON.stringify(links));return{links,publicPositionsPreserved:true};});
await check('controls-retry-after-new-result',async(p,c)=>{let release,initialFailure=true;const gate=new Promise(y=>{release=y;});releases.push(release);await c.route('**/ChartActionDock.*.js',async route=>{if(initialFailure)return route.abort('failed');await gate;await route.continue();});await p.goto(origin+'/birth-chart/#c='+token,{waitUntil:'domcontentloaded'});await p.locator('#birth-date').focus();await p.locator('[data-chart-controls-retry]').waitFor();initialFailure=false;await p.locator('[data-chart-controls-retry]').click();await p.locator('#birth-time').fill('13:00');await p.locator('.calc__form').evaluate(form=>form.dispatchEvent(new Event('submit',{bubbles:true,cancelable:true})));await p.locator('.calc__result').waitFor();await settle(p);await p.locator('#birth-date').focus();release();await p.locator('[data-explorer-entity-picker]').waitFor();await settle(p);const active=await p.evaluate(()=>({id:document.activeElement?.id,picker:document.activeElement?.hasAttribute('data-explorer-entity-picker')}));assert.equal(active.id,'birth-date');return{active};});
}finally{releases.forEach(f=>f());const report={node:process.version,browser:browser?.version(),freeze,staticRoot:root,origin,results,served,requests,driverSha256:hash(fs.readFileSync(new URL(import.meta.url))),qualification:'Unmodified frozen production Astro/critical-styles output served locally; actual native import paths. Only synthetic URL input and bounded asset transport fault/delay. No source or response rewriting.',cleanup:{browserClosed:true,serverClosed:true}};await browser?.close();await new Promise(y=>server.close(y));fs.writeFileSync('static-result.json',JSON.stringify(report,null,2)+'\n');if(results.some(x=>!x.passed))process.exitCode=1;}
