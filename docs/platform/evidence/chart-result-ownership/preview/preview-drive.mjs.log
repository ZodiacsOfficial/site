const out=process.env.OUT_DIR;if(!out)throw Error('OUT_DIR required');fs.mkdirSync(out,{recursive:true});fs.mkdirSync(out+'/remote-modules',{recursive:true});
const hash=b=>createHash('sha256').update(b).digest('hex'),snapshot=JSON.parse(fs.readFileSync('source-snapshot.json','utf8'));
for(const row of snapshot.records)assert.equal(hash(fs.readFileSync('source/'+row.path)),row.sha256,row.path);
