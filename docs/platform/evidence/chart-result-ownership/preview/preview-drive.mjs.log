const report={at:new Date().toISOString(),sourceCommit:commit,sourceSnapshot:snapshot,node:process.version,base:origin,checks:[],requests:[],responses:[],blocks:[],moduleIdentities:{},authBootstrap:{isolated:true,observed:false},scope:'Actual remote pages/modules. Passive event observation and CDP. Deliberate envelope JSON.stringify fault is host-API fault injection, not product source rewriting. No local source module is injected into the page.',outcome:'failed'};
const pendingResponses=[],releases=[];let browser,cookies=[];
function findNatal(bytes,file){const ast=ts.createSourceFile(file,bytes.toString(),ts.ScriptTarget.Latest,true),found=[];function visit(node){if(ts.isFunctionDeclaration(node)&&node.parameters.length===1){const parameter=node.parameters[0].name.getText(ast),returned=node.body?.statements.find(ts.isReturnStatement),expression=returned?.expression;if(expression&&ts.isObjectLiteralExpression(expression)){const properties=new Map(expression.properties.filter(ts.isPropertyAssignment).map(p=>[p.name.getText(ast),p.initializer.getText(ast)]));if(properties.get('input')===parameter&&properties.has('bodies')&&properties.has('engineVersion'))found.push(node.name.text);}}ts.forEachChild(node,visit);}visit(ast);assert.equal(found.length,1);return{path:file,sha256:hash(bytes),function:found[0],mapping:'Parsed from actual remote response: one-argument function returning exact input plus bodies and engineVersion.'};}
async function observed(s){return s.page.evaluate(()=>({computed:window.__previewReview.computed,contexts:window.__previewReview.contexts,result:!!document.querySelector('.calc__result'),receipt:!!document.querySelector('[data-calculation-receipt-export]'),share:!!document.querySelector('[data-share-card]'),save:!!document.querySelector('[data-save-chart]'),postContext:window.zodiacsPostChartContext??null,date:document.querySelector('#birth-date')?.value,time:document.querySelector('#birth-time')?.value,busy:document.querySelector('.calc__form')?.getAttribute('aria-busy'),error:document.querySelector('.calc__error')?.textContent??'',focusedError:document.activeElement?.matches('.calc__error')??false,storedProfile:localStorage.getItem('zodiacs.profile.v1')}));}
async function empty(s){const v=await observed(s);assert.equal(v.result,false);assert.equal(v.receipt,false);assert.equal(v.share,false);assert.equal(v.save,false);assert.equal(v.postContext,null);return v;}
async function settle(s){await s.page.waitForFunction(()=>document.querySelector('.calc__form')?.getAttribute('aria-busy')==='false');}
async function ready(s,url=link()){const r=await s.page.goto(url,{waitUntil:'domcontentloaded',timeout:45000});assert.equal(r.status(),200);await s.page.locator('astro-island[component-url*="ChartCalculator"]:not([ssr])').waitFor();}
async function result(s){await s.page.locator('.calc__result').waitFor();await settle(s);}
async function more(s){const details=s.page.locator('[data-chart-more]');if(await details.getAttribute('open')===null){await details.locator(':scope > summary').focus();await s.page.keyboard.press('Enter');}await s.page.locator('[data-calculation-receipt-export]').waitFor({state:'visible'});}
async function setup(name,width=1280){const context=await browser.newContext({viewport:{width,height:1000},reducedMotion:'reduce',timezoneId:'UTC',acceptDownloads:true});if(cookies.length)await context.addCookies(cookies);context.setDefaultTimeout(15000);
 await context.route('**/*',async route=>{const r=route.request(),u=new URL(r.url());if(r.method()!=='GET'||u.origin!==origin||u.pathname.startsWith('/api/')){report.blocks.push({case:name,method:r.method(),origin:u.origin,path:u.pathname,reason:r.method()!=='GET'?'write-blocked':u.origin!==origin?'external-blocked':'api-blocked'});return route.abort('blockedbyclient');}return route.continue();});
 await context.addInitScript(()=>{window.__previewReview={computed:[],contexts:[],failReceipt:false};addEventListener('zodiacs:chart-computed',e=>window.__previewReview.computed.push(e.detail));addEventListener('zodiacs:chart-context',e=>window.__previewReview.contexts.push(e.detail));const stringify=JSON.stringify;JSON.stringify=function(value,...args){if(window.__previewReview.failReceipt&&value?.schema==='zodiacs.natal-envelope.draft-v1')throw Error('Synthetic private receipt failure');return stringify.call(this,value,...args);};});
 const page=await context.newPage(),errors=[],consoleErrors=[];page.on('pageerror',e=>errors.push(e.message));page.on('console',m=>{if(m.type()==='error')consoleErrors.push(m.text());});page.on('request',r=>{const u=new URL(r.url());report.requests.push({case:name,method:r.method(),origin:u.origin,path:u.pathname});});
 page.on('response',r=>{const u=new URL(r.url());if(u.origin!==origin)return;pendingResponses.push((async()=>{try{const bytes=await r.body(),id={case:name,path:u.pathname,status:r.status(),bytes:bytes.length,sha256:hash(bytes)};report.responses.push(id);if(u.pathname.endsWith('.js')&&r.status()===200){const basename=path.basename(u.pathname),existing=report.moduleIdentities[u.pathname];if(existing)assert.equal(existing.sha256,id.sha256);else{fs.writeFileSync(out+'/remote-modules/'+basename,bytes);report.moduleIdentities[u.pathname]={sha256:id.sha256,bytes:bytes.length};}if(/^chart-adapter\..*\.js$/.test(basename)){const identity=findNatal(bytes,u.pathname);if(report.nativeIdentity)assert.deepEqual(identity,report.nativeIdentity);report.nativeIdentity=identity;}}}catch(e){report.responses.push({case:name,path:u.pathname,status:r.status(),bodyUnavailable:true,error:String(e)});}})());});
 const cdp=await context.newCDPSession(page);await cdp.send('Profiler.enable');await cdp.send('Profiler.startPreciseCoverage',{callCount:true,detailed:true});return{name,width,context,page,cdp,errors,consoleErrors,expectedNatal:1};}
async function gate(s,observedPrefix){const matching=Object.keys(report.moduleIdentities).filter(p=>path.basename(p).startsWith(observedPrefix+'.'));assert.equal(matching.length,1,'Gate must use one previously observed remote module');let begin,release;const started=new Promise(r=>begin=r),wait=new Promise(r=>release=r);releases.push(release);await s.context.route(origin+matching[0],async route=>{begin();await wait;await route.continue().catch(()=>{});});return{started,release,path:matching[0]};}
async function check(name,action,width=1280){const s=await setup(name,width);try{const detail=await action(s);assert.deepEqual(s.errors,[]);await Promise.allSettled(pendingResponses);assert.ok(report.nativeIdentity);const all=(await s.cdp.send('Profiler.takePreciseCoverage')).result,coverage=all.filter(x=>x.url===origin+report.nativeIdentity.path);fs.writeFileSync(out+'/'+name+'-native-coverage.json',JSON.stringify(coverage,null,2)+'\n');const nativeCalls=coverage.flatMap(x=>x.functions).filter(f=>f.functionName===report.nativeIdentity.function).reduce((n,f)=>n+f.ranges[0].count,0);assert.equal(nativeCalls,s.expectedNatal,'Actual remote native natal count');const state=await observed(s);assert.equal(state.storedProfile,null);report.checks.push({name,width,status:'passed',detail,nativeCalls,state,pageErrors:s.errors,consoleErrors:s.consoleErrors});}catch(e){report.checks.push({name,width,status:'failed',error:String(e.stack??e),state:await observed(s).catch(()=>null),pageErrors:s.errors,consoleErrors:s.consoleErrors});await s.page.screenshot({path:out+'/'+name+'-failure.png',fullPage:true}).catch(()=>{});}finally{releases.splice(0).forEach(f=>f());await s.context.close();}console.log(JSON.stringify({name,status:report.checks.at(-1).status,error:report.checks.at(-1).error?.split('\n')[0]}));}
try{browser=await chromium.launch({executablePath:await findChromium(),headless:true,args:STABLE_CHROMIUM_ARGS});report.browser=browser.version();const auth=JSON.parse(fs.readFileSync(process.env.ZODIACS_PREVIEW_AUTH_FILE,'utf8')),bootstrap=await browser.newContext();try{const page=await bootstrap.newPage();await page.goto(auth.url,{waitUntil:'networkidle',timeout:60000});cookies=await bootstrap.cookies();report.authBootstrap.completed=true;}catch{throw Error('Protected preview bootstrap failed.');}finally{await bootstrap.close();}
 for(const locale of ['en','ru'])for(const width of[1280,390])await check('ordinary-'+locale+'-'+width,async s=>{s.expectedNatal=2;await ready(s,link(locale));await result(s);assert.equal(await s.page.locator('#birth-date').inputValue(),'1990-06-15');assert.equal(await s.page.locator('#birth-time').inputValue(),'14:30');assert.equal(await s.page.evaluate(()=>document.documentElement.scrollWidth),width);await more(s);const button=s.page.locator('[data-download-calculation-receipt]');assert.equal(await button.isEnabled(),true);const label=(await button.innerText()).trim();const pending=s.page.waitForEvent('download');await button.focus();await s.page.keyboard.press('Enter');const download=await pending;assert.equal(download.suggestedFilename(),'zodiacs-calculation-receipt.json');const file=out+'/'+s.name+'-receipt.json';await download.saveAs(file);const bytes=fs.readFileSync(file),decoded=parseNatalEnvelope(bytes.toString());assert.equal(decoded.ok,true);assert.equal(decoded.envelope.receipt.engine.version,'0.1.1-rc.6');assert.equal(decoded.envelope.receipt.localResolution.date,'1990-06-15');assert.equal(decoded.envelope.receipt.localResolution.time,'14:30');await s.page.locator('[data-chart-more]').screenshot({path:out+'/'+s.name+'-actions.png'});await s.page.locator('[data-share-options]').click();await s.page.locator('[data-share-dialog]').waitFor({state:'visible'});await s.page.keyboard.press('Escape');await s.page.locator('[data-share-dialog]').waitFor({state:'hidden'});await s.page.locator('.calc__result').screenshot({path:out+'/'+s.name+'-result.png'});await s.page.locator('#birth-time').fill('15:30');const cleared=await empty(s);assert.equal(cleared.computed.length,1);assert.equal(cleared.busy,'false');await s.page.locator('.calc__submit').click();await result(s);assert.equal((await observed(s)).computed.length,2);return{locale,label,receiptSha256:hash(bytes),receiptSchema:decoded.envelope.schema,shareDialogOpenedAndClosed:true,editedResultCleared:true,recovered:true};},width);
 await check('failed-run-clears-and-recovers',async s=>{s.expectedNatal=3;await ready(s);await result(s);await s.page.locator('#birth-date').fill('1991-06-15');await s.page.evaluate(()=>window.__previewReview.failReceipt=true);await s.page.locator('.calc__submit').click();await s.page.locator('.calc__error').waitFor();await settle(s);await s.page.waitForFunction(()=>document.activeElement?.matches('.calc__error'));const failed=await empty(s);assert.equal(failed.date,'1991-06-15');assert.equal(failed.computed.length,1);assert.ok(!failed.error.includes('Synthetic private'));await s.page.screenshot({path:out+'/'+s.name+'-alert.png',fullPage:true});await s.page.evaluate(()=>window.__previewReview.failReceipt=false);await s.page.locator('.calc__submit').click();await result(s);assert.equal((await observed(s)).computed.length,2);return{fault:'Scoped native JSON.stringify envelope failure; actual remote modules unchanged',failed,recovered:true};});
 for(const prefix of['calculator-receipt','full'])await check('edit-during-'+prefix+'-loader',async s=>{s.expectedNatal=0;const delay=await gate(s,prefix);await ready(s);await Promise.race([delay.started,new Promise((_,reject)=>setTimeout(()=>reject(Error('Remote module gate not reached')),15000))]);await s.page.locator('#birth-date').fill('1991-06-15');delay.release();await settle(s);await s.page.waitForTimeout(300);const state=await empty(s);assert.equal(state.computed.length,0);return{observedRemoteModule:delay.path,staleCompletionSuppressed:true};});
 await check('new-run-during-receipt-loader',async s=>{const delay=await gate(s,'calculator-receipt');await ready(s);await delay.started;await s.page.locator('#birth-date').fill('1991-06-15');await s.page.locator('.calc__submit').click();delay.release();await result(s);assert.equal((await observed(s)).computed.length,1);assert.ok((await s.page.locator('[data-chart-receipt]').textContent()).includes('1991-06-15'));return{replacementOnly:true,observedRemoteModule:delay.path};});
 await check('positions-only',async s=>{s.expectedNatal=0;const token='2.'+Buffer.from(JSON.stringify({b:Array.from({length:12},(_,i)=>i*27),h:'w',v:'0.1.1-rc.6'})).toString('base64url');await ready(s,origin+'/birth-chart/#p='+token);await s.page.locator('[data-positions-only]').waitFor();assert.equal(await s.page.locator('[data-calculation-receipt-export]').count(),0);assert.equal((await observed(s)).computed.length,0);const requests=report.requests.filter(r=>r.case===s.name);assert.ok(!requests.some(r=>/\/(?:calculator-receipt|chart-adapter|full)\./.test(r.path)));return{positionsPreserved:true,noCivilOrEngineModuleRequest:true};});
 report.outcome=report.checks.every(c=>c.status==='passed')?'passed':'failed';
}catch(e){report.failure=String(e.stack??e);process.exitCode=1;}finally{releases.forEach(f=>f());await browser?.close();await Promise.allSettled(pendingResponses);cookies=[];report.cleanup={browserClosed:true,contextsClosed:true,localServerStarted:false};report.driverSha256=hash(fs.readFileSync(new URL(import.meta.url)));fs.writeFileSync(out+'/result.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({checks:report.checks.length,passed:report.checks.filter(r=>r.status==='passed').length,outcome:report.outcome}));if(report.outcome!=='passed')process.exitCode=1;}
