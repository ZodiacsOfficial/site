import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';
const accessDir='/private/tmp/zodiacs-platform-chart-preview-auth';
const auth=JSON.parse(fs.readFileSync(accessDir+'/access.json','utf8')),url=new URL(auth.url);
const values=[auth.url,...[...url.searchParams.values()].filter(x=>x.length>8)];
const secrets=[...new Set(values.flatMap(x=>[x,encodeURIComponent(x),JSON.stringify(x).slice(1,-1)]))];
function walk(dir){return fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>{const p=path.join(dir,e.name);return e.isSymbolicLink()?[]:e.isDirectory()?walk(p):[p];});}
const matches=[];const files=walk('.');
for(const p of files){const b=fs.readFileSync(p);if(secrets.some(s=>b.includes(Buffer.from(s))))matches.push(p);}
fs.rmSync(accessDir,{recursive:true,force:true});
const cleanup={at:new Date().toISOString(),temporaryAccessDirectoryRemoved:!fs.existsSync(accessDir),scannedFiles:files.length,exactPrivateUrlAndNontrivialQueryValueMatches:matches.length,matchedFiles:matches,qualification:'Authentication bootstrap used a separate disposable context before test request observation. Test contexts blocked external, API and non-GET requests. Browser contexts closed; credentials removed after scan. No claim that the isolated authentication bootstrap made zero network requests.'};
fs.writeFileSync('cleanup.json',JSON.stringify(cleanup,null,2)+'\n');assert.equal(cleanup.temporaryAccessDirectoryRemoved,true);assert.equal(matches.length,0);console.log(JSON.stringify(cleanup));
