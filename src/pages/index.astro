---
import Base from '../layouts/Base.astro';
import SignIcon from '../components/SignIcon.astro';
import ToolGlyph from '../components/ToolGlyph.astro';
import SkyTicker from '../islands/SkyTicker';
import TodayBySign from '../islands/TodayBySign';
import DemoChart from '../islands/DemoChart';
import WelcomeBack from '../islands/WelcomeBack';
import glassMaps from '../data/glass-maps.json';
import { SIGNS } from '../lib/signs';
import '../styles/today.css';

const faq = [
  {
    q: 'Is it free?',
    a: 'Yes. Every calculator and guide is free, with no account and no paywall. Charts are computed in your own browser, so there is nothing to sell you.',
  },
  {
    q: 'How accurate are the charts?',
    a: 'Planetary positions come from a professional-grade astronomical engine, tested automatically against NASA JPL reference data to within a few hundredths of a degree. Time zones are resolved against the complete historical database, including pre-1922 local mean time. Every chart lists its computed UTC instant, so you can check it.',
  },
  {
    q: 'What happens to my birth data?',
    a: 'The calculation runs entirely in your browser. Saving a chart stores it on this device first; if you choose account sync, your saved charts upload to your Supabase account so they can follow you across devices.',
  },
  {
    q: 'What is Astrofolio?',
    a: 'Astrofolio is where your saved charts live. It starts on this device, free and without an account, with optional account sync when you want your charts on every device.',
  },
  {
    q: 'What is the Registry?',
    a: 'The collector’s wing of the site: a museum-style catalogue of the twelve signs as canonical records, with its own archive and thesis. It is deliberately separate from the astrology tools. Visit it if collecting interests you, or ignore it entirely.',
  },
];

const jsonLd = [
  {
    '@type': 'Organization',
    '@id': 'https://zodiacs.org/#org',
    name: 'Zodiacs',
    alternateName: 'Zodiacs.org',
    url: 'https://zodiacs.org/',
    logo: 'https://zodiacs.org/assets/og/v2/share.png',
    sameAs: [
      'https://x.com/astrofoliosol',
      'https://www.instagram.com/astrofolioonsol/',
      'https://tiktok.com/@astrofolio',
      'https://t.me/astrofoliosol',
      'https://astrofolio.xyz/',
      'https://github.com/ZodiacsOfficial/sdk',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': 'https://zodiacs.org/#site',
    url: 'https://zodiacs.org/',
    name: 'Zodiacs.org',
    description: 'Free birth charts, moon signs, compatibility, horoscopes, and sign guides — private in your browser.',
    publisher: { '@id': 'https://zodiacs.org/#org' },
    inLanguage: 'en',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

const tools = [
  { href: '/birth-chart/', title: 'Birth chart', promise: 'Your sun, moon, rising, planets, houses, and what they mean.', hue: 'var(--sign-cancer)', kind: 'birth' as const },
  { href: '/moon-sign/', title: 'Moon sign', promise: 'How you feel — and what helps you feel at home.', hue: 'var(--sign-pisces)', kind: 'moon' as const },
  { href: '/rising-sign/', title: 'Rising sign', promise: 'How people first meet you.', hue: 'var(--sign-libra)', kind: 'rising' as const },
  { href: '/compatibility/', title: 'Compatibility', promise: 'See how two charts connect.', hue: 'var(--sign-leo)', kind: 'compat' as const },
];
---
<Base
  title="Zodiacs.org — Free Birth Charts, Sign Guides & Astrology Tools"
  description="Free birth charts, moon signs, compatibility, horoscopes, and sign guides — accurate, private, and easy to understand."
  path="/"
  jsonLd={jsonLd}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Zodiacs.org — the sky, daily" href="/feeds/daily-sky.xml" />
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/assets/hero/zodiacs-hero-poster.avif"
    fetchpriority="high"
  />
  <!-- Legacy hash deep-links (the registry SPA lived here) → the wing. -->
  <script is:inline>
    (function () {
      var h = location.hash;
      if (['#verify', '#registry', '#official-twelve', '#sdk', '#market', '#faq-registry', '#identity', '#pulse', '#standings'].indexOf(h) !== -1) {
        location.replace('/collect/' + h);
      }
    })();
  </script>

  <!-- 01 · Hero — one rounded cinematic frame, headline over the footage. -->
  <section class="hero container">
    <div class="hero__frame reveal">
      <video
        class="hero__video"
        data-src="/assets/hero/zodiacs-hero.mp4"
        poster="/assets/hero/zodiacs-hero-poster.avif"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        aria-hidden="true"
        tabindex="-1"
        data-hero-video
      ></video>
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__content">
        <h1 class="hero__title">Explore the stars behind your story.</h1>
        <div class="hero__foot">
          <p class="hero__sub">
            Free birth charts, moon signs, compatibility, and horoscopes —
            accurate, private, and easy to understand.
          </p>
          <div class="hero__ctas">
            <a class="btn btn--primary" href="/birth-chart/"><span>Get your free birth chart</span><span class="orb">↗</span></a>
            <a class="btn btn--ghost hero__ghost" href="/horoscopes/"><span>See your forecasts</span></a>
          </div>
        </div>
      </div>
    </div>
    <script is:inline>
      // The footage animates on every screen unless the visitor prefers
      // reduced motion. On phones the poster stays the LCP: the video
      // only attaches after load, so it never competes with first paint.
      (function () {
        var v = document.querySelector('[data-hero-video]');
        if (!v) return;
        var play = function () {
          if (!v.src) { v.src = v.dataset.src; v.preload = 'auto'; }
          var p = v.play();
          if (p && p.catch) p.catch(function () {});
        };
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          if (window.matchMedia('(min-width: 720px)').matches) {
            play();
          } else if (document.readyState === 'complete') {
            play();
          } else {
            window.addEventListener('load', play, { once: true });
          }
          window.addEventListener('pageshow', function (e) { if (e.persisted) play(); });
        }
      })();
    </script>

    <!-- Lens filters for the glass chrome: capsule displacement maps ride
         inline so nothing is fetched. Browsers without url() backdrop
         filters never leave the blur floor. -->
    <svg class="glass-defs" aria-hidden="true" focusable="false">
      <filter id="zdx-lens-cta" color-interpolation-filters="sRGB" primitiveUnits="objectBoundingBox" x="-0.1" y="-0.2" width="1.2" height="1.4">
        <feImage href={glassMaps.cta} x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="0.5" xChannelSelector="R" yChannelSelector="G" result="disp" />
        <feGaussianBlur in="disp" stdDeviation="0.009 0.038" result="soft" />
        <feColorMatrix in="soft" type="saturate" values="1.4" />
      </filter>
      <filter id="zdx-lens-nav" color-interpolation-filters="sRGB" primitiveUnits="objectBoundingBox" x="-0.1" y="-0.2" width="1.2" height="1.4">
        <feImage href={glassMaps.nav} x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="0.35" xChannelSelector="R" yChannelSelector="G" result="disp" />
        <feGaussianBlur in="disp" stdDeviation="0.005 0.038" result="soft" />
        <feColorMatrix in="soft" type="saturate" values="1.35" />
      </filter>
    </svg>
  </section>

  <!-- 01b · Returning visitors with a saved chart get greeted; everyone else sees nothing here -->
  <WelcomeBack client:load />

  <!-- 02 · The sky, right now -->
  <section class="container ticker-band reveal">
    <SkyTicker client:load />
  </section>

  <!-- 02b · Zero-input value: tap your sign, see today -->
  <section class="section container reveal">
    <TodayBySign client:load />
  </section>

  <!-- 03 · Tools -->
  <section class="section container">
    <div class="section-head reveal">
      <h2>Start with your chart</h2>
      <p>Find your birth chart, moon sign, rising sign, compatibility, and what the sky is doing now.</p>
    </div>
    <div class="home-tools">
      {tools.map((t, i) => (
        <a class="tile reveal" href={t.href} style={`--sign:${t.hue};--reveal-delay:${i * 60}ms`}>
          <div class="home-tool">
            <ToolGlyph kind={t.kind} />
            <h3>{t.title}</h3>
            <p>{t.promise}</p>
            <span class="home-tool__go">Open →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 04 · Demo chart -->
  <section class="section container">
    <div class="section-head reveal">
      <h2>What a chart can show you</h2>
      <p>Frida Kahlo's chart, calculated from the 1907 sky and read in plain terms.</p>
    </div>
    <div class="reveal">
      <DemoChart client:visible />
    </div>
  </section>

  <!-- 05 · The Twelve -->
  <section class="section container" id="signs">
    <div class="section-head reveal">
      <h2>The twelve signs</h2>
      <p>A full guide to each: character, relationships, history, and what the sign means across your chart.</p>
    </div>
    <div class="twelve">
      {SIGNS.map((s, i) => (
        <a class="tile reveal" href={`/${s.slug}/`} style={`--sign:${s.hue};--reveal-delay:${(i % 6) * 45}ms`}>
          <div class="twelve__card">
            <SignIcon sign={s.slug} size={64} />
            <strong>{s.name}</strong>
            <span class="mono twelve__dates">{s.dates}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 06 · Three pillars -->
  <section class="section container">
    <div class="section-head reveal">
      <h2>Learn your signs. Save what matters.</h2>
      <p>Three parts to the site, and you can start anywhere.</p>
    </div>
    <div class="pillars">
      <div class="pillar reveal">
        <em class="kicker">Learn</em>
        <h3>A guide to every sign</h3>
        <p>Twelve sign guides, the big three explained, and plain-language help for reading your chart.</p>
        <a href="/learn/">Start here →</a>
      </div>
      <div class="pillar reveal" style="--reveal-delay:80ms">
        <em class="kicker">Calculate</em>
        <h3>Free astrology tools</h3>
        <p>Birth chart, moon, rising, compatibility, and transits, calculated privately in your browser.</p>
        <a href="/tools/">Open the tools →</a>
      </div>
      <div class="pillar reveal" style="--reveal-delay:160ms">
        <em class="kicker">Keep</em>
        <h3>Saved charts</h3>
        <p>Save a chart, return to it, and keep the people you care about close. Sign in only when you want sync.</p>
        <a href="/profile/">Saved charts →</a>
      </div>
    </div>
  </section>

  <!-- 07 · Persona doors -->
  <section class="section--tight container">
    <div class="doors">
      <a class="door reveal" href="/learn/">
        <em class="kicker">New here</em>
        <span class="door__title">Start with the big three</span>
        <span class="door__sub">Sun, moon, and rising, in about ten minutes.</span>
      </a>
      <a class="door reveal" href="/birth-chart/" style="--reveal-delay:70ms">
        <em class="kicker">Know your way around a chart</em>
        <span class="door__title">Choose your house system</span>
        <span class="door__sub">Whole sign or Placidus, with details when you want them.</span>
      </a>
      <a class="door door--collect reveal" href="/collect/" style="--reveal-delay:140ms">
        <em class="kicker">A collector</em>
        <span class="door__title">The collector's wing</span>
        <span class="door__sub">The Registry, a museum of the Twelve.</span>
      </a>
    </div>
  </section>

  <!-- 08 · FAQ -->
  <section class="section container container--narrow">
    <div class="section-head reveal"><h2>Common questions</h2></div>
    <div class="faq reveal">
      {faq.map(({ q, a }) => (
        <details class="faq__item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- 09 · Close -->
  <section class="section container close">
    <h2 class="display reveal">Start with your birth chart.</h2>
    <div class="reveal" style="--reveal-delay:120ms">
      <a class="btn btn--primary" href="/birth-chart/"><span>Get your free birth chart</span><span class="orb">↗</span></a>
    </div>
  </section>
</Base>

<style>
  /* ── Hero — the rounded cinematic frame ── */
  .hero {
    /* Cancel main's nav clearance so the frame rises behind the fixed
       nav pill — the liquid-glass capsule then refracts the footage from
       the first paint instead of empty void. The headline keeps clear of
       the nav via the content padding below. */
    margin-top: calc(-1 * var(--nav-space, 96px));
    width: min(100% - 32px, 1440px);
    padding-block: 0 clamp(14px, 2vw, 22px);
  }
  .hero__frame {
    position: relative;
    overflow: hidden;
    border-radius: clamp(18px, 2.6vw, 30px);
    /* Frame now starts at the top of the viewport; fill it, leaving a
       small peek of the ticker waiting below. */
    min-height: clamp(600px, calc(100svh - 40px), 900px);
    background: var(--void-1);
    /* A hairline ring keeps the frame editorial rather than app-like. */
    box-shadow:
      inset 0 0 0 1px rgba(198, 204, 218, 0.10),
      0 30px 80px -40px rgba(0, 0, 0, 0.8);
    isolation: isolate;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    transform: scale(1.035);
    transform-origin: center;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg,
        rgba(6, 7, 9, 0.58) 0%,
        rgba(6, 7, 9, 0.34) 30%,
        rgba(6, 7, 9, 0.22) 56%,
        rgba(6, 7, 9, 0.70) 88%,
        rgba(6, 7, 9, 0.88) 100%);
  }
  .hero__content {
    position: relative;
    z-index: 2;
    height: 100%;
    min-height: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    /* Top padding clears the fixed nav (now overlapping the frame) plus
       any notch inset; sides and bottom unchanged. */
    padding: calc(clamp(100px, 13svh, 132px) + env(safe-area-inset-top)) clamp(22px, 4vw, 56px) clamp(28px, 5vw, 64px);
    text-align: center;
  }
  .hero__title {
    margin: 0 0 clamp(14px, 2vw, 20px);
    font-family: var(--font-sans);
    font-weight: 690;
    font-size: clamp(2.4rem, 0.95rem + 5.9vw, 6rem);
    line-height: 0.94;
    letter-spacing: 0.002em;
    text-transform: uppercase;
    max-width: 9.53em; /* 14ch of Instrument — font-independent so fallback text can't resize the box */
    color: var(--ink-0, #EEF1F7);
    text-wrap: balance;
    text-shadow: 0 2px 28px rgba(6, 7, 9, 0.55);
  }
  /* The second thought lands a register lower — hierarchy inside one voice. */
  .hero__title em {
    font-style: normal;
    color: var(--ink-1, #C6CCDA);
  }
  /* Headline pins to the top; the caption and buttons sink to the base
     of the frame over the footage. */
  .hero__foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(20px, 3vw, 28px);
  }
  .hero__sub {
    margin: 0;
    max-width: 31.97em; /* 48ch of Instrument */
    color: var(--ink-1, #C6CCDA);
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.125rem);
    line-height: 1.6;
    text-wrap: pretty;
    text-shadow: 0 1px 18px rgba(6, 7, 9, 0.6);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  /* Ghost button needs its own footing on live footage. The frosted floor
     (background + -webkit-backdrop-filter blur) is what Safari/iOS renders — a
     little heavier so it reads as glass, not a see-through outline. */
  .hero__ghost {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0) 46%),
      rgba(10, 12, 17, 0.46);
    /* brightness() lifts the dark, scrimmed footage behind the button so the
       frost is actually visible; the inset rim is the glass catch-light. */
    backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    -webkit-backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    border-color: rgba(238, 241, 247, 0.42);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -12px 22px -14px rgba(255, 255, 255, 0.08),
      0 8px 26px -12px rgba(0, 0, 0, 0.5);
  }
  .hero__ghost:hover { background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 46%), rgba(10, 12, 17, 0.6); }

  /* Primary CTA wears the same lens as the nav — a translucent capsule over
     the footage rather than a solid slab — but its arrow disc stays a solid
     white token so the call to action still reads as the bright anchor. */
  .hero__ctas .btn--primary {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 46%),
      rgba(10, 12, 17, 0.46);
    backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    -webkit-backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    border-color: rgba(238, 241, 247, 0.46);
    color: var(--ink-0, #EEF1F7);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.34),
      inset 0 -12px 22px -14px rgba(255, 255, 255, 0.08),
      0 8px 26px -12px rgba(0, 0, 0, 0.5);
  }
  .hero__ctas .btn--primary:hover {
    background: rgba(10, 12, 17, 0.6);
    border-color: rgba(238, 241, 247, 0.42);
  }
  .hero__ctas .btn--primary .orb {
    background: var(--ink-0, #EEF1F7);
    border-color: rgba(238, 241, 247, 0.5);
    color: var(--void-0, #060709);
  }
  .hero__ctas .btn--primary:hover .orb { background: #ffffff; }

  /* ── Liquid glass (homepage chrome) ──
     Everyone gets the frosted blur floor above — it renders on Safari/iOS via
     -webkit-backdrop-filter, so the buttons and nav read as real glass there.
     Chromium additionally refracts the backdrop through the SVG capsule lens,
     gated by the .zdx-lens class (added by a tiny inline script only on
     Chromium): Safari reports support for url() backdrop filters but paints
     nothing, which would otherwise leave these controls flat and transparent. */
  .glass-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  :global(html.zdx-lens) .hero__ghost {
    background: rgba(10, 12, 17, 0.34);
    backdrop-filter: url(#zdx-lens-cta);
    -webkit-backdrop-filter: url(#zdx-lens-cta);
    border-color: rgba(238, 241, 247, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.20),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06),
      0 10px 30px -12px rgba(0, 0, 0, 0.55);
  }
  :global(html.zdx-lens) .hero__ghost:hover { background: rgba(10, 12, 17, 0.5); }
  :global(html.zdx-lens) .hero__ctas .btn--primary {
    background: rgba(10, 12, 17, 0.34);
    backdrop-filter: url(#zdx-lens-cta);
    -webkit-backdrop-filter: url(#zdx-lens-cta);
    border-color: rgba(238, 241, 247, 0.30);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.20),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06),
      0 10px 30px -12px rgba(0, 0, 0, 0.55);
  }
  :global(html.zdx-lens) .hero__ctas .btn--primary:hover { background: rgba(10, 12, 17, 0.5); }
  :global(html.zdx-lens .nav-wrap .nav) {
    background: rgba(10, 12, 17, 0.56);
    backdrop-filter: url(#zdx-lens-nav);
    -webkit-backdrop-filter: url(#zdx-lens-nav);
    box-shadow:
      inset 0 1px 0 rgba(238, 241, 247, 0.10),
      inset 0 -1px 0 rgba(238, 241, 247, 0.04),
      0 12px 32px -14px rgba(0, 0, 0, 0.7);
  }
  /* Reduced transparency: solid, no blur — applies to the frosted floor and
     the Chromium lens alike. */
  @media (prefers-reduced-transparency: reduce) {
    .hero__ghost,
    .hero__ctas .btn--primary {
      background: rgba(10, 12, 17, 0.86);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    :global(html .nav-wrap .nav) {
      background: rgba(10, 12, 17, 0.92);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (max-width: 640px) {
    .hero { width: min(100% - 20px, 1440px); }
    .hero__frame { min-height: clamp(540px, calc(100svh - 56px), 760px); }
    .hero__content { padding: calc(clamp(96px, 15svh, 120px) + env(safe-area-inset-top)) 18px 22px; }
    .hero__title {
      max-width: 7.49em; /* 11ch of Instrument */
      font-size: clamp(2.25rem, 11.5vw, 3.55rem);
      line-height: 0.95;
    }
    .hero__sub {
      max-width: 20.65em; /* 31ch of Instrument */
      font-size: 0.98rem;
      line-height: 1.52;
    }
    .hero__ctas .btn { flex: 1 1 auto; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__frame { box-shadow: inset 0 0 0 1px rgba(198, 204, 218, 0.10); }
  }

  /* Welcome-back strip + sky ticker styles live in ../styles/today.css
     (shared with /es/, which renders the same islands). */

  /* ── Tools ── */
  .home-tools { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .home-tools { grid-template-columns: repeat(4, 1fr); } }
  .home-tool {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 26px 22px 22px;
    min-height: 196px;
  }
  /* Tool-card icon disc lives in ToolGlyph.astro (shared with /es/). */
  .home-tool h3 { margin: 2px 0 0; font-size: var(--text-base); font-weight: 620; letter-spacing: -0.01em; color: var(--text); }
  .home-tool p { margin: 0; font-size: 13px; color: var(--text-2); line-height: 1.55; }
  .home-tool__go {
    margin-top: auto;
    padding-top: 12px;
    font-size: 12.5px;
    font-weight: 550;
    color: var(--muted);
    transition: color var(--dur-1) var(--ease);
  }
  .tile:hover .home-tool__go { color: var(--text); }

  /* ── Demo ── */
  :global(.demo) { display: grid; gap: 22px; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 960px) { :global(.demo) { grid-template-columns: 1.15fr 0.85fr; } }
  :global(.demo__wheel-core) { padding: clamp(14px, 2.5vw, 26px); }
  :global(.demo__receipt) { margin: 12px 0 0; text-align: center; font-size: 10.5px; letter-spacing: 0.06em; color: var(--faint); }
