---
import Base from '../layouts/Base.astro';
import SignIcon from '../components/SignIcon.astro';
import ZodiacWheelHero from '../islands/ZodiacWheelHero';
import SkyTicker from '../islands/SkyTicker';
import DemoChart from '../islands/DemoChart';
import { SIGNS } from '../lib/signs';

const faq = [
  {
    q: 'Is it free?',
    a: 'Yes. Every calculator and guide is free, with no account and no paywall. Charts are computed in your own browser, so there is nothing to sell you.',
  },
  {
    q: 'How accurate are the charts?',
    a: 'Planetary positions come from a professional-grade astronomical engine, tested automatically against NASA JPL reference data to within a few hundredths of a degree. Time zones are resolved against the complete historical database, including pre-1922 local mean time. Every chart lists its computed UTC instant, so you can check it.',
  },
  {
    q: 'What happens to my birth data?',
    a: 'It never leaves your device. The calculation runs entirely in your browser. There is no upload, no account, and no server that sees your birth details. Saving a chart stores it in your own browser only.',
  },
  {
    q: 'What is Astrofolio?',
    a: 'Astrofolio is where the charts you calculate are kept: your saved charts, the relationships you follow, your cosmic profile. It starts on this device, free and without an account. Syncing across devices comes next.',
  },
  {
    q: 'What is the Registry?',
    a: 'The collector’s wing of the site: a museum-style catalogue of the twelve signs as canonical records, with its own archive and thesis. It is deliberately separate from the astrology tools. Visit it if collecting interests you, or ignore it entirely.',
  },
];

const jsonLd = [
  {
    '@type': 'Organization',
    '@id': 'https://zodiacs.org/#org',
    name: 'Zodiacs',
    alternateName: 'Zodiacs.org',
    url: 'https://zodiacs.org/',
    logo: 'https://zodiacs.org/assets/og/v2/share.png',
    sameAs: [
      'https://x.com/astrofoliosol',
      'https://www.instagram.com/astrofolioonsol/',
      'https://tiktok.com/@astrofolio',
      'https://t.me/astrofoliosol',
      'https://astrofolio.xyz/',
      'https://github.com/ZodiacsOfficial/sdk',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': 'https://zodiacs.org/#site',
    url: 'https://zodiacs.org/',
    name: 'Zodiacs.org',
    description: 'Free birth charts, sign guides, and astrology tools — computed on your device.',
    publisher: { '@id': 'https://zodiacs.org/#org' },
    inLanguage: 'en',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

const tools = [
  { href: '/birth-chart/', title: 'Birth chart', promise: 'The whole map — planets, houses, aspects.', hue: 'var(--sign-cancer)', glyph: '☉' },
  { href: '/moon-sign/', title: 'Moon sign', promise: 'How you feel — found in twenty seconds.', hue: 'var(--sign-pisces)', glyph: '☽' },
  { href: '/rising-sign/', title: 'Rising sign', promise: 'How people first read you.', hue: 'var(--sign-libra)', glyph: 'ASC' },
  { href: '/compatibility/', title: 'Compatibility', promise: 'Two charts, honestly compared.', hue: 'var(--sign-leo)', glyph: '☌' },
];
---
<Base
  title="Zodiacs.org — Free Birth Charts, Sign Guides & Astrology Tools"
  description="Your whole chart, not just your sign. Calculate a free birth chart, moon sign, and rising sign, computed precisely on your device and explained clearly."
  path="/"
  jsonLd={jsonLd}
>
  <!-- Legacy hash deep-links (the registry SPA lived here) → the wing. -->
  <script is:inline>
    (function () {
      var h = location.hash;
      if (['#verify', '#registry', '#official-twelve', '#sdk', '#market', '#faq-registry', '#identity', '#pulse', '#standings'].indexOf(h) !== -1) {
        location.replace('/collect/' + h);
      }
    })();
  </script>

  <!-- 01 · Hero -->
  <section class="hero container">
    <div class="hero__copy">
      <h1 class="display hero__title reveal">Your whole chart, not just your sign.</h1>
      <p class="hero__sub reveal" style="--reveal-delay:90ms">
        Enter your birth date, time, and place, and see every planet, house,
        and aspect. Calculated exactly, and kept entirely on your device.
      </p>
      <div class="hero__ctas reveal" style="--reveal-delay:150ms">
        <a class="btn btn--primary" href="/birth-chart/"><span>Calculate my chart</span><span class="orb">↗</span></a>
        <a class="btn btn--ghost" href="/learn/"><span>Read the twelve signs</span></a>
      </div>
    </div>
    <div class="hero__wheel reveal" style="--reveal-delay:120ms">
      <ZodiacWheelHero client:load />
    </div>
  </section>

  <!-- 02 · The sky, right now -->
  <section class="container ticker-band reveal">
    <SkyTicker client:load />
  </section>

  <!-- 03 · Tools -->
  <section class="section container">
    <div class="section-head reveal">
      <h2>The calculators</h2>
      <p>Each one computes from the real position of the sky at your birth. Free, and private by default.</p>
    </div>
    <div class="home-tools">
      {tools.map((t, i) => (
        <a class="tile reveal" href={t.href} style={`--sign:${t.hue};--reveal-delay:${i * 60}ms`}>
          <div class="home-tool">
            <span class="home-tool__glyph mono">{t.glyph}</span>
            <h3>{t.title}</h3>
            <p>{t.promise}</p>
            <span class="home-tool__go">Open →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 04 · Demo chart -->
  <section class="section container">
    <div class="section-head reveal">
      <h2>A worked example</h2>
      <p>Frida Kahlo's chart, calculated from the 1907 sky and read back in plain terms.</p>
    </div>
    <div class="reveal">
      <DemoChart client:visible />
    </div>
  </section>

  <!-- 05 · The Twelve -->
  <section class="section container" id="signs">
    <div class="section-head reveal">
      <h2>The twelve signs</h2>
      <p>A full guide to each: character, relationships, history, and what the sign means across your chart.</p>
    </div>
    <div class="twelve">
      {SIGNS.map((s, i) => (
        <a class="tile reveal" href={`/${s.slug}/`} style={`--sign:${s.hue};--reveal-delay:${(i % 6) * 45}ms`}>
          <div class="twelve__card">
            <SignIcon sign={s.slug} size={64} />
            <strong>{s.name}</strong>
            <span class="mono twelve__dates">{s.dates}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 06 · Three pillars -->
  <section class="section container">
    <div class="section-head reveal">
      <h2>Learn, calculate, keep</h2>
      <p>Three parts to the site, and you can start anywhere.</p>
    </div>
    <div class="pillars">
      <div class="pillar reveal">
        <em class="kicker">Learn</em>
        <h3>A guide to every sign</h3>
        <p>Twelve sign guides, the big three explained, and how to read a chart, with the jargon translated as it comes up.</p>
        <a href="/learn/">Start here →</a>
      </div>
      <div class="pillar reveal" style="--reveal-delay:80ms">
        <em class="kicker">Calculate</em>
        <h3>Calculators for your real sky</h3>
        <p>Birth chart, moon, and rising, with astronomical accuracy and historical time zones. Every result is checkable.</p>
        <a href="/tools/">Open the tools →</a>
      </div>
      <div class="pillar reveal" style="--reveal-delay:160ms">
        <em class="kicker">Keep</em>
        <h3>A place to keep your charts</h3>
        <p>Save a chart, return to it, and gather the people you care about. It lives on your device. Optional, and free.</p>
        <a href="/profile/">Your profile →</a>
      </div>
    </div>
  </section>

  <!-- 07 · Persona doors -->
  <section class="section--tight container">
    <div class="doors">
      <a class="door reveal" href="/learn/">
        <em class="kicker">New here</em>
        <span class="door__title">Start with the big three</span>
        <span class="door__sub">Sun, moon, and rising, in about ten minutes.</span>
      </a>
      <a class="door reveal" href="/birth-chart/" style="--reveal-delay:70ms">
        <em class="kicker">Know your way around a chart</em>
        <span class="door__title">The full chart, your house system</span>
        <span class="door__sub">Whole sign or Placidus, with every aspect.</span>
      </a>
      <a class="door door--collect reveal" href="/collect/" style="--reveal-delay:140ms">
        <em class="kicker">A collector</em>
        <span class="door__title">The collector's wing</span>
        <span class="door__sub">The Registry, a museum of the Twelve.</span>
      </a>
    </div>
  </section>

  <!-- 08 · FAQ -->
  <section class="section container container--narrow">
    <div class="section-head reveal"><h2>Common questions</h2></div>
    <div class="faq reveal">
      {faq.map(({ q, a }) => (
        <details class="faq__item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- 09 · Close -->
  <section class="section container close">
    <h2 class="display reveal">Begin with your own chart.</h2>
    <div class="reveal" style="--reveal-delay:120ms">
      <a class="btn btn--primary" href="/birth-chart/"><span>Calculate my chart</span><span class="orb">↗</span></a>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
    padding-block: clamp(40px, 7vw, 108px);
  }
  @media (min-width: 900px) { .hero { grid-template-columns: 1.05fr 0.95fr; } }
  .hero__title {
    margin: 0 0 24px;
    font-size: var(--text-hero);
    line-height: 0.98;
    max-width: 15ch;
  }
  .hero__sub {
    margin: 0 0 32px;
    max-width: 48ch;
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: 1.62;
    text-wrap: pretty;
  }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__wheel { display: grid; place-items: center; }

  /* Wheel hero (island styles are global by necessity) */
  :global(.wheelhero) {
    position: relative;
    width: min(78vw, 440px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  :global(.wheelhero__halo) {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    border: 1px solid var(--hair-1);
    background:
      radial-gradient(48% 48% at 50% 50%, rgba(198, 204, 218, 0.05), transparent 70%);
  }
  :global(.wheelhero__ring) { position: absolute; inset: 0; animation: orbit 120s linear infinite; }
  :global(.wheelhero__spoke) { position: absolute; inset: 0; transform: rotate(var(--a)); }
  :global(.wheelhero__arm) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) translateY(calc(min(78vw, 440px) / -2 + 9%));
  }
  :global(.wheelhero__counter) { transform: rotate(var(--na)); animation: orbit 120s linear infinite reverse; }
  :global(.wheelhero__icon) { position: relative; display: block; line-height: 0; }
  :global(.wheelhero__icon img) {
    border-radius: 50%;
    width: clamp(36px, 9vw, 52px);
    height: auto;
    transition: transform var(--dur-2) var(--ease);
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.45));
  }
  :global(.wheelhero__icon:hover img) { transform: scale(1.12); }
  :global(.wheelhero__tip) {
    position: absolute;
    left: 50%;
    top: calc(100% + 6px);
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-1);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease);
    pointer-events: none;
    white-space: nowrap;
  }
  :global(.wheelhero__icon:hover .wheelhero__tip) { opacity: 1; }
  :global(.wheelhero:hover .wheelhero__ring),
  :global(.wheelhero:hover .wheelhero__counter) { animation-play-state: paused; }
  :global(.wheelhero__core) {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 4px;
    z-index: 2;
  }
  :global(.wheelhero__phase) { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-2); }
  :global(.wheelhero__moonsign) { font-size: 10px; color: var(--faint); letter-spacing: 0.08em; }
  @keyframes orbit { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    :global(.wheelhero__ring), :global(.wheelhero__counter) { animation: none !important; }
  }

  /* ── Ticker ── */
  .ticker-band {
    border-block: 1px solid var(--hair-1);
    padding-block: 14px;
  }
  :global(.skyticker) {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--text-2);
  }
  :global(.skyticker__label) {
    font-style: italic;
    font-family: var(--font-serif);
    font-size: 14px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--muted);
    margin-right: 10px;
  }
  :global(.skyticker__sep) { color: var(--faint); margin-right: 10px; }

  /* ── Tools ── */
  .home-tools { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .home-tools { grid-template-columns: repeat(4, 1fr); } }
  .home-tool { display: flex; flex-direction: column; gap: 8px; padding: 24px 20px; min-height: 176px; }
  .home-tool__glyph { font-size: 21px; color: var(--sign); }
  .home-tool h3 { margin: 2px 0 0; font-size: var(--text-base); font-weight: 620; letter-spacing: -0.01em; color: var(--text); }
  .home-tool p { margin: 0; font-size: 13px; color: var(--text-2); line-height: 1.55; }
  .home-tool__go { margin-top: auto; font-size: 12.5px; font-weight: 550; color: var(--text); }

  /* ── Demo ── */
  :global(.demo) { display: grid; gap: 22px; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 960px) { :global(.demo) { grid-template-columns: 1.15fr 0.85fr; } }
  :global(.demo__wheel-core) { padding: clamp(14px, 2.5vw, 26px); }
  :global(.demo__receipt) { margin: 12px 0 0; text-align: center; font-size: 10.5px; letter-spacing: 0.06em; color: var(--faint); }
  :global(.demo__callouts) { display: grid; gap: 12px; align-content: start; }
  :global(.demo__callout) {
    display: grid;
    gap: 5px;
    padding: 14px 16px;
    border: 1px solid color-mix(in oklab, var(--sign) 30%, transparent);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--sign) 6%, transparent);
  }
  :global(.demo__callout strong) { font-size: var(--text-lg); letter-spacing: -0.01em; }
  :global(.demo__callout p) { margin: 0; font-size: var(--text-sm); color: var(--text-2); line-height: 1.55; }
  :global(.demo__cta-line) { margin: 8px 0 2px; font-size: var(--text-sm); color: var(--muted); line-height: 1.6; }
  :global(.demo__cta-line strong) { color: var(--text); }

  /* ── The Twelve ── */
  .twelve { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 640px) { .twelve { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 960px) { .twelve { grid-template-columns: repeat(6, 1fr); } }
  .twelve__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 11px;
    padding: 26px 12px 20px;
    text-align: center;
  }
  .twelve__card strong { font-size: 15px; font-weight: 600; color: var(--text); }
  .twelve__dates { font-size: 9.5px; color: var(--faint); letter-spacing: 0.05em; }

  /* ── Pillars ── */
  .pillars { display: grid; gap: 20px; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .pillars { grid-template-columns: repeat(3, 1fr); } }
  .pillar {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 4px 0;
    border-top: 1px solid var(--hair-2);
  }
  .pillar .kicker { margin-top: 18px; color: var(--muted); font-size: var(--text-base); }
  .pillar h3 { margin: 0; font-size: var(--text-lg); font-weight: 620; letter-spacing: -0.015em; }
  .pillar p { margin: 0; font-size: var(--text-sm); color: var(--text-2); line-height: 1.62; }
  .pillar a { margin-top: 4px; font-size: 13.5px; font-weight: 550; color: var(--text); text-decoration: none; }
  .pillar a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ── Doors ── */
  .doors { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .doors { grid-template-columns: repeat(3, 1fr); } }
  .door {
    display: grid;
    gap: 5px;
    padding: 22px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-lg);
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease), background var(--dur-2) var(--ease);
  }
  .door:hover { border-color: var(--hair-3); background: rgba(198, 204, 218, 0.03); }
  .door .kicker { font-size: var(--text-base); color: var(--faint); margin-bottom: 2px; }
  .door__title { font-size: var(--text-base); font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
  .door__sub { font-size: 13px; color: var(--muted); }

  /* ── FAQ ── */
  .faq { display: grid; gap: 8px; }
  .faq__item {
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
    padding: 4px 18px;
  }
  .faq__item summary { cursor: pointer; padding: 12px 0; font-weight: 550; color: var(--text); }
  .faq__item p { margin: 2px 0 16px; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; }

  /* ── Close ── */
  .close { text-align: center; }
  .close h2 {
    margin: 0 0 30px;
    font-size: var(--text-2xl);
  }
</style>
