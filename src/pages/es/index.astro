---
import Base from '../../layouts/Base.astro';
import SignIcon from '../../components/SignIcon.astro';
import SkyTicker from '../../islands/SkyTicker';
import WelcomeBack from '../../islands/WelcomeBack';
import { SIGNS, signDates, signName } from '../../lib/signs';
import { localizePath } from '../../lib/i18n';

const tools = [
  { href: '/birth-chart/', title: 'Carta natal', promise: 'Tu Sol, Luna, ascendente, planetas, casas y lo que significan.', hue: 'var(--sign-cancer)', glyph: '☉' },
  { href: '/moon-sign/', title: 'Signo lunar', promise: 'Cómo sientes, qué te calma y qué necesitas para sentirte en casa.', hue: 'var(--sign-pisces)', glyph: '☽' },
  { href: '/rising-sign/', title: 'Ascendente', promise: 'La primera impresión que das y cómo se ordena tu carta.', hue: 'var(--sign-libra)', glyph: 'ASC' },
  { href: '/compatibility/', title: 'Compatibilidad', promise: 'Compara dos cartas y mira dónde conectan, chocan y crecen.', hue: 'var(--sign-leo)', glyph: '☌' },
];

const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': 'https://zodiacs.org/es/#site',
    url: 'https://zodiacs.org/es/',
    name: 'Zodiacs.org en español',
    description: 'Cartas natales gratis, signo lunar, compatibilidad, horóscopos y guías de signos, privadas y fáciles de entender.',
    publisher: { '@type': 'Organization', name: 'Zodiacs.org', url: 'https://zodiacs.org/' },
    inLanguage: 'es',
  },
];
---
<Base
  title="Zodiacs.org en español — cartas natales gratis y astrología fácil"
  description="Cartas natales gratis, signo lunar, ascendente, compatibilidad, horóscopos y guías de signos: precisas, privadas y fáciles de entender."
  path="/es/"
  locale="es"
  jsonLd={jsonLd}
>
  <section class="hero-es container">
    <div class="hero-es__frame reveal">
      <video
        class="hero-es__video"
        src="/assets/hero/zodiacs-hero.mp4"
        poster="/assets/hero/zodiacs-hero-poster.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        disablepictureinpicture
        aria-hidden="true"
        tabindex="-1"
        data-hero-video-es
      ></video>
      <div class="hero-es__scrim" aria-hidden="true"></div>
      <div class="hero-es__content">
        <h1>Explora las estrellas detrás de tu historia.</h1>
        <p>Cartas natales, signo lunar, compatibilidad y horóscopos gratis: precisos, privados y fáciles de entender.</p>
        <div class="hero-es__ctas">
          <a class="btn btn--primary" href={localizePath('es', '/birth-chart/')}><span>Obtén tu carta natal gratis</span><span class="orb">↗</span></a>
          <a class="btn btn--ghost hero-es__ghost" href="/horoscopes/"><span>Ver pronósticos</span></a>
        </div>
      </div>
    </div>
    <script is:inline>
      // Reduced-motion visitors keep the poster; the footage never forces itself.
      (function () {
        var v = document.querySelector('[data-hero-video-es]');
        if (v && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          v.removeAttribute('autoplay');
          v.preload = 'none';
          try { v.pause(); v.currentTime = 0; } catch (e) { /* not yet loaded — poster stays */ }
        }
      })();
    </script>
  </section>

  <WelcomeBack client:load locale="es" />

  <section class="container ticker-band reveal">
    <SkyTicker client:load locale="es" />
  </section>

  <section class="section container">
    <div class="section-head reveal">
      <h2>Empieza con tu carta</h2>
      <p>Encuentra tu carta natal, signo lunar, ascendente, compatibilidad y lo que está pasando en el cielo ahora.</p>
    </div>
    <div class="home-tools-es">
      {tools.map((tool, i) => (
        <a class="tile reveal" href={localizePath('es', tool.href)} style={`--sign:${tool.hue};--reveal-delay:${i * 60}ms`}>
          <div class="home-tool-es">
            <span class="home-tool-es__glyph mono">{tool.glyph}</span>
            <h3>{tool.title}</h3>
            <p>{tool.promise}</p>
            <span class="home-tool-es__go">Abrir →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section container" id="signos">
    <div class="section-head reveal">
      <h2>Los doce signos</h2>
      <p>Guías claras para cada signo: personalidad, amor, compatibilidad y qué significa en tu carta.</p>
    </div>
    <div class="twelve-es">
      {SIGNS.map((sign, i) => (
        <a class="tile reveal" href={localizePath('es', `/${sign.slug}/`)} style={`--sign:${sign.hue};--reveal-delay:${(i % 6) * 45}ms`}>
          <div class="twelve-es__card">
            <SignIcon sign={sign.slug} size={64} />
            <strong>{signName(sign, 'es')}</strong>
            <span class="mono twelve-es__dates">{signDates(sign, 'es')}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section container close-es">
    <h2 class="display reveal">Empieza con tu carta natal.</h2>
    <div class="reveal" style="--reveal-delay:120ms">
      <a class="btn btn--primary" href={localizePath('es', '/birth-chart/')}><span>Obtén tu carta natal gratis</span><span class="orb">↗</span></a>
    </div>
  </section>
</Base>

<style>
  .hero-es {
    width: min(100% - 32px, 1440px);
    padding-block: 0 clamp(14px, 2vw, 22px);
  }
  .hero-es__frame {
    position: relative;
    overflow: hidden;
    border-radius: clamp(18px, 2.6vw, 30px);
    min-height: clamp(560px, calc(100svh - 128px), 860px);
    background: var(--void-1);
    box-shadow: inset 0 0 0 1px rgba(198, 204, 218, 0.10), 0 30px 80px -40px rgba(0, 0, 0, 0.8);
    isolation: isolate;
  }
  .hero-es__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    transform: scale(1.035);
  }
  .hero-es__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(6, 7, 9, 0.62) 0%, rgba(6, 7, 9, 0.34) 36%, rgba(6, 7, 9, 0.72) 100%);
  }
  .hero-es__content {
    position: relative;
    z-index: 2;
    min-height: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: clamp(88px, 12svh, 124px) clamp(22px, 4vw, 56px) clamp(28px, 5vw, 64px);
    text-align: center;
  }
  .hero-es h1 {
    margin: 0 0 clamp(14px, 2vw, 20px);
    max-width: 14ch;
    font-family: var(--font-sans);
    font-size: clamp(2.35rem, 0.95rem + 5.8vw, 5.9rem);
    line-height: 0.95;
    font-weight: 690;
    text-transform: uppercase;
    color: var(--ink-0, #EEF1F7);
    text-wrap: balance;
    text-shadow: 0 2px 28px rgba(6, 7, 9, 0.55);
  }
  .hero-es p {
    margin: 0 0 clamp(20px, 3vw, 28px);
    max-width: 50ch;
    color: var(--ink-1, #C6CCDA);
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.125rem);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .hero-es__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .hero-es__ghost {
    background: rgba(10, 12, 17, 0.42);
    backdrop-filter: blur(10px) saturate(130%);
    -webkit-backdrop-filter: blur(10px) saturate(130%);
    border-color: rgba(198, 204, 218, 0.28);
  }
  .ticker-band { border-block: 1px solid var(--hair-1); padding-block: 14px; }
  .home-tools-es { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .home-tools-es { grid-template-columns: repeat(4, 1fr); } }
  .home-tool-es { display: flex; flex-direction: column; gap: 9px; padding: 26px 22px 22px; min-height: 196px; }
  .home-tool-es__glyph {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--sign) 40%, transparent);
    color: var(--sign);
  }
  .home-tool-es h3 { margin: 2px 0 0; font-size: var(--text-base); font-weight: 620; color: var(--text); }
  .home-tool-es p { margin: 0; font-size: 13px; color: var(--text-2); line-height: 1.55; }
  .home-tool-es__go { margin-top: auto; padding-top: 12px; font-size: 12.5px; color: var(--muted); }
  .twelve-es { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 640px) { .twelve-es { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 960px) { .twelve-es { grid-template-columns: repeat(6, 1fr); } }
  .twelve-es__card { display: flex; flex-direction: column; align-items: center; gap: 11px; padding: 26px 12px 20px; text-align: center; }
  .twelve-es__card strong { font-size: 15px; font-weight: 600; color: var(--text); }
  .twelve-es__dates { font-size: 9.5px; color: var(--faint); letter-spacing: 0.05em; }
  .close-es { text-align: center; }
  .close-es h2 { margin: 0 0 30px; font-size: var(--text-2xl); }
  @media (max-width: 640px) {
    .hero-es { width: min(100% - 20px, 1440px); }
    .hero-es__frame { min-height: clamp(520px, calc(100svh - 180px), 700px); }
    .hero-es__content { padding: clamp(86px, 14svh, 112px) 18px 22px; }
    .hero-es h1 { max-width: 11ch; font-size: clamp(2.2rem, 11vw, 3.45rem); }
    .hero-es p { max-width: 31ch; font-size: 0.98rem; line-height: 1.52; }
    .hero-es__ctas .btn { flex: 1 1 auto; justify-content: center; }
  }
</style>
