---
import HoroscopeProgramPage from '../../../components/HoroscopeProgramPage.astro';
import DailyForYou from '../../../islands/DailyForYou';
import programData from '../../../data/horoscope-program.json';
import { pageReadingFromProgram } from '../../../lib/horoscope-page-data';
import type { HoroscopeProgram } from '../../../lib/horoscope-program';
import { UI } from '../../../lib/i18n';
import { SIGNS, signBySlug } from '../../../lib/signs';

export function getStaticPaths() {
  return SIGNS.map((sign) => ({
    params: { sign: sign.slug },
    props: { signSlug: sign.slug },
  }));
}

const { signSlug } = Astro.props;
const sign = signBySlug(signSlug);
const program = programData as HoroscopeProgram;
const reading = pageReadingFromProgram(program, sign.slug, 'today');
const labels = {
  forYourChart: UI.en.forYourChart,
  whyThisReading: UI.en.whyThisReading,
  natal: UI.en.natal,
  orb: UI.en.orb,
  openDailyBrief: UI.en.openDailyBrief,
  allTransits: UI.en.allTransits,
};
---
<HoroscopeProgramPage signSlug={sign.slug} surface="today" reading={reading}>
  <DailyForYou slot="enhancement" client:visible sign={sign.slug} labels={labels} />
</HoroscopeProgramPage>
