---
import Base from '../../layouts/Base.astro';
import EditionText from '../../components/EditionText.astro';
import EvidenceDisclosure from '../../components/EvidenceDisclosure.astro';
import UpcomingEventLinks from '../../components/events/UpcomingEventLinks.astro';
import TodayBrief from '../../islands/today/TodayBrief';
import dailyData from '../../data/daily.json';
import publicationData from '../../data/daily-publication.json';
import type { Daily } from '../../lib/daily';
import type { DailyPublication } from '../../lib/daily-publication';
import { editionDateLabel } from '../../lib/edition-freshness';

const daily = dailyData as Daily;
const publication = publicationData as DailyPublication;
const publicationLabel = editionDateLabel(publication.date);
const sunSignLines = Object.fromEntries(
  publication.signs.map((entry) => [entry.sign, entry.todayLine.text]),
);
---
<Base
  inlineCriticalCss
  stableTypography
  localTypography
  title={`${publicationLabel} Daily Astrology Brief | Zodiacs.org`}
  description={`Choose your Sun sign for a clear note from the ${publicationLabel} UTC edition, or privately compare that sky with a birth chart saved on this device.`}
  path="/today/"
  imageAlt={`${publicationLabel} daily astrology brief — Zodiacs.org`}
  editionDate={publication.date}
>
  <script slot="head" is:inline>
    /* Local-only return-state hint. It carries no chart data: the boolean and
       validated sign let CSS establish the correct first-paint geometry
       before the idle island reads storage. */
    (function () {
      try {
        var sign = localStorage.getItem('zodiacs:today-sun-sign:v1');
        if (/^(aries|taurus|gemini|cancer|leo|virgo|libra|scorpio|sagittarius|capricorn|aquarius|pisces)$/.test(sign || '')) {
          document.documentElement.setAttribute('data-today-sun-sign', sign);
        }
        var rawProfile = localStorage.getItem('zodiacs.profile.v1');
        var profile = rawProfile ? JSON.parse(rawProfile) : null;
        var charts = profile && profile.version === 1 && Array.isArray(profile.charts)
          ? profile.charts.filter(function (chart) {
              return chart && typeof chart.id === 'string' && chart.id.length > 0
                && chart.summary && Array.isArray(chart.summary.bodies)
                && chart.summary.bodies.some(function (body) { return Number.isFinite(body && body.lon); });
            })
          : [];
        var newestChart = charts.reduce(function (latest, chart) {
          if (!latest) return chart;
          var chartStamp = typeof chart.updatedAt === 'string' ? chart.updatedAt : (chart.createdAt || '');
          var latestStamp = typeof latest.updatedAt === 'string' ? latest.updatedAt : (latest.createdAt || '');
          return chartStamp > latestStamp ? chart : latest;
        }, null);
        var rawTodayPreference = localStorage.getItem('zodiacs.today-chart.v1');
        var todayPreference = null;
        try { todayPreference = rawTodayPreference ? JSON.parse(rawTodayPreference) : null; } catch (error) {}
        var selectedChart = todayPreference && todayPreference.version === 1 && typeof todayPreference.chartId === 'string'
          ? charts.find(function (chart) { return chart.id === todayPreference.chartId; }) || null
          : null;
        selectedChart = selectedChart || newestChart;
        if (selectedChart && (!todayPreference || todayPreference.chartId !== selectedChart.id)) {
          localStorage.setItem('zodiacs.today-chart.v1', JSON.stringify({ version: 1, chartId: selectedChart.id }));
        } else if (!selectedChart && rawTodayPreference !== null) {
          localStorage.removeItem('zodiacs.today-chart.v1');
        }
        var hasUsableChart = selectedChart !== null;
        if (hasUsableChart) {
          document.documentElement.setAttribute('data-today-saved-chart', '');
          var sun = selectedChart.summary.bodies.find(function (body) {
            return body && body.body === 'Sun' && Number.isFinite(body.lon);
          });
          if (sun) {
            var signNames = ['aries', 'taurus', 'gemini', 'cancer', 'leo', 'virgo', 'libra', 'scorpio', 'sagittarius', 'capricorn', 'aquarius', 'pisces'];
            var longitude = ((sun.lon % 360) + 360) % 360;
            document.documentElement.setAttribute('data-today-chart-sun-sign', signNames[Math.floor(longitude / 30)]);
          }
        }
      } catch (error) {}
    })();
  </script>
  <section
    class="section--tight container container--narrow today-page"
    data-edition-content="true"
    data-daily-date={publication.date}
    data-generation-mode={publication.generation.mode}
  >
    <header class="today-hero">
      <em class="kicker">Your daily brief</em>
      <h1 class="display"><EditionText current="Today" editionDate={publication.date} /></h1>
      <p>
        Start with the zodiac sign you know. If you have a saved birth chart,
        you’ll automatically get a more personal comparison.
      </p>
    </header>

    <!-- The complete no-chart brief is server-rendered. This island owns all
         of its copy, so it needs neither the full client UI catalog nor eager
         hydration; personalization can wait until the first paint is idle. -->
    <TodayBrief client:idle sunSignLines={sunSignLines} />

    <UpcomingEventLinks date={publication.date} />

    {daily.eventsCoverage === 'unavailable' && (
      <p class="today-coverage-note">
        This edition uses planetary positions only; exact-event timing
        isn’t available for this date.
      </p>
    )}

    <EvidenceDisclosure
      class="today-provenance"
      variant="panel"
      label="Behind this daily reading"
      description="Sky details, limitations, and editorial standards"
    >
      <p>
        Each reading is tied to the recorded sky for{' '}
        <time datetime={publication.date}>{publication.date}</time>, the UTC
        edition date; planetary positions use a noon-UTC snapshot. Automated
        checks verify the sky facts, keep the twelve signs meaningfully distinct,
        and screen restricted advice before an edition is published.
      </p>
      <p class="evidence-disclosure__links today-provenance__links">
        <a href="/methodology/#daily-publication">How daily publication works</a>
        <a href="/data/daily-publication.json">View this edition’s record</a>
        <a href="/corrections/">Corrections</a>
      </p>
    </EvidenceDisclosure>
  </section>
</Base>

<style is:global>
  .today-page { max-width: 780px; }
  .today-hero { max-width: 60ch; margin-bottom: clamp(24px, 5vw, 40px); }
  .today-hero h1 {
    margin: 12px 0 12px;
    font-size: var(--text-2xl);
    line-height: 1.04;
  }
  .today-hero p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .today-coverage-note {
    margin: 18px 0 0;
    padding: 12px 14px;
    border-left: 2px solid var(--hair-2);
    color: var(--faint);
    font-size: var(--text-xs);
    line-height: 1.65;
  }
  .today-provenance { margin-top: 18px; }
  .today-card__core { padding: clamp(22px, 5vw, 38px); }
  .today-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--hair-1);
  }
  .today-card__date {
    margin: 0;
    color: var(--text);
    font-size: var(--text-lg);
    font-weight: 620;
    letter-spacing: -0.015em;
  }
  .today-card__time { margin: 4px 0 0; color: var(--faint); font-size: 11px; }
  .today-streak {
    display: grid;
    grid-template-columns: minmax(4ch, auto) 29px;
    align-items: baseline;
    gap: 5px;
    min-width: calc(4ch + 34px);
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
    visibility: hidden;
  }
  .today-streak[data-ready] { visibility: visible; }
  .today-streak__count {
    display: block;
    min-width: 4ch;
    color: var(--sign-cancer);
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 500;
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1;
    text-align: right;
    animation: today-streak-in 220ms var(--ease-soft) both;
  }
  @keyframes today-streak-in {
    from { opacity: 0.35; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .today-reading { display: grid; min-width: 0; gap: 24px; padding-top: 24px; }
  .today-returning-chart-placeholder { display: none; align-content: start; }
  :root[data-today-saved-chart] .today-fallback { display: none; }
  :root[data-today-saved-chart] .today-returning-chart-placeholder { display: grid; }
  .today-reading__body {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    min-height: 300px;
    min-width: 0;
    gap: 18px;
  }
  .today-reading__body--fallback {
    grid-template-rows: auto auto;
    align-content: space-between;
  }
  .today-returning-chart-status {
    min-height: 1.65em;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.65;
    visibility: hidden;
  }
  .today-returning-chart-status.is-visible { visibility: visible; }
  .today-returning-sun-baseline { display: none; gap: 8px; }
  .today-returning-sun-baseline p { margin: 0; max-width: 58ch; }
  .today-returning-sun-baseline > a { color: var(--sign); font-size: var(--text-sm); font-weight: 650; }
  .today-returning-sign-links { display: flex; flex-wrap: wrap; gap: 8px 14px; }
  .today-returning-sign-links a { color: var(--text-2); font-size: var(--text-sm); }
  :root[data-today-chart-sun-sign] .today-returning-sign-links { display: none; }
  :root[data-today-chart-sun-sign="aries"] [data-today-chart-sun="aries"],
  :root[data-today-chart-sun-sign="taurus"] [data-today-chart-sun="taurus"],
  :root[data-today-chart-sun-sign="gemini"] [data-today-chart-sun="gemini"],
  :root[data-today-chart-sun-sign="cancer"] [data-today-chart-sun="cancer"],
  :root[data-today-chart-sun-sign="leo"] [data-today-chart-sun="leo"],
  :root[data-today-chart-sun-sign="virgo"] [data-today-chart-sun="virgo"],
  :root[data-today-chart-sun-sign="libra"] [data-today-chart-sun="libra"],
  :root[data-today-chart-sun-sign="scorpio"] [data-today-chart-sun="scorpio"],
  :root[data-today-chart-sun-sign="sagittarius"] [data-today-chart-sun="sagittarius"],
  :root[data-today-chart-sun-sign="capricorn"] [data-today-chart-sun="capricorn"],
  :root[data-today-chart-sun-sign="aquarius"] [data-today-chart-sun="aquarius"],
  :root[data-today-chart-sun-sign="pisces"] [data-today-chart-sun="pisces"] { display: grid; }
  .today-reading__head h2,
  .today-fallback__intro h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-xl);
    font-weight: 620;
    letter-spacing: -0.02em;
  }
  .today-reading__head { min-width: 0; }
  .today-reading__head h2 { min-width: 0; }
  .today-reading__head h2:has(.today-reading__chart-name) {
    display: flex;
    gap: 0.24em;
  }
  .today-reading__chart-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .today-reading__head p,
  .today-fallback__intro p {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .today-chart-picker {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    max-width: 420px;
    margin-top: 13px;
  }
  .today-chart-picker > span {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .today-chart-picker select {
    min-width: 0;
    height: 38px;
    padding: 0 34px 0 12px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-md);
    background: var(--void-1);
    color: var(--text);
    font: inherit;
    font-size: var(--text-sm);
  }
  .today-chart-picker select:focus-visible { outline: 2px solid var(--ink-0); outline-offset: 2px; }
  .today-lines {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .today-lines li {
    padding: 18px 0 18px 18px;
    border-bottom: 1px solid var(--hair-1);
    border-left: 2px solid color-mix(in oklab, var(--sign-cancer) 70%, transparent);
  }
  .today-lines li:first-child { padding-top: 4px; }
  .today-lines li:last-child { padding-bottom: 4px; border-bottom: 0; }
  .today-lines__sentence {
    margin: 0;
    color: var(--text-2);
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.12rem);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .today-lines__ask {
    position: relative;
    display: inline-block;
    margin: 0 0 0 0.25em;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 11.5px;
    font-weight: 650;
    line-height: 1.4;
    white-space: nowrap;
  }
  .today-lines__ask::before { content: ''; position: absolute; inset: -14px -8px; }
  .today-lines__ask:hover { color: var(--text); }
  .today-lines__ask:focus-visible { outline: 2px solid var(--ink-0); outline-offset: 3px; }
  .today-lines__receipt {
    margin: 8px 0 0;
    color: var(--faint);
    font-size: 10.5px;
    line-height: 1.65;
  }
  .today-private {
    margin: 0;
    color: var(--faint);
    font-size: 12px;
    line-height: 1.7;
  }
  .today-coming-up {
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--hair-1);
  }
  .today-coming-up > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    cursor: pointer;
    list-style: none;
  }
  .today-coming-up > summary::-webkit-details-marker { display: none; }
  .today-coming-up > summary strong {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
  }
  .today-coming-up > summary:focus-visible { outline: 2px solid var(--ink-0); outline-offset: 3px; }
  .today-coming-up__next {
    display: inline-block;
    width: clamp(108px, 28vw, 160px);
    overflow: hidden;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9.5px;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .today-coming-up__body { display: grid; gap: 18px; padding-top: 18px; }
  .today-coming-up__group { display: grid; gap: 9px; }
  .today-coming-up__group h4 {
    margin: 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .today-coming-up__group ol {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .today-coming-up__group li {
    display: grid;
    grid-template-columns: minmax(66px, auto) minmax(0, 1fr);
    gap: 12px;
    padding: 12px 13px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--sign-cancer) 3%, var(--void-1));
  }
  .today-coming-up__group time {
    color: var(--sign-cancer);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.65;
    white-space: nowrap;
  }
  .today-coming-up__group p {
    margin: 0;
    color: var(--text-2);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .today-coming-up__quiet,
  .today-coming-up__privacy {
    margin: 0;
    color: var(--faint);
    font-size: 12px;
    line-height: 1.65;
  }
  .today-coming-up__privacy { padding-top: 2px; }
  .today-coming-up__method {
    display: grid;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--hair-1);
  }
  .today-coming-up__method > strong { color: var(--text-2); font-size: var(--text-sm); }
  .today-coming-up__method > p { margin: 0; color: var(--faint); font-size: 12px; line-height: 1.7; }
  .today-coming-up__method ul { display: grid; gap: 6px; margin: 0; padding-left: 18px; }
  .today-coming-up__method li { overflow-wrap: anywhere; font-family: var(--font-mono); font-size: 10.5px; }
  .today-fallback { display: grid; gap: 24px; padding-top: 24px; }
  .today-fallback__intro p { max-width: 56ch; }
  .today-fallback__intro .today-fallback__status {
    /* The ready-state sentence wraps to two lines at its 56ch measure. Keep
       both lines in the first-paint geometry even while the copy is hidden. */
    min-height: 3.2em;
    margin-top: 10px;
    color: var(--faint);
    font-size: 12px;
    visibility: hidden;
  }
  .today-fallback__status.is-visible { visibility: visible; }
  .today-sign-picker {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .today-sign-picker__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
  }
  .today-sign {
    display: grid;
    grid-template-rows: 34px 18px 16px;
    justify-items: center;
    align-content: start;
    min-width: 0;
    block-size: 88px;
    padding: 9px 5px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    color: var(--muted);
    background: var(--void-1);
    cursor: pointer;
    font: inherit;
    text-decoration: none;
    text-align: center;
    transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .today-sign:hover { border-color: color-mix(in oklab, var(--sign) 65%, var(--hair-2)); }
  .today-sign:active { transform: scale(0.97); }
  .today-sign:focus-visible { outline: 2px solid var(--ink-0); outline-offset: 2px; }
  .today-sign--selected {
    border-color: color-mix(in oklab, var(--sign) 75%, var(--hair-2));
    color: var(--text);
    background: color-mix(in oklab, var(--sign) 10%, var(--void-1));
  }
  .today-sign__icon {
    display: block;
    grid-row: 1;
    width: 34px;
    height: 34px;
  }
  .today-sign__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .today-sign__name { grid-row: 2; margin-top: 6px; font-size: 12px; font-weight: 650; line-height: 1; }
  .today-sign__dates {
    grid-row: 3;
    margin-top: 5px;
    color: var(--faint);
    font-size: 8.5px;
    line-height: 1.2;
    white-space: nowrap;
  }
  .today-fallback__result { min-height: 38px; }
  .today-sign-readings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  :root[data-today-sun-sign]:not([data-today-saved-chart]) .today-sign-readings {
    grid-template-columns: 1fr;
  }
  :root[data-today-sun-sign="aries"] .today-sign-readings > :not([data-today-sun-sign="aries"]),
  :root[data-today-sun-sign="taurus"] .today-sign-readings > :not([data-today-sun-sign="taurus"]),
  :root[data-today-sun-sign="gemini"] .today-sign-readings > :not([data-today-sun-sign="gemini"]),
  :root[data-today-sun-sign="cancer"] .today-sign-readings > :not([data-today-sun-sign="cancer"]),
  :root[data-today-sun-sign="leo"] .today-sign-readings > :not([data-today-sun-sign="leo"]),
  :root[data-today-sun-sign="virgo"] .today-sign-readings > :not([data-today-sun-sign="virgo"]),
  :root[data-today-sun-sign="libra"] .today-sign-readings > :not([data-today-sun-sign="libra"]),
  :root[data-today-sun-sign="scorpio"] .today-sign-readings > :not([data-today-sun-sign="scorpio"]),
  :root[data-today-sun-sign="sagittarius"] .today-sign-readings > :not([data-today-sun-sign="sagittarius"]),
  :root[data-today-sun-sign="capricorn"] .today-sign-readings > :not([data-today-sun-sign="capricorn"]),
  :root[data-today-sun-sign="aquarius"] .today-sign-readings > :not([data-today-sun-sign="aquarius"]),
  :root[data-today-sun-sign="pisces"] .today-sign-readings > :not([data-today-sun-sign="pisces"]) {
    display: none;
  }
  .today-sign-reading {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding: clamp(18px, 4vw, 26px);
    border: 1px solid color-mix(in oklab, var(--sign) 35%, var(--hair-1));
    border-left: 3px solid var(--sign);
    border-radius: var(--r-lg);
    background: color-mix(in oklab, var(--sign) 7%, var(--void-1));
  }
  .today-sign-reading .kicker { margin: 0; }
  .today-sign-reading h3 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }
  .today-sign-reading__line {
    margin: 0;
    color: var(--text-2);
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.12rem);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .today-sign-reading__title {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .today-sign-reading__icon {
    display: block;
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
  }
  .today-sign-reading__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .today-sign-reading--compact {
    align-content: start;
    gap: 9px;
    padding: clamp(16px, 3vw, 20px);
  }
  .today-sign-reading--compact h3 { font-size: var(--text-lg); }
  .today-sign-reading--compact .today-sign-reading__line {
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .today-sign-reading__more {
    color: var(--text-2);
    font-size: 12px;
    font-weight: 650;
    text-underline-offset: 3px;
  }
  .today-sign-reading__more:hover { color: var(--text); }
  .today-sign-reading:target {
    border-color: color-mix(in oklab, var(--sign) 75%, var(--hair-2));
  }
  .today-sign-reading .btn { margin-top: 2px; }
  .today-fallback__personalize {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-top: 20px;
    border-top: 1px solid var(--hair-1);
  }
