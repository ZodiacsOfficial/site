---
import Base from '../../layouts/Base.astro';
import EvidenceDisclosure from '../../components/EvidenceDisclosure.astro';
import TodayBrief from '../../islands/today/TodayBrief';
import dailyData from '../../data/daily.json';
import publicationData from '../../data/daily-publication.json';
import type { Daily } from '../../lib/daily';
import type { DailyPublication } from '../../lib/daily-publication';

const daily = dailyData as Daily;
const publication = publicationData as DailyPublication;
const sunSignLines = Object.fromEntries(
  publication.signs.map((entry) => [entry.sign, entry.todayLine.text]),
);
---
<Base
  clientUi
  title="Today — Your Daily Astrology Brief | Zodiacs.org"
  description="Choose your Sun sign for a clear daily note, or privately compare today’s sky with a birth chart saved on this device."
  path="/today/"
>
  <section
    class="section--tight container container--narrow today-page"
    data-daily-date={publication.date}
    data-generation-mode={publication.generation.mode}
  >
    <header class="today-hero">
      <em class="kicker">Your daily brief</em>
      <h1 class="display">Today</h1>
      <p>
        Start with the zodiac sign you know. If you have a saved birth chart,
        you’ll automatically get a more personal comparison.
      </p>
    </header>

    <TodayBrief client:load sunSignLines={sunSignLines} />

    {daily.eventsCoverage === 'unavailable' && (
      <p class="today-coverage-note">
        Today’s reading uses planetary positions only; exact-event timing
        isn’t available for this date.
      </p>
    )}

    <EvidenceDisclosure
      class="today-provenance"
      variant="panel"
      label="Behind today’s reading"
      description="Sky details, limitations, and editorial standards"
    >
      <p>
        Each reading is tied to the recorded sky for{' '}
        <time datetime={publication.date}>{publication.date}</time>. Automated
        checks verify the sky facts, keep the twelve signs meaningfully distinct,
        and screen restricted advice before an edition is published.
      </p>
      <p class="evidence-disclosure__links today-provenance__links">
        <a href="/methodology/#daily-publication">How daily publication works</a>
        <a href="/data/daily-publication.json">View this edition’s record</a>
        <a href="/corrections/">Corrections</a>
      </p>
    </EvidenceDisclosure>
  </section>
</Base>

<style is:global>
  .today-page { max-width: 780px; }
  .today-hero { max-width: 60ch; margin-bottom: clamp(24px, 5vw, 40px); }
  .today-hero h1 {
    margin: 12px 0 12px;
    font-size: var(--text-2xl);
    line-height: 1.04;
  }
  .today-hero p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .today-coverage-note {
    margin: 18px 0 0;
    padding: 12px 14px;
    border-left: 2px solid var(--hair-2);
    color: var(--faint);
    font-size: var(--text-xs);
    line-height: 1.65;
  }
  .today-provenance { margin-top: 18px; }
  .today-card__core { padding: clamp(22px, 5vw, 38px); }
  .today-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--hair-1);
  }
  .today-card__date {
    margin: 0;
    color: var(--text);
    font-size: var(--text-lg);
    font-weight: 620;
    letter-spacing: -0.015em;
  }
  .today-card__time { margin: 4px 0 0; color: var(--faint); font-size: 11px; }
  .today-streak {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    gap: 5px;
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
  }
  .today-streak__count {
    color: var(--sign-cancer);
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 500;
    line-height: 1;
    animation: today-streak-in 220ms var(--ease-soft) both;
  }
  @keyframes today-streak-in {
    from { opacity: 0.35; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .today-reading { display: grid; gap: 24px; padding-top: 24px; }
  .today-reading__head h2,
  .today-fallback__intro h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-xl);
    font-weight: 620;
    letter-spacing: -0.02em;
  }
  .today-reading__head p,
  .today-fallback__intro p {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .today-lines {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .today-lines li {
    padding: 18px 0 18px 18px;
    border-bottom: 1px solid var(--hair-1);
    border-left: 2px solid color-mix(in oklab, var(--sign-cancer) 70%, transparent);
  }
  .today-lines li:first-child { padding-top: 4px; }
  .today-lines li:last-child { padding-bottom: 4px; border-bottom: 0; }
  .today-lines__sentence {
    margin: 0;
    color: var(--text-2);
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.12rem);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .today-lines__receipt {
    margin: 8px 0 0;
    color: var(--faint);
    font-size: 10.5px;
    line-height: 1.65;
  }
  .today-private {
    margin: 0;
    color: var(--faint);
    font-size: 12px;
    line-height: 1.7;
  }
  .today-fallback { display: grid; gap: 24px; padding-top: 24px; }
  .today-fallback__intro p { max-width: 56ch; }
  .today-fallback__intro .today-fallback__status {
    margin-top: 10px;
    color: var(--faint);
    font-size: 12px;
  }
  .today-sign-picker {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .today-sign-picker__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
  }
  .today-sign {
    display: grid;
    justify-items: center;
    align-content: center;
    min-width: 0;
    min-height: 82px;
    padding: 9px 5px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    color: var(--muted);
    background: var(--void-1);
    cursor: pointer;
    font: inherit;
    text-decoration: none;
    text-align: center;
    transition: border-color 160ms cubic-bezier(0.23, 1, 0.32, 1),
      background 160ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .today-sign:hover { border-color: color-mix(in oklab, var(--sign) 65%, var(--hair-2)); }
  .today-sign:active { transform: scale(0.97); }
  .today-sign:focus-visible { outline: 2px solid var(--ink-0); outline-offset: 2px; }
  .today-sign--selected {
    border-color: color-mix(in oklab, var(--sign) 75%, var(--hair-2));
    color: var(--text);
    background: color-mix(in oklab, var(--sign) 10%, var(--void-1));
  }
  .today-sign__icon {
    display: block;
    width: 34px;
    height: 34px;
  }
  .today-sign__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .today-sign__name { margin-top: 6px; font-size: 12px; font-weight: 650; line-height: 1; }
  .today-sign__dates {
    margin-top: 5px;
    color: var(--faint);
    font-size: 8.5px;
    line-height: 1.2;
    white-space: nowrap;
  }
  .today-fallback__result { min-height: 38px; }
  .today-sign-readings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .today-sign-reading {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding: clamp(18px, 4vw, 26px);
    border: 1px solid color-mix(in oklab, var(--sign) 35%, var(--hair-1));
    border-left: 3px solid var(--sign);
    border-radius: var(--r-lg);
    background: color-mix(in oklab, var(--sign) 7%, var(--void-1));
  }
  .today-sign-reading .kicker { margin: 0; }
  .today-sign-reading h3 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }
  .today-sign-reading__line {
    margin: 0;
    color: var(--text-2);
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.12rem);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .today-sign-reading__title {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .today-sign-reading__icon {
    display: block;
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
  }
  .today-sign-reading__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .today-sign-reading--compact {
    align-content: start;
    gap: 9px;
    padding: clamp(16px, 3vw, 20px);
  }
  .today-sign-reading--compact h3 { font-size: var(--text-lg); }
  .today-sign-reading--compact .today-sign-reading__line {
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .today-sign-reading__more {
    color: var(--text-2);
    font-size: 12px;
    font-weight: 650;
    text-underline-offset: 3px;
  }
  .today-sign-reading__more:hover { color: var(--text); }
  .today-sign-reading:target {
    border-color: color-mix(in oklab, var(--sign) 75%, var(--hair-2));
  }
  .today-sign-reading .btn { margin-top: 2px; }
  .today-fallback__personalize {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-top: 20px;
    border-top: 1px solid var(--hair-1);
  }
  .today-fallback__personalize strong { color: var(--text-2); font-size: var(--text-sm); }
  .today-fallback__personalize p {
    margin: 4px 0 0;
    color: var(--faint);
    font-size: 12px;
    line-height: 1.5;
  }
  .today-fallback__personalize .btn { flex: 0 0 auto; }
  .today-quiet { padding-top: 24px; }
  .today-quiet p { margin: 0; color: var(--text-2); line-height: 1.65; }
  .today-method-details {
    border-top: 1px solid var(--hair-1);
    padding-top: 16px;
    color: var(--faint);
    font-size: 12px;
  }
  .today-method-details summary {
    width: fit-content;
    color: var(--muted);
    cursor: pointer;
    font-weight: 600;
  }
  .today-method-details summary:hover { color: var(--text); }
  .today-method-details__body { padding-top: 12px; line-height: 1.7; }
  .today-method-details__body p { margin: 0; }
  .today-method-details__body ul { display: grid; gap: 6px; margin: 10px 0 0; padding-left: 18px; }
  .today-method-details__body li { overflow-wrap: anywhere; font-family: var(--font-mono); font-size: 10.5px; }
  @media (max-width: 480px) {
    .today-card__head { align-items: center; }
    .today-lines li { padding-left: 14px; }
    .today-sign-picker__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .today-sign { min-height: 76px; }
    .today-sign-readings { grid-template-columns: 1fr; }
    .today-fallback__personalize { align-items: flex-start; flex-direction: column; }
    .today-fallback__personalize .btn { width: 100%; justify-content: space-between; }
  }
  @media (prefers-reduced-motion: reduce) {
    .today-streak__count { animation: none; }
    .today-sign { transition: none; }
  }
</style>
