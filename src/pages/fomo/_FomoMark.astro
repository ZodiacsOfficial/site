---
/**
 * fomo's eyes at text size, set after the word "fomo" in headings and
 * prominent copy on /fomo/: the glyph of fomo's own app icon with the tile
 * keyed away (docs/VENUE-MARKS.md). Decorative: the word carries the
 * meaning, so the image is hidden from assistive technology. The underscore
 * keeps this file out of routing; the folder keeps it inside the wing lane.
 */
interface Props { class?: string }
const { class: className } = Astro.props;
---
<img class:list={['fomo-mark', className]} src="/assets/venues/fomo-eyes.png" width="512" height="326" alt="" aria-hidden="true" decoding="async" />
