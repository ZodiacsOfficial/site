    .fomo-cta:hover .fomo-cta__arrow { transform: translate(1px, -1px); background-color: #626ce9; }
  }
  .fomo-cta:active { transform: scale(0.975); }
  .fomo-cta:focus-visible { outline: 2px solid #7f88ff; outline-offset: 3px; }

  /* ── Phone ───────────────────────────────────────────────────────── */
  .fomo-phone {
    position: relative;
    margin: 0;
    justify-self: center;
    perspective: 1600px;
  }
  .fomo-phone::before {
    content: '';
    position: absolute;
    /* Horizontal insets stay non-negative: an absolutely positioned box past
       the viewport edge would add sideways scroll on phones, while the blur
       itself is ink overflow and bleeds without doing so. */
    inset: 6% 0 4%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(58% 46% at 50% 50%, color-mix(in oklab, var(--fomo-sign) 28%, transparent), transparent 72%);
    filter: blur(34px);
    pointer-events: none;
  }
  .fomo-phone__frame {
    width: min(340px, 84vw);
    aspect-ratio: 9 / 19;
    padding: 10px;
    border-radius: 54px;
    background: linear-gradient(160deg, #2b303f 0%, #14171f 42%, #0a0c12 100%);
    box-shadow:
      0 0 0 1px rgba(238, 241, 247, 0.1),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 50px 110px -46px rgba(0, 0, 0, 0.95),
      0 28px 60px -34px color-mix(in oklab, var(--fomo-sign) 40%, transparent);
    transform: rotateY(-9deg) rotateX(3deg);
    transform-style: preserve-3d;
    transition: transform var(--dur-3) var(--ease-soft), box-shadow 900ms var(--ease-soft);
  }
  /* The thing you are about to touch stops drifting and faces you. */
  .fomo-phone:hover .fomo-phone__frame,
  .fomo-phone:focus-within .fomo-phone__frame { transform: none; animation-play-state: paused; }
  .fomo-phone__screen {
    position: relative;
