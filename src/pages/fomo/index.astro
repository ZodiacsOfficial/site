---
/**
 * /fomo/ — the consumer landing page for Astrofolio on the Fomo app.
 *
 * Wing lane (see WING_ONLY_SOURCE in scripts/consumer-boundary-lib.mjs): this
 * page carries acquisition register on purpose. Every "Open in Fomo" link is
 * built from the verified Solana address in the Zodiacs Registry, and every
 * figure on the page is a dated DexScreener read from the committed market
 * history, refreshed once in the browser when the network allows.
 *
 * Hero footage: an owner-supplied screen recording of the Fomo app
 * (2026-09-02, iPhone, 1206×2622 HEVC, 60fps), used exactly as recorded.
 * The only processing is what browsers need: ffmpeg scales the full frame to
 * 720×1566 and re-encodes it as H.264 (libx264 crf 26) and AV1 (libaom crf
 * 34), audio track dropped; the posters are the 3.6s frame.
 */
import Base from '../../layouts/Base.astro';
import SignIcon from '../../components/SignIcon.astro';
import FomoMark from './_FomoMark.astro';
import { SIGNS } from '../../lib/signs';
import registryJson from '../../../public/registry/zodiacs.registry.json';
import marketHistoryJson from '../../../public/assets/data/registry-market-history.v1.json';

type RegistryRepresentation = { chain: string; address: string; symbol?: string };
type RegistryAsset = { sign: string; displayName: string; representations: RegistryRepresentation[] };
type SnapshotAsset = {
  sign: string;
  priceUsd?: number | null;
  change24hPct?: number | null;
  marketCapUsd?: number | null;
};
type Snapshot = {
  date: string;
  source?: { provider?: string; readAt?: string };
  assets: SnapshotAsset[];
};

/* Fomo's own destinations. The coin deep link is the same one the Astrofolio
   vitrine uses (src/app.jsx); no referral or partner parameter is ever added. */
const FOMO_SITE = 'https://fomo.family/';
const FOMO_APP_STORE = 'https://apps.apple.com/us/app/fomo-never-miss-out/id6741115427';
const FOMO_PLAY = 'https://play.google.com/store/apps/details?id=family.fomo.app';
const FOMO_SOLANA_CHAIN_ID = '1399811149';
const fomoCoinUrl = (mint: string) =>
  `https://fomo.family/coin?address=${encodeURIComponent(mint)}&chainId=${FOMO_SOLANA_CHAIN_ID}`;

/* Official store badges, unmodified, self-hosted for the CSP (see
   docs/VENUE-MARKS.md, "Store badges"). Apple's badge is an SVG at its
   published 119.66×40 proportions; Google's PNG carries its own clear space,
   so it is drawn taller to match the visible badge height. */
const APP_STORE_BADGE = '/assets/badges/app-store-en.svg';
const GOOGLE_PLAY_BADGE = '/assets/badges/google-play-en.png';
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

/* Owner-supplied renders, used as delivered: Fomo's example alert and the
   phone showing Fomo's Verified list. The phone is the hero's largest paint,
   so AVIF and WebP encodes of the same pixels are offered first and the
   original PNG stays the fallback. Dimensions are the renders' own. */
const ALERT_RENDER = { src: '/assets/fomo/fomo-alert.png', width: 1425, height: 1104 };
const VERIFIED_RENDER = {
  png: '/assets/fomo/fomo-verified.png',
  avif: '/assets/fomo/fomo-verified.avif',
  webp: '/assets/fomo/fomo-verified.webp',
  width: 1243,
  height: 1265,
};

/* Hero footage and its poster (see the header comment for provenance). */
/* The owner's Astrofolio film: the twelve glyphs over footage, ending on the
   eye. Conformed to 25 fps, its tail dissolved into its head so it loops
   without a cut, sound dropped (it autoplays muted), AV1 with an H.264
   fallback. */
const FILM = Object.freeze({
  av1: '/assets/fomo/fomo-film-av1.mp4',
  h264: '/assets/fomo/fomo-film.mp4',
  posterAvif: '/assets/fomo/fomo-film-poster.avif',
  posterWebp: '/assets/fomo/fomo-film-poster.webp',
  width: 1080,
  height: 1920,
});

const FOOTAGE = Object.freeze({
  av1: '/assets/fomo/fomo-zodiacs-av1.mp4',
  h264: '/assets/fomo/fomo-zodiacs.mp4',
  posterAvif: '/assets/fomo/fomo-zodiacs-poster.avif',
  posterWebp: '/assets/fomo/fomo-zodiacs-poster.webp',
  width: 720,
  height: 1566,
});

const SPARK_DAYS = 14;
const registryAssets = registryJson.assets as RegistryAsset[];
const snapshots = (marketHistoryJson as unknown as { snapshots: Snapshot[] }).snapshots;
if (!Array.isArray(snapshots) || snapshots.length === 0) {
  throw new Error('Fomo page: registry market history has no snapshots');
}
const latest = snapshots[snapshots.length - 1];
const history = snapshots.slice(-SPARK_DAYS);
const readAtIso = latest.source?.readAt ?? `${latest.date}T00:00:00.000Z`;
const readAtLabel = `${readAtIso.slice(0, 10)} ${readAtIso.slice(11, 16)} UTC`;
const provider = latest.source?.provider ?? 'DexScreener';

function fmtPrice(value: number | null | undefined): string {
  if (value == null || !Number.isFinite(value) || value <= 0) return '—';
  if (value >= 1) return `$${value.toFixed(2)}`;
  if (value >= 0.01) return `$${value.toFixed(4)}`;
  if (value >= 0.000001) return `$${value.toFixed(6)}`;
  return `$${value.toFixed(9)}`;
}
function fmtCompact(value: number | null | undefined): string {
  if (value == null || !Number.isFinite(value) || value <= 0) return '—';
  if (value >= 1e9) return `$${(value / 1e9).toFixed(2)}B`;
  if (value >= 1e6) return `$${(value / 1e6).toFixed(2)}M`;
  if (value >= 1e3) return `$${(value / 1e3).toFixed(1)}K`;
  return `$${value.toFixed(0)}`;
}
function fmtChange(value: number | null | undefined): string {
  if (value == null || !Number.isFinite(value)) return '—';
  const magnitude = Math.abs(value).toFixed(2);
  if (value > 0) return `▲ ${magnitude}%`;
  if (value < 0) return `▼ ${magnitude}%`;
  return `${magnitude}%`;
}
function changeClass(value: number | null | undefined): string {
  if (value == null || !Number.isFinite(value) || value === 0) return '';
  return value > 0 ? 'is-up' : 'is-down';
}

/* A 240-wide sparkline from the last SPARK_DAYS daily reads. Missing days
   are skipped rather than invented; fewer than two reads draws a level line. */
function sparkPath(values: Array<number | null>, H: number): { line: string; area: string } {
  const W = 240;
  const P = 3;
  const points = values
    .map((value, index) => [index, value] as const)
    .filter((point): point is readonly [number, number] => typeof point[1] === 'number' && Number.isFinite(point[1]) && point[1] > 0);
  if (points.length < 2) {
    const y = H / 2;
    return { line: `M${P} ${y} L${W - P} ${y}`, area: '' };
  }
  const steps = Math.max(1, values.length - 1);
  const min = Math.min(...points.map((point) => point[1]));
  const max = Math.max(...points.map((point) => point[1]));
  const flat = max === min;
  const x = (index: number) => P + (index / steps) * (W - 2 * P);
  const y = (value: number) => (flat ? H / 2 : H - P - ((value - min) / (max - min)) * (H - 2 * P));
  const coords = points.map(([index, value]) => [x(index), y(value)] as const);
  const line = coords.map(([px, py], k) => `${k ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`).join(' ');
  const first = coords[0];
  const last = coords[coords.length - 1];
  const area = `${line} L${last[0].toFixed(1)} ${H} L${first[0].toFixed(1)} ${H} Z`;
  return { line, area };
}

function currentSignSlug(now: Date): string {
  const today = (now.getUTCMonth() + 1) * 100 + now.getUTCDate();
  for (const sign of SIGNS) {
    const start = sign.start[0] * 100 + sign.start[1];
    const end = sign.end[0] * 100 + sign.end[1];
    const inside = start <= end ? today >= start && today <= end : today >= start || today <= end;
    if (inside) return sign.slug;
  }
  return 'leo';
}

const records = SIGNS.map((sign) => {
  const asset = registryAssets.find((candidate) => candidate.sign === sign.slug);
  const solana = asset?.representations.find((representation) => representation.chain === 'solana');
  if (!asset || !solana?.address) throw new Error(`Fomo page: missing verified Solana record for ${sign.slug}`);
  const market = latest.assets.find((candidate) => candidate.sign === sign.slug);
  const series = history.map((snapshot) => snapshot.assets.find((candidate) => candidate.sign === sign.slug)?.priceUsd ?? null);
  const spark = sparkPath(series, 64);
  const cardSpark = sparkPath(series, 48);
  return {
    slug: sign.slug,
    name: asset.displayName,
    symbol: solana.symbol ?? sign.name.toUpperCase(),
    dates: sign.dates,
    start: sign.start,
    end: sign.end,
    hue: sign.hue,
    mint: solana.address,
    fomo: fomoCoinUrl(solana.address),
    icon: `/assets/zodiac-icons/128/${sign.slug}.webp`,
    price: market?.priceUsd ?? null,
    change: market?.change24hPct ?? null,
    marketCap: market?.marketCapUsd ?? null,
    sparkLine: spark.line,
    sparkArea: spark.area,
    cardLine: cardSpark.line,
    cardArea: cardSpark.area,
  };
});

if (records.length !== 12 || new Set(records.map((record) => record.mint)).size !== 12) {
  throw new Error('Fomo page: expected twelve unique verified Solana records');
}

const initial = records.find((record) => record.slug === currentSignSlug(new Date())) ?? records[4];
const recordsJson = JSON.stringify({
  readAt: readAtIso,
  provider,
  days: history.length,
  records,
}).replaceAll('<', '\\u003c');

const title = 'Zodiacs on Fomo | Astrofolio';
const description = 'Every official Zodiac is listed in the free Fomo app under its verified Solana address. Get the app, add funds, and open your sign in a few taps.';
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
    { '@type': 'ListItem', position: 2, name: 'Astrofolio', item: 'https://zodiacs.org/astrofolio/' },
    { '@type': 'ListItem', position: 3, name: 'Zodiacs on Fomo', item: 'https://zodiacs.org/fomo/' },
  ],
};
const sources = [
  { label: 'Fomo (fomo.family)', href: FOMO_SITE },
  { label: 'Fomo on the App Store', href: FOMO_APP_STORE },
  { label: 'Fomo on Google Play', href: FOMO_PLAY },
  { label: 'Zodiacs Registry', href: '/registry/' },
  { label: `${provider} token pairs API`, href: 'https://docs.dexscreener.com/api/reference' },
];
---

<Base
  title={title}
  description={description}
  path="/fomo/"
  image="/assets/og/v2/fomo.png"
  imageAlt="The twelve Zodiacs are on Fomo. Astrofolio, in a trading app."
  jsonLd={[breadcrumb]}
  sources={sources}
  glass
  terminalMarketNotice
>
  <article class="fomo" data-fomo-page data-initial-sign={initial.slug} style={`--fomo-sign:${initial.hue}`}>
    <section class="fomo-hero" aria-labelledby="fomo-title">
      <div class="fomo-film" data-fomo-film aria-hidden="true">
        <picture>
          <source type="image/avif" srcset={FILM.posterAvif} />
          <img
            class="fomo-film__poster"
            src={FILM.posterWebp}
            width={FILM.width}
            height={FILM.height}
            alt=""
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <video
          class="fomo-film__video"
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          tabindex="-1"
          data-fomo-film-video
          data-playback="poster"
        >
          <source data-src={FILM.av1} type='video/mp4; codecs="av01.0.08M.08"' />
          <source data-src={FILM.h264} type="video/mp4" />
        </video>
        <div class="fomo-film__shade"></div>
      </div>

      <div class="fomo-hero__inner container">
        <div class="fomo-hero__copy">
          <a class="fomo-back" href="/astrofolio/">← Astrofolio</a>
          <p class="kicker reveal">Astrofolio, in a trading app</p>
          <h1 id="fomo-title" class="display reveal" style="--reveal-delay:60ms">The twelve Zodiacs are on Fomo<FomoMark />.</h1>
          <p class="fomo-deck reveal" style="--reveal-delay:120ms">
            Fomo<FomoMark /> is a free trading app for iPhone, Android, and the web. All twelve official Zodiacs are listed
            there under their verified Solana addresses, so you can watch your sign, follow the other eleven,
            and buy in a few taps.
          </p>
          <div class="fomo-stores reveal" id="top-stores" style="--reveal-delay:180ms" data-fomo-stores>
            <a class="fomo-badge fomo-badge--apple" href={FOMO_APP_STORE} rel="external nofollow noopener" data-store="apple">
              <img src={APP_STORE_BADGE} width="144" height="48" alt="Download on the App Store" />
            </a>
            <a class="fomo-badge fomo-badge--google" href={FOMO_PLAY} rel="external nofollow noopener" data-store="google">
              <img src={GOOGLE_PLAY_BADGE} width="185" height="71" alt="Get it on Google Play" />
            </a>
          </div>
          <p class="fomo-web reveal" style="--reveal-delay:220ms">
            <span>Or on a computer:</span>
            <a href={FOMO_SITE} rel="external nofollow noopener">fomo.family in a browser ↗</a>
          </p>
          <ul class="fomo-facts-strip reveal" style="--reveal-delay:260ms" role="list">
            <li><strong>12</strong> official Zodiacs</li>
            <li><strong>Solana</strong> one verified address each</li>
            <li><strong>Free</strong> app, rated 18+</li>
          </ul>
        </div>

        <figure class="fomo-hero__render reveal" style="--reveal-delay:140ms">
          <picture>
            <source type="image/avif" srcset={VERIFIED_RENDER.avif} />
            <source type="image/webp" srcset={VERIFIED_RENDER.webp} />
            <img
              src={VERIFIED_RENDER.png}
              width={VERIFIED_RENDER.width}
              height={VERIFIED_RENDER.height}
              alt="A phone showing Fomo’s Verified list with the Zodiacs, each marked with a blue check."
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </figure>
      </div>
    </section>

    <section class="fomo-tape" aria-label="The twelve Zodiacs, latest prices">
      <div class="fomo-tape__track">
        {[0, 1].map((copy) => (
          <ul class="fomo-tape__group" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {records.map((record) => (
              <li>
                <a href={`#sign-${record.slug}`} tabindex={copy === 1 ? -1 : undefined}>
                  <SignIcon sign={record.slug} size={18} />
                  <span class="fomo-tape__name">{record.name}</span>
                  <span class="fomo-tape__px" data-tape-price={record.slug}>{fmtPrice(record.price)}</span>
                  <span class:list={['fomo-delta', changeClass(record.change)]} data-tape-change={record.slug}>{fmtChange(record.change)}</span>
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>

    <section class="fomo-alerts container" id="alerts" aria-labelledby="alerts-title">
        <div class="fomo-alerts__inner">
          <figure class="fomo-alerts__figure reveal">
            <img
              src={ALERT_RENDER.src}
              width={ALERT_RENDER.width}
              height={ALERT_RENDER.height}
              alt="A Fomo notification: Capricorn is up 5.98 percent. 50 top traders bought $88,203.12."
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="fomo-alerts__copy reveal" style="--reveal-delay:80ms">
            <p class="kicker">Stay in the loop</p>
            <h2 id="alerts-title" class="display">Alerts when your sign moves.</h2>
            <p>Fomo<FomoMark /> sends price alerts like this one for the Zodiacs you watch, so you hear about a move without keeping a chart open.</p>
          </div>
        </div>
      </section>

    <section class="fomo-finder container" id="your-sign" aria-labelledby="finder-title" data-fomo-finder>
      <div class="shell fomo-finder__shell">
        <div class="core fomo-finder__core">
          <div class="fomo-finder__ask">
            <p class="kicker">Not sure which one is yours?</p>
            <h2 id="finder-title" class="display">Find your sign by birthday.</h2>
            <p>Pick the month and day. You get your sign with its latest figures and a link that opens it in Fomo<FomoMark />.</p>
          </div>
          <form class="fomo-finder__form" data-fomo-finder-form novalidate>
            <label class="fomo-finder__field">
              <span>Month</span>
              <select name="month" data-finder-month required>
                <option value="" selected>Month</option>
                {MONTHS.map((month, index) => <option value={index + 1}>{month}</option>)}
              </select>
            </label>
            <label class="fomo-finder__field">
              <span>Day</span>
              <select name="day" data-finder-day required>
                <option value="" selected>Day</option>
                {Array.from({ length: 31 }, (_, index) => <option value={index + 1}>{index + 1}</option>)}
              </select>
            </label>
            <p class="fomo-finder__note" data-finder-note role="status" aria-live="polite"></p>
            <div class="fomo-finder__card" data-finder-card hidden>
              <div class="fomo-finder__card-head">
                <img data-finder-icon src={initial.icon} width="48" height="48" alt="" />
                <div class="fomo-finder__card-id">
                  <strong data-finder-name>{initial.name}</strong>
                  <small><span data-finder-dates>{initial.dates}</span> · <span data-finder-symbol>{initial.symbol}</span></small>
                </div>
                <div class="fomo-finder__card-px">
                  <strong data-finder-price>{fmtPrice(initial.price)}</strong>
                  <small class:list={['fomo-delta', changeClass(initial.change)]} data-finder-change>{fmtChange(initial.change)} · 24h</small>
                </div>
              </div>
              <svg class="fomo-spark" viewBox="0 0 240 64" aria-hidden="true" focusable="false">
                <path class="fomo-spark__area" data-finder-area d={initial.sparkArea} />
                <path class="fomo-spark__line" data-finder-line d={initial.sparkLine} />
              </svg>
              <div class="fomo-finder__card-foot">
                <span class="fomo-finder__range">{history.length} daily reads · {provider}</span>
                <div class="fomo-finder__actions">
                  <a class="fomo-cta fomo-cta--compact" href={initial.fomo} rel="external nofollow noopener" data-finder-open>
                    <img src="/assets/venues/fomo-official.svg" width="30" height="30" alt="" />
                    <span class="fomo-cta__copy"><small data-finder-symbol>{initial.symbol}</small><strong>Open in Fomo</strong></span>
                    <span class="fomo-cta__arrow" aria-hidden="true">↗</span>
                  </a>
                  <a class="fomo-finder__card-link" href={`#sign-${initial.slug}`} data-finder-jump>See the <span data-finder-name>{initial.name}</span> card ↓</a>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="fomo-steps section--tight container" id="how" aria-labelledby="how-title">
      <div class="section-head">
        <p class="kicker">Three steps</p>
        <h2 id="how-title">How it works</h2>
        <p>From download to your first Zodiac in a few minutes. Nobody needs your recovery phrase at any point.</p>
      </div>
      <ol class="fomo-steps__list">
        <li class="tile reveal">
          <span class="fomo-steps__num">01</span>
          <h3>Get the app</h3>
          <p>Download Fomo from the App Store or Google Play, or open fomo.family in a browser. Sign in with an email address or Apple ID; Fomo sets up the wallet inside the app.</p>
          <a href="#top-stores">Get the app ↑</a>
        </li>
        <li class="tile reveal" style="--reveal-delay:80ms">
          <span class="fomo-steps__num">02</span>
          <h3>Add funds</h3>
          <p>Fomo takes Apple Pay where it is offered, or a transfer of USDC or SOL from a wallet or exchange you already use. Send a small test amount first and the rest once it lands.</p>
          <a href="/astrofolio/how-to-buy/#fund-wallet">Funding basics ↗</a>
        </li>
        <li class="tile reveal" style="--reveal-delay:160ms">
          <span class="fomo-steps__num">03</span>
          <h3>Open your sign</h3>
          <p>Tap your sign below. The link opens that Zodiac in Fomo with the verified address already in place. Compare it against the Registry record before you buy.</p>
          <a href="#signs">Choose a sign ↓</a>
        </li>
      </ol>
    </section>

    <section class="fomo-footage section--tight container" id="inside" aria-labelledby="footage-title">
      <div class="fomo-footage__inner">
        <div class="fomo-footage__copy reveal">
          <p class="kicker">Inside the app</p>
          <h2 id="footage-title" class="display">This is what Fomo<FomoMark /> looks like.</h2>
          <p>A short recording from the app: a Zodiac’s sheet with its chart and your position, the list of all twelve, and the buy and sell buttons at the foot of every sheet.</p>
          <a href="#signs">Choose a sign ↓</a>
        </div>
        <figure class="fomo-phone reveal" style="--reveal-delay:80ms" data-fomo-phone>
          <div class="fomo-phone__frame">
            <div class="fomo-phone__screen">
              <div class="fomo-phone__stage" data-fomo-stage>
                <picture>
                  <source type="image/avif" srcset={FOOTAGE.posterAvif} />
                  <img
                    class="fomo-phone__poster"
                    src={FOOTAGE.posterWebp}
                    width={FOOTAGE.width}
                    height={FOOTAGE.height}
                    alt="The Fomo app showing the twelve Zodiacs in a holdings list, each with its value and 24-hour change."
                    loading="lazy"
                    decoding="async"
                    data-fomo-poster
                  />
                </picture>
                <video
                  class="fomo-phone__video"
                  muted
                  loop
                  playsinline
                  preload="none"
                  disablepictureinpicture
                  aria-hidden="true"
                  tabindex="-1"
                  data-fomo-video
                  data-playback="poster"
                >
                  <source data-src={FOOTAGE.av1} type='video/mp4; codecs="av01.0.08M.08"' />
                  <source data-src={FOOTAGE.h264} type="video/mp4" />
                </video>
              </div>
            </div>
          </div>
          <figcaption class="fomo-phone__caption">Footage from the Fomo app, recorded September 2026.</figcaption>
        </figure>
      </div>
    </section>

    <section class="fomo-signs section--tight container" id="signs" aria-labelledby="signs-title">
      <div class="section-head">
        <p class="kicker">Every sign, one tap</p>
        <h2 id="signs-title">Choose your sign</h2>
        <p>Each link opens that Zodiac in Fomo under its verified Solana address. Figures are {provider} reads from {latest.date}; the app shows live prices.</p>
      </div>
      <ul class="fomo-grid" role="list">
        {records.map((record, index) => (
          <li class="tile fomo-card reveal" id={`sign-${record.slug}`} style={`--sign:${record.hue};--reveal-delay:${(index % 4) * 60}ms`} data-sign-card={record.slug}>
            <div class="fomo-card__head">
              <SignIcon sign={record.slug} size={56} />
              <div>
                <h3>{record.name}</h3>
                <p class="fomo-card__dates">{record.dates}</p>
              </div>
            </div>
            <svg class="fomo-spark fomo-spark--card" viewBox="0 0 240 48" aria-hidden="true" focusable="false" data-card-spark>
              <path class="fomo-spark__area" d={record.cardArea} />
              <path class="fomo-spark__line" d={record.cardLine} />
            </svg>
            <dl class="fomo-card__data">
              <div><dt>Price</dt><dd data-card-price>{fmtPrice(record.price)}</dd></div>
              <div><dt>24h</dt><dd class:list={['fomo-delta', changeClass(record.change)]} data-card-change>{fmtChange(record.change)}</dd></div>
              <div><dt>Market cap</dt><dd data-card-mcap>{fmtCompact(record.marketCap)}</dd></div>
            </dl>
            <div class="fomo-card__actions">
              <a class="fomo-cta fomo-cta--compact" href={record.fomo} rel="external nofollow noopener" aria-label={`Open ${record.name} in Fomo`} data-fomo-open={record.slug}>
                <img src="/assets/venues/fomo-official.svg" width="30" height="30" alt="" />
                <span class="fomo-cta__copy"><small>{record.symbol}</small><strong>Open in Fomo</strong></span>
                <span class="fomo-cta__arrow" aria-hidden="true">↗</span>
              </a>
              <a class="fomo-card__record" href={`/registry/${record.slug}/`}>Registry record →</a>
            </div>
          </li>
        ))}
      </ul>
      <p class="fomo-grid__note">
        <span data-fomo-live-note>Prices and the {history.length}-day lines: {provider}, read {readAtLabel}.</span>
        {' '}Every link carries the address published in the Zodiacs Registry. Fomo is a separate app; check that
        the address on its screen matches the record before you approve anything.
        {' '}<a href="/registry/technical/#market-transparency">Data &amp; methodology</a>
      </p>
    </section>

    <section class="fomo-facts section--tight container" aria-labelledby="facts-title">
      <div class="section-head">
        <p class="kicker">Before you start</p>
        <h2 id="facts-title">What Fomo<FomoMark /> is, and what it is not</h2>
      </div>
      <div class="fomo-facts__grid">
        <div class="tile reveal">
          <h3>An independent app</h3>
          <p>Fomo is made by FOMO Labs Inc. It is not part of Zodiacs.org. Zodiacs.org has no referral account or fee arrangement with Fomo and receives nothing when you trade there.</p>
        </div>
        <div class="tile reveal" style="--reveal-delay:80ms">
          <h3>The same twelve addresses</h3>
          <p>The links on this page carry the Solana addresses published in the Zodiacs Registry. Here, “official” means listed in that Registry. It is not approval by a regulator, wallet, or exchange.</p>
        </div>
        <div class="tile reveal" style="--reveal-delay:160ms">
          <h3>Real money, real risk</h3>
          <p>Zodiac tokens are speculative and thinly traded. Prices move quickly, liquidity can disappear, and you can lose everything you spend. Nothing here is financial advice, and astrology does not predict prices.</p>
        </div>
        <div class="tile reveal" style="--reveal-delay:240ms">
          <h3>Your account, and support from Fomo<FomoMark /></h3>
          <p>Fomo is rated 18+ and may not be available where you live. Read Fomo’s terms and fees inside the app, keep your sign-in details private, and take account questions to Fomo, not to Zodiacs.org.</p>
        </div>
      </div>
    </section>

    <section class="fomo-faq section--tight container container--narrow" aria-labelledby="faq-title">
      <div class="section-head">
        <h2 id="faq-title">Questions people ask</h2>
      </div>
      <div class="fomo-faq__items">
        <details>
          <summary><span>Do I need a crypto wallet first?</span><span aria-hidden="true">+</span></summary>
          <p>No. Fomo sets up a wallet inside the app when you sign in. If you already use Phantom, Solflare, or an exchange, you can move USDC or SOL into Fomo from there.</p>
        </details>
        <details>
          <summary><span>Is Fomo<FomoMark /> free?</span><span aria-hidden="true">+</span></summary>
          <p>The app is free to download. Fomo charges its own trading fees, shown before you confirm a trade. Zodiacs.org adds nothing and receives nothing.</p>
        </details>
        <details>
          <summary><span>Which sign should I buy?</span><span aria-hidden="true">+</span></summary>
          <p>That is your decision, and this page does not make it for you. Many people start with their own Sun sign; the Registry lists all twelve with the same standing. Spend only what you can afford to lose.</p>
        </details>
        <details>
          <summary><span>Can I use Fomo<FomoMark /> on a computer?</span><span aria-hidden="true">+</span></summary>
          <p>Yes. fomo.family runs in a browser and syncs with the phone app, so a watchlist you build on one shows up on the other.</p>
        </details>
        <details>
          <summary><span>Why do the prices here differ from the app?</span><span aria-hidden="true">+</span></summary>
          <p>The figures on this page are dated {provider} reads, refreshed when the site rebuilds and, where your browser allows it, once more when the page loads. Fomo shows live prices, and the two will rarely match to the cent.</p>
        </details>
        <details>
          <summary><span>Is there another way to buy?</span><span aria-hidden="true">+</span></summary>
          <p>Yes. The <a href="/astrofolio/how-to-buy/">beginner guide</a> walks through a Solana wallet and an optional Jupiter swap, one step at a time.</p>
        </details>
