          <p>Get the app, add a little, and open your sign. Read every screen before you approve.</p>
          <div class="fomo-stores fomo-stores--center" data-fomo-stores>
            <a class="fomo-badge fomo-badge--apple" href={FOMO_APP_STORE} rel="external nofollow noopener" data-store="apple">
              <img src={APP_STORE_BADGE} width="144" height="48" alt="Download on the App Store" />
            </a>
