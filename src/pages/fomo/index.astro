  }
  .fomo-back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: clamp(20px, 4vw, 44px);
    color: var(--muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .fomo-back:hover { color: var(--text); }
  .fomo-hero__copy .kicker { margin: 0 0 14px; }
  .fomo-hero h1 {
    margin: 0;
    max-width: 11ch;
    font-size: clamp(2.9rem, 1.6rem + 5.4vw, 5.6rem);
