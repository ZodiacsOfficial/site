  }

  /* ── Branded Fomo hand-off (the same pill the Astrofolio vitrine uses) ── */
  .fomo-cta {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 54px;
    padding: 6px 8px 6px 7px;
    border-radius: var(--r-full);
