---
import Base from '../../../layouts/Base.astro';
import ToolGlyph from '../../../components/ToolGlyph.astro';
import { localizePath } from '../../../lib/i18n';

const tools = [
  { href: '/birth-chart/', title: 'Tema natale', promise: 'Il tuo Sole, la tua Luna, l’ascendente, i pianeti, le case e il loro significato.', hue: 'var(--sign-cancer)', kind: 'birth' as const },
  { href: '/today/', title: 'Oggi (in inglese)', promise: 'Il tuo ultimo tema salvato a confronto con il cielo di mezzogiorno, gradi compresi.', hue: 'var(--sign-cancer)', kind: 'transit' as const, englishOnly: true },
  { href: '/compatibility/', title: 'Compatibilità', promise: 'Confronta due temi e scopri dove si accordano, si scontrano e crescono.', hue: 'var(--sign-libra)', kind: 'compat' as const },
  { href: '/moon-sign/', title: 'Segno lunare', promise: 'Come vivi le emozioni e che cosa ti calma.', hue: 'var(--sign-pisces)', kind: 'moon' as const },
  { href: '/rising-sign/', title: 'Ascendente', promise: 'Il segno che mostri agli altri al primo incontro.', hue: 'var(--sign-gemini)', kind: 'rising' as const },
  { href: '/moon-phase/', title: 'Fase lunare', promise: 'La Luna di oggi e quella di qualsiasi data importante per te.', hue: 'var(--sign-cancer)', kind: 'moonphase' as const },
  { href: '/saturn-return/', title: 'Ritorno di Saturno', promise: 'Quando arriva il tuo, con precisione, e che cosa tende a chiedere.', hue: 'var(--sign-capricorn)', kind: 'saturn' as const },
  { href: '/transits/', title: 'Transiti', promise: 'Il cielo di oggi a confronto con il tuo tema.', hue: 'var(--sign-aries)', kind: 'transit' as const },
];

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Strumenti astrologici gratuiti',
    url: 'https://zodiacs.org/it/tools/',
    description: 'Strumenti astrologici gratuiti, calcolati in modo riservato nel tuo browser.',
    inLanguage: 'it',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
];
---
<Base
  title="Strumenti astrologici gratuiti | Zodiacs.org"
  description="Strumenti astrologici gratuiti: tema natale, compatibilità, segno lunare, ascendente, fase lunare, ritorno di Saturno e transiti, calcolati nel tuo browser."
  path="/it/tools/"
  locale="it"
  image="/assets/og/v2/tool/tools.png"
  imageAlt="Strumenti astrologici gratuiti — Zodiacs.org"
  jsonLd={jsonLd}
>
  <section class="section container">
    <div class="section-head">
      <h2>Strumenti astrologici gratuiti</h2>
      <p>Scopri il tuo tema natale, il segno lunare, l’ascendente, le compatibilità e ciò che accade nel cielo adesso. I tuoi dati vengono calcolati nel browser.</p>
    </div>

    <div class="tools-grid">
      {tools.map((tool) => (
        <a class="shell tinted" href={'englishOnly' in tool ? tool.href : localizePath('it', tool.href)} hreflang={'englishOnly' in tool ? 'en' : undefined} style={`--sign:${tool.hue}`}>
          <div class="core tinted tool-card">
            <ToolGlyph kind={tool.kind} />
            <h3>{tool.title}</h3>
            <p>{tool.promise}</p>
            <span class="tool-card__go">Apri →</span>
          </div>
        </a>
      ))}
      <button
        class="shell tinted assistant-tool"
        type="button"
        style="--sign:var(--sign-aquarius)"
        data-assistant-open
        data-assistant-locale="it"
        aria-haspopup="dialog"
      >
        <div class="core tinted tool-card">
          <ToolGlyph kind="assistant" />
          <h3>Chiedi al sito</h3>
          <p>Fai una domanda su uno strumento, un termine astrologico o un tema che hai salvato qui.</p>
          <span class="tool-card__go">Inizia una conversazione →</span>
        </div>
      </button>
    </div>

    <div class="tools-upcoming">
      <em class="kicker">Disponibile anche in inglese</em>
      <ul>
        <li><strong>Oroscopi.</strong> Un oroscopo mensile per ogni segno, basato sulle date reali del cielo: <a href="/horoscopes/" hreflang="en">leggi questo mese</a>.</li>
        <li><strong>Mercurio retrogrado.</strong> I periodi esatti fino al 2027: <a href="/mercury-retrograde/" hreflang="en">vedi le date</a>.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .tools-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .tools-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .tools-grid { grid-template-columns: repeat(3, 1fr); } }
  .tool-card { display: flex; flex-direction: column; gap: 10px; padding: 26px 22px; min-height: 210px; }
  /* Tool-card icon disc lives in ToolGlyph.astro. */
  .tool-card h3 { margin: 4px 0 0; font-size: var(--text-lg); font-weight: 620; color: var(--text); }
  .tool-card p { margin: 0; font-size: var(--text-sm); color: var(--text-2); line-height: 1.6; }
  .tool-card__go { margin-top: auto; font-size: 13px; font-weight: 550; color: var(--text); }
  .assistant-tool { display: block; width: 100%; text-align: left; transition: border-color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease); }
  .assistant-tool:hover { border-color: color-mix(in oklab, var(--sign) 45%, transparent); transform: translateY(-2px); }
  .assistant-tool:hover .core { border-color: color-mix(in oklab, var(--sign) 28%, transparent); }
  .tools-upcoming { margin-top: clamp(28px, 5vw, 44px); padding-top: 24px; border-top: 1px solid var(--hair-1); }
  .tools-upcoming ul { margin: 12px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .tools-upcoming li { font-size: var(--text-sm); color: var(--muted); }
  .tools-upcoming strong { color: var(--text-2); font-weight: 600; }
  .tools-upcoming a { color: var(--text); }
</style>
