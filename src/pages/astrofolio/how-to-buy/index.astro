---
import Base from '../../../layouts/Base.astro';
import { SIGNS } from '../../../lib/signs';
import registryJson from '../../../../public/registry/zodiacs.registry.json';

interface Props {
  initialSlug?: string;
  canonicalPath?: string;
}

type RegistryRepresentation = {
  chain: string;
  address: string;
  symbol?: string;
};

type RegistryAsset = {
  sign: string;
  displayName: string;
  representations: RegistryRepresentation[];
};

const registryAssets = registryJson.assets as RegistryAsset[];
const records = SIGNS.map((sign) => {
  const asset = registryAssets.find((candidate) => candidate.sign === sign.slug);
  const solana = asset?.representations.find((representation) => representation.chain === 'solana');
  if (!asset || !solana?.address) throw new Error(`How-to-buy: missing verified Solana record for ${sign.slug}`);
  return {
    slug: sign.slug,
    name: asset.displayName,
    symbol: solana.symbol ?? sign.name.toUpperCase(),
    glyph: sign.glyph,
    dates: sign.dates,
    hue: sign.hue,
    mint: solana.address,
    icon: `/assets/zodiac-icons/128/${sign.slug}.webp`,
  };
});

if (records.length !== 12 || new Set(records.map((record) => record.mint)).size !== 12) {
  throw new Error('How-to-buy: expected twelve unique verified Solana records');
}

const { initialSlug = 'leo', canonicalPath = '/astrofolio/how-to-buy/' } = Astro.props;
const defaultRecord = records.find((record) => record.slug === initialSlug)
  ?? records.find((record) => record.slug === 'leo')
  ?? records[0];
const recordsJson = JSON.stringify(records).replaceAll('<', '\\u003c');
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
    { '@type': 'ListItem', position: 2, name: 'Astrofolio', item: 'https://zodiacs.org/astrofolio/' },
    { '@type': 'ListItem', position: 3, name: `How to buy ${defaultRecord.name}`, item: `https://zodiacs.org${canonicalPath}` },
  ],
};

const sources = [
  { label: 'Solana wallet basics', href: 'https://solana.com/learn/what-is-a-wallet' },
  { label: 'Solana safety guide', href: 'https://solana.com/learn/staying-safe-on-solana' },
  { label: 'Solana wallet directory', href: 'https://solana.com/wallets' },
  { label: 'Coinbase recovery phrase guide', href: 'https://www.coinbase.com/learn/crypto-glossary/what-is-a-seed-phrase' },
  { label: 'Coinbase network guide', href: 'https://help.coinbase.com/coinbase/trading-and-funding/sending-or-receiving-cryptocurrency/assets-on-multiple-networks' },
  { label: 'Jupiter developer documentation', href: 'https://developers.jup.ag/docs/swap' },
];
---

<Base
  title="How to buy a Zodiac | Astrofolio"
  description="A clear beginner guide to wallets, Solana, verified Zodiac addresses, and reviewing a swap before you approve it."
  path={canonicalPath}
  jsonLd={[breadcrumb]}
  sources={sources}
  noindex
  stableTypography
  terminalMarketNotice
>
  <article class="buy-guide" data-initial-sign={defaultRecord.slug} style={`--selected-sign:${defaultRecord.hue}`}>
    <header class="buy-hero">
      <a class="buy-back" href="/astrofolio/">← Back to Astrofolio</a>
      <p class="buy-kicker">Astrofolio · Beginner guide</p>
      <h1>How to buy <span data-sign-name>{defaultRecord.name}</span></h1>
      <p class="buy-deck">
        A calm, step-by-step walkthrough for your first wallet and first swap. You stay in control:
        Astrofolio never receives your funds or recovery phrase.
      </p>
      <div class="buy-hero__promise" role="note">
        <span aria-hidden="true">✓</span>
        <p><strong>No rush and no automatic connection.</strong> Read the guide first. The optional Jupiter tool loads only if you ask for it.</p>
      </div>
    </header>

    <section class="sign-picker" aria-labelledby="choose-sign-title">
      <div class="section-heading section-heading--compact">
        <p class="buy-kicker">First, choose the one you mean</p>
        <h2 id="choose-sign-title">Choose your Zodiac</h2>
      </div>
      <nav class="sign-rail" aria-label="Choose a Zodiac for this guide">
        {records.map((record) => (
          <a
            class="sign-choice"
            href={`/astrofolio/how-to-buy/${record.slug}/`}
            data-select-sign={record.slug}
            aria-current={record.slug === defaultRecord.slug ? 'true' : undefined}
            style={`--sign:${record.hue}`}
          >
            <img src={record.icon} width="44" height="44" alt="" loading="lazy" decoding="async" />
            <span>{record.name}</span>
          </a>
        ))}
      </nav>

      <div class="selected-card" aria-live="polite">
        <img data-sign-icon src={defaultRecord.icon} width="64" height="64" alt="" />
        <div class="selected-card__identity">
          <span>Selected Zodiac</span>
          <strong data-sign-name>{defaultRecord.name}</strong>
          <small data-sign-symbol>{defaultRecord.symbol}</small>
        </div>
        <div class="selected-card__address">
          <span>Official Solana address</span>
          <code data-sign-mint>{defaultRecord.mint}</code>
          <div class="selected-card__actions">
            <button type="button" data-copy-mint>Copy address</button>
            <a data-registry-link href={`/registry/${defaultRecord.slug}/#record`}>Check the public record ↗</a>
          </div>
          <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <section class="start-paths" aria-labelledby="start-path-title">
      <div class="section-heading section-heading--compact">
        <p class="buy-kicker">Start where you are</p>
        <h2 id="start-path-title">New or experienced?</h2>
      </div>
      <div class="start-paths__grid">
        <a href="#wallet" class="start-path start-path--primary">
          <span class="start-path__number">01</span>
          <strong>I’m new to wallets</strong>
          <p>Learn the terms, set up safely, and move one step at a time.</p>
          <span class="start-path__action">Start at the beginning ↓</span>
        </a>
        <a href="#verify" class="start-path">
          <span class="start-path__number">03</span>
          <strong>I already have a Solana wallet</strong>
          <p>Jump to address verification, then review the swap checklist.</p>
          <span class="start-path__action">Skip ahead ↓</span>
        </a>
      </div>
    </section>

    <div class="guide-layout">
      <div class="guide-steps">
        <section class="guide-step" id="wallet" aria-labelledby="wallet-title">
          <div class="guide-step__number" aria-hidden="true">01</div>
          <div class="guide-step__body">
            <p class="buy-kicker">Set up access</p>
            <h2 id="wallet-title">Choose a Solana wallet</h2>
            <p class="guide-step__lead">
              A wallet is an app that shows what you own, connects to Solana apps, and lets you approve
              transactions. It does not store money like a bank account; it controls the keys that give you access.
            </p>
            <div class="plain-compare" aria-label="Wallet information you can and cannot share">
              <div>
                <span class="plain-compare__icon plain-compare__icon--safe" aria-hidden="true">✓</span>
                <strong>Public wallet address</strong>
                <p>Share this when you want to receive funds. It is similar to an account number.</p>
              </div>
              <div>
                <span class="plain-compare__icon plain-compare__icon--danger" aria-hidden="true">×</span>
                <strong>Recovery phrase or private key</strong>
                <p>Never share it, paste it into a site, or send it to support. Anyone with it can control your wallet.</p>
              </div>
            </div>
            <div class="guide-links">
              <a href="https://phantom.com/" rel="noopener noreferrer external">Phantom ↗</a>
              <a href="https://www.solflare.com/" rel="noopener noreferrer external">Solflare ↗</a>
              <a href="https://solana.com/wallets" rel="noopener noreferrer external">See Solana’s wallet directory ↗</a>
            </div>
            <p class="safety-note"><strong>Write the recovery phrase down offline.</strong> A legitimate support person will never ask for it. If it is lost, the wallet provider may not be able to restore access.</p>
          </div>
        </section>

        <section class="guide-step" id="fund-wallet" aria-labelledby="fund-title">
          <div class="guide-step__number" aria-hidden="true">02</div>
          <div class="guide-step__body">
            <p class="buy-kicker">Prepare the wallet</p>
            <h2 id="fund-title">Add USDC on Solana—and a little SOL</h2>
            <p class="guide-step__lead">
              The convenience tool below swaps USDC for your selected Zodiac. SOL pays the small Solana network fee.
              When moving funds from an exchange, the asset and network must match on both sides.
            </p>
            <ol class="micro-steps">
              <li><span>1</span><div><strong>Copy your wallet’s public address.</strong><p>Use the Receive button inside your wallet.</p></div></li>
              <li><span>2</span><div><strong>Choose USDC and the Solana network.</strong><p>Do not assume every USDC transfer uses the same network.</p></div></li>
              <li><span>3</span><div><strong>Send a small test amount first.</strong><p>Confirm it arrives before moving the rest.</p></div></li>
              <li><span>4</span><div><strong>Keep a little SOL for fees.</strong><p>Your wallet cannot approve a Solana transaction with no SOL available for the network cost.</p></div></li>
            </ol>
            <p class="safety-note safety-note--warn"><strong>Wrong-network transfers may be difficult or impossible to recover.</strong> Pause if the sending service does not clearly say Solana.</p>
          </div>
        </section>

        <section class="guide-step" id="verify" aria-labelledby="verify-title">
          <div class="guide-step__number" aria-hidden="true">03</div>
          <div class="guide-step__body">
            <p class="buy-kicker">Check identity</p>
            <h2 id="verify-title">Verify the complete address</h2>
            <p class="guide-step__lead">
              Names and symbols can be copied. The complete token address is what identifies the official{' '}
              <span data-sign-name>{defaultRecord.name}</span> token on Solana.
            </p>
            <p class="official-scope" role="note">
              Here, &ldquo;official&rdquo; only means that this complete address appears in the Zodiacs Registry.
              It is not government, regulator, wallet, or exchange approval.
            </p>
            <div class="verify-card">
              <div class="verify-card__top">
                <img data-sign-icon src={defaultRecord.icon} width="52" height="52" alt="" />
                <div><span>Buying</span><strong data-sign-name>{defaultRecord.name}</strong></div>
                <span class="network-badge">Solana</span>
              </div>
              <code data-sign-mint>{defaultRecord.mint}</code>
              <div class="verify-card__links">
                <button type="button" data-copy-mint>Copy verified address</button>
                <a data-solscan-link href={`https://solscan.io/token/${defaultRecord.mint}`} rel="noopener noreferrer external">View on Solscan ↗</a>
              </div>
            </div>
            <p class="safety-note"><strong>Match the beginning and the end, then compare the whole address.</strong> Cancel if even one character differs.</p>
          </div>
        </section>

        <section class="guide-step" id="review" aria-labelledby="review-title">
          <div class="guide-step__number" aria-hidden="true">04</div>
          <div class="guide-step__body">
            <p class="buy-kicker">Before approval</p>
            <h2 id="review-title">Review what your wallet shows</h2>
            <p class="guide-step__lead">
              Connecting a wallet shares its public address and allows an app to ask for approval. It does not
              give an app permission to move funds by itself. Nothing should happen until you approve in your wallet.
            </p>
            <div class="review-list" role="list" aria-label="Swap review checklist">
              <div role="listitem"><span>Network</span><strong>Solana</strong></div>
              <div role="listitem"><span>You are buying</span><strong data-sign-name>{defaultRecord.name}</strong></div>
              <div role="listitem"><span>Official address</span><code data-sign-mint>{defaultRecord.mint}</code></div>
              <div role="listitem"><span>Also confirm</span><strong>Spend, estimated receive, price impact, and every fee</strong></div>
            </div>
            <p class="safety-note safety-note--warn"><strong>Transactions are generally irreversible.</strong> Prices can move, available liquidity can disappear, and a Zodiac can lose all of its market value.</p>
          </div>
        </section>
      </div>

      <aside class="ready-card" aria-label="What you need">
        <p class="buy-kicker">Your checklist</p>
        <div class="ready-card__sign">
          <img data-sign-icon src={defaultRecord.icon} width="46" height="46" alt="" />
          <div><span>Selected</span><strong data-sign-name>{defaultRecord.name}</strong></div>
        </div>
        <ul>
          <li><span aria-hidden="true">1</span>A Solana wallet</li>
          <li><span aria-hidden="true">2</span>USDC on Solana</li>
          <li><span aria-hidden="true">3</span>A little SOL for fees</li>
          <li><span aria-hidden="true">4</span>The verified address</li>
        </ul>
        <a href="#jupiter">Continue to Jupiter ↓</a>
      </aside>
    </div>

    <section class="jupiter-section" id="jupiter" aria-labelledby="jupiter-title">
      <div class="jupiter-intro">
        <p class="buy-kicker">Optional convenience</p>
        <h2 id="jupiter-title">Prefer to swap here?</h2>
        <p>
          You can load the existing Jupiter-powered tool without leaving this guide. The buying side is fixed to
          the verified <span data-sign-name>{defaultRecord.name}</span> address shown above.
        </p>
      </div>
      <div class="jupiter-disclosure" role="note">
        <strong>Before you load it</strong>
        <p>Astrofolio at zodiacs.org/astrofolio is the official Zodiacs.org consumer page. Jupiter and your wallet remain independent services. Loading the tool requests a live quote from Jupiter and public market data. Your wallet reviews and signs any transaction. Astrofolio holds no keys or funds, cannot reverse a transaction, and receives no referral or trading fee.</p>
      </div>
      <div class="eligibility-ack" role="group" aria-labelledby="eligibility-title">
        <label><input type="checkbox" data-eligibility-confirm /><span id="eligibility-title">I am at least 18 and may lawfully use a third-party swap service where I live.</span></label>
        <p>Check availability for your region and review the <a href="/terms/">Terms</a> and <a href="/disclosure/">Disclosure</a>. This confirmation does not mean Jupiter is available in your location.</p>
      </div>
      <button class="load-jupiter" type="button" data-load-jupiter disabled>
        <span data-jupiter-button-label>Load optional Jupiter tool for {defaultRecord.name}</span>
        <span aria-hidden="true">→</span>
      </button>
      <p class="jupiter-status" data-jupiter-status role="status" aria-live="polite">Confirm your eligibility above to continue. Nothing has connected and no quote has been requested.</p>
      <div class="jupiter-host" data-jupiter-host hidden></div>
      <noscript><p class="jupiter-noscript">The convenience tool needs JavaScript. You can still follow the guide and use the verified address in a Solana wallet or swap service you trust.</p></noscript>
    </section>

    <section class="after-section" id="after" aria-labelledby="after-title">
      <div class="section-heading">
        <p class="buy-kicker">After approval</p>
        <h2 id="after-title">Where your Zodiac goes</h2>
        <p>The token goes to the wallet that approved the swap. Astrofolio and Jupiter do not hold it for you.</p>
      </div>
      <div class="after-grid">
        <article><span>01</span><h3>Check your wallet</h3><p>Your Zodiac may appear automatically. If it does not, search or import it using only the verified address.</p></article>
        <article><span>02</span><h3>Check the transaction</h3><p>Open the wallet’s activity screen and use its explorer link to see the public Solana record.</p></article>
        <article><span>03</span><h3>Ignore “support” DMs</h3><p>Nobody needs your recovery phrase to make a token visible or help with a transaction.</p></article>
      </div>
    </section>

    <section class="buy-faq" aria-labelledby="buy-faq-title">
      <div class="section-heading">
        <p class="buy-kicker">Questions</p>
        <h2 id="buy-faq-title">Before you go</h2>
      </div>
      <div class="buy-faq__items">
        <details><summary>What if I do not have USDC yet?<span aria-hidden="true">+</span></summary><p>The Jupiter tool includes a “Fund first” path with independent providers. Funding USDC is separate from the Zodiac swap. Check provider availability, identity requirements, fees, and the Solana network before continuing.</p></details>
        <details><summary>What if the quote looks very different from what I expected?<span aria-hidden="true">+</span></summary><p>Do not approve it. Try a smaller amount or come back later. A large price impact can mean there is not much available at the current price.</p></details>
        <details><summary>Why do I need SOL if I am spending USDC?<span aria-hidden="true">+</span></summary><p>SOL pays Solana’s network fee. The fee is separate from the amount you spend and from any fee shown by the swap service.</p></details>
        <details><summary>Can Astrofolio recover a mistaken transaction?<span aria-hidden="true">+</span></summary><p>No. Astrofolio does not hold your keys or funds, and transactions are generally irreversible. Verify the network, address, amounts, and fees before you approve.</p></details>
      </div>
    </section>

    <div class="buy-close">
      <p class="buy-kicker">Take your time</p>
      <h2>Confidence first. Approval second.</h2>
      <p>If anything looks unfamiliar, cancel and check the guide again. There is never a reason to share your recovery phrase.</p>
      <a href="/astrofolio/">Return to Astrofolio</a>
    </div>
  </article>

  <script is:inline type="application/json" id="zodiac-buy-records" set:html={recordsJson}></script>

<script>
  type BuyRecord = {
    slug: string;
    name: string;
    symbol: string;
    glyph: string;
    dates: string;
    hue: string;
    mint: string;
    icon: string;
  };

  type TradeInstance = { destroy?: () => void };
  type TradeWindow = Window & {
    zodiacsTrade?: {
      mount: (host: HTMLElement, sign: {
        name: string;
        slug: string;
        mint: string;
        hue?: string;
        iconUrl?: string;
      }, hooks?: {
        onStateChange?: (view: { error?: string | null }, state: { state?: string }) => void;
      }) => TradeInstance | null;
    };
  };

  const dataNode = document.querySelector<HTMLScriptElement>('#zodiac-buy-records');
  const records = JSON.parse(dataNode?.textContent || '[]') as BuyRecord[];
  const recordsBySlug = new Map(records.map((record) => [record.slug, record]));
  const root = document.querySelector<HTMLElement>('.buy-guide');
  const astrofolioNav = document.querySelector<HTMLAnchorElement>('.nav__chip[href="/astrofolio/"]');
  const loadButton = document.querySelector<HTMLButtonElement>('[data-load-jupiter]');
  const loadButtonLabel = document.querySelector<HTMLElement>('[data-jupiter-button-label]');
  const eligibilityConfirm = document.querySelector<HTMLInputElement>('[data-eligibility-confirm]');
  const tradeHost = document.querySelector<HTMLElement>('[data-jupiter-host]');
  const tradeStatus = document.querySelector<HTMLElement>('[data-jupiter-status]');
  const requestedSign = new URLSearchParams(window.location.search).get('sign')?.toLowerCase() || '';
  const initialSign = root?.dataset.initialSign || 'leo';
  let active = recordsBySlug.get(requestedSign) ?? recordsBySlug.get(initialSign) ?? recordsBySlug.get('leo') ?? records[0];
  let tradeInstance: TradeInstance | null = null;
  let runtimePromise: Promise<void> | null = null;
  let runtimeRequested = false;

  astrofolioNav?.setAttribute('aria-current', 'page');

  function setLoadButtonLabel(mode: 'idle' | 'loading' | 'retry' = 'idle') {
    if (!loadButtonLabel || !active) return;
    if (mode === 'loading') loadButtonLabel.textContent = `Loading Jupiter for ${active.name}…`;
    else if (mode === 'retry') loadButtonLabel.textContent = `Try loading Jupiter again for ${active.name}`;
    else loadButtonLabel.textContent = `Load optional Jupiter tool for ${active.name}`;
  }

  function updateUrl(record: BuyRecord) {
    const url = new URL(window.location.href);
    url.pathname = `/astrofolio/how-to-buy/${record.slug}/`;
    url.searchParams.delete('sign');
    window.history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
  }

  function syncRecord(record: BuyRecord, writeUrl = false) {
    active = record;
    if (writeUrl) updateUrl(record);
    root?.style.setProperty('--selected-sign', record.hue);
    document.querySelectorAll<HTMLElement>('[data-sign-name]').forEach((node) => { node.textContent = record.name; });
    document.querySelectorAll<HTMLElement>('[data-sign-symbol]').forEach((node) => { node.textContent = record.symbol; });
    document.querySelectorAll<HTMLElement>('[data-sign-mint]').forEach((node) => { node.textContent = record.mint; });
    document.querySelectorAll<HTMLImageElement>('[data-sign-icon]').forEach((image) => {
      image.src = record.icon;
      image.alt = '';
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-registry-link]').forEach((link) => {
      link.href = `/registry/${record.slug}/#record`;
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-solscan-link]').forEach((link) => {
      link.href = `https://solscan.io/token/${encodeURIComponent(record.mint)}`;
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-select-sign]').forEach((link) => {
      const selected = link.dataset.selectSign === record.slug;
      if (selected) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
    document.title = `How to buy ${record.name} | Astrofolio`;
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    if (status) status.textContent = '';
    if (runtimeRequested) remountTrade();
    else setLoadButtonLabel();
  }

  async function copyMint() {
    if (!active) return;
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    try {
      await navigator.clipboard.writeText(active.mint);
      if (status) status.textContent = `${active.name} address copied.`;
    } catch {
      const field = document.createElement('textarea');
      field.value = active.mint;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.append(field);
      field.select();
      const copied = document.execCommand('copy');
      field.remove();
      if (status) status.textContent = copied ? `${active.name} address copied.` : 'Copy failed. Select the address and copy it manually.';
    }
  }

  function loadTradeRuntime() {
    const tradeWindow = window as TradeWindow;
    if (tradeWindow.zodiacsTrade?.mount) return Promise.resolve();
    if (runtimePromise) return runtimePromise;
    runtimePromise = new Promise<void>((resolve, reject) => {
      const existing = document.querySelector<HTMLScriptElement>('script[data-zodiac-trade-runtime]');
      existing?.remove();
      const script = document.createElement('script');
      script.src = '/assets/trade.js';
      script.defer = true;
      script.dataset.zodiacTradeRuntime = '';
      script.addEventListener('load', () => {
        if ((window as TradeWindow).zodiacsTrade?.mount) resolve();
        else {
          script.remove();
          reject(new Error('runtime'));
        }
      }, { once: true });
      script.addEventListener('error', () => {
        script.remove();
        reject(new Error('runtime'));
      }, { once: true });
      document.head.append(script);
    });
    return runtimePromise;
  }

  function remountTrade(): boolean {
    if (!active || !tradeHost) return false;
    tradeInstance?.destroy?.();
    tradeInstance = null;
    tradeHost.replaceChildren();
    const selected = active;
    const mount = (window as TradeWindow).zodiacsTrade?.mount;
    if (!mount) return false;
    if (tradeStatus) tradeStatus.textContent = `Jupiter tool loaded for verified ${selected.name}. Fetching a live quote…`;
    tradeInstance = mount(tradeHost, {
      name: active.name,
      slug: active.slug,
      mint: active.mint,
      hue: active.hue,
      iconUrl: active.icon,
    }, {
      onStateChange: (view, state) => {
        if (!tradeStatus || active?.slug !== selected.slug) return;
        if (state.state === 'ready') {
          tradeStatus.textContent = `Live Jupiter quote ready for verified ${selected.name}. Nothing will happen until you review and approve in your wallet.`;
        } else if (state.state === 'error') {
          tradeStatus.textContent = view.error
            ? `Jupiter could not return a quote: ${view.error} Use “Try quote again” in the tool below.`
            : 'Jupiter could not return a quote. Nothing connected. Use “Try quote again” in the tool below.';
        } else if (state.state === 'signing') {
          tradeStatus.textContent = 'Review every detail in your wallet. Cancel if anything differs from this guide.';
        } else if (state.state === 'done') {
          tradeStatus.textContent = 'Jupiter reports that the swap is complete. Check the transaction in your wallet.';
        } else if (state.state === 'quoting') {
          tradeStatus.textContent = `Jupiter tool loaded for verified ${selected.name}. Fetching a live quote…`;
        }
      },
    }) ?? null;
    return Boolean(tradeInstance);
  }

  async function revealTrade() {
    if (!loadButton || !tradeHost || !active) return;
    if (!eligibilityConfirm?.checked) {
