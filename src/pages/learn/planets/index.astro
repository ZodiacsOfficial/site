---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PlanetGlyph from '../../../components/PlanetGlyph';
import '../../../styles/cluster.css';

const PLANET_ORDER = [
  'Sun', 'Moon', 'Mercury', 'Venus', 'Mars',
  'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto',
];

const entries = await getCollection('learn', (e) => e.data.kind === 'planet' && !e.data.draft);
const planets = PLANET_ORDER.map((name) => {
  const entry = entries.find((e) => e.data.kind === 'planet' && e.data.planet === name);
  if (!entry) throw new Error(`Missing planet page: ${name}`);
  return { name, slug: entry.id.split('/')[1], role: entry.data.kind === 'planet' ? entry.data.role : '' };
});

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'The planets in astrology',
    url: 'https://zodiacs.org/learn/planets/',
    description: 'What each planet means in a birth chart, from the Sun to Pluto — plain-language guides to all ten.',
  },
  {
    '@type': 'ItemList',
    numberOfItems: planets.length,
    itemListElement: planets.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      url: `https://zodiacs.org/learn/planets/${p.slug}/`,
    })),
  },
];
---
<Base
  title="The Planets in Astrology — What Each One Means | Zodiacs.org"
  description="What every planet means in a birth chart: the Sun and Moon, Mercury through Mars, and the slow outer planets — each explained plainly, with its cycle and rulerships."
  path="/learn/planets/"
  jsonLd={jsonLd}
>
  <section class="section--tight container container--narrow">
    <div class="cluster-hero reveal">
      <em class="kicker">Learn</em>
      <h1 class="display">The planets</h1>
      <p>
        A chart is ten planets doing ten jobs. The Sun and Moon set identity
        and feeling, the inner planets handle the daily machinery, and the
        outer ones move slowly enough to mark whole eras of a life.
      </p>
    </div>

    <ol class="cluster-list reveal">
      {planets.map((p) => (
        <li>
          <a class="cluster-row" href={`/learn/planets/${p.slug}/`}>
            <span class="cluster-row__glyph"><PlanetGlyph body={p.name} size={18} /></span>
            <span class="cluster-row__name">{p.name}</span>
            <span class="cluster-row__role">{p.role}</span>
            <span class="cluster-row__go">→</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="cluster-note reveal">
      Every one of them has a sign, a house, and aspects in your chart —
      <a href="/birth-chart/">compute yours</a> to see where they landed.
      Or continue with <a href="/learn/houses/">the houses</a> and
      <a href="/learn/aspects/">the aspects</a>.
    </p>
  </section>
</Base>

