---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';

/**
 * Ask Zodiacs — the grounded assistant's home. The page is deliberately a
 * useful static guide first: everything above the fold reads without
 * JavaScript and stays useful when the assistant is resting. The
 * conversation itself is the existing reviewed panel, opened by the same
 * one-click loader the footer uses; nothing about the assistant's
 * privacy, quota, or grounding contract is duplicated here.
 */
const faq = [
  {
    q: 'Where do the answers come from?',
    a: 'From this site. The assistant carries a guide built from Zodiacs.org pages — the calculators, the sign guides, Learn, the calendars — and answers from that material, naming the pages it drew on. When the site does not cover something, it says so instead of improvising.',
  },
  {
    q: 'Are the answers generated?',
    a: 'Yes. Replies are generated on the spot and can be wrong. Astrology here is a symbolic tradition read over precisely computed astronomy: positions are facts, meanings are interpretation — never fate, diagnosis, or a prediction of events.',
  },
  {
    q: 'What happens to my conversation?',
    a: 'It lives in your browser tab and nowhere else. We do not store conversations or chart summaries. The service keeps a daily counter against an anonymous, salted hash so one visitor cannot exhaust it for everyone; the counter clears itself after two days.',
  },
  {
    q: 'How does it use my birth chart?',
    a: 'Only if you attach it, and you see exactly what is sent first. If you have a saved chart on this device, the assistant can include a placements-only summary — computed in your browser — after you confirm a preview of the precise text. No birth date, time, or place travels with it, and it is not stored.',
  },
  {
    q: 'What will it not do?',
    a: 'No medical, mental-health, legal, financial, or investment advice. No predictions of specific events or dates. No readings about third parties. A chart is the wrong instrument for those decisions, and the assistant will say so.',
  },
];

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': 'https://zodiacs.org/ask/#page',
    url: 'https://zodiacs.org/ask/',
    name: 'Ask Zodiacs — a grounded astrology assistant',
    description: 'Ask about this site’s tools, general astrology, or your own saved chart. Answers are generated from Zodiacs.org pages, with sources named and nothing stored.',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Ask Zodiacs', item: 'https://zodiacs.org/ask/' },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title="Ask Zodiacs — a grounded astrology assistant"
  description="Ask about this site's tools, general astrology, or your own saved chart. Answers come from Zodiacs.org pages, with sources named and nothing stored."
  path="/ask/"
  image="/assets/og/v2/tool/ask.png"
  imageAlt="Ask Zodiacs — a grounded astrology assistant"
  jsonLd={jsonLd}
>
  <section class="container container--narrow ask">
    <header class="ask__hero reveal">
      <em class="kicker">Ask Zodiacs</em>
      <h1 class="display">A question, answered from this site.</h1>
      <p class="ask__lede">
        Ask how a tool works, what a placement means, or what your own saved
        chart is doing — and get an answer drawn from Zodiacs.org pages, with
        the sources named so you can read further.
      </p>
      <div class="ask__cta">
        <button type="button" class="btn btn--primary" data-assistant-open>
          <span>Start asking</span><span class="orb" aria-hidden="true">↗</span>
        </button>
        <noscript>
          <p class="ask__nojs">
            Asking needs JavaScript. Everything the assistant knows lives on
            this site's own pages, so the guides below answer without it.
          </p>
        </noscript>
      </div>
    </header>

    <div class="ask__grid reveal">
      <section class="tile ask__card" aria-labelledby="ask-site">
        <h2 id="ask-site">About the site</h2>
        <p>“How do I save a chart?” “What house system does the calculator
        use?” “Where are the eclipse dates?” The assistant knows every tool
        here and points at the page instead of paraphrasing it.</p>
        <p class="ask__links"><a href="/birth-chart/">Birth chart</a> · <a href="/tools/">All tools</a> · <a href="/methodology/">How we compute</a></p>
      </section>
      <section class="tile ask__card" aria-labelledby="ask-astro">
        <h2 id="ask-astro">General astrology</h2>
        <p>“What does a Saturn square feel like?” “What is a cusp, really?”
        Plain-language answers in the same register as the Learn pages —
        tradition read over computed astronomy, never fate.</p>
        <p class="ask__links"><a href="/learn/">Learn</a> · <a href="/learn/houses/">The houses</a> · <a href="/learn/aspects/">The aspects</a></p>
      </section>
      <section class="tile ask__card" aria-labelledby="ask-chart">
        <h2 id="ask-chart">Your own chart</h2>
        <p>With a chart saved on this device, the assistant can read your
        actual placements — after you approve a preview of exactly what will
        be sent. Placements only; nothing stored; your call every time.</p>
        <p class="ask__links"><a href="/birth-chart/">Compute a chart</a> · <a href="/profile/">Saved charts</a></p>
      </section>
    </div>

    <section class="shell tinted reveal ask__contract">
      <div class="core tinted ask__contract-core">
        <h2>The contract, plainly</h2>
        <ul>
          <li><strong>Grounded.</strong> Answers come from this site's pages and name their sources. When the site doesn't cover it, the assistant says so.</li>
          <li><strong>Generated.</strong> Replies are produced on the spot and can be wrong. Astrology here is symbolic, not deterministic.</li>
          <li><strong>Private.</strong> Conversations and chart summaries are never stored. A chart is attached only after you confirm a preview of the exact text.</li>
          <li><strong>Bounded.</strong> No medical, legal, or financial advice; no event predictions; no third-party readings. Fair-use limits keep it available: a short per-minute pace and thirty questions a day.</li>
        </ul>
        <p class="ask__rest">When the assistant is resting — off, or over its daily budget — this page and the site's own guides remain the answer. Nothing here requires it.</p>
      </div>
    </section>

    <section class="reveal">
      <Faq items={faq} heading="Ask Zodiacs, answered" />
    </section>
  </section>
</Base>

<style>
  .ask { display: grid; gap: clamp(30px, 5vw, 48px); padding-block: clamp(24px, 5vw, 56px) clamp(40px, 6vw, 72px); }
  .ask__hero { display: grid; gap: 16px; justify-items: start; }
  .ask__hero h1 { margin: 0; font-size: clamp(2.1rem, 1.4rem + 3.2vw, 3.4rem); line-height: 1.04; }
  .ask__lede { margin: 0; max-width: 60ch; color: var(--text-2); font-size: var(--text-lg); line-height: 1.6; text-wrap: pretty; }
  .ask__cta { display: grid; gap: 10px; justify-items: start; }
  .ask__nojs { margin: 0; max-width: 52ch; color: var(--muted); font-size: var(--text-sm); }
  .ask__grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .ask__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .ask__card { display: grid; gap: 10px; align-content: start; padding: clamp(18px, 3vw, 24px); }
  .ask__card h2 { margin: 0; font-size: var(--text-md); }
  .ask__card p { margin: 0; color: var(--text-2); font-size: var(--text-sm); line-height: 1.6; }
  .ask__links { color: var(--muted); }
  .ask__links a { color: var(--text-2); text-decoration-color: var(--hair-2); text-underline-offset: 3px; }
  .ask__contract-core { padding: clamp(22px, 4vw, 34px); display: grid; gap: 14px; }
  .ask__contract-core h2 { margin: 0; font-size: var(--text-lg); }
  .ask__contract-core ul { margin: 0; padding-left: 18px; display: grid; gap: 9px; }
  .ask__contract-core li { color: var(--text-2); font-size: var(--text-sm); line-height: 1.6; }
  .ask__contract-core strong { color: var(--text); }
  .ask__rest { margin: 0; color: var(--muted); font-size: var(--text-sm); max-width: 62ch; }
</style>
