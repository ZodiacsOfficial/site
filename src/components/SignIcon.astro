---
/**
 * The pastel SDK sign icon at a canonical rendered size. Serves the
 * pre-resized AVIF/WebP derivatives (never the raw 1024px PNGs) and
 * exposes the sign's hue as --sign on the element for tinting.
 */
import { signBySlug } from '../lib/signs';

interface Props {
  sign: string;
  /** Rendered CSS pixels. Tiers: ≤24→48src, ≤64→128src, else 400src. */
  size?: number;
  alt?: string;
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'high' | 'low' | 'auto';
  /** Skip AVIF when its derivative is larger than WebP on an LCP path. */
  webpOnly?: boolean;
  /**
   * Hold the sources in data attributes so the icon fetches nothing at page
   * load. Chromium fetches lazy images inside display:none panels eagerly,
   * so JS-only surfaces (the nav menus) use this and promote the attributes
   * on first open — see loadDeferredIcons in SiteNav.
   */
  deferred?: boolean;
  decoding?: 'async' | 'sync' | 'auto';
  class?: string;
}

const {
  sign,
  size = 24,
  alt = '',
  loading = 'lazy',
  fetchPriority,
  webpOnly = false,
  deferred = false,
  decoding = 'async',
  class: className,
} = Astro.props;
const s = signBySlug(sign);
const tier = size <= 24 ? 48 : size <= 64 ? 128 : 400;
const avif = `/assets/zodiac-icons/${tier}/${sign}.avif`;
const webp = `/assets/zodiac-icons/${tier}/${sign}.webp`;
---
<picture class:list={['sign-icon', className]} style={`--sign:${s.hue};--sign-size:${size}px`}>
  {!webpOnly && <source {...(deferred ? { 'data-srcset': avif } : { srcset: avif })} type="image/avif" />}
  <img
    {...(deferred ? { 'data-src': webp } : { src: webp })}
    width={size}
    height={size}
    alt={alt}
    loading={loading}
    fetchpriority={fetchPriority}
    decoding={decoding}
  />
</picture>

<style>
  .sign-icon {
    display: inline-block;
    flex: 0 0 auto;
    width: var(--sign-size);
    height: auto;
    max-width: 100%;
    aspect-ratio: 1;
    line-height: 0;
  }
  .sign-icon img { display: block; width: 100%; height: auto; aspect-ratio: 1; border-radius: 50%; }
</style>
