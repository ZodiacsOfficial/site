---
import enhancementUrl from '../lib/email/capture-enhancement.js?url';
---

<!-- A tiny inline loader keeps optional capture code out of the initial route.
     The asset URL is fingerprinted by Vite; normal form POST remains available. -->
<script is:inline type="module" define:vars={{ enhancementUrl }}>
  if (!window.zodiacsEmailCaptureDeferred) {
    window.zodiacsEmailCaptureDeferred = true;
    let activated = false;
    let loading;
    let latestContext;
    function activate() {
      loading ??= import(enhancementUrl).then(({ enhanceEmailCapture }) => {
        enhanceEmailCapture(latestContext);
        activated = true;
        latestContext = undefined;
      }).catch(() => {
        loading = void 0;
      });
      return loading;
    }
    for (const type of ["zodiacs:chart-computed", "zodiacs:chart-context-cleared"]) {
      window.addEventListener(type, (event) => {
        if (activated) return;
        latestContext = { type, detail: event.detail };
        if (type === "zodiacs:chart-computed") void activate();
      });
    }
    const surfaces = document.querySelectorAll("[data-email-capture-shell]");
    surfaces.forEach((surface) => {
      surface.addEventListener("focusin", () => {
        void activate();
      });
      surface.addEventListener("pointerdown", () => {
        void activate();
      });
    });
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void activate();
      }, { rootMargin: "200px" });
      surfaces.forEach((surface) => observer.observe(surface));
    }
  }
</script>
