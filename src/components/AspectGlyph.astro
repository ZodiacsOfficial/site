---
/**
 * A crafted aspect glyph (conjunction / sextile / square / trine /
 * opposition) as line-art, for the learn/aspects surfaces and the aspect
 * lists in the calculators.
 */
import { ASPECT_GLYPH } from '../lib/glyphs/paths';

interface Props {
  type: string;
  size?: number;
  class?: string;
  label?: string;
}
const { type, size = 18, class: cls = '', label } = Astro.props;
const markup = ASPECT_GLYPH[type] ?? '';
---
<svg
  class={`aglyph${cls ? ' ' + cls : ''}`}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label ?? undefined}
  aria-hidden={label ? undefined : 'true'}
  set:html={markup}
></svg>
