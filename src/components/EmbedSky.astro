---
/**
 * The embeddable current-sky card. Fully standalone: no site chrome, no
 * webfonts, no JS, zero requests beyond the document — hosts iframe it
 * and it must cost them nothing. The backlink is the license.
 */
import daily from '../data/daily.json';
import { signBySlug } from '../lib/signs';

interface Props { theme: 'dark' | 'light' }
const { theme } = Astro.props;

const GLYPHS: Record<string, string> = {
  Sun: '☉', Moon: '☽', Mercury: '☿', Venus: '♀', Mars: '♂',
  Jupiter: '♃', Saturn: '♄', Uranus: '♅', Neptune: '♆', Pluto: '♇',
};

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const positions = daily.bodies.map((b) => ({
  glyph: GLYPHS[b.body] ?? '',
  body: b.body,
  label: `${b.degree.toFixed(0)}° ${signBySlug(b.sign)?.name ?? cap(b.sign)}`,
  rx: b.retrograde,
}));
const retro = daily.bodies.filter((b) => b.retrograde).map((b) => b.body).join(', ');

const c = theme === 'dark'
  ? { bg: '#0A0C11', text: '#EEF1F7', mut: '#8B93A7', hair: 'rgba(198,204,218,0.14)', link: '#C6CCDA' }
  : { bg: '#FBFAF7', text: '#1C1E26', mut: '#6B7183', hair: 'rgba(28,30,38,0.14)', link: '#3C4152' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>The sky right now — zodiacs.org</title>
  </head>
  <body style={`margin:0;background:${c.bg};color:${c.text};font:13px/1.5 system-ui,-apple-system,sans-serif;`}>
    <div style="padding:14px 16px;display:flex;flex-direction:column;gap:10px;min-height:calc(100vh - 28px);box-sizing:border-box;">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap;">
        <strong style="font-size:13px;letter-spacing:-0.01em;">The sky right now</strong>
        <span style={`font-family:ui-monospace,monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:${c.mut};`}>{daily.date} · {daily.moon.phase}</span>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:4px 14px;">
        {positions.map((p) => (
          <span style={`font-family:ui-monospace,monospace;font-size:11px;white-space:nowrap;color:${c.text};`}>
            <span aria-hidden="true">{p.glyph}</span> {p.body} {p.label}{p.rx ? ' Rx' : ''}
          </span>
        ))}
      </div>
      <div style={`margin-top:auto;display:flex;justify-content:space-between;align-items:baseline;gap:10px;border-top:1px solid ${c.hair};padding-top:8px;`}>
        <span style={`font-size:11px;color:${c.mut};`}>{retro ? `Retrograde: ${retro}` : 'No planets retrograde'}</span>
        <a href="https://zodiacs.org/transits/?utm_source=embed" target="_blank" rel="noopener" style={`font-size:11px;color:${c.link};text-decoration:none;border-bottom:1px solid ${c.hair};white-space:nowrap;`}>zodiacs.org →</a>
      </div>
    </div>
  </body>
</html>
