---
import { SIGNS, signName } from '../lib/signs';
import BrandMark from './BrandMark.astro';
import EmailCapture from './EmailCapture.astro';
import {
  LOCALE_META,
  LEGACY_HOME_SELECTOR_LOCALES,
  alternatePathEntries,
  localizePath,
  normalizeCatalogLocale,
  stripLocale,
  t,
  type CatalogLocale as Locale,
} from '../lib/i18n';

const year = new Date().getFullYear();
interface Props { locale?: Locale }
const locale = normalizeCatalogLocale(Astro.props.locale);
const routeLanguageLinks = alternatePathEntries(Astro.url.pathname);
// Preserve the established locale-home fallback on English-only routes while
// deriving the candidate set from actual route availability, never LOCALES.
const availableHomeFallback = alternatePathEntries('/').filter((entry) => (
  LEGACY_HOME_SELECTOR_LOCALES.includes(entry.locale as typeof LEGACY_HOME_SELECTOR_LOCALES[number])
));
const languageLinks = (routeLanguageLinks.length ? routeLanguageLinks : availableHomeFallback).map((entry) => ({
  ...entry,
  meta: LOCALE_META[entry.locale],
}));
const FOOTER_COPY = {
  en: { assistant: 'Ask Zodiacs', today: 'Today' },
  es: { assistant: 'Pregúntale a Zodiacs', today: 'Hoy (en inglés)' },
  pt: { assistant: 'Pergunte ao Zodiacs', today: 'Hoje (em inglês)' },
  fr: { assistant: 'Demander à Zodiacs', today: 'Aujourd’hui (en anglais)' },
  it: { assistant: 'Chiedi a Zodiacs', today: 'Oggi (in inglese)' },
  ru: { assistant: 'Спросить Zodiacs — пока по-английски', today: 'Сегодня — пока по-английски' },
} as const satisfies Record<Locale, { assistant: string; today: string }>;
const englishSuffix = locale === 'ru' ? ' — пока по-английски' : '';
const englishOnlyAria = locale === 'ru' ? 'Материал пока доступен по-английски' : undefined;
const privacyHref = localizePath(locale, '/privacy/');
const consumerPath = stripLocale(Astro.url.pathname);
const isRegistryWing = /^\/(?:terminal|registry|sdk|thesis|archive|disclosure)(?:\/|$)/.test(consumerPath);
const suppressFooterEmailCapture = /^\/(?:birth-chart|horoscopes|profile)(?:\/|$)/.test(consumerPath);
---
<footer class="footer">
  <div class="container">
    {locale !== 'ru' && !isRegistryWing && !suppressFooterEmailCapture && <EmailCapture locale={locale} placement="footer" />}
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__mark" href={localizePath(locale, '/')}>
          <BrandMark size={19} />
          <span class="footer__name">Zodiacs</span><span class="footer__tld">.org</span>
        </a>
        <p class="footer__tag">{t(locale, 'footerTag')}</p>
        {locale !== 'ru' && (
          <button
            class="footer__assistant"
            type="button"
            data-assistant-open
            data-assistant-locale={locale}
            aria-haspopup="dialog"
          >
            {FOOTER_COPY[locale].assistant}
          </button>
        )}
      </div>

      <nav class="footer__col" aria-label={t(locale, 'navTools')}>
        <span class="footer__label">{t(locale, 'navTools')}</span>
        <a href={localizePath(locale, '/birth-chart/')}>{t(locale, 'birthChart')}</a>
        <a href="/today/" hreflang="en" title={englishOnlyAria}>{FOOTER_COPY[locale].today}</a>
        <a href={localizePath(locale, '/compatibility/')}>{t(locale, 'compatibility')}</a>
        <a href={localizePath(locale, '/moon-sign/')}>{t(locale, 'moonSign')}</a>
        <a href={localizePath(locale, '/rising-sign/')}>{t(locale, 'risingSign')}</a>
        <a href={localizePath(locale, '/moon-phase/')}>{t(locale, 'moonPhase')}</a>
        <a href={localizePath(locale, '/saturn-return/')}>{t(locale, 'saturnReturn')}</a>
        <a href={localizePath(locale, '/transits/')}>{t(locale, 'transits')}</a>
        <a href="/retrogrades/" hreflang={locale === 'ru' ? 'en' : undefined} title={englishOnlyAria}>{t(locale, 'retrogrades')}{englishSuffix}</a>
      </nav>

      <nav class="footer__col" aria-label={t(locale, 'navLearn')}>
        <span class="footer__label">{t(locale, 'navLearn')}</span>
        <a href="/learn/" hreflang={locale === 'ru' ? 'en' : undefined} title={englishOnlyAria}>{t(locale, 'footerStartHere')}{englishSuffix}</a>
        <a href="/horoscopes/" hreflang={locale === 'ru' ? 'en' : undefined} title={englishOnlyAria}>{t(locale, 'navHoroscopes')}{englishSuffix}</a>
        <a href="/learn/planets/" hreflang={locale === 'ru' ? 'en' : undefined} title={englishOnlyAria}>{t(locale, 'footerPlanets')}{englishSuffix}</a>
        <a href="/learn/houses/" hreflang={locale === 'ru' ? 'en' : undefined} title={englishOnlyAria}>{t(locale, 'footerHouses')}{englishSuffix}</a>
        <a href="/learn/zodiac-dates/" hreflang="en" title={englishOnlyAria}>{t(locale, 'footerZodiacDates')}{englishSuffix}</a>
        <a href="/learn/glossary/" hreflang="en" title={englishOnlyAria}>{t(locale, 'footerGlossary')}{englishSuffix}</a>
        <a href={localizePath(locale, '/methodology/')}>{t(locale, 'footerCompute')}</a>
        <a href={localizePath(locale, '/profile/')}>{t(locale, 'navSavedCharts')}</a>
      </nav>

      <nav class="footer__col footer__col--signs" aria-label={t(locale, 'navSigns')}>
        <span class="footer__label">{t(locale, 'navTwelve')}</span>
        <div class="footer__signs">
          {SIGNS.map((s) => <a href={localizePath(locale, `/${s.slug}/`)}>{signName(s, locale)}</a>)}
        </div>
      </nav>

      <nav class="footer__col" aria-label={t(locale, 'navCollect')}>
        <span class="footer__label">{t(locale, 'navCollect')}</span>
        <a href="/registry/" hreflang={locale === 'ru' ? 'en' : undefined} title={englishOnlyAria}>{t(locale, 'footerRegistry')}{englishSuffix}</a>
        <a href="/sdk/" hreflang={locale === 'ru' ? 'en' : undefined} title={englishOnlyAria}>{t(locale, 'footerSdk')}{englishSuffix}</a>
        <a href={localizePath(locale, '/disclosure/')}>{t(locale, 'footerDisclosure')}</a>
        <span class="footer__note">{t(locale, 'footerCollectNote')}</span>
      </nav>
    </div>

    <hr class="rule" />

    <div class="footer__base">
      <span>© {year} Zodiacs.org</span>
      <span class="footer__base-links">
        <a href="/about/" hreflang={locale === 'ru' ? 'en' : undefined} title={englishOnlyAria}>{t(locale, 'footerAbout')}{englishSuffix}</a>
        <a href={privacyHref}>{t(locale, 'footerPrivacy')}</a>
        <a href="/terms/" hreflang={locale === 'ru' ? 'en' : undefined} title={englishOnlyAria}>{t(locale, 'footerTerms')}{englishSuffix}</a>
        <a href={localizePath(locale, '/methodology/')}>{t(locale, 'footerMethodology')}</a>
        <span>{t(locale, 'footerPlaceData')}: <a href="https://www.geonames.org/" rel="noopener noreferrer">GeoNames</a> (CC BY 4.0)</span>
        <span>{t(locale, 'footerFonts')} <a href={locale === 'ru' ? '/fonts/OFL-golos-text.txt' : '/fonts/OFL-instrument-sans.txt'}>SIL OFL</a></span>
        <a href="/widgets/" hreflang={locale === 'ru' ? 'en' : undefined} title={englishOnlyAria}>{t(locale, 'footerWidgets')}{englishSuffix}</a>
        <a href="/feeds/horoscopes.xml" hreflang={locale === 'ru' ? 'en' : undefined} title={englishOnlyAria}>RSS{englishSuffix}</a>
        <span class="footer__languages">
          {languageLinks.map((entry, index) => (
            <span class="footer__language-option">
              {index > 0 && <span class="footer__language-separator" aria-hidden="true">·</span>}
              {entry.locale === locale
                ? <span lang={entry.meta.htmlLang}>{entry.meta.languageName}</span>
                : <a href={entry.href} hreflang={entry.meta.hreflang} lang={entry.meta.htmlLang}>{entry.meta.languageName}</a>}
            </span>
          ))}
        </span>
      </span>
    </div>
  </div>
</footer>

<script is:inline>
  /* The assistant stays outside Astro's module graph. Its dialog and chart
     summary code load only after an explicit click, from one stable bundle. */
  (function () {
    var buttons = document.querySelectorAll('[data-assistant-open]');
    if (!buttons.length) return;
    var modulePromise;
    function open(button) {
      modulePromise = modulePromise || import('/assets/assistant-ui.js');
      modulePromise.then(function (mod) {
        mod.openAssistant(button.getAttribute('data-assistant-locale') || undefined, button);
      }).catch(function () {});
    }
    buttons.forEach(function (button) {
      button.addEventListener('click', function () { open(button); });
    });
  })();
</script>

<style>
  .footer {
    margin-top: clamp(56px, 9vw, 104px);
    padding: clamp(48px, 7vw, 80px) 0 42px;
    border-top: 1px solid var(--hair-1);
    background: rgba(15, 18, 26, 0.34);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px 24px;
    margin-bottom: clamp(36px, 6vw, 60px);
  }
  @media (min-width: 900px) {
    .footer__grid { grid-template-columns: 1.5fr 0.9fr 0.9fr 1.2fr 1fr; }
  }
  .footer__brand { grid-column: 1 / -1; }
  @media (min-width: 900px) { .footer__brand { grid-column: auto; } }
  .footer__mark {
    direction: ltr;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .footer__name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 21px;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--text);
  }
  .footer__tld {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--faint);
    align-self: end;
    margin-bottom: 1px;
  }
  .footer__tag {
    margin: 12px 0 0;
    max-width: 26ch;
    font-size: var(--text-sm);
    color: var(--muted);
    text-wrap: pretty;
  }
  .footer__assistant {
    margin-top: 14px;
    min-height: 44px;
    padding: 0 15px;
    border: 1px solid var(--hair-2);
    border-radius: 999px;
    color: var(--text-2);
    font-size: var(--text-sm);
  }
  .footer__assistant:hover { color: var(--text); border-color: var(--hair-3); }
  .footer__col { display: flex; flex-direction: column; gap: 9px; }
  .footer__label {
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .footer__col a {
    font-size: var(--text-sm);
    color: var(--text-2);
    text-decoration: none;
    width: fit-content;
  }
  .footer__col a:hover { color: var(--text); }
  .footer__signs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px 16px;
  }
  .footer__note {
    margin-top: 8px;
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--faint);
    max-width: 24ch;
    text-wrap: pretty;
  }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px 20px;
    padding-top: 26px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--faint);
  }
  /* Middots ride as attached ::after separators so they never strand at the
     start of a wrapped line on mobile. */
  .footer__base-links { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 0; }
  .footer__base-links > *:not(:last-child)::after { content: '·'; margin: 0 10px; color: var(--faint); }
  .footer__languages { display: inline-flex; flex-wrap: wrap; align-items: center; }
  .footer__language-option { display: inline-flex; align-items: center; white-space: nowrap; }
  .footer__language-option > a {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
  }
  .footer__language-separator { margin: 0 10px; color: var(--faint); }
  .footer__base a { color: var(--muted); text-decoration: none; }
  .footer__base-links > span:not(.footer__languages) a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .footer__base a:hover { color: var(--text); }
</style>
