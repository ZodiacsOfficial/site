---
import { SIGNS } from '../lib/signs';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__mark" href="/">Zodiacs<span>.org</span></a>
        <p class="footer__tag">
          Birth charts and sign guides, calculated precisely and kept
          private. Your details are computed in the browser and never leave
          your device.
        </p>
      </div>

      <nav class="footer__col" aria-label="Tools">
        <span class="footer__label">Tools</span>
        <a href="/birth-chart/">Birth chart</a>
        <a href="/moon-sign/">Moon sign</a>
        <a href="/rising-sign/">Rising sign</a>
        <a href="/tools/">All tools</a>
      </nav>

      <nav class="footer__col" aria-label="Learn">
        <span class="footer__label">Learn</span>
        <a href="/learn/">Start here</a>
        <a href="/methodology/">How we compute</a>
        <a href="/profile/">Your profile</a>
      </nav>

      <nav class="footer__col footer__col--signs" aria-label="Sign guides">
        <span class="footer__label">The twelve</span>
        <div class="footer__signs">
          {SIGNS.map((s) => <a href={`/${s.slug}/`}>{s.name}</a>)}
        </div>
      </nav>

      <nav class="footer__col" aria-label="Collect">
        <span class="footer__label">Collect</span>
        <a href="/collect/">The Registry</a>
        <a href="/thesis/">Thesis</a>
        <a href="/archive/">Archive</a>
        <a href="/sdk/">SDK</a>
        <span class="footer__note">
          The collector's wing is read-only: no custody, no signing, no
          transactions. Nothing there is financial advice.
        </span>
      </nav>
    </div>

    <hr class="rule" />

    <div class="footer__base">
      <span>© {year} Zodiacs.org</span>
      <span class="footer__base-links">
        <a href="/methodology/">Methodology</a>
        <span aria-hidden="true">·</span>
        <span>Place data: <a href="https://www.geonames.org/" rel="noopener noreferrer">GeoNames</a> (CC BY 4.0)</span>
        <span aria-hidden="true">·</span>
        <span>Fonts under <a href="/fonts/OFL-instrument-sans.txt">SIL OFL</a></span>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(56px, 9vw, 104px);
    padding: clamp(48px, 7vw, 80px) 0 42px;
    border-top: 1px solid var(--hair-1);
    background: linear-gradient(180deg, transparent, rgba(15, 18, 26, 0.5));
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px 24px;
    margin-bottom: clamp(36px, 6vw, 60px);
  }
  @media (min-width: 900px) {
    .footer__grid { grid-template-columns: 1.5fr 0.9fr 0.9fr 1.2fr 1fr; }
  }
  .footer__brand { grid-column: 1 / -1; }
  @media (min-width: 900px) { .footer__brand { grid-column: auto; } }
  .footer__mark {
    font-weight: 650;
    font-size: 17px;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .footer__mark span { color: var(--faint); font-weight: 500; }
  .footer__tag {
    margin: 12px 0 0;
    max-width: 26ch;
    font-size: var(--text-sm);
    color: var(--muted);
    text-wrap: pretty;
  }
  .footer__col { display: flex; flex-direction: column; gap: 9px; }
  .footer__label {
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .footer__col a {
    font-size: var(--text-sm);
    color: var(--text-2);
    text-decoration: none;
    width: fit-content;
    transition: color var(--dur-1) var(--ease);
  }
  .footer__col a:hover { color: var(--text); }
  .footer__signs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px 16px;
  }
  .footer__note {
    margin-top: 8px;
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--faint);
    max-width: 24ch;
    text-wrap: pretty;
  }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px 20px;
    padding-top: 26px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--faint);
  }
  .footer__base-links { display: inline-flex; flex-wrap: wrap; gap: 8px 10px; align-items: center; }
  .footer__base a { color: var(--muted); text-decoration: none; }
  .footer__base a:hover { color: var(--text); }
</style>
