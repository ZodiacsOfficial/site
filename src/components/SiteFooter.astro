---
import { SIGNS, signName } from '../lib/signs';
import BrandMark from './BrandMark.astro';
import EmailCapture from './EmailCapture.astro';
import TerminalMarketVenueNotice from './TerminalMarketVenueNotice.astro';
import { GUIDE_LOADER_MARKER, guideLoaderSource } from '../lib/assistant/guide-loader.mjs';
import { FOOTER_TOOLS } from '../lib/nav-tools';
import {
  LOCALE_META,
  LEGACY_HOME_SELECTOR_LOCALES,
  alternatePathEntries,
  renderableAlternatePathEntries,
  localizePath,
  normalizeCatalogLocale,
  stripLocale,
  t,
  type CatalogLocale as Locale,
} from '../lib/i18n';

const year = new Date().getFullYear();
interface Props { locale?: Locale; terminalMarketNotice?: boolean }
const locale = normalizeCatalogLocale(Astro.props.locale);
const routeLanguageLinks = renderableAlternatePathEntries(Astro.url.pathname);
// Preserve the established locale-home fallback on English-only routes while
// deriving the candidate set from actual route availability, never LOCALES.
const availableHomeFallback = alternatePathEntries('/').filter((entry) => (
  LEGACY_HOME_SELECTOR_LOCALES.includes(entry.locale as typeof LEGACY_HOME_SELECTOR_LOCALES[number])
));
const languageLinks = (routeLanguageLinks.length ? routeLanguageLinks : availableHomeFallback).map((entry) => ({
  ...entry,
  meta: LOCALE_META[entry.locale],
}));
const FOOTER_COPY = {
  en: { assistant: 'Guide' },
  es: { assistant: 'Guide' },
  pt: { assistant: 'Guide' },
  fr: { assistant: 'Guide' },
  it: { assistant: 'Guide' },
  ru: { assistant: 'Guide — пока по-английски' },
} as const satisfies Record<Locale, { assistant: string }>;
// The RU release set the bar: a link whose destination is English-only
// carries hreflang="en" plus a visible "in English for now" cue. Every
// released locale now inherits that courtesy instead of linking silently.
const ENGLISH_ONLY_COPY: Partial<Record<Locale, { suffix: string; aria: string }>> = {
  es: { suffix: ' — por ahora en inglés', aria: 'Contenido por ahora en inglés' },
  pt: { suffix: ' — por enquanto em inglês', aria: 'Conteúdo por enquanto em inglês' },
  fr: { suffix: ' — pour l’instant en anglais', aria: 'Contenu pour l’instant en anglais' },
  it: { suffix: ' — per ora in inglese', aria: 'Contenuto per ora in inglese' },
  ru: { suffix: ' — пока по-английски', aria: 'Материал пока доступен по-английски' },
};
const englishOnly = ENGLISH_ONLY_COPY[locale];
const englishSuffix = englishOnly?.suffix ?? '';
const englishOnlyAria = englishOnly?.aria;
const englishHreflang = englishOnly ? ('en' as const) : undefined;
const privacyHref = localizePath(locale, '/privacy/');
const consumerPath = stripLocale(Astro.url.pathname);
const isRegistryWing = /^\/(?:terminal|registry|sdk|thesis|archive|disclosure)(?:\/|$)/.test(consumerPath);
const suppressFooterEmailCapture = /^\/(?:birth-chart|horoscopes|profile)(?:\/|$)/.test(consumerPath);
const terminalMarketNotice = Boolean(Astro.props.terminalMarketNotice);
---
<footer class="footer">
  <div class="container">
    {locale !== 'ru' && !isRegistryWing && !suppressFooterEmailCapture && <EmailCapture locale={locale} placement="footer" />}
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__mark" href={localizePath(locale, '/')}>
          <BrandMark size={19} />
          <span class="footer__name">Zodiacs</span><span class="footer__tld">.org</span>
        </a>
        <p class="footer__tag">{t(locale, 'footerTag')}</p>
        <button
          class="footer__assistant"
          type="button"
          data-assistant-open
          data-assistant-locale={locale}
          aria-haspopup="dialog"
        >
          {FOOTER_COPY[locale].assistant}
        </button>
      </div>

      <nav class="footer__col" aria-label={t(locale, 'navTools')}>
        <span class="footer__label">{t(locale, 'navTools')}</span>
        {FOOTER_TOOLS.map((tool) => (
          <a
            href={tool.localized ? localizePath(locale, tool.href) : tool.href}
            hreflang={!tool.localized ? 'en' : undefined}
            title={!tool.localized ? englishOnlyAria : undefined}
          >
            {tool.labels?.[locale] ?? t(locale, tool.label)}
            {!tool.localized && !tool.labels ? englishSuffix : ''}
          </a>
        ))}
      </nav>

      <nav class="footer__col" aria-label={t(locale, 'navLearn')}>
        <span class="footer__label">{t(locale, 'navLearn')}</span>
        <a href="/learn/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerStartHere')}{englishSuffix}</a>
        <a href="/horoscopes/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'navHoroscopes')}{englishSuffix}</a>
        <a href="/learn/planets/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerPlanets')}{englishSuffix}</a>
        <a href="/learn/houses/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerHouses')}{englishSuffix}</a>
        <a href="/learn/zodiac-dates/" hreflang="en" title={englishOnlyAria}>{t(locale, 'footerZodiacDates')}{englishSuffix}</a>
        <a href="/learn/glossary/" hreflang="en" title={englishOnlyAria}>{t(locale, 'footerGlossary')}{englishSuffix}</a>
        <a href={localizePath(locale, '/methodology/')}>{t(locale, 'footerCompute')}</a>
        <a href={localizePath(locale, '/profile/')}>{t(locale, 'navSavedCharts')}</a>
      </nav>

      <nav class="footer__col footer__col--signs" aria-label={t(locale, 'navSigns')}>
        <span class="footer__label">{t(locale, 'navTwelve')}</span>
        <div class="footer__signs">
          {SIGNS.map((s) => <a href={localizePath(locale, `/${s.slug}/`)}>{signName(s, locale)}</a>)}
        </div>
      </nav>

      <nav class="footer__col" aria-label={t(locale, 'navCollect')}>
        <span class="footer__label">{t(locale, 'navCollect')}</span>
        <a href="/astrofolio/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'navCollect')}{englishSuffix}</a>
        <a href="/registry/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerRegistry')}{englishSuffix}</a>
        <a href="/sdk/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerSdk')}{englishSuffix}</a>
        <a href={localizePath(locale, '/disclosure/')}>{t(locale, 'footerDisclosure')}</a>
        <span class="footer__note">{t(locale, 'footerCollectNote')}</span>
      </nav>
    </div>

    {terminalMarketNotice && <TerminalMarketVenueNotice />}

    <hr class="rule" />

    <div class="footer__base">
      <span>© {year} Zodiacs.org</span>
      <span class="footer__base-links">
        <a href="/about/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerAbout')}{englishSuffix}</a>
        <a href={privacyHref}>{t(locale, 'footerPrivacy')}</a>
        <a href="/terms/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerTerms')}{englishSuffix}</a>
        <a href={localizePath(locale, '/methodology/')}>{t(locale, 'footerMethodology')}</a>
        <span>{t(locale, 'footerPlaceData')}: <a href="https://www.geonames.org/" rel="noopener noreferrer">GeoNames</a> (CC BY 4.0)</span>
        <span>{t(locale, 'footerFonts')} <a href={locale === 'ru' ? '/fonts/OFL-golos-text.txt' : '/fonts/OFL-instrument-sans.txt'}>SIL OFL</a></span>
        <a href="/widgets/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerWidgets')}{englishSuffix}</a>
        <a href="/feeds/horoscopes.xml" hreflang={englishHreflang} title={englishOnlyAria}>RSS{englishSuffix}</a>
        <span class="footer__languages">
          {languageLinks.map((entry, index) => (
            <span class="footer__language-option">
              {index > 0 && <span class="footer__language-separator" aria-hidden="true">·</span>}
              {entry.locale === locale
                ? <span lang={entry.meta.htmlLang}>{entry.meta.languageName}</span>
                : <a href={entry.href} hreflang={entry.meta.hreflang} lang={entry.meta.htmlLang}>{entry.meta.languageName}</a>}
            </span>
          ))}
        </span>
      </span>
    </div>
  </div>
</footer>

<!-- Guide stays outside Astro's module graph. Before its post-load mount, the
     inline loader reacts only to a deliberate Guide CTA click. -->
<script is:inline data-guide-loader={GUIDE_LOADER_MARKER} set:html={guideLoaderSource(locale)} />

<style>
  .footer {
    margin-top: clamp(56px, 9vw, 104px);
    padding: clamp(48px, 7vw, 80px) 0 42px;
    border-top: 1px solid var(--hair-1);
    background: rgba(15, 18, 26, 0.34);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px 24px;
    margin-bottom: clamp(36px, 6vw, 60px);
  }
  @media (min-width: 900px) {
    .footer__grid { grid-template-columns: 1.5fr 0.9fr 0.9fr 1.2fr 1fr; }
  }
  .footer__brand { grid-column: 1 / -1; }
  @media (min-width: 900px) { .footer__brand { grid-column: auto; } }
  .footer__mark {
    direction: ltr;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .footer__name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 21px;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--text);
  }
  .footer__tld {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--faint);
    align-self: end;
    margin-bottom: 1px;
  }
  .footer__tag {
    margin: 12px 0 0;
    max-width: 26ch;
    font-size: var(--text-sm);
    color: var(--muted);
    text-wrap: pretty;
  }
  .footer__assistant {
    margin-top: 14px;
    min-height: 44px;
    padding: 0 15px;
    border: 1px solid var(--hair-2);
    border-radius: 999px;
    color: var(--text-2);
    font-size: var(--text-sm);
  }
  .footer__assistant:hover { color: var(--text); border-color: var(--hair-3); }
  .footer__col { display: flex; flex-direction: column; gap: 9px; }
  .footer__label {
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .footer__col a {
    font-size: var(--text-sm);
    color: var(--text-2);
    text-decoration: none;
    width: fit-content;
  }
  .footer__col a:hover { color: var(--text); }
  .footer__signs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px 16px;
  }
  .footer__note {
    margin-top: 8px;
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--faint);
    max-width: 24ch;
    text-wrap: pretty;
  }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px 20px;
    padding-top: 26px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--faint);
  }
  /* Middots ride as attached ::after separators so they never strand at the
     start of a wrapped line on mobile. */
  .footer__base-links { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 0; }
  .footer__base-links > *:not(:last-child)::after { content: '·'; margin: 0 10px; color: var(--faint); }
  .footer__languages { display: inline-flex; flex-wrap: wrap; align-items: center; }
  .footer__language-option { display: inline-flex; align-items: center; white-space: nowrap; }
  .footer__language-option > a {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
  }
  .footer__language-separator { margin: 0 10px; color: var(--faint); }
  .footer__base a { color: var(--muted); text-decoration: none; }
  .footer__base-links > span:not(.footer__languages) a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .footer__base a:hover { color: var(--text); }
</style>
