---
/**
 * Per-page head metadata. `path` is the site-relative canonical path
 * (with trailing slash); JSON-LD nodes are passed pre-built.
 */
interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  image = '/assets/og/v2/share.png',
  imageAlt = 'Zodiacs.org — free birth charts, sign guides, and astrology tools.',
  type = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const site = 'https://zodiacs.org';
const canonical = site + path;
const imageUrl = image.startsWith('http') ? image : site + image;
const graph = jsonLd.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })
  : null;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content="Zodiacs.org" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{graph && <script is:inline type="application/ld+json" set:html={graph} />}
