---
/**
 * Per-page head metadata. `path` is the site-relative canonical path
 * (with trailing slash); JSON-LD nodes are passed pre-built.
 */
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_META,
  alternatePaths,
  normalizeLocale,
  stripLocale,
  type Locale,
} from '../lib/i18n';
import {
  SCHEMA_EN,
  SOCIAL_PROFILES,
  WEB_APPLICATION_PATHS,
  breadcrumbLabel,
  ogAltForPath,
  ogImageForPath,
} from '../strings/seo.en.mjs';

interface Props {
  title: string;
  description: string;
  path: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  locale?: Locale;
}

const {
  title,
  description,
  path,
  canonicalPath = path,
  image: explicitImage,
  imageAlt: explicitImageAlt,
  type = 'website',
  noindex = false,
  jsonLd = [],
  locale: rawLocale = 'en',
} = Astro.props;

const site = 'https://zodiacs.org';
const locale = normalizeLocale(rawLocale);
const canonical = site + canonicalPath;
const contentPath = stripLocale(canonicalPath);
const image = explicitImage ?? ogImageForPath(contentPath) ?? '/assets/og/v2/share.png';
const imageAlt = explicitImageAlt ?? ogAltForPath(contentPath);
const imageUrl = image.startsWith('http') ? image : site + image;
const alternates = noindex
  ? null
  : alternatePaths(path);
const alternateEntries = alternates
  ? LOCALES.flatMap((candidate) => {
      const href = alternates[candidate];
      return href ? [{ locale: candidate, href }] : [];
    })
  : [];
const defaultAlternate = alternates?.[DEFAULT_LOCALE];
const ogLocale = LOCALE_META[locale].ogLocale;
const ogLocaleAlternates = alternateEntries
  .filter((entry) => entry.locale !== locale)
  .map((entry) => LOCALE_META[entry.locale].ogLocale);
const organization = {
  '@type': 'Organization',
  '@id': 'https://zodiacs.org/#org',
  name: SCHEMA_EN.organizationName,
  alternateName: SCHEMA_EN.organizationAlternateName,
  url: 'https://zodiacs.org/',
  logo: {
    '@type': 'ImageObject',
    url: 'https://zodiacs.org/assets/app-icons/icon-512.png',
    width: 512,
    height: 512,
  },
  sameAs: SOCIAL_PROFILES,
};

const nodeHasType = (node: Record<string, unknown>, wanted: string) => {
  const value = node['@type'];
  return Array.isArray(value) ? value.includes(wanted) : value === wanted;
};

const suppliedOrganization = jsonLd.find((node) => node['@id'] === organization['@id']);
const mergedOrganization = suppliedOrganization
  ? {
      ...organization,
      ...suppliedOrganization,
      sameAs: [...new Set([
        ...SOCIAL_PROFILES,
        ...(Array.isArray(suppliedOrganization.sameAs) ? suppliedOrganization.sameAs : []),
      ])],
    }
  : organization;
const pageNodes = jsonLd
  .filter((node) => node !== suppliedOrganization)
  .map((node) => {
    if (nodeHasType(node, 'Article')) {
      return {
        headline: title.replace(/\s*[|—]\s*Zodiacs\.org.*$/i, ''),
        description,
        url: canonical,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        image: imageUrl,
        author: { '@id': organization['@id'] },
        publisher: { '@id': organization['@id'] },
        inLanguage: LOCALE_META[locale].htmlLang,
        ...node,
      };
    }
    if (nodeHasType(node, 'WebApplication')) {
      return {
        name: title.replace(/\s*[|—]\s*Zodiacs\.org.*$/i, ''),
        url: canonical,
        description,
        applicationCategory: SCHEMA_EN.applicationCategory,
        operatingSystem: SCHEMA_EN.operatingSystem,
        browserRequirements: SCHEMA_EN.browserRequirements,
        isAccessibleForFree: true,
        offers: {
          '@type': 'Offer',
          price: SCHEMA_EN.freePrice,
          priceCurrency: SCHEMA_EN.currency,
        },
        image: imageUrl,
        publisher: { '@id': organization['@id'] },
        ...node,
      };
    }
    return node;
  });

function automaticBreadcrumb(): Record<string, unknown> | null {
  if (noindex || canonicalPath === '/' || pageNodes.some((node) => nodeHasType(node, 'BreadcrumbList'))) {
    return null;
  }
  if (contentPath === '/' && locale !== DEFAULT_LOCALE) {
    return {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SCHEMA_EN.breadcrumbHome, item: `${site}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: LOCALE_META[locale].languageName,
          item: canonical,
        },
      ],
    };
  }
  const segments = contentPath.split(/[?#]/, 1)[0].split('/').filter(Boolean);
  const localePrefix = LOCALE_META[locale].pathPrefix;
  const itemListElement: Record<string, unknown>[] = [
    {
      '@type': 'ListItem',
      position: 1,
      name: SCHEMA_EN.breadcrumbHome,
      item: `${site}${localePrefix || '/'}`,
    },
  ];
  let current = localePrefix;
  segments.forEach((segment, index) => {
    current += `/${segment}`;
    itemListElement.push({
      '@type': 'ListItem',
      position: index + 2,
      name: breadcrumbLabel(segment),
      item: `${site}${current}/`,
    });
  });
  return { '@type': 'BreadcrumbList', itemListElement };
}

const normalizedCanonicalPath = contentPath === '/'
  ? '/'
  : `/${contentPath.split(/[?#]/, 1)[0].replace(/^\/+|\/+$/g, '')}/`;
const automaticWebApplication = WEB_APPLICATION_PATHS.includes(normalizedCanonicalPath)
  && !pageNodes.some((node) => nodeHasType(node, 'WebApplication'))
  ? {
      '@type': 'WebApplication',
      '@id': `${canonical}#application`,
      name: title.replace(/\s*[|—]\s*Zodiacs\.org.*$/i, ''),
      url: canonical,
      description,
      applicationCategory: SCHEMA_EN.applicationCategory,
      operatingSystem: SCHEMA_EN.operatingSystem,
      browserRequirements: SCHEMA_EN.browserRequirements,
      isAccessibleForFree: true,
      offers: {
        '@type': 'Offer',
        price: SCHEMA_EN.freePrice,
        priceCurrency: SCHEMA_EN.currency,
      },
      image: imageUrl,
      publisher: { '@id': organization['@id'] },
    }
  : null;

const automaticWebsite = contentPath === '/'
  && !pageNodes.some((node) => nodeHasType(node, 'WebSite'))
  ? {
      '@type': 'WebSite',
      '@id': 'https://zodiacs.org/#site',
      url: 'https://zodiacs.org/',
      name: SCHEMA_EN.websiteName,
      description: SCHEMA_EN.websiteDescription,
      publisher: { '@id': organization['@id'] },
      inLanguage: LOCALE_META[locale].htmlLang,
    }
  : null;

const automaticArticle = type === 'article'
  && !pageNodes.some((node) => nodeHasType(node, 'Article'))
  ? {
      '@type': 'Article',
      headline: title.replace(/\s*[|—]\s*Zodiacs\.org.*$/i, ''),
      description,
      url: canonical,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      image: imageUrl,
      author: { '@id': organization['@id'] },
      publisher: { '@id': organization['@id'] },
      inLanguage: LOCALE_META[locale].htmlLang,
    }
  : null;

const graphNodes = [
  mergedOrganization,
  ...[automaticWebsite, automaticBreadcrumb(), automaticWebApplication, automaticArticle]
    .filter((node): node is Record<string, unknown> => Boolean(node)),
  ...pageNodes,
];
const graph = graphNodes.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graphNodes }).replaceAll('<', '\\u003c')
  : null;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{defaultAlternate && (
  <>
    {alternateEntries.map((entry) => (
      <link rel="alternate" hreflang={LOCALE_META[entry.locale].hreflang} href={site + entry.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={site + defaultAlternate} />
  </>
)}
<meta name="robots" content={noindex ? 'noindex, follow, max-image-preview:large' : 'max-image-preview:large'} />

<meta property="og:site_name" content="Zodiacs.org" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={ogLocale} />
{ogLocaleAlternates.map((alternate) => <meta property="og:locale:alternate" content={alternate} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{graph && <script is:inline type="application/ld+json" set:html={graph} />}
