---
/**
 * Per-page head metadata. `path` is the site-relative canonical path
 * (with trailing slash); JSON-LD nodes are passed pre-built.
 */
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, alternatePaths, normalizeLocale, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  path: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  locale?: Locale;
}

const {
  title,
  description,
  path,
  canonicalPath = path,
  image = '/assets/og/v2/share.png',
  imageAlt = 'Zodiacs.org — free birth charts, sign guides, and astrology tools.',
  type = 'website',
  noindex = false,
  jsonLd = [],
  locale: rawLocale = 'en',
} = Astro.props;

const site = 'https://zodiacs.org';
const locale = normalizeLocale(rawLocale);
const canonical = site + canonicalPath;
const imageUrl = image.startsWith('http') ? image : site + image;
const alternates = noindex
  ? null
  : alternatePaths(path);
const alternateEntries = alternates
  ? LOCALES.flatMap((candidate) => {
      const href = alternates[candidate];
      return href ? [{ locale: candidate, href }] : [];
    })
  : [];
const defaultAlternate = alternates?.[DEFAULT_LOCALE];
const ogLocale = LOCALE_META[locale].ogLocale;
const ogLocaleAlternates = alternateEntries
  .filter((entry) => entry.locale !== locale)
  .map((entry) => LOCALE_META[entry.locale].ogLocale);
const organization = {
  '@type': 'Organization',
  '@id': 'https://zodiacs.org/#org',
  name: 'Zodiacs',
  alternateName: 'Zodiacs.org',
  url: 'https://zodiacs.org/',
  logo: {
    '@type': 'ImageObject',
    url: 'https://zodiacs.org/assets/app-icons/icon-512.png',
    width: 512,
    height: 512,
  },
};
const graphNodes = [
  ...(jsonLd.some((node) => node['@id'] === organization['@id']) ? [] : [organization]),
  ...jsonLd,
];
const graph = graphNodes.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graphNodes })
  : null;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{defaultAlternate && (
  <>
    {alternateEntries.map((entry) => (
      <link rel="alternate" hreflang={LOCALE_META[entry.locale].hreflang} href={site + entry.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={site + defaultAlternate} />
  </>
)}
<meta name="robots" content={noindex ? 'noindex, follow, max-image-preview:large' : 'max-image-preview:large'} />

<meta property="og:site_name" content="Zodiacs.org" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={ogLocale} />
{ogLocaleAlternates.map((alternate) => <meta property="og:locale:alternate" content={alternate} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{graph && <script is:inline type="application/ld+json" set:html={graph} />}
