---
import SignIcon from './SignIcon.astro';
import { hasEmailCaptureProvider } from '../lib/email/config';
import { SIGNS, signName } from '../lib/signs';
import { normalizeLocale, t, tf, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
  placement: 'chart' | 'horoscopes' | 'footer';
  revealOnChart?: boolean;
  sign?: string;
}

const {
  locale: rawLocale = 'en',
  placement,
  revealOnChart = false,
  sign: requestedSign,
} = Astro.props;
const locale = normalizeLocale(rawLocale);
const selectedSignData = SIGNS.find((sign) => sign.slug === requestedSign);
const selectedSign = selectedSignData?.slug;
const selectedSignName = selectedSignData ? signName(selectedSignData, locale) : undefined;
// Astro's static frontmatter runs in Node; unprefixed provider secrets are
// intentionally absent from `import.meta.env` client exposure.
const enabled = hasEmailCaptureProvider(process.env);
const id = `email-${placement}-${locale}`;
---
{enabled && (
  <section
    class:list={['email-capture', `email-capture--${placement}`]}
    data-email-capture-shell
    data-placement={placement}
    data-reveal-on-chart={revealOnChart ? 'true' : undefined}
    data-personalized-sign={selectedSign ? 'true' : undefined}
    hidden={revealOnChart}
    aria-labelledby={`${id}-title`}
  >
    <div class="email-capture__copy">
      <span class="email-capture__kicker">{t(locale, 'emailCaptureKicker')}</span>
      <h2
        id={`${id}-title`}
        data-email-title
        data-default-title={t(locale, 'emailCaptureTitle')}
        data-personal-title={t(locale, 'emailCapturePersonalTitle')}
      >
        {selectedSignName
          ? tf(locale, 'emailCapturePersonalTitle', { sign: selectedSignName })
          : t(locale, 'emailCaptureTitle')}
      </h2>
      <p>{t(locale, 'emailCaptureCopy')}</p>
    </div>

    <form
      class="email-capture__form"
      method="post"
      action="/api/email/subscribe"
      data-email-capture
      data-placement={placement}
    >
      <input type="hidden" name="locale" value={locale} />
      <div class="email-capture__trap" aria-hidden="true">
        <label for={`${id}-website`}>{t(locale, 'emailCaptureHoneypot')}</label>
        <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="email-capture__email-row">
        <div class="email-capture__field">
          <label for={`${id}-address`}>{t(locale, 'emailCaptureEmailLabel')}</label>
          <input
            id={`${id}-address`}
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder={t(locale, 'emailCaptureEmailPlaceholder')}
            maxlength="254"
            required
          />
        </div>
        <button class="btn btn--primary email-capture__submit" type="submit" data-label={t(locale, 'emailCaptureSubmit')} data-busy-label={t(locale, 'emailCaptureSubmitting')}>
          {t(locale, 'emailCaptureSubmit')}
        </button>
      </div>

      <div
        class="email-capture__sign-summary"
        data-email-sign-summary
        data-summary-template={t(locale, 'emailCaptureUsingSign')}
        hidden={!selectedSignName}
      >
        <span data-email-sign-summary-copy>
          {selectedSignName ? tf(locale, 'emailCaptureUsingSign', { sign: selectedSignName }) : ''}
        </span>
        <button
          class="email-capture__change-sign"
          type="button"
          data-email-sign-change
          aria-controls={`${id}-signs`}
          aria-expanded="false"
        >
          {t(locale, 'emailCaptureChangeSign')}
        </button>
      </div>

      <fieldset id={`${id}-signs`} class="email-capture__signs" data-email-signs hidden={Boolean(selectedSignName)}>
        <legend>{t(locale, 'emailCaptureSignLegend')}</legend>
        <label class="email-capture__skip">
          <input type="radio" name="sign" value="" checked={!selectedSign} />
          <span>{t(locale, 'emailCaptureNoSign')}</span>
        </label>
        <div class="email-capture__sign-grid">
          {SIGNS.map((sign) => (
            <label class="email-capture__sign" title={signName(sign, locale)}>
              <input
                type="radio"
                name="sign"
                value={sign.slug}
                data-sign-name={signName(sign, locale)}
                checked={selectedSign === sign.slug}
              />
              <span class="email-capture__disc">
                <SignIcon sign={sign.slug} size={24} alt="" />
              </span>
              <span class="email-capture__sign-name">{signName(sign, locale)}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <p class="email-capture__privacy">{t(locale, 'emailCapturePrivacy')}</p>
      <p class="email-capture__status" role="status" aria-live="polite" data-email-status></p>
      <span hidden data-success-copy>{t(locale, 'emailCaptureSuccess')}</span>
      <span hidden data-error-copy>{t(locale, 'emailCaptureError')}</span>
    </form>
  </section>
)}

<script>
  type AnalyticsWindow = Window & {
    zodiacsAnalytics?: { track?: (name: string, props: Record<string, string>) => void };
  };

  function trackCaptureView(surface: HTMLElement) {
    if (surface.dataset.viewTracked === 'true') return;
    surface.dataset.viewTracked = 'true';
    (window as AnalyticsWindow).zodiacsAnalytics?.track?.('email_capture_viewed', {
      placement: surface.dataset.placement ?? 'unknown',
    });
  }

  const captureSurfaces = document.querySelectorAll<HTMLElement>('[data-email-capture-shell]');
  if ('IntersectionObserver' in window) {
    const captureObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        trackCaptureView(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.2 });
    captureSurfaces.forEach((surface) => captureObserver.observe(surface));
  } else {
    captureSurfaces.forEach((surface) => {
      if (!surface.hidden) trackCaptureView(surface);
    });
  }

  function preselectCaptureSign(surface: HTMLElement, sign: string | undefined) {
    if (!sign) return;
    const radios = Array.from(surface.querySelectorAll<HTMLInputElement>('input[name="sign"]'));
    const radio = radios.find((input) => input.value === sign);
    if (!radio) return;
    surface.dataset.personalizedSign = 'true';
    radios.forEach((input) => {
      input.checked = input === radio;
      input.defaultChecked = input === radio;
    });
    renderCaptureSign(surface, radio, true);
  }

  function fillSignTemplate(template: string | undefined, signName: string) {
    return (template ?? '').replace('{sign}', signName);
  }

  function renderCaptureSign(
    surface: HTMLElement,
    radio: HTMLInputElement | undefined,
    collapse: boolean,
  ) {
    const title = surface.querySelector<HTMLElement>('[data-email-title]');
    const summary = surface.querySelector<HTMLElement>('[data-email-sign-summary]');
    const summaryCopy = surface.querySelector<HTMLElement>('[data-email-sign-summary-copy]');
    const chooser = surface.querySelector<HTMLFieldSetElement>('[data-email-signs]');
    const change = surface.querySelector<HTMLButtonElement>('[data-email-sign-change]');
    if (!title || !summary || !summaryCopy || !chooser || !change) return;

    const name = radio?.value ? radio.dataset.signName : undefined;
    if (!name) {
      title.textContent = title.dataset.defaultTitle ?? '';
      summary.hidden = true;
      chooser.hidden = false;
      change.setAttribute('aria-expanded', 'true');
      return;
    }

    title.textContent = fillSignTemplate(title.dataset.personalTitle, name);
    summaryCopy.textContent = fillSignTemplate(summary.dataset.summaryTemplate, name);
    summary.hidden = false;
    chooser.hidden = collapse;
    change.setAttribute('aria-expanded', String(!collapse));
  }

  function setupSignChooser(surface: HTMLElement) {
    if (surface.dataset.signChooserEnhanced === 'true') return;
    const chooser = surface.querySelector<HTMLFieldSetElement>('[data-email-signs]');
    const summary = surface.querySelector<HTMLElement>('[data-email-sign-summary]');
    const change = surface.querySelector<HTMLButtonElement>('[data-email-sign-change]');
    if (!chooser || !summary || !change) return;
    surface.dataset.signChooserEnhanced = 'true';

    change.addEventListener('click', () => {
      const selected = chooser.querySelector<HTMLInputElement>('input[name="sign"]:checked');
      const opening = chooser.hidden;
      renderCaptureSign(surface, selected ?? undefined, !opening);
      if (opening) requestAnimationFrame(() => selected?.focus());
    });

    chooser.addEventListener('change', (event) => {
      const radio = (event.target as HTMLElement).closest<HTMLInputElement>('input[name="sign"]');
      if (!radio || surface.dataset.personalizedSign !== 'true') return;
      const radios = Array.from(chooser.querySelectorAll<HTMLInputElement>('input[name="sign"]'));
      radios.forEach((input) => { input.defaultChecked = input === radio; });
      renderCaptureSign(surface, radio, Boolean(radio.value));
      if (radio.value) change.focus({ preventScroll: true });
    });

    chooser.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || surface.dataset.personalizedSign !== 'true') return;
      const selected = chooser.querySelector<HTMLInputElement>('input[name="sign"]:checked');
      if (!selected?.value) return;
      event.preventDefault();
      renderCaptureSign(surface, selected, true);
      change.focus({ preventScroll: true });
    });
  }

  function revealChartCapture(event: Event) {
    const detail = (event as CustomEvent<{ mode?: string; sunSign?: string }>).detail;
    const mode = detail?.mode;
    if (mode !== 'full') return;
    document.querySelectorAll<HTMLElement>('[data-reveal-on-chart="true"]').forEach((surface) => {
      preselectCaptureSign(surface, detail?.sunSign);
      surface.hidden = false;
    });
  }

  window.addEventListener('zodiacs:chart-computed', revealChartCapture);

  captureSurfaces.forEach(setupSignChooser);

  document.querySelectorAll<HTMLFormElement>('[data-email-capture]').forEach((form) => {
    if (form.dataset.enhanced === 'true') return;
    form.dataset.enhanced = 'true';
    form.addEventListener('reset', () => {
      queueMicrotask(() => {
        const surface = form.closest<HTMLElement>('[data-email-capture-shell]');
        if (!surface || surface.dataset.personalizedSign !== 'true') return;
        const selected = form.querySelector<HTMLInputElement>('input[name="sign"]:checked');
        renderCaptureSign(surface, selected ?? undefined, Boolean(selected?.value));
      });
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>('[data-email-status]');
      if (!button || !status) return;
      const idle = button.dataset.label ?? button.textContent ?? '';
      button.disabled = true;
      button.textContent = button.dataset.busyLabel ?? idle;
      status.textContent = '';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
        });
        if (!response.ok) throw new Error('subscription unavailable');
        status.textContent = form.querySelector<HTMLElement>('[data-success-copy]')?.textContent ?? '';
        form.reset();
        const placement = form.dataset.placement ?? 'unknown';
        (window as AnalyticsWindow)
          .zodiacsAnalytics?.track?.('email_subscribed', { placement });
      } catch {
        status.textContent = form.querySelector<HTMLElement>('[data-error-copy]')?.textContent ?? '';
      } finally {
        button.disabled = false;
        button.textContent = idle;
      }
    });
  });
</script>

<style>
  .email-capture {
    display: grid;
    gap: 22px;
    margin: clamp(30px, 6vw, 56px) 0;
    padding: clamp(22px, 4vw, 34px);
    border: 1px solid var(--hair-2);
    border-radius: var(--r-lg);
    background: var(--void-1);
  }
  .email-capture[hidden] { display: none; }
  @media (min-width: 860px) {
    .email-capture { grid-template-columns: minmax(180px, 0.7fr) minmax(0, 1.3fr); align-items: start; }
  }
  .email-capture__kicker,
  .email-capture__field label,
  .email-capture__signs legend {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .email-capture h2 {
    margin: 8px 0 6px;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.08;
  }
  .email-capture__copy p { margin: 0; max-width: 38ch; color: var(--muted); font-size: var(--text-sm); }
  .email-capture__form { min-width: 0; }
  .email-capture__trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .email-capture__email-row { display: grid; gap: 9px; }
  @media (min-width: 540px) { .email-capture__email-row { grid-template-columns: minmax(0, 1fr) auto; align-items: end; } }
  .email-capture__field { display: grid; gap: 7px; }
  .email-capture__field input {
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    padding: 11px 13px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-sm);
    background: var(--void-0);
    color: var(--text);
    font: inherit;
  }
  .email-capture__field input:focus-visible,
  .email-capture button:focus-visible,
  .email-capture__sign input:focus-visible + .email-capture__disc,
  .email-capture__skip input:focus-visible + span { outline: 2px solid var(--ink-0); outline-offset: 3px; }
  .email-capture__submit { min-height: 46px; padding-inline: 18px; white-space: nowrap; }
  .email-capture__submit:disabled { cursor: wait; }
  .email-capture__sign-summary {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 16px;
    padding: 0 4px 0 12px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-full);
    color: var(--text-2);
    font-size: 13px;
  }
  .email-capture__sign-summary[hidden] { display: none; }
  .email-capture__change-sign {
    min-width: 72px;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--r-full);
    background: rgba(198, 204, 218, 0.08);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .email-capture__change-sign:hover { background: rgba(198, 204, 218, 0.14); }
  }
  .email-capture__change-sign:active { transform: scale(0.97); }
  .email-capture__signs { margin: 16px 0 0; padding: 0; border: 0; }
  .email-capture__signs[hidden] { display: none; }
  .email-capture__signs legend { margin-bottom: 9px; }
  .email-capture__skip { display: inline-flex; align-items: center; gap: 7px; margin: 0 0 10px; color: var(--muted); font-size: 12px; cursor: pointer; }
  .email-capture__skip input { accent-color: var(--ink-1); }
  .email-capture__sign-grid { display: flex; flex-wrap: wrap; gap: 6px; }
  .email-capture__sign { position: relative; display: grid; min-width: 44px; justify-items: center; gap: 3px; cursor: pointer; }
  .email-capture__sign input { position: absolute; opacity: 0; pointer-events: none; }
  .email-capture__disc {
    display: block;
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 50%;
    opacity: 0.58;
    transition: opacity var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .email-capture__sign:hover .email-capture__disc { opacity: 0.88; }
  }
  .email-capture__sign input:checked + .email-capture__disc { opacity: 1; border-color: var(--ink-1); transform: translateY(-1px); }
  .email-capture__sign-name { max-width: 58px; overflow: hidden; color: var(--faint); font-size: 9px; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
  .email-capture__sign input:checked ~ .email-capture__sign-name { color: var(--text-2); }
  .email-capture__privacy,
  .email-capture__status { margin: 10px 0 0; color: var(--faint); font-size: 11px; line-height: 1.5; }
  .email-capture__status:not(:empty) { color: var(--text-2); }
  .email-capture--footer { margin: 0 0 clamp(36px, 6vw, 60px); }
  @media (prefers-reduced-motion: reduce) {
    .email-capture__disc,
    .email-capture__change-sign { transition: none; }
  }
</style>
