---
import type { DisclosureRow } from '../lib/disclosure';
import { disclosureText, statusText } from '../lib/disclosure';
import type { ReleasedLocale as Locale } from '../lib/i18n';

interface Props {
  rows: readonly DisclosureRow[];
  locale: Locale;
}

const { rows, locale } = Astro.props;
---
<div class="disclosure-table-wrap">
  {/* Explicit table roles survive the ≤660px display:block switch, which
      otherwise strips the implicit table semantics for assistive tech. */}
  <table class="disclosure-table" role="table" aria-label={disclosureText(locale, 'tableLabel')}>
    <thead role="rowgroup">
      <tr role="row">
        <th role="columnheader" scope="col">{disclosureText(locale, 'statementHeading')}</th>
        <th role="columnheader" scope="col">{disclosureText(locale, 'evidenceHeading')}</th>
      </tr>
    </thead>
    <tbody role="rowgroup">
      {rows.map((row) => (
        <tr role="row" id={row.id}>
          <th role="rowheader" scope="row">
            <span class="disclosure-table__label">{row.label}</span>
            <span class="disclosure-table__statement">{row.statement}</span>
          </th>
          <td role="cell">
            <span class:list={['status-chip', `status-chip--${row.status}`]}>
              {statusText(locale, row.status)}
            </span>
            <p class="disclosure-table__evidence">{row.evidence}</p>
            {row.links.length > 0 && (
              <ul class="disclosure-table__links">
                {row.links.map((link) => (
                  <li>
                    {link.href ? (
                      <a
                        href={link.href}
                        rel={link.external ? 'noopener nofollow' : undefined}
                      >
                        {link.label}{link.external ? ' ↗' : ''}
                      </a>
                    ) : (
                      <span class="evidence-slot">{link.label}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .disclosure-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-lg);
    background: rgba(15, 18, 26, 0.72);
  }
  .disclosure-table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
  }
  th, td {
    padding: clamp(18px, 3vw, 28px);
    border-bottom: 1px solid var(--hair-1);
    text-align: start;
    vertical-align: top;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--faint);
  }
  tbody tr:last-child > * { border-bottom: 0; }
  tbody th { width: 52%; font-weight: 400; }
  .disclosure-table__label {
    display: block;
    margin-bottom: 9px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-1);
  }
  .disclosure-table__statement {
    display: block;
    max-width: 56ch;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--text);
  }
  .status-chip {
    display: inline-flex;
    padding: 5px 9px;
    border: 1px solid var(--hair-3);
    border-radius: var(--r-full);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .status-chip--verified { color: var(--ink-1); background: rgba(198, 204, 218, 0.06); }
  /* Operator attested: published and dated, but not independently verified.
     The chip text carries the distinction; the cool tint only reinforces it.
     (#B6D4E4 is the Cancer disc hue — sanctioned chroma, distinct from the
     amber pending state, which stays reserved for unresolved rows.) */
  .status-chip--operator-attested {
    color: #B6D4E4;
    border-color: rgba(182, 212, 228, 0.4);
    background: rgba(182, 212, 228, 0.07);
  }
  .status-chip--pending {
    color: #E0B080;
    border-color: rgba(224, 176, 128, 0.45);
    background: rgba(224, 176, 128, 0.08);
  }
  .disclosure-table__evidence {
    margin: 12px 0 0;
    max-width: 54ch;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--muted);
  }
  .disclosure-table__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .disclosure-table__links a,
  .evidence-slot {
    display: inline-flex;
    padding: 6px 9px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-full);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.35;
    letter-spacing: 0.05em;
    text-decoration: none;
  }
  .disclosure-table__links a { color: var(--ink-1); }
  .evidence-slot { color: #E0B080; border-color: rgba(224, 176, 128, 0.3); }
  @media (max-width: 660px) {
    .disclosure-table-wrap { overflow-x: visible; }
    .disclosure-table { display: block; min-width: 0; }
    .disclosure-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .disclosure-table tbody,
    .disclosure-table tr,
    .disclosure-table th,
    .disclosure-table td { display: block; width: 100%; }
    .disclosure-table tbody tr { border-bottom: 1px solid var(--hair-1); }
    .disclosure-table tbody tr:last-child { border-bottom: 0; }
    .disclosure-table tbody th {
      padding-bottom: 10px;
      border-bottom: 0;
    }
    .disclosure-table tbody td {
      padding-top: 0;
      border-bottom: 0;
    }
  }
</style>
