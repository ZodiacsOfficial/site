---
/**
 * A build-time render of the armillary sphere — the same projection the
 * interactive depth view draws, computed here once and shipped as inline
 * SVG with no JavaScript. Pages hand it a recorded chart and choose which
 * circles to show; the maths comes from the same module the island uses,
 * so the two can never disagree about where anything sits.
 */
import {
  declinationCircle,
  eclipticToVec,
  gmstHours,
  horizonCircle,
  inclinedCircle,
  norm360,
  OBLIQUITY,
  orient,
  splitByDepth,
  zenithOf,
  type EclipticPoint,
  type Projected,
} from '../lib/wheel/ecliptic3d';
import { ramcOf } from '../lib/engine/houses';
import { SIGNS } from '../lib/signs';

interface FigureBody {
  body: string;
  lon: number;
  lat: number;
  /** Optional emphasis ring, e.g. the two ends of a contraparallel. */
  ringed?: boolean;
  dim?: boolean;
}

interface Props {
  bodies?: FigureBody[];
  /** Anchors the view the way the wheel does: this longitude sits left. */
  asc?: number | null;
  /** Site latitude/longitude/instant; enables the horizon. */
  latitude?: number | null;
  longitude?: number | null;
  utcMs?: number | null;
  tilt?: number;
  spin?: number;
  showEquator?: boolean;
  showBounds?: boolean;
  showHorizon?: boolean;
  showBand?: boolean;
  /** Declination circles to emphasise, degrees. */
  declRings?: number[];
  /** Chord between the first two ringed bodies. */
  chord?: boolean;
  caption: string;
}

const {
  bodies = [], asc = null,
  latitude = null, longitude = null, utcMs = null,
  tilt = 62, spin = 0,
  showEquator = true, showBounds = false, showHorizon = false, showBand = true,
  declRings = [], chord = false,
  caption,
} = Astro.props;

const VB = 400;
const CX = 200;
const CY = 200;
const R_SPHERE = 150;
const R_BAND_IN = 128;
const R_ICON = 139;

const GLYPH: Record<string, string> = {
  Sun: '☉', Moon: '☽', Mercury: '☿', Venus: '♀', Mars: '♂',
  Jupiter: '♃', Saturn: '♄', Uranus: '♅', Neptune: '♆', Pluto: '♇',
};

const anchor = asc ?? 0;
const at = (lon: number, lat: number, r: number): Projected => {
  const v = orient(eclipticToVec(180 + (lon - anchor), lat), spin, tilt);
  return { x: CX + r * v.x, y: CY - r * v.y, depth: v.z };
};
const poly = (pts: Projected[]) => pts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
const curve = (pts: EclipticPoint[], r: number) => splitByDepth(pts.map((p) => at(p.lon, p.lat, r)));
const cue = (d: number) => 0.4 + 0.6 * ((d + 1) / 2);

/** Meridians and parallels, split into behind/in-front runs. */
const wire: { front: boolean; d: string }[] = [];
for (let lon = 0; lon < 180; lon += 30) {
  const pts: Projected[] = [];
  for (let lat = -90; lat <= 90; lat += 6) pts.push(at(lon, lat, R_SPHERE));
  for (let lat = 90; lat >= -90; lat -= 6) pts.push(at(lon + 180, lat, R_SPHERE));
  splitByDepth(pts).forEach((r) => wire.push({ front: r.front, d: poly(r.points) }));
}
for (const lat of [-60, -30, 30, 60]) {
  const pts: Projected[] = [];
  for (let lon = 0; lon <= 360; lon += 6) pts.push(at(lon, lat, R_SPHERE));
  splitByDepth(pts).forEach((r) => wire.push({ front: r.front, d: poly(r.points) }));
}

const equator = showEquator ? curve(inclinedCircle(0, OBLIQUITY, 3), R_SPHERE) : [];
const bounds = showBounds
  ? [OBLIQUITY, -OBLIQUITY].map((dec) => curve(declinationCircle(dec, OBLIQUITY, 4), R_SPHERE))
  : [];
const decl = declRings.map((dec) => curve(declinationCircle(dec, OBLIQUITY, 4), R_SPHERE));

const sited = showHorizon && latitude !== null && longitude !== null && utcMs !== null;
const zenith = sited
  ? zenithOf(ramcOf({ gastHours: gmstHours(utcMs!), longitude: longitude! }), latitude!)
  : null;
const horizon = zenith ? curve(horizonCircle(zenith, 3), R_SPHERE) : [];

const sectors = showBand
  ? SIGNS.map((sign, i) => {
    const outer: Projected[] = [];
    const inner: Projected[] = [];
    for (let d = 0; d <= 30; d += 3) {
      outer.push(at(i * 30 + d, 0, R_SPHERE));
      inner.unshift(at(i * 30 + d, 0, R_BAND_IN));
    }
    const mid = at(i * 30 + 15, 0, R_BAND_IN);
    return { sign, points: poly([...outer, ...inner]), depth: mid.depth };
  }).sort((a, z) => a.depth - z.depth)
  : [];

const icons = showBand
  ? SIGNS.map((sign, i) => ({ sign, p: at(i * 30 + 15, 0, R_ICON) }))
    .sort((a, z) => a.p.depth - z.p.depth)
  : [];

const marks = bodies
  .filter((b) => GLYPH[b.body])
  .map((b) => ({ ...b, p: at(b.lon, b.lat, R_SPHERE), foot: at(b.lon, 0, R_SPHERE) }))
  .sort((a, z) => a.p.depth - z.p.depth);

const ringed = marks.filter((m) => m.ringed);
const chordLine = chord && ringed.length >= 2 ? { p1: ringed[0].p, p2: ringed[1].p } : null;

const ascMark = sited && asc !== null
  ? { p: at(asc, 0, R_SPHERE), d: at(norm360(asc + 180), 0, R_SPHERE) }
  : null;
---
<figure class="df">
  <svg viewBox={`0 0 ${VB} ${VB}`} role="img" aria-label={caption}>
    <circle class="df-globe" cx={CX} cy={CY} r={R_SPHERE} />

    <g class="df-wire is-back">
      {wire.filter((w) => !w.front).map((w) => <polyline points={w.d} />)}
    </g>
    <g class="df-ring is-back">
      {equator.filter((r) => !r.front).map((r) => <polyline class="df-equator" points={poly(r.points)} />)}
      {horizon.filter((r) => !r.front).map((r) => <polyline class="df-horizon" points={poly(r.points)} />)}
      {bounds.map((b) => b.filter((r) => !r.front).map((r) => <polyline class="df-bound" points={poly(r.points)} />))}
      {decl.map((b) => b.filter((r) => !r.front).map((r) => <polyline class="df-decl" points={poly(r.points)} />))}
    </g>

    {marks.filter((m) => m.p.depth < 0).map((m) => (
      <g class={`df-body${m.dim ? ' is-dim' : ''}`} style={`--hue:${SIGNS[Math.floor(norm360(m.lon) / 30)].hue};opacity:${(cue(m.p.depth) * (m.dim ? 0.5 : 1)).toFixed(2)}`}>
        <line class="df-stem" x1={m.foot.x.toFixed(1)} y1={m.foot.y.toFixed(1)} x2={m.p.x.toFixed(1)} y2={m.p.y.toFixed(1)} />
        {m.ringed && <circle class="df-ringed" cx={m.p.x.toFixed(1)} cy={m.p.y.toFixed(1)} r="12" />}
        <circle class="df-disc" cx={m.p.x.toFixed(1)} cy={m.p.y.toFixed(1)} r="8" />
        <text class="df-glyph" x={m.p.x.toFixed(1)} y={m.p.y.toFixed(1)} text-anchor="middle" dominant-baseline="central">{GLYPH[m.body]}</text>
      </g>
    ))}

    <g class="df-band">
      {sectors.map(({ sign, points }) => (
        <polygon class="df-sector" points={points} style={`--hue:${sign.hue}`} />
      ))}
    </g>
    {icons.map(({ sign, p }) => (
      <image
        href={`/assets/zodiac-icons/48/${sign.slug}.webp`}
        x={(p.x - 9).toFixed(1)} y={(p.y - 9).toFixed(1)}
        width="18" height="18"
        style={`opacity:${cue(p.depth).toFixed(2)}`}
      />
    ))}

    {chordLine && (
      <line class="df-chord"
            x1={chordLine.p1.x.toFixed(1)} y1={chordLine.p1.y.toFixed(1)}
            x2={chordLine.p2.x.toFixed(1)} y2={chordLine.p2.y.toFixed(1)} />
    )}

    <g class="df-ring">
      {equator.filter((r) => r.front).map((r) => <polyline class="df-equator" points={poly(r.points)} />)}
      {horizon.filter((r) => r.front).map((r) => <polyline class="df-horizon" points={poly(r.points)} />)}
      {bounds.map((b) => b.filter((r) => r.front).map((r) => <polyline class="df-bound" points={poly(r.points)} />))}
      {decl.map((b) => b.filter((r) => r.front).map((r) => <polyline class="df-decl" points={poly(r.points)} />))}
    </g>
    <g class="df-wire is-front">
      {wire.filter((w) => w.front).map((w) => <polyline points={w.d} />)}
    </g>

    {ascMark && (
      <g class="df-angle">
        <circle cx={ascMark.p.x.toFixed(1)} cy={ascMark.p.y.toFixed(1)} r="3.4" />
        <text x={ascMark.p.x.toFixed(1)} y={(ascMark.p.y - 8).toFixed(1)} text-anchor="middle">ASC</text>
        <circle class="is-dsc" cx={ascMark.d.x.toFixed(1)} cy={ascMark.d.y.toFixed(1)} r="2.4" />
        <text x={ascMark.d.x.toFixed(1)} y={(ascMark.d.y - 8).toFixed(1)} text-anchor="middle">DSC</text>
      </g>
    )}

    {marks.filter((m) => m.p.depth >= 0).map((m) => (
      <g class={`df-body${m.dim ? ' is-dim' : ''}`} style={`--hue:${SIGNS[Math.floor(norm360(m.lon) / 30)].hue};opacity:${(cue(m.p.depth) * (m.dim ? 0.5 : 1)).toFixed(2)}`}>
        <line class="df-stem" x1={m.foot.x.toFixed(1)} y1={m.foot.y.toFixed(1)} x2={m.p.x.toFixed(1)} y2={m.p.y.toFixed(1)} />
        {m.ringed && <circle class="df-ringed" cx={m.p.x.toFixed(1)} cy={m.p.y.toFixed(1)} r="12" />}
        <circle class="df-disc" cx={m.p.x.toFixed(1)} cy={m.p.y.toFixed(1)} r="8" />
        <text class="df-glyph" x={m.p.x.toFixed(1)} y={m.p.y.toFixed(1)} text-anchor="middle" dominant-baseline="central">{GLYPH[m.body]}</text>
      </g>
    ))}
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .df { margin: 26px 0; }
  .df svg { display: block; width: min(440px, 100%); margin: 0 auto; }
  .df-globe { fill: var(--void-1, #0A0C11); stroke: var(--hair-1, #242936); stroke-width: 1; }
  .df-wire polyline { fill: none; stroke: var(--hair-1, #242936); stroke-width: 0.7; }
  .df-wire.is-back polyline { stroke-dasharray: 2 4; opacity: 0.45; }
  .df-wire.is-front polyline { opacity: 0.85; }
  .df-ring polyline { fill: none; stroke-width: 1.25; }
  .df-ring.is-back polyline { opacity: 0.3; }
  .df-equator { stroke: var(--sign-sagittarius); opacity: 0.75; }
  .df-horizon { stroke: var(--sign-virgo); stroke-width: 1.4; opacity: 0.9; }
  .df-bound { stroke: var(--sign-sagittarius); stroke-width: 1; stroke-dasharray: 1 5; opacity: 0.55; }
  .df-decl { stroke: var(--sign-libra); stroke-width: 1.1; stroke-dasharray: 6 4; opacity: 0.8; }
  .df-chord { stroke: var(--sign-libra); stroke-width: 1.1; stroke-dasharray: 2 3; stroke-linecap: round; opacity: 0.7; }
  .df-sector { fill: var(--hue); opacity: 0.16; stroke: none; }
  .df-stem { stroke: var(--hue); stroke-width: 1.4; opacity: 0.8; }
  .df-disc { fill: var(--void-1, #0A0C11); stroke: var(--hue); stroke-width: 1.5; }
  .df-glyph { fill: var(--ink-0, #EEF1F7); font-size: 10px; font-family: var(--font-mono); }
  .df-ringed { fill: none; stroke: var(--sign-libra); stroke-width: 1; opacity: 0.85; }
  .df-angle circle { fill: var(--ink-0, #EEF1F7); }
  .df-angle circle.is-dsc { fill: var(--sign-virgo); }
  .df-angle text { fill: var(--faint); font-family: var(--font-mono); font-size: 8px; letter-spacing: 0.12em; }
  .df figcaption {
    margin-top: 10px;
    text-align: center;
    color: var(--muted);
    font-size: var(--text-sm);
    text-wrap: pretty;
  }
</style>
