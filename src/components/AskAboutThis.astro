---
import type { ReleasedLocale } from '../lib/i18n/core';

interface Props {
  locale: ReleasedLocale;
  path: string;
  topic: 'chart' | 'transits' | 'compatibility' | 'learn';
}

const { locale, path, topic } = Astro.props;
const copy = {
  en: {
    action: 'Ask about this',
    chart: 'Help me understand my birth chart.',
    transits: 'Help me understand these transits.',
    compatibility: 'Help me understand this compatibility reading.',
    learn: 'Help me understand this astrology topic.',
  },
  es: {
    action: 'Pregunta sobre esto',
    chart: 'Ayúdame a entender mi carta natal.',
    transits: 'Ayúdame a entender estos tránsitos.',
    compatibility: 'Ayúdame a entender esta lectura de compatibilidad.',
    learn: 'Ayúdame a entender este tema de astrología.',
  },
  pt: {
    action: 'Pergunte sobre isto',
    chart: 'Ajude-me a entender meu mapa astral.',
    transits: 'Ajude-me a entender estes trânsitos.',
    compatibility: 'Ajude-me a entender esta leitura de compatibilidade.',
    learn: 'Ajude-me a entender este tema de astrologia.',
  },
  fr: {
    action: 'Poser une question',
    chart: 'Aide-moi à comprendre mon thème astral.',
    transits: 'Aide-moi à comprendre ces transits.',
    compatibility: 'Aide-moi à comprendre cette lecture de compatibilité.',
    learn: 'Aide-moi à comprendre ce sujet astrologique.',
  },
  it: {
    action: 'Chiedi di questo',
    chart: 'Aiutami a capire il mio tema natale.',
    transits: 'Aiutami a capire questi transiti.',
    compatibility: 'Aiutami a capire questa lettura di compatibilità.',
    learn: 'Aiutami a capire questo argomento astrologico.',
  },
} as const;
const selected = copy[locale];
---
<aside class="ask-context container" aria-label={selected.action}>
  <button
    type="button"
    class="ask-context__button"
    data-assistant-open
    data-assistant-locale={locale}
    data-assistant-page-path={path}
    data-assistant-prefill={selected[topic]}
  >
    <span>{selected.action}</span>
    <span aria-hidden="true">↗</span>
  </button>
</aside>

<style>
  .ask-context {
    display: flex;
    justify-content: flex-end;
    margin-top: clamp(22px, 4vw, 40px);
  }
  .ask-context__button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    padding: 9px 15px;
    border: 1px solid var(--hair-2);
    border-radius: 999px;
    color: var(--text-2);
    font-size: var(--text-sm);
    background: color-mix(in srgb, var(--field) 88%, transparent);
  }
  .ask-context__button:hover { color: var(--text); border-color: var(--hair-3); }
  .ask-context__button:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; }
</style>
