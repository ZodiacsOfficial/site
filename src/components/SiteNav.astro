---
/**
 * Floating pill navigation. The Signs item opens a 12-icon pastel grid —
 * the icons are the navigation. The profile glyph fills once the visitor
 * has saved something (read from localStorage, progressive).
 */
import { SIGNS, signDates, signName } from '../lib/signs';
import SignIcon from './SignIcon.astro';
import { availableLocalesForPath, englishOnlyCue, localizePath, normalizeCatalogLocale, t, type CatalogLocale as Locale } from '../lib/i18n';
import { ALL_TOOLS_LABEL, NAV_TOOLS, navToolLabelHasEnglishCue, type NavTool } from '../lib/nav-tools';

interface Props { locale?: Locale }
const locale = normalizeCatalogLocale(Astro.props.locale);
const path = Astro.url.pathname;
const hasDailyReading = availableLocalesForPath('/today/')?.includes(locale) ?? false;
const todayLabel = t(locale, 'today').replace(/^./u, (letter) => letter.toLocaleUpperCase(locale));
const links = [
  ...(hasDailyReading ? [{ href: '/today/', label: todayLabel }] : []),
  { href: '/learn/', label: t(locale, 'navLearn') },
  { href: '/horoscopes/', label: t(locale, 'navHoroscopes') },
] as const;
const astrofolioLabel: Record<Locale, string> = {
  en: 'The twelve Zodiac signs',
  es: 'Los doce signos del Zodiaco — por ahora en inglés',
  pt: 'Os doze signos do Zodíaco — por enquanto em inglês',
  fr: 'Les douze signes du Zodiaque — pour l’instant en anglais',
  it: 'I dodici segni zodiacali — per ora in inglese',
  ru: 'Двенадцать знаков Зодиака, пока по-английски',
};
const searchLabel: Record<Locale, string> = {
  en: 'Search the site',
  es: 'Buscar en el sitio',
  pt: 'Pesquisar no site',
  fr: 'Rechercher sur le site',
  it: 'Cerca nel sito',
  ru: 'Поиск по сайту',
};
const openMenuLabel: Record<Locale, string> = {
  en: 'Open menu',
  es: 'Abrir menú',
  pt: 'Abrir menu',
  fr: 'Ouvrir le menu',
  it: 'Apri menu',
  ru: 'Открыть меню',
};
const closeMenuLabel: Record<Locale, string> = {
  en: 'Close menu',
  es: 'Cerrar menú',
  pt: 'Fechar menu',
  fr: 'Fermer le menu',
  it: 'Chiudi menu',
  ru: 'Закрыть меню',
};
// Shared English-only courtesy (src/lib/i18n/english-only.ts): hreflang="en"
// plus a visible cue on every link whose destination has no localized route.
const englishOnly = englishOnlyCue(locale);
const englishOnlyAria = englishOnly?.aria;
const englishOnlyBadge = englishOnly?.suffix.replace(/^ /, '');
const visibleNavTools = locale === 'ru'
  ? NAV_TOOLS.filter((tool) => tool.href !== '/birthday/')
  : NAV_TOOLS;
/** True when localizePath falls back to the canonical English route. */
const englishOnlyHref = (href: string): boolean => Boolean(englishOnly) && localizePath(locale, href) === href;
const toolNeedsEnglishCue = (tool: NavTool): boolean => englishOnlyHref(tool.href)
  && !navToolLabelHasEnglishCue(locale, tool.label, t(locale, tool.label));
---
<div class="nav-wrap">
  <nav class:list={['nav', { 'nav--localized': locale !== 'en', 'nav--without-search': locale === 'ru', 'nav--with-today': links.some((link) => link.href === '/today/') }]} aria-label={t(locale, 'navPrimary')} data-nav>
    <a class="nav__mark" href={localizePath(locale, '/')}>
      <span class="nav__name">Zodiacs<span class="nav__sep">·</span><span class="nav__dim">org</span></span>
    </a>

    <div class="nav__links">
      <button class="nav__link nav__dropdown-btn" type="button" data-tools-toggle aria-expanded="false" aria-controls="tools-menu" aria-haspopup="true">
        {t(locale, 'navTools')}
        <svg width="8" height="5" viewBox="0 0 8 5" fill="none" aria-hidden="true"><path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="nav__link nav__dropdown-btn" type="button" data-signs-toggle aria-expanded="false" aria-controls="signs-menu" aria-haspopup="true">
        {t(locale, 'navSigns')}
        <svg width="8" height="5" viewBox="0 0 8 5" fill="none" aria-hidden="true"><path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      {links.map((l) => (
        <a
          class:list={['nav__link', { 'nav__link--deferred': englishOnlyHref(l.href) }]}
          href={localizePath(locale, l.href)}
          hreflang={englishOnlyHref(l.href) ? 'en' : undefined}
          aria-current={path.startsWith(localizePath(locale, l.href)) ? 'page' : undefined}
          title={englishOnlyHref(l.href) ? englishOnlyAria : undefined}
          aria-label={englishOnlyHref(l.href) ? `${l.label}. ${englishOnlyAria}` : undefined}
        >
          {englishOnlyHref(l.href) ? (
            <><span>{l.label}</span><small class="nav__deferred">{englishOnlyBadge}</small></>
          ) : l.label}
        </a>
      ))}
      <a class="nav__link nav__saved" href={localizePath(locale, '/profile/')} aria-current={path.startsWith(localizePath(locale, '/profile/')) ? 'page' : undefined} data-profile-glyph>{t(locale, 'navSavedCharts')}</a>
    </div>

    {locale === 'ru' ? null : locale === 'en' ? (
      <button class="nav__search" type="button" data-search-open aria-label="Search the site" aria-haspopup="dialog">
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.75" stroke="currentColor" stroke-width="1.4"/><path d="M10.5 10.5L13.5 13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <kbd class="nav__search-kbd" aria-hidden="true">/</kbd>
      </button>
    ) : (
      <a
        class="nav__search"
        href="/?search=1"
        hreflang="en"
        title={englishOnlyAria}
        aria-label={`${searchLabel[locale]}. ${englishOnlyAria}`}
      >
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.75" stroke="currentColor" stroke-width="1.4"/><path d="M10.5 10.5L13.5 13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </a>
    )}

    <a
      class:list={['nav__chip', { 'nav__chip--deferred': Boolean(englishOnly) }]}
      href="/astrofolio/"
      hreflang={englishOnly ? 'en' : undefined}
      aria-current={path === '/astrofolio/' ? 'page' : undefined}
      title={englishOnlyAria}
      aria-label={englishOnly ? `${t(locale, 'navCollect')}. ${englishOnlyAria}` : undefined}
    >
      {englishOnly ? (
        <><span>{t(locale, 'navCollect')}</span><small class="nav__deferred">{englishOnlyBadge}</small></>
      ) : t(locale, 'navCollect')}
    </a>

    <button
      class="nav__burger"
      type="button"
      data-menu-toggle
      data-open-label={openMenuLabel[locale]}
      data-close-label={closeMenuLabel[locale]}
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={openMenuLabel[locale]}
    >
      <span class="nav__burger-line"></span>
      <span class="nav__burger-line"></span>
      <span class="nav__burger-line"></span>
    </button>
  </nav>

  <div class="nav-menu tools-menu" id="tools-menu" data-tools-menu hidden>
    <div class="tools-menu__grid">
      {visibleNavTools.map((tool) => (
        <a
          class="tools-menu__item"
          href={localizePath(locale, tool.href)}
          hreflang={englishOnlyHref(tool.href) ? 'en' : undefined}
          title={englishOnlyHref(tool.href) ? englishOnlyAria : undefined}
        >
          <span class="tools-menu__name">{t(locale, tool.label)}{toolNeedsEnglishCue(tool) ? englishOnly?.suffix : ''}</span>
          <span class="tools-menu__desc">{tool.sublabel[locale]}</span>
        </a>
      ))}
      <a class="tools-menu__all" href={localizePath(locale, '/tools/')}>
        {ALL_TOOLS_LABEL[locale]} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="nav-menu signs-menu" id="signs-menu" data-signs-menu hidden>
    <div class="signs-menu__grid">
      {SIGNS.map((s) => (
        <a class="signs-menu__item" href={localizePath(locale, `/${s.slug}/`)} style={`--sign:${s.hue}`}>
          <SignIcon sign={s.slug} size={32} deferred />
          <span class="signs-menu__name">{signName(s, locale)}</span>
          <span class="signs-menu__dates">{signDates(s, locale)}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <nav aria-label={locale === 'ru' ? 'Мобильная навигация' : 'Mobile'}>
    <div class="mobile-menu__group">
      <span class="mobile-menu__label">{t(locale, 'navSite')}</span>
      {hasDailyReading && <a class="mobile-menu__link" style="--i:0" href={localizePath(locale, '/today/')}>{todayLabel}</a>}
      <a class="mobile-menu__link" style={`--i:${hasDailyReading ? 1 : 0}`} href={localizePath(locale, '/learn/')} hreflang={englishOnlyHref('/learn/') ? 'en' : undefined} title={englishOnlyHref('/learn/') ? englishOnlyAria : undefined}>{t(locale, 'navLearn')}{englishOnlyHref('/learn/') ? englishOnly?.suffix : ''}</a>
      <a class="mobile-menu__link" style={`--i:${hasDailyReading ? 2 : 1}`} href={localizePath(locale, '/horoscopes/')} hreflang={englishOnlyHref('/horoscopes/') ? 'en' : undefined} title={englishOnlyHref('/horoscopes/') ? englishOnlyAria : undefined}>{t(locale, 'navHoroscopes')}{englishOnlyHref('/horoscopes/') ? englishOnly?.suffix : ''}</a>
      <a class="mobile-menu__link" style={`--i:${hasDailyReading ? 3 : 2}`} href={localizePath(locale, '/profile/')}>{t(locale, 'navSavedCharts')}</a>
      <a class="mobile-menu__link mobile-menu__registry" style={`--i:${hasDailyReading ? 4 : 3}`} href="/astrofolio/" hreflang={englishOnly ? 'en' : undefined} title={englishOnlyAria}>
        <span>{t(locale, 'navCollect')}</span>
        <small>{astrofolioLabel[locale]}</small>
      </a>
    </div>
    <div class="mobile-menu__group">
      <span class="mobile-menu__label">{t(locale, 'navTools')}</span>
      <div class="mobile-menu__tools">
        {visibleNavTools.map((tool, i) => (
          <a
            class="mobile-menu__tool"
            style={`--i:${i}`}
            href={localizePath(locale, tool.href)}
            hreflang={englishOnlyHref(tool.href) ? 'en' : undefined}
            title={englishOnlyHref(tool.href) ? englishOnlyAria : undefined}
            aria-label={`${t(locale, tool.label)}. ${tool.sublabel[locale]}${toolNeedsEnglishCue(tool) ? ` ${englishOnlyAria}.` : ''}`}
          >
            <span>{t(locale, tool.label)}{toolNeedsEnglishCue(tool) ? englishOnly?.suffix : ''}</span>
          </a>
        ))}
        <a class="mobile-menu__tool mobile-menu__tool--all" href={localizePath(locale, '/tools/')}>
          {ALL_TOOLS_LABEL[locale]} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="mobile-menu__group">
      <span class="mobile-menu__label">{t(locale, 'navTwelve')}</span>
      <div class="mobile-menu__signs">
        {SIGNS.map((s, i) => (
          <a class="mobile-menu__sign" style={`--i:${i}`} href={localizePath(locale, `/${s.slug}/`)} aria-label={signName(s, locale)}>
            <SignIcon sign={s.slug} size={30} deferred />
            <span>{signName(s, locale)}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>
</div>

<style>
  .nav-wrap {
    position: fixed;
    top: 14px;
    inset-inline: 0;
    z-index: var(--z-nav);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    padding-top: env(safe-area-inset-top);
    font-family: var(--font-nav-sans);
  }
  .nav {
    pointer-events: auto;
    /* Reserve the pill and control tracks before streamed children or fonts
       arrive. Text is never allowed to determine the centered shell width. */
    display: grid;
    grid-template-areas: 'mark search chip menu';
    grid-template-columns: minmax(0, 1fr) 44px 116px 44px;
    box-sizing: border-box;
    width: 336px;
    max-width: calc(100% - 32px);
    align-items: center;
    gap: 10px;
    height: 52px;
    padding-block: 0;
    padding-inline: 20px 10px;
    border-radius: var(--r-full);
    background: rgba(10, 12, 17, 0.66);
    backdrop-filter: saturate(150%) blur(18px);
    -webkit-backdrop-filter: saturate(150%) blur(18px);
    border: 1px solid var(--hair-2);
    box-shadow:
      inset 0 1px 0 rgba(238, 241, 247, 0.06),
      0 12px 32px -14px rgba(0, 0, 0, 0.7);
  }
  .nav--without-search {
    width: 292px;
    grid-template-areas: 'mark chip menu';
    grid-template-columns: minmax(0, 1fr) 116px 44px;
  }
  /* Shared-chart pages mark the receiver in <head>, before the nav streams.
     Their existing boundary removes the wing link. Reserve only the remaining
     tracks from the first paint, keeping their sizes and the pill centered. */
  :global(html[data-chart-share-receiver]) .nav {
    width: 210px;
    grid-template-areas: 'mark search menu';
    grid-template-columns: minmax(0, 1fr) 44px 44px;
  }
  :global(html[data-chart-share-receiver]) .nav--without-search {
    width: 166px;
    grid-template-areas: 'mark menu';
    grid-template-columns: minmax(0, 1fr) 44px;
  }
  .nav__mark {
    grid-area: mark;
    min-width: 0;
    direction: ltr;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__name {
    font-family: var(--font-nav-serif);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--text);
    white-space: nowrap;
  }
  .nav__sep { color: var(--muted); margin: 0 4px; }
  .nav__dim { color: var(--text-2); font-weight: 500; }
  /* Compact by default; the full lockup appears with the desktop links. */
  .nav__sep,
  .nav__dim { display: none; }

  .nav__links {
    grid-area: links;
    display: none;
    min-width: 0;
    align-items: center;
    gap: 2px;
    grid-template-columns: 74px 74px 64px 62px 102px minmax(0, 1fr);
  }
  .nav--localized .nav__links {
    grid-template-columns: 128px 82px repeat(2, minmax(0, 1fr)) 156px;
  }
  /* The server knows the full link set before children stream. Never infer
     the sixth track from children arriving later in the document. */
  .nav--localized.nav--with-today .nav__links {
    grid-template-columns: 128px 82px 52px repeat(2, minmax(0, 1fr)) 144px;
  }
  .nav--without-search .nav__links {
    grid-template-columns: 136px 84px repeat(2, minmax(0, 1fr)) 172px;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    padding: 7px 11px;
    border-radius: var(--r-full);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__link:hover { color: var(--text); background: rgba(198, 204, 218, 0.07); }
  .nav__link[aria-current='page'] { color: var(--text); }
  .nav__link--deferred,
  .nav__chip--deferred {
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    line-height: 1.05;
  }
  .nav__deferred {
    display: block;
    font-family: var(--font-nav-sans);
    font-size: 7.5px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
    color: var(--faint);
    white-space: nowrap;
  }

  .nav__search {
    grid-area: search;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    gap: 7px;
    padding: 0;
    border: none;
    border-radius: var(--r-full);
    background: none;
    color: var(--text-2);
    cursor: pointer;
    text-decoration: none;
  }
  .nav__search:hover { color: var(--text); background: rgba(198, 204, 218, 0.07); }
  .nav__search-kbd {
    display: none;
    font-family: var(--font-nav-mono);
    font-size: 10px;
    line-height: 1;
    padding: 3px 5px;
    border: 1px solid var(--hair-2);
    border-radius: 4px;
    color: var(--faint);
  }
  .nav__dropdown-btn { justify-content: space-between; }
  .nav__dropdown-btn svg { transition: transform var(--dur-1) var(--ease); }
  .nav__dropdown-btn[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* Saved-charts link tints to accent once this device has saved a chart. */
  .nav__saved.has-saves { color: var(--accent); }
  .nav__saved.has-saves:hover { color: var(--accent); }

  /* A permanent door into Astrofolio. It stays compact on phones, then gains
     the divider treatment once the desktop link row appears. */
  .nav__chip {
    grid-area: chip;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0;
    padding-inline: 16px 2px;
    border-inline-start: 1px solid var(--hair-2);
    font-family: var(--font-nav-serif);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__chip:hover { color: var(--text); }
  .nav__chip[aria-current='page'] { color: var(--text); }

  .nav__burger {
    grid-area: menu;
    position: relative;
    display: inline-block;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--hair-2);
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .nav__burger:active { transform: scale(0.97); }
  .nav__burger-line {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--text-2);
    transform-origin: 50% 50%;
    transition: transform 220ms cubic-bezier(0.77, 0, 0.175, 1), opacity 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .nav__burger-line:first-child { transform: translate(-50%, calc(-50% - 5px)); }
  .nav__burger-line:nth-child(2) { transform: translate(-50%, -50%); }
  .nav__burger-line:last-child { transform: translate(-50%, calc(-50% + 5px)); }
  /* Three bars collapse into an X: top and bottom cross at the centre,
     the middle bar fades out. */
  .nav__burger[aria-expanded='true'] .nav__burger-line:first-child { transform: translate(-50%, -50%) rotate(45deg); }
  .nav__burger[aria-expanded='true'] .nav__burger-line:nth-child(2) { opacity: 0; transform: translate(-50%, -50%) scaleX(0.18); }
  .nav__burger[aria-expanded='true'] .nav__burger-line:last-child { transform: translate(-50%, -50%) rotate(-45deg); }

  /* Keep both 44px controls intact on 320px screens by compacting only the
     surrounding lockup, gaps, padding, and destination label. */
  @media (max-width: 360px) {
    .nav { width: 272px; grid-template-columns: minmax(0, 1fr) 44px 88px 44px; }
    .nav { gap: 4px; padding-inline: 10px 4px; }
    .nav--localized { width: 288px; grid-template-columns: minmax(0, 1fr) 44px 100px 44px; }
    .nav--without-search { width: 224px; grid-template-columns: minmax(0, 1fr) 88px 44px; }
    :global(html[data-chart-share-receiver]) .nav { width: 180px; }
    :global(html[data-chart-share-receiver]) .nav--localized { width: 184px; }
    :global(html[data-chart-share-receiver]) .nav--without-search { width: 132px; }
    .nav__mark { gap: 0; }
    .nav__name { font-size: 11px; letter-spacing: 0.08em; }
    .nav__chip { padding-inline: 7px 0; font-size: 11px; letter-spacing: 0.04em; }
  }

  /* A desktop row opens only when its complete reserved shell fits. The
     localized tier accommodates full labels and their English-only cues. */
  @media (min-width: 920px) {
    .nav:not(.nav--localized) {
      width: 884px;
      grid-template-areas: 'mark links search chip';
      grid-template-columns: 116px minmax(0, 1fr) 62px 120px;
      gap: 18px;
    }
    :global(html[data-chart-share-receiver]) .nav:not(.nav--localized) {
      width: 746px;
      grid-template-areas: 'mark links search';
      grid-template-columns: 116px minmax(0, 1fr) 62px;
    }
    .nav:not(.nav--localized) .nav__links { display: grid; }
    .nav:not(.nav--localized) .nav__sep,
    .nav:not(.nav--localized) .nav__dim { display: inline; }
    .nav:not(.nav--localized) .nav__search { display: inline-flex; align-items: center; width: 62px; padding: 8px 11px; }
    .nav:not(.nav--localized) .nav__search-kbd { display: inline-block; }
    .nav:not(.nav--localized) .nav__chip { min-height: 34px; letter-spacing: 0.14em; }
    .nav:not(.nav--localized) .nav__burger { display: none; }
  }
  @media (min-width: 1040px) {
    .nav--localized {
      width: 992px;
      grid-template-areas: 'mark links search chip';
      grid-template-columns: 116px minmax(0, 1fr) 44px 120px;
      gap: 18px;
    }
    .nav--without-search { grid-template-areas: 'mark links chip'; grid-template-columns: 116px minmax(0, 1fr) 120px; }
    :global(html[data-chart-share-receiver]) .nav--localized {
      width: 854px;
      grid-template-areas: 'mark links search';
      grid-template-columns: 116px minmax(0, 1fr) 44px;
    }
    :global(html[data-chart-share-receiver]) .nav--without-search {
      grid-template-areas: 'mark links';
      grid-template-columns: 116px minmax(0, 1fr);
    }
    .nav--localized .nav__links { display: grid; }
    .nav--localized .nav__sep,
    .nav--localized .nav__dim { display: inline; }
    .nav--localized .nav__chip { min-height: 34px; letter-spacing: 0.14em; }
    .nav--localized .nav__burger { display: none; }
  }

  /* ── Tools / Signs dropdowns ── */
  .nav-menu {
    pointer-events: auto;
    margin-top: 10px;
    width: min(100% - 32px, 620px);
    border-radius: var(--r-lg);
    background: rgba(10, 12, 17, 0.82);
    backdrop-filter: saturate(150%) blur(22px);
    -webkit-backdrop-filter: saturate(150%) blur(22px);
    border: 1px solid var(--hair-2);
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.8);
    padding: 10px;
    opacity: 0;
    transform: translateY(-6px) scale(0.99);
    transition: opacity var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  .nav-menu.is-open { opacity: 1; transform: none; }
  .tools-menu { width: min(100% - 32px, 720px); }
  .tools-menu__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
  }
  .tools-menu__item {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding: 12px;
    border-radius: var(--r-md);
    color: var(--text);
    text-decoration: none;
  }
  .tools-menu__item:hover,
  .tools-menu__item:focus-visible { background: rgba(198, 204, 218, 0.07); }
  .tools-menu__name { font-size: 14px; font-weight: 550; line-height: 1.25; }
  .tools-menu__desc {
    overflow: hidden;
    font-family: var(--font-nav-mono);
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.025em;
    color: var(--faint);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tools-menu__all {
    grid-column: 1 / -1;
    padding: 11px 12px 8px;
    border-top: 1px solid var(--hair-1);
    color: var(--text-2);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }
  .tools-menu__all:hover,
  .tools-menu__all:focus-visible { color: var(--text); }
  .signs-menu__grid {
    direction: ltr;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
  }
  @media (min-width: 640px) { .signs-menu__grid { grid-template-columns: repeat(3, 1fr); } }
  .signs-menu__item {
    display: grid;
    grid-template-columns: 32px 1fr;
    grid-template-rows: auto auto;
    column-gap: 12px;
    align-items: center;
    padding: 10px 12px;
    border-radius: var(--r-md);
    text-decoration: none;
  }
  :global(html:lang(ar)) .signs-menu__item { direction: rtl; }
  .signs-menu__item:hover { background: color-mix(in oklab, var(--sign) 12%, transparent); }
  .signs-menu__item :global(.sign-icon) { grid-row: span 2; }
  .signs-menu__name { font-size: 14px; font-weight: 550; color: var(--text); line-height: 1.25; }
  .signs-menu__dates {
    font-family: var(--font-nav-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  /* ── Mobile overlay ── */
  :global(body:has([data-mobile-menu]:not([hidden])) .zguide-launcher) {
    visibility: hidden;
    pointer-events: none;
  }
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-nav) - 1);
    background: rgba(6, 7, 9, 0.88);
    backdrop-filter: blur(26px) saturate(140%);
    -webkit-backdrop-filter: blur(26px) saturate(140%);
    padding: calc(96px + env(safe-area-inset-top)) 24px 40px;
    overflow-y: auto;
    font-family: var(--font-nav-sans);
  }
  .mobile-menu__group + .mobile-menu__group { margin-top: 34px; }
  .mobile-menu__group--quiet {
    padding-top: 18px;
    border-top: 1px solid var(--hair-1);
  }
  .mobile-menu__label {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-nav-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .mobile-menu__link {
    display: block;
    padding: 13px 0;
    font-family: var(--font-nav-serif);
    font-size: clamp(24px, 7vw, 32px);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.05;
    text-decoration: none;
    color: var(--text);
    border-bottom: 1px solid var(--hair);
  }
  .mobile-menu__link:last-child { border-bottom: 0; }
  .mobile-menu__registry {
    display: grid;
    gap: 5px;
  }
  .mobile-menu__registry small {
    color: var(--faint);
    font-family: var(--font-nav-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    line-height: 1.35;
  }
  .mobile-menu__tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .mobile-menu__tool {
    display: block;
    min-width: 0;
    min-height: 44px;
    padding: 11px 0;
    border-bottom: 1px solid var(--hair);
    color: var(--text);
    font-family: var(--font-nav-serif);
    font-size: clamp(18px, 5vw, 22px);
    line-height: 1.05;
    text-decoration: none;
  }
  .mobile-menu__tool:last-child { border-bottom: 0; }
  .mobile-menu__tool--all { color: var(--text-2); font-size: clamp(16px, 4.6vw, 20px); }
  .mobile-menu__signs {
    direction: ltr;
    display: flex;
    flex-direction: column;
  }
  .mobile-menu__sign {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 13px;
    padding: 10px 0;
    text-decoration: none;
    font-family: var(--font-nav-serif);
    font-size: clamp(20px, 5.5vw, 26px);
    font-weight: 400;
    color: var(--text);
    border-bottom: 1px solid var(--hair);
  }
  :global(html:lang(ar)) .mobile-menu__sign { direction: rtl; }
  .mobile-menu__sign:last-child { border-bottom: 0; }
  @media (prefers-reduced-motion: reduce) {
    .nav__burger,
    .nav__dropdown-btn svg,
    .nav__burger-line,
    .nav-menu { transition: none; }
  }
</style>

<script>
  const navWrap = document.querySelector('[data-nav]')?.parentElement;
  const toolsBtn = document.querySelector('[data-tools-toggle]') as HTMLButtonElement | null;
  const toolsMenu = document.querySelector('[data-tools-menu]') as HTMLElement | null;
  const signsBtn = document.querySelector('[data-signs-toggle]') as HTMLButtonElement | null;
  const signsMenu = document.querySelector('[data-signs-menu]') as HTMLElement | null;
  const burger = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const mobileMenu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;

  // Menu sign icons ship with data-src/data-srcset (SignIcon `deferred`) so a
  // closed panel fetches nothing at page load; promote them the first time the
  // panel opens. Sources before imgs, so the browser never picks the webp
  // fallback while its sibling source is still empty.
  function loadDeferredIcons(panel: HTMLElement | null) {
    if (!panel) return;
    for (const el of panel.querySelectorAll<HTMLElement>('source[data-srcset], img[data-src]')) {
      const { srcset, src } = el.dataset;
      if (srcset) { (el as HTMLSourceElement).srcset = srcset; delete el.dataset.srcset; }
      if (src) { (el as HTMLImageElement).src = src; delete el.dataset.src; }
    }
  }

  function dropdown(
    button: HTMLButtonElement | null,
    menu: HTMLElement | null,
    columns: number,
  ) {
    if (!button || !menu) return null;
    const toggle = button;
    const panel = menu;
    const items = [...panel.querySelectorAll<HTMLAnchorElement>('a')];
    let active = 0;
    let hideTimer: number | undefined;

    function setActive(index: number, focus = false) {
      active = (index + items.length) % items.length;
      items.forEach((item, i) => { item.tabIndex = i === active ? 0 : -1; });
      if (focus) items[active]?.focus();
    }

    function setOpen(open: boolean, focusIndex?: number) {
      window.clearTimeout(hideTimer);
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        loadDeferredIcons(panel);
        panel.hidden = false;
        if (focusIndex !== undefined) setActive(focusIndex, true);
        requestAnimationFrame(() => panel.classList.add('is-open'));
      } else {
        panel.classList.remove('is-open');
        hideTimer = window.setTimeout(() => { panel.hidden = true; }, 190);
      }
    }

    toggle.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      setOpen(true, event.key === 'ArrowDown' ? 0 : items.length - 1);
    });

    panel.addEventListener('keydown', (event) => {
      const item = (event.target as HTMLElement).closest<HTMLAnchorElement>('a');
      if (!item) return;
      const index = items.indexOf(item);
      const moves: Record<string, number> = {
        ArrowRight: 1,
        ArrowLeft: -1,
        ArrowDown: columns,
        ArrowUp: -columns,
      };
      if (event.key in moves) {
        event.preventDefault();
        setActive(index + moves[event.key], true);
      } else if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        setActive(event.key === 'Home' ? 0 : items.length - 1, true);
      } else if (event.key === 'Escape') {
        event.preventDefault();
        event.stopPropagation();
        setOpen(false);
        toggle.focus();
      }
    });

    items.forEach((item, index) => {
      item.addEventListener('focus', () => setActive(index));
    });
    setActive(0);

    return {
      button: toggle,
      menu: panel,
      isOpen: () => toggle.getAttribute('aria-expanded') === 'true',
      setOpen,
    };
  }

  const toolsDropdown = dropdown(toolsBtn, toolsMenu, 2);
  const signsDropdown = dropdown(signsBtn, signsMenu, 3);

  toolsDropdown?.button.addEventListener('click', () => {
    const open = !toolsDropdown.isOpen();
    signsDropdown?.setOpen(false);
    toolsDropdown.setOpen(open);
  });
  toolsDropdown?.button.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') signsDropdown?.setOpen(false);
  });
  signsDropdown?.button.addEventListener('click', () => {
    const open = !signsDropdown.isOpen();
    toolsDropdown?.setOpen(false);
    signsDropdown.setOpen(open);
  });
  signsDropdown?.button.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') toolsDropdown?.setOpen(false);
  });

  // An open dropdown must not float over content once keyboard focus has
  // moved on (WCAG 1.4.13-adjacent) — close when focus leaves both parts.
  for (const dd of [toolsDropdown, signsDropdown]) {
    if (!dd) continue;
    const closeOnFocusout = (event: FocusEvent) => {
      const next = event.relatedTarget as Node | null;
      if (next && (dd.menu.contains(next) || dd.button.contains(next))) return;
      dd.setOpen(false);
    };
    dd.menu.addEventListener('focusout', closeOnFocusout);
    dd.button.addEventListener('focusout', closeOnFocusout);
  }

  const mobileFocusables = () => Array.from(
    mobileMenu?.querySelectorAll<HTMLElement>('a[href], button:not([disabled])') ?? [],
  );

  function setMobile(open: boolean) {
    if (!burger || !mobileMenu) return;
    const hadFocusInside = mobileMenu.contains(document.activeElement);
    if (open) {
      loadDeferredIcons(mobileMenu);
      toolsDropdown?.setOpen(false);
      signsDropdown?.setOpen(false);
    }
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open
      ? (burger.dataset.closeLabel || 'Close menu')
      : (burger.dataset.openLabel || 'Menu'));
    mobileMenu.hidden = !open;
    mobileMenu.classList.toggle('is-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    // The overlay covers the page, so focus must travel with it: into the
    // first menu link on open, back to the burger on close — never dropped
    // onto <body> behind a full-screen surface.
    if (open) mobileFocusables()[0]?.focus();
    else if (hadFocusInside) burger.focus();
  }

  // While the full-screen menu is open, Tab cycles inside it.
  mobileMenu?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab') return;
    const items = mobileFocusables();
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
  burger?.addEventListener('click', () => {
    setMobile(burger.getAttribute('aria-expanded') !== 'true');
  });
  mobileMenu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMobile(false);
  });
  document.addEventListener('click', (event) => {
    if (navWrap?.contains(event.target as Node)) return;
    toolsDropdown?.setOpen(false);
    signsDropdown?.setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const focused = document.activeElement;
    const restore = toolsDropdown?.menu.contains(focused)
      ? toolsDropdown.button
      : signsDropdown?.menu.contains(focused)
        ? signsDropdown.button
        : mobileMenu && mobileMenu.contains(focused)
          ? burger
          : null;
    toolsDropdown?.setOpen(false);
    signsDropdown?.setOpen(false);
    setMobile(false);
    restore?.focus();
  });

  // Profile glyph fills once anything is saved on this verified browser surface.
  const syncProfileGlyph = () => {
    const glyph = document.querySelector('[data-profile-glyph]');
    glyph?.classList.remove('has-saves');
    try {
      const profileAccess = Reflect.get(window, 'zodiacsProfileAccess') as
        { canRead?: () => boolean } | undefined;
      if (document.documentElement.hasAttribute('data-account-sync-v2')
        && profileAccess?.canRead?.() !== true) return;
      const raw = localStorage.getItem('zodiacs.profile.v1');
      if (raw && JSON.parse(raw)?.charts?.length) glyph?.classList.add('has-saves');
    } catch { /* private mode etc. — glyph stays empty */ }
  };
  syncProfileGlyph();
  window.addEventListener('zodiacs:profile-access', syncProfileGlyph);
  window.addEventListener('zodiacs:profile', syncProfileGlyph);

</script>

{locale === 'en' && (
  <script is:inline>
    /* Site search loader — deliberately a CLASSIC inline script. The dialog,
       index fetch, and ranking live in /assets/search-ui.js (built by
       scripts/build-search-ui.mjs); dynamic import() works in classic
       scripts, and keeping it out of the processed module graph is what
       lets Astro inline the nav script — otherwise every page, including
       the zero-JS sign pages, would carry an external nav chunk. */
    (function () {
      var btn = document.querySelector('[data-search-open]');
      if (!btn) return;
      function open(from) {
        import('/assets/search-ui.js').then(function (mod) {
          mod.openSearch(from || btn);
        });
      }
      btn.addEventListener('click', function () { open(btn); });
      document.addEventListener('keydown', function (e) {
        var el = e.target;
        var typing = el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA'
          || el.tagName === 'SELECT' || el.isContentEditable);
        if ((e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !e.altKey)
          || ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey))) {
          e.preventDefault();
          open(btn);
        }
      });
      var initialUrl = new URL(window.location.href);
      if (initialUrl.searchParams.has('search')) {
        initialUrl.searchParams.delete('search');
        history.replaceState(
          history.state,
          '',
          initialUrl.pathname + initialUrl.search + initialUrl.hash
        );
        open(btn);
      }
    })();
  </script>
)}
