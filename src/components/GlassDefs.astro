---
/**
 * The liquid-glass lens, made portable. The homepage pioneered the SVG
 * displacement lens (capsule maps refracting the backdrop at the rim);
 * this component carries the same filter defs to any page that opts in
 * via <Base glass>, so `.btn--glass` capsules can be lens-refracted on
 * Chromium instead of stopping at the frosted floor.
 *
 * The lens rules live INSIDE this component on purpose: a page that
 * carries `html.zdx-lens` (set globally in Base) but no filter defs must
 * never reference `url(#zdx-lens-cta)` — an unresolvable backdrop filter
 * paints no backdrop at all. Where the defs go, the rules go.
 *
 * The homepage keeps its own inline defs + hero-scoped rules until the
 * sitewide glass rollout migrates it here (MASTER-PLAN §13.3).
 */
import glassMaps from '../data/glass-maps.json';
---
<svg class="glass-defs" aria-hidden="true" focusable="false">
  <filter id="zdx-lens-cta" color-interpolation-filters="sRGB" primitiveUnits="objectBoundingBox" x="-0.1" y="-0.2" width="1.2" height="1.4">
    <feImage href={glassMaps.cta} x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
    <feDisplacementMap in="SourceGraphic" in2="map" scale="0.5" xChannelSelector="R" yChannelSelector="G" result="disp" />
    <feGaussianBlur in="disp" stdDeviation="0.009 0.038" result="soft" />
    <feColorMatrix in="soft" type="saturate" values="1.4" />
  </filter>
</svg>

<style is:global>
  .glass-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  /* Chromium-only lens upgrade for glass buttons. Astro bundles global
     styles by import graph, not render tree, so this rule ships to every
     page — the `.glass-defs ~ main` combinator is what actually scopes it
     to pages where the defs RENDER (GlassDefs sits immediately before
     <main> in Base). Without the defs present, url(#zdx-lens-cta) paints
     no backdrop at all, which is exactly the failure this prevents. */
  html.zdx-lens .glass-defs ~ main .btn--glass {
    background: rgba(10, 12, 17, 0.34);
    backdrop-filter: url(#zdx-lens-cta);
    -webkit-backdrop-filter: url(#zdx-lens-cta);
  }
  @media (prefers-reduced-transparency: reduce) {
    html.zdx-lens .glass-defs ~ main .btn--glass,
    html.zdx-lens .glass-defs ~ main .btn--glass:hover {
      background: rgba(24, 28, 39, 0.92);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
