---
/**
 * The one sanctioned cross-link from a guide into the collector's wing.
 * Quiet, museum-toned, near the top so visitors arriving from external
 * listings find the record in one click. No market language here.
 */
import { t } from '../lib/i18n';

interface Props {
  signName: string;
  slug: string;
  locale?: 'en' | 'es';
}
const { signName, slug, locale = 'en' } = Astro.props;
const copy = {
  label: t(locale, 'recordLabel'),
  text: `${signName} ${t(locale, 'recordOneOfTwelve')}`,
  link: t(locale, 'recordViewLink'),
};
---
<aside class="collect-band">
  <span class="collect-band__label mono">{copy.label}</span>
  <span class="collect-band__text">
    {copy.text}
  </span>
  <a class="collect-band__link" href={`/registry/${slug}/`}>{copy.link}</a>
</aside>

<style>
  .collect-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding: 12px 18px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: linear-gradient(90deg, rgba(198, 204, 218, 0.04), transparent 60%);
  }
  .collect-band__label {
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .collect-band__text {
    font-size: 13px;
    color: var(--muted);
  }
  .collect-band__link {
    margin-left: auto;
    font-size: 13px;
    font-weight: 550;
    color: var(--text-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .collect-band__link:hover { color: var(--text); }
</style>
