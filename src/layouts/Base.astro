---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';
import SEO from '../components/SEO.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SourcesLine, { type SourceLink } from '../components/SourcesLine.astro';
import EditorialLine from '../components/EditorialLine.astro';
import GlassDefs from '../components/GlassDefs.astro';
import EditionFreshnessGuard from '../components/EditionFreshnessGuard.astro';
import AskAboutThis from '../components/AskAboutThis.astro';
import { ANALYTICS_EVENT_PROPS, ANALYTICS_EVENT_VALUES } from '../lib/analytics';
import { hasDailyChartEmailProvider } from '../lib/email/daily-config';
import { BRAND_ICON_PATHS } from '../lib/brand-icons.mjs';
import { LOCALE_META, UI, normalizeCatalogLocale, stripLocale, t, type CatalogLocale as Locale } from '../lib/i18n';
import { RUSSIAN_RUNTIME } from '../lib/i18n/ru-runtime/server';

interface Props {
  title: string;
  description: string;
  path: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Pair with noindex for routes that must not pass discovery onward. */
  nofollow?: boolean;
  jsonLd?: Record<string, unknown>[];
  locale?: Locale;
  sources?: SourceLink[];
  /** Optional route-specific RSS autodiscovery in addition to the global feeds. */
  rssFeed?: { href: string; title: string };
  /** Include the liquid-glass lens defs so `.btn--glass` refracts on Chromium. */
  glass?: boolean;
  /** Embed this page's one-locale UI catalog before hydrating client islands. */
  clientUi?: boolean;
  /** Inline this route's emitted CSS at postbuild for latency-sensitive entry pages. */
  inlineCriticalCss?: boolean;
  /** Use optional font aliases so a cold font can never shift this page. */
  stableTypography?: boolean;
  /** Use metric-matched local faces when first paint must make zero font requests. */
  localTypography?: boolean;
  /** UTC edition rendered by a daily surface; relative wording is enabled only while current. */
  editionDate?: string;
}

const props = Astro.props;
const locale = normalizeCatalogLocale(props.locale);
const clientUi = props.clientUi ? UI[locale] : null;
const russianRuntime = props.clientUi && locale === 'ru' ? RUSSIAN_RUNTIME : null;
const plausibleScriptUrl = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_URL?.trim();
const plausibleEndpoint = import.meta.env.PUBLIC_PLAUSIBLE_ENDPOINT?.trim() ?? '';
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN?.trim() ?? '';
const plausibleEnabled = Boolean(plausibleScriptUrl && !props.noindex);
const dailyEmailLifecycleEnabled = hasDailyChartEmailProvider(process.env);
const rtlDocumentDirection = (direction: 'ltr' | 'rtl') => direction === 'rtl' ? direction : undefined;
const assistantContextPath = stripLocale(props.path);
const assistantContextTopic = assistantContextPath.startsWith('/birth-chart/')
  ? 'chart'
  : assistantContextPath.startsWith('/transits/')
    ? 'transits'
    : assistantContextPath.startsWith('/compatibility/')
      ? 'compatibility'
      : assistantContextPath.startsWith('/learn/')
        ? 'learn'
        : null;

---
<!doctype html>
<html
  lang={LOCALE_META[locale].htmlLang}
  dir={rtlDocumentDirection(LOCALE_META[locale].dir)}
  data-edition-date={props.editionDate || undefined}
  data-inline-critical-css={props.inlineCriticalCss ? '' : undefined}
  data-stable-typography={props.stableTypography ? '' : undefined}
  data-local-typography={props.localTypography ? '' : undefined}
  data-daily-email-lifecycle={dailyEmailLifecycleEnabled ? '' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#060709" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      /* Chromium paints SVG url() backdrop filters; Safari reports support but
         renders nothing. Mark Chromium so the glass lens applies only there —
         Safari/iOS keep the frosted -webkit-backdrop-filter blur floor instead
         of a flat, transparent capsule. Runs in <head> so there's no flash. */
      try {
        if (window.chrome && window.CSS && CSS.supports('backdrop-filter', "url('#zdx-lens-cta')")) {
          document.documentElement.classList.add('zdx-lens');
        }
      } catch (e) {}
    </script>
    {props.editionDate && (
      <>
        <script is:inline>
          var editionRoot = document.documentElement;
          var editionDate = editionRoot.getAttribute('data-edition-date');
          var editionState = editionDate === new Date().toISOString().slice(0, 10) ? 'current' : 'dated';
          editionRoot.setAttribute('data-edition-state', editionState);

          /* EditionText keeps a dated server/no-JS fallback. On a current
             edition, replace each span as the parser adds it so a warm-cache
             paint can never briefly lay out the longer dated label. */
          if (editionState === 'current' && 'MutationObserver' in window) {
            var syncCurrentEditionText = function (node) {
              if (node.nodeType === Node.TEXT_NODE) {
                var parent = node.parentElement && node.parentElement.closest('[data-edition-text]');
                if (parent) {
                  var parentCurrent = parent.getAttribute('data-edition-current');
                  if (parentCurrent !== null && parent.textContent !== parentCurrent) parent.textContent = parentCurrent;
                }
                return;
              }
              if (node.nodeType !== Node.ELEMENT_NODE && node.nodeType !== Node.DOCUMENT_NODE) return;
              var nodes = [];
              if (node.nodeType === Node.ELEMENT_NODE && node.matches('[data-edition-text]')) nodes.push(node);
              node.querySelectorAll('[data-edition-text]').forEach(function (match) { nodes.push(match); });
              nodes.forEach(function (match) {
                var current = match.getAttribute('data-edition-current');
                if (current !== null && match.textContent !== current) match.textContent = current;
              });
            };
            var editionPrepaintObserver = new MutationObserver(function (records) {
              records.forEach(function (record) {
                record.addedNodes.forEach(syncCurrentEditionText);
              });
            });
            editionPrepaintObserver.observe(editionRoot, { childList: true, subtree: true });
            document.addEventListener('DOMContentLoaded', function () {
              syncCurrentEditionText(document);
              editionPrepaintObserver.disconnect();
            }, { once: true });
          }
        </script>
        <style is:inline>
          [data-edition-current-only] { display: none; }
          [data-edition-dated-only] { display: inline; }
          :root[data-edition-state="current"] [data-edition-current-only] { display: inline; }
          :root[data-edition-state="current"] [data-edition-dated-only] { display: none; }
        </style>
      </>
    )}
    {props.editionDate && <EditionFreshnessGuard />}
    <script is:inline>
      // Capture Chromium's one-shot install event before calculator islands
      // hydrate. The prompt itself stays hidden until two successful charts.
      window.addEventListener('beforeinstallprompt', function (event) {
        event.preventDefault();
        window.zodiacsInstallPrompt = event;
        window.dispatchEvent(new Event('zodiacs:install-prompt-ready'));
      });
    </script>
    <link rel="icon" type="image/svg+xml" sizes="any" href={BRAND_ICON_PATHS.faviconSvg} />
    <link rel="icon" type="image/png" sizes="16x16" href={BRAND_ICON_PATHS.favicon16} />
    <link rel="icon" type="image/png" sizes="32x32" href={BRAND_ICON_PATHS.favicon32} />
    <link rel="icon" type="image/png" sizes="96x96" href={BRAND_ICON_PATHS.favicon} />
    <link rel="apple-touch-icon" sizes="180x180" href={BRAND_ICON_PATHS.appleTouch} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Zodiacs.org — the sky, daily" href="/feeds/daily-sky.xml" />
    <link rel="alternate" type="application/rss+xml" title="Zodiacs.org daily horoscopes" href="/feeds/horoscopes.xml" />
    <link rel="alternate" type="application/rss+xml" title="The Zodiacs.org Almanac" href="/feeds/almanac.xml" />
    {props.rssFeed && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={props.rssFeed.title}
        href={props.rssFeed.href}
      />
    )}
    {locale === 'ru' ? (
      <>
        <link rel="preload" href="/fonts/golos-text-cyr-a.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/golos-text-cyr-b.woff2" as="font" type="font/woff2" crossorigin />
        {props.path !== '/ru/' && (
          <link rel="preload" href="/fonts/eb-garamond-cyrillic-500-normal.woff2" as="font" type="font/woff2" crossorigin />
        )}
      </>
    ) : !props.localTypography && (
      <>
        <link
          rel="preload"
          href="/fonts/instrument-sans-latin-wght-normal.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
        <link
          rel="preload"
          href="/fonts/eb-garamond-latin-500-normal.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      </>
    )}
    <!-- The mono face is decorative metadata, never the LCP typeface. Let CSS
         discover it after the sans/serif faces instead of making its 39KB
         preload compete with the first meaningful paint on mobile. -->
    <SEO {...props} />
    {locale === 'en' && (
      <script is:inline>
        (function () {
          var context = document.modelContext || Reflect.get(navigator, 'modelContext');
          if (!context || typeof context.registerTool !== 'function') return;
          import('/assets/webmcp-register.js')
            .then(function (module) { return module.registerWebMcpSearch(context); })
            .catch(function () {});
        })();
      </script>
    )}
    <script is:inline>window.zodiacsAnalytics = window.zodiacsAnalytics || Object.freeze({ track: function () {} });</script>
    {plausibleEnabled && (
      <>
        <script is:inline define:vars={{
          plausibleEndpoint,
          analyticsEventProps: ANALYTICS_EVENT_PROPS,
          analyticsEventValues: ANALYTICS_EVENT_VALUES,
        }}>
          window.plausible = window.plausible || function () {
            (window.plausible.q = window.plausible.q || []).push(arguments);
          };
          window.plausible.init = window.plausible.init || function (options) {
            window.plausible.o = options || {};
          };
          var options = {
            hashBasedRouting: false,
            transformRequest: function (payload) {
              var canonical = document.querySelector('link[rel="canonical"]');
              payload.u = canonical ? canonical.href : location.origin + location.pathname;
              payload.r = null;
              if (payload.p && payload.p.url) delete payload.p.url;
              return payload;
            }
          };
          if (plausibleEndpoint) options.endpoint = plausibleEndpoint;
          window.plausible.init(options);
          var eventProps = Object.freeze(analyticsEventProps);
          window.zodiacsAnalytics = Object.freeze({
            track: function (name, props) {
              var allowed = eventProps[name];
              if (!allowed) return;
              var safe = {};
              allowed.forEach(function (key) {
                var value = (props || {})[key];
                var enumValues = analyticsEventValues[name] && analyticsEventValues[name][key];
                if (enumValues && (typeof value !== 'string' || enumValues.indexOf(value) === -1)) return;
                if (typeof value === 'number' || typeof value === 'boolean' ||
                    (typeof value === 'string' && value.length <= 32)) safe[key] = value;
              });
              window.plausible(name, { props: safe });
            }
          });
          document.addEventListener('click', function (event) {
            var target = event.target;
            var link = target && target.closest ? target.closest('a[href]') : null;
            if (!link) return;
            var href = link.getAttribute('href') || '';
            var destination = href.indexOf('/sdk/') === 0 ? 'docs'
              : href.indexOf('npmjs.com/package/@zodiacs/sdk') !== -1 ? 'npm'
              : href.indexOf('github.com/ZodiacsOfficial/sdk') !== -1 ? 'github' : '';
            if (destination) window.zodiacsAnalytics.track('sdk_click', {
              source: 'astrology', destination: destination
            });
          });
        </script>
        <script is:inline defer data-domain={plausibleDomain || undefined} src={plausibleScriptUrl}></script>
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <!-- Keep the route catalog ahead of every island, but out of <head> so
         its ~20KB inline payload cannot delay CSS and LCP-font discovery. -->
    {clientUi && (
      <script is:inline define:vars={{ uiLocale: locale, uiMessages: clientUi }}>
        globalThis.__ZDX_UI__ = { locale: uiLocale, messages: uiMessages };
      </script>
    )}
    {russianRuntime && (
      <script is:inline define:vars={{ russianRuntime }}>
        globalThis.__ZDX_RU__ = { locale: 'ru', data: russianRuntime };
      </script>
    )}
    <a href="#main" class="skip">{t(locale, 'skipContent')}</a>
    <div class="orbs" aria-hidden="true"></div>
    <div class="dust" aria-hidden="true"></div>

    <SiteNav locale={locale} />

    {props.glass && <GlassDefs />}

    <main id="main">
      <slot />
    </main>

    {assistantContextTopic && locale !== 'ru' && (
      <AskAboutThis
        locale={locale}
        path={props.path}
        topic={assistantContextTopic}
      />
    )}

    {props.type === 'article' && <EditorialLine locale={locale} />}
    <SourcesLine sources={props.sources} locale={locale} />
    <SiteFooter locale={locale} />

    <script>
      // Scroll reveal — heavy fade-up on viewport entry, once.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveals = document.querySelectorAll('.reveal');
      if (!reduced && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          // threshold 0: tall blocks (full articles) must still reveal —
          // a ratio threshold never fires for elements taller than the
          // viewport.
          { threshold: 0, rootMargin: '0px 0px -8% 0px' }
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-in'));
      }

      // The worker owns only a versioned astrology app shell. Registry
      // identity JSON bypasses its caches in public/sw.js.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
        }, { once: true });
      }
    </script>
  </body>
</html>

<style is:global>
  :root { --nav-space: 96px; }
  main { position: relative; z-index: var(--z-base); padding-top: var(--nav-space); }
</style>
