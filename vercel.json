{
  "functions": {
    "api/assistant.ts": {
      "supportsCancellation": true,
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "^www\\.zodiacs\\.org$" }],
      "destination": "https://zodiacs.org/:path",
      "permanent": true
    },
    { "source": "/astrofolio", "destination": "/sdk/#astrofolio", "statusCode": 301 },
    { "source": "/astrofolio/", "destination": "/sdk/#astrofolio", "statusCode": 301 },
    { "source": "/astrofolio-sdk", "destination": "/sdk/#astrofolio", "statusCode": 301 },
    { "source": "/astrofolio-sdk/", "destination": "/sdk/#astrofolio", "statusCode": 301 },
    { "source": "/astrology-sdk", "destination": "/sdk/#new-input", "statusCode": 301 },
    { "source": "/astrology-sdk/", "destination": "/sdk/#new-input", "statusCode": 301 },
    { "source": "/build-ai-astrology-app", "destination": "/sdk/#ai-astrology", "statusCode": 301 },
    { "source": "/build-ai-astrology-app/", "destination": "/sdk/#ai-astrology", "statusCode": 301 },
    { "source": "/cosmic-receipt", "destination": "/sdk/#receipt-preview", "statusCode": 301 },
    { "source": "/cosmic-receipt/", "destination": "/sdk/#receipt-preview", "statusCode": 301 },
    { "source": "/simastry-zodiacs-sdk", "destination": "/sdk/#simastry", "statusCode": 301 },
    { "source": "/simastry-zodiacs-sdk/", "destination": "/sdk/#simastry", "statusCode": 301 },
    { "source": "/tools-for-building-astrology-apps", "destination": "/sdk/#app-stack", "statusCode": 301 },
    { "source": "/tools-for-building-astrology-apps/", "destination": "/sdk/#app-stack", "statusCode": 301 },
    { "source": "/zodiac-ownership-api", "destination": "/sdk/#core-api", "statusCode": 301 },
    { "source": "/zodiac-ownership-api/", "destination": "/sdk/#core-api", "statusCode": 301 },
    { "source": "/collect", "destination": "/registry/", "permanent": true },
    { "source": "/collect/", "destination": "/registry/", "permanent": true },
    { "source": "/collect/:path(.*)", "destination": "/registry/:path", "permanent": true },
    {
      "source": "/:path((?!api(?:/|$)|\\.well-known(?:/|$)|.*\\.[^/]+$).*[^/])",
      "destination": "/:path/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *; object-src 'none'; base-uri 'self'" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/app.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/zodiac-icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(art|nuggets|og)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
