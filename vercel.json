      "destination": "/terminal/",
      "permanent": true
    },
    {
      "source": "/collect/:path(.*)",
      "destination": "/registry/:path",
      "permanent": true
    },
    {
      "source": "/registry/shelf",
      "destination": "/terminal/",
      "permanent": true
    },
    {
      "source": "/registry/shelf/",
      "destination": "/terminal/",
      "permanent": true
    },
    {
      "source": "/registry/gallery",
