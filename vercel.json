    },
    {
      "source": "/simastry-zodiacs-sdk",
      "destination": "/sdk/#simastry",
      "statusCode": 301
    },
    {
      "source": "/simastry-zodiacs-sdk/",
      "destination": "/sdk/#simastry",
      "statusCode": 301
    },
    {
      "source": "/tools-for-building-astrology-apps",
      "destination": "/sdk/#app-stack",
      "statusCode": 301
    },
    {
      "source": "/tools-for-building-astrology-apps/",
      "destination": "/sdk/#app-stack",
      "statusCode": 301
    },
    {
      "source": "/zodiac-ownership-api",
      "destination": "/sdk/#core-api",
      "statusCode": 301
    },
    {
