          "type": "host",
          "value": "^www\\.zodiacs\\.org$"
        }
      ],
      "destination": "https://zodiacs.org/:path",
      "permanent": true
    },
    {
      "source": "/astrofolio",
      "destination": "/sdk/#astrofolio",
      "statusCode": 301
    },
    {
      "source": "/astrofolio/",
      "destination": "/sdk/#astrofolio",
      "statusCode": 301
    },
    {
      "source": "/astrofolio-sdk",
      "destination": "/sdk/#astrofolio",
