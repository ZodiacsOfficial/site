{
  "name": "zodiacs-video",
  "private": true,
  "type": "module",
  "description": "15s looping X-timeline video for zodiacs.org — Remotion source",
  "scripts": {
    "studio": "remotion studio",
    "render:square": "remotion render Square out/zodiacs-x-square.mp4",
    "render:wide": "remotion render Wide out/zodiacs-x-wide.mp4",
    "render:vertical": "remotion render Vertical out/zodiacs-x-vertical.mp4",
    "still:first": "remotion still Square out/loop-frame-000.png --frame=0",
    "still:last": "remotion still Square out/loop-frame-449.png --frame=449",
    "verify:loop": "node tools/verify-loop.mjs",
    "verify:legibility": "node tools/verify-legibility.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.0",
    "typescript": "^5.8.0"
  }
}
